 }
diff --git a/clang/include/clang/Basic/ChineseDirectives.def b/clang/include/clang/Basic/ChineseDirectives.def
new file mode 100644
index 0000000..9976409
--- /dev/null
+++ b/clang/include/clang/Basic/ChineseDirectives.def
@@ -0,0 +1,140 @@
+//===--- ChineseDirectives.def - 中文预处理指令拼写表 -----------*- C -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+//  本文件为 Clang 增加「中文预处理指令拼写」（Chinese preprocessor
+//  directive spellings）。
+//
+//  效果：`#包含` 与 `#include` 被识别为【同一条】指令。例如
+//
+//      中文 `#包含`  ─┐
+//                     ├─→  tok::pp_include  →  HandleIncludeDirective
+//      英文 `#include`─┘
+//
+//  用户可以【随意混用】中英两种拼写，不需要任何开关或模式 —— 因为两种拼写
+//  解析出的是同一个 tok::pp_* 枚举值，`HandleDirective` 拿到枚举值之后
+//  根本无法区分文件里写的是哪一种（它从来不看指令名的拼写）。
+//
+//  设计约束（修改本文件前请务必阅读）：
+//
+//   1. 【只增不改】本文件只“新增”拼写。TokenKinds.def 里的 PPKEYWORD 列表
+//      保持零改动，所以英文指令的既有行为完全不变，标准库头文件、第三方
+//      项目以及 Clang 自举编译都不受影响。
+//
+//   2. 【单一 token】每个中文拼写都映射到与英文原指令「完全相同」的
+//      tok::pp_* 上。因此词法分析之后的所有阶段 —— PPDirectives、
+//      PreprocessingRecord、clang-format、clangd、libclang 索引 ——
+//      均无需任何改动。
+//
+//   3. 【本表的读取者】目前有两处，加拼写时两处自动同步、无需手工维护：
+//
+//        * clang/lib/Basic/IdentifierTable.cpp : lookupChineseDirective()
+//          把中文拼写解析成 tok::pp_*，供 `#` 之后的指令分发使用。
+//        * tests/checks/verify_chinese_keywords.py 第 11 节
+//          机器校核本表与 TokenKinds.def / ChineseKeywords.def 的一致性。
+//
+//      依赖扫描器（clang/lib/Lex/DependencyDirectivesScanner.cpp）是【第三处】
+//      读取者，但它为了性能自有一张 ASCII 字符串表，不能 include 本文件；
+//      它那 13 条中文 .Case() 由上面第 11 节校核为「本表与本表英文名在
+//      扫描器中的交集」，因此不会漂移。
+//
+//   4. 【键是英文名】第一个参数必须是 TokenKinds.def 中 PPKEYWORD 的
+//      英文名（拼写完全一致）。它同时被用作 tok::pp_##EN，所以写错名字
+//      编译不过 —— 这是故意的：编译器替我们查出拼写错误。
+//
+//   5. 【不与关键字表抢所有权】`模块` / `导入` 同时出现在
+//      ChineseKeywords.def 第八节（作为 C++20 模块关键字 kw_module /
+//      kw_import）。本表也列出它们，是因为「中文预处理指令拼写」这件事
+//      需要一处唯一来源给依赖扫描器和校验脚本用。两者给出的 tok::pp_*
+//      必须相同，第 11 节机器校核。
+//
+//       ⚠ 这里推翻了一条 2026-09-22 写在 IdentifierTable.cpp 里的旧结论：
+//         「放在这里而不是新增一张 .def 表：标志位已经是唯一数据源，
+//          再抄一份拼写就会出现两处需要同步。」
+//         那条结论对【关键字】成立（关键字都有标志位），对【指令】不成立：
+//         include / define / if 这些英文在 TokenKinds.def 里【没有】关键字
+//         标志位可抄，而且依赖扫描器根本读不到标志位。所以指令拼写必须
+//         自有一张表。推翻记录见 docs\诊断汉化\第三批-待译与术语包.md。
+//
+//   6. 【汉字数 2–6】与关键字同一条定则（用户 2026-09-23 明确）。本表
+//      最长的是 `否则若未定义` / `否则若已定义`（6 字），全部合规。
+//
+//   7. 【译名唯一】本表内不得重复。与关键字表重名时，只有当两者指向
+//      【同一个英文】才允许 —— 例如 `如果` 既是关键字 if 也是指令 if，
+//      这与英文 `if` 的双重身份完全一致（指令名在
+//      ParsingPreprocessorDirective 下不做关键字映射）。若把 `#否则` 指给
+//      endif 而 `否则` 是 else，第 11 节会报错。
+//
+//   8. 【有意不收的拼写】下面 6 条保持英文，不收中文：
+//
+//        __include_macros   __preprocessed_module   __preprocessed_import
+//        __public_macro     __private_macro         sccs
+//
+//      前 5 条是编译器自己写进 PCH / 模块文件（.pcm）的内部拼写。PCH 与
+//      模块文件是二进制格式、可跨版本复用，改动其指令拼写会影响格式兼容，
+//      收益为零。`sccs` 是 1980 年代 SCCS 的遗留，Clang 默认报错，
+//      没有必要汉化。
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef ZH_DIRECTIVE
+#define ZH_DIRECTIVE(EN, ZH)
+#endif
+
+// C99 6.10.1 - Conditional Inclusion.
+
+ZH_DIRECTIVE(if, 如果)
+ZH_DIRECTIVE(ifdef, 如果已定义)
+ZH_DIRECTIVE(ifndef, 如果未定义)
+ZH_DIRECTIVE(elif, 否则若)
+ZH_DIRECTIVE(elifdef, 否则若已定义)
+ZH_DIRECTIVE(elifndef, 否则若未定义)
+ZH_DIRECTIVE(else, 否则)
+ZH_DIRECTIVE(endif, 结束如果)
+
+// C99 6.10.2 - Source File Inclusion.
+
+ZH_DIRECTIVE(include, 包含)
+
+// C99 6.10.3 - Macro Replacement.
+
+ZH_DIRECTIVE(define, 定义)
+ZH_DIRECTIVE(undef, 取消定义)
+
+// C99 6.10.4 - Line Control.
+
+ZH_DIRECTIVE(line, 行号)
+
+// C99 6.10.5 - Error Directive.
+
+ZH_DIRECTIVE(error, 错误)
+
+// C99 6.10.6 - Pragma Directive.
+
+ZH_DIRECTIVE(pragma, 编译指示)
+
+// C23 6.10.4 / C++26 - Embed Directive.
+
+ZH_DIRECTIVE(embed, 嵌入)
+
+// C++20 - Modules.
+
+ZH_DIRECTIVE(module, 模块)
+ZH_DIRECTIVE(import, 导入)
+
+// GNU Extensions.
+
+ZH_DIRECTIVE(include_next, 包含下一个)
+ZH_DIRECTIVE(warning, 警告)
+ZH_DIRECTIVE(ident, 标识)
+
+// Obsolete GNU Extensions.
+
+ZH_DIRECTIVE(assert, 断言)
+ZH_DIRECTIVE(unassert, 取消断言)
+
+#undef ZH_DIRECTIVE
diff --git a/clang/include/clang/Basic/ChineseKeywords.def b/clang/include/clang/Basic/ChineseKeywords.def
new file mode 100644
index 0000000..b721e42
--- /dev/null
+++ b/clang/include/clang/Basic/ChineseKeywords.def
@@ -0,0 +1,374 @@
+//===--- ChineseKeywords.def - 中文关键字别名表 -----------------*- C -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+//  本文件为 Clang 增加「中文关键字别名」（Chinese keyword aliases）。
+//
+//  效果：中文拼写与英文拼写都被识别为同一个关键字。例如
+//
+//      中文 `如果`  ─┐
+//                    ├─→  tok::kw_if
+//      英文 `if`    ─┘
+//
+//  设计约束（修改本文件前请务必阅读）：
+//
+//   1. 【只增不改】本文件只“新增”拼写，绝不修改 TokenKinds.def 中的任何
+//      英文定义。TokenKinds.def 保持零改动，因此英文关键字的既有行为完全
+//      不变，标准库头文件（libc / libcxx / compiler-rt）以及 Clang 自身的
+//      自举编译都不受影响。
+//
+//   2. 【单一 token】每个中文拼写都注册到与英文原关键字「完全相同」的
+//      tok::kw_* 上。因此词法分析之后的所有阶段 —— Parser、Sema、
+//      CodeGen、AST 打印、clang-format、clangd —— 均无需任何改动。
+//
+//   3. 【中文为主】本表同时被 clang/lib/Basic/TokenKinds.cpp 的
+//      getKeywordSpelling() 使用，使中文成为对外呈现的「正式拼写」：
+//      诊断信息、AST 打印、clangd 补全都显示中文。英文仍可正常书写，
+//      只是不再作为对外显示的正式拼写。
+//
+//   4. 【标志照抄】FLAGS 一律照抄 TokenKinds.def / Traits.td 中对应英文
+//      关键字的标志，使中文与英文在各语言模式（C / C++ / C23 / 协程 /
+//      模块）下的可用性完全一致。
+//
+//   5. 【译名唯一】译名必须互不重复。若两个中文拼写相同，后注册者会覆盖
+//      先注册者，导致其中一个关键字失效。
+//
+//   6. 【至少两字】所有译名不短于两个汉字。单字关键字极易与用户标识符
+//      冲突，汉语本身也以双音节为主。
+//
+//   7. 【最多六字】所有译名不多于六个汉字。
+//
+//      6 与 7 合起来是一条【定则】：译名的汉字数必须在 2–6 之间。
+//      由用户 2026-09-23 明确（原话：关键字有一个定则，就是至少要两个汉字，
+//      最多 6 个汉字，无论如何都得遵守这一条）。
+//      汉字数按【汉字】算，不按总字符数 —— 表里有一个带数字的译名
+//      `字符8位`（char8_t）：总长 4、汉字 3，合规。
+//
+//      ⚠ 在这之前只有第 6 条写在注释里、而且【没有任何机器校核】；第 7 条
+//      根本没写下来。现在两条都在 tests\checks\verify_chinese_keywords.py
+//      第 10 节机器校核，而且那一节**自带自测**（证明这个检查真的会失败）。
+//      实测 2026-09-23：**99 个译名全部合规**（三族合计，见第 8 条），
+//      最长的是 `取无修饰类型`（6 字）。
+//
+//   8. 【三族合计 99 条】本文件的译名分【三个宏族】，改任何一处都要知道总数：
+//
+//          ZH_KEYWORD            86   普通关键字（如果 / 返回 / 类型 …）
+//          ZH_VIRT_SPECIFIER      2   override 重写 / final 最终
+//          ZH_OPERATOR_KEYWORD   11   并且 或者 并非 异或 位与 位或 取反
+//                                     与赋值 或赋值 异或赋值 不等于
+//          ──────────────────────────
+//                                99
+//
+//      ⚠ 只解析第一族会数出 86 —— 这个坑 2026-09-23 踩过：有人用只匹配
+//      ZH_KEYWORD 的正则数出 86，据此去改文档里本来就对的 99。事实上
+//      「99」同时写在本文件所在目录的《关键字改动清单.md》第 7 行、
+//      tests\06-parity 的输出、以及校核器的三族分解里。
+//      现在 tests\checks\verify_chinese_keywords.py 解析全部三族，
+//      结论行会打印 86 ＋ 2 ＋ 11 ＝ 99。
+//
+//      译名的三条强制定则（2–6 个汉字 / 唯一 / 每个字符可被 clang 切分）
+//      与「已定、不再讨论」的译名，记在
+//      docs\关键字\关键字改动清单.md 的第十、十一节。
+//
+//  用法：仅以下两个位置会重定义 ZH_KEYWORD 并包含本文件，其它任何包含点
+//        都会把 ZH_KEYWORD 展开为空：
+//          clang/lib/Basic/IdentifierTable.cpp  —— 注册中文拼写
+//          clang/lib/Basic/TokenKinds.cpp       —— 中文作为正式拼写
+//
+//  编码：本文件含 UTF-8 中文，必须保证编译器按 UTF-8 读取本文件。
+//        在 MSVC 下由 clang/lib/Basic/CMakeLists.txt 对 IdentifierTable.cpp
+//        设置 /utf-8。若 TokenKinds.cpp 也需在 MSVC 下编译（它确实需要），
+//        该文件同样必须加 /utf-8，否则中文拼写会“静默失效”：不报错，只是
+//        永远匹配不上。
+//
+//  扩展：新增中文关键字只需在下方表中增加一行
+//            ZH_KEYWORD(英文名, 中文名, 标志)
+//        其中「英文名」必须与 TokenKinds.def 中 KEYWORD() 的第一个参数
+//        完全一致（Traits.td 来源的关键字同理，如 sizeof / alignof）。
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef ZH_KEYWORD
+#define ZH_KEYWORD(NAME, ZH, FLAGS)
+#endif
+
+//===----------------------------------------------------------------------===//
+// 一、C 语言关键字（KEYALL = 在 C 与 C++ 中均为关键字）
+//===----------------------------------------------------------------------===//
+
+ZH_KEYWORD(auto,      自动,   KEYALL)              // auto
+ZH_KEYWORD(break,     跳出,   KEYALL)              // break：跳出整个循环
+ZH_KEYWORD(case,      情形,   KEYALL)              // case
+ZH_KEYWORD(char,      字符,   KEYALL)              // char
+ZH_KEYWORD(const,     常量,   KEYALL)              // const
+ZH_KEYWORD(continue,  跳过,   KEYALL)              // continue：跳过本轮剩余，与 break「跳出」相对
+ZH_KEYWORD(default,   默认,   KEYALL)              // default
+ZH_KEYWORD(do,        执行,   KEYALL)              // do：后测试循环，“执行 { } 每当(条件);”
+ZH_KEYWORD(double,    双精度, KEYALL)              // double
+ZH_KEYWORD(else,      否则,   KEYALL)              // else
+ZH_KEYWORD(enum,      枚举,   KEYALL)              // enum
+ZH_KEYWORD(extern,    外部,   KEYALL)              // extern
+ZH_KEYWORD(float,     单精度, KEYALL)              // float
+ZH_KEYWORD(for,       对于,   KEYALL)              // for
+ZH_KEYWORD(goto,      跳转,   KEYALL)              // goto
+ZH_KEYWORD(if,        如果,   KEYALL)              // if
+ZH_KEYWORD(int,       整数,   KEYALL)              // int
+ZH_KEYWORD(long,      长型,   KEYALL)              // long：可组合为「长型 双精度」「长型 长型」
+ZH_KEYWORD(register,  寄存器, KEYALL)              // register
+ZH_KEYWORD(return,    返回,   KEYALL)              // return
+ZH_KEYWORD(short,     短型,   KEYALL)              // short
+ZH_KEYWORD(signed,    有符号, KEYALL)              // signed
+ZH_KEYWORD(static,    静态,   KEYALL)              // static
+ZH_KEYWORD(struct,    结构,   KEYALL)              // struct
+ZH_KEYWORD(switch,    选择,   KEYALL)              // switch
+ZH_KEYWORD(typedef,   类型别名, KEYALL)            // typedef
+ZH_KEYWORD(union,     共用体, KEYALL)              // union
+ZH_KEYWORD(unsigned,  无符号, KEYALL)              // unsigned
+ZH_KEYWORD(void,      空型,   KEYALL)              // void
+ZH_KEYWORD(volatile,  易变,   KEYALL | KEYNOHLSL)  // volatile
+ZH_KEYWORD(while,     每当,   KEYALL)              // while：“每当(条件) { }”
+
+// C99 6.5.3.4 / 6.7.4：一元运算符与函数说明符
+// sizeof 定义于 clang/include/clang/Basic/Traits.td（经 Traits.inc 引入）
+ZH_KEYWORD(sizeof,    大小,   KEYALL)              // sizeof
+ZH_KEYWORD(restrict,  受限,   KEYC99)              // restrict（C99）
+ZH_KEYWORD(inline,    内联,   KEYC99 | KEYCXX | KEYGNU)  // inline
+
+// C99 6.2.5 / C23：布尔与真值
+ZH_KEYWORD(bool,      布尔,   BOOLSUPPORT | KEYC23)  // bool
+ZH_KEYWORD(true,      真值,   BOOLSUPPORT | KEYC23)  // true
+ZH_KEYWORD(false,     假值,   BOOLSUPPORT | KEYC23)  // false
+
+//===----------------------------------------------------------------------===//
+// 二、C++ 关键字（KEYCXX = 仅 C++）
+//===----------------------------------------------------------------------===//
+
+ZH_KEYWORD(asm,               汇编,         KEYCXX | KEYGNU)  // asm
+ZH_KEYWORD(catch,             捕获,         KEYCXX)           // catch
+// ⚠ 译名【已定，不再讨论】：`class` 必须译成「类型」。
+//   由用户 2026-09-23 明确（原话：class 必须翻译成 类型，这是我和其他 AI
+//   对话里讨论的结果）。之所以要把"已定"写在这里 —— 此前全仓库翻遍只有
+//   docs\诊断汉化\诊断汉化-准备.md 的一行【陈述】，没有理由、也没有已定标记，
+//   于是 2026-09-23 有人把它当成待议项重新提了出来。只写映射不写状态，
+//   后来者只能读成"还没定"。
+//   （当时讨论的具体论证没有存进仓库。要看理由回去问用户，别自己编。）
+//
+//   【理由·2026-09-29 用户原话（补记，填空上面那句）】
+//       「之所以是类型而不是类，是因为我认为汉语关键字不能用一个汉字，至少得是两个」
+//   即：`类` 这种单字拼写**不能做关键字** —— 单字与用户标识符的冲突面太大，
+//   而汉语术语本身也以双音节为主。这与本文件开头的第 6/7 条【定则】
+//   （译名 2–6 个汉字，2026-09-23 用户明确）是**同一条定则**，
+//   `class` 只是它最有名的一处后果。
+//
+//   同一原因造成的其它译名（都不是"翻译偏好"，而是这条定则的必然后果）：
+//       void   -> 空型     （不是 `空`）
+//       auto   -> 自动     （不是 `自`）
+//       new    -> 新建     （不是 `新`）      delete -> 删除（不是 `删`）
+//       true/false -> 真值/假值（不是 `真`/`假`）
+//       break/continue -> 跳出/跳过（不是 `断`/`续`）
+//       nullptr-> 空指针   sizeof -> 大小     typedef -> 类型别名
+//       and/or/not -> 并且/或者/并非；bitand/bitor/compl -> 位与/位或/取反
+//   ⚠ 判据：**关键字译名一律 ≥2 汉字**；库里普通标识符不受此限（如标准库成员
+//      `尺寸` / `取值`），但不得与这 99 个关键字重名（生成器有机器守卫）。
+//
+//   推论（诊断汉化在用，不是这条关键字决定的一部分）：**关键字位置一律「类型」**；
+//   正文里作为【普通名词】出现的 class 沿用「类」（类模板 / 类中成员 / 最终类），
+//   见 ChineseDiagnostics.def 第十二节。
+ZH_KEYWORD(class,             类型,         KEYCXX)           // class：定义一个类类型
+ZH_KEYWORD(const_cast,        常量转换,     KEYCXX)           // const_cast
+ZH_KEYWORD(delete,            删除,         KEYCXX)           // delete
+ZH_KEYWORD(dynamic_cast,      动态转换,     KEYCXX)           // dynamic_cast
+ZH_KEYWORD(explicit,          显式,         KEYCXX)           // explicit
+ZH_KEYWORD(export,            导出,         KEYCXX)           // export
+ZH_KEYWORD(friend,            友元,         KEYCXX)           // friend
+ZH_KEYWORD(mutable,           可变,         KEYCXX)           // mutable
+ZH_KEYWORD(namespace,         名域,         KEYCXX)           // namespace
+ZH_KEYWORD(new,               新建,         KEYCXX)           // new
+ZH_KEYWORD(operator,          运算符,       KEYCXX)           // operator
+ZH_KEYWORD(private,           私有,         KEYCXX)           // private
+ZH_KEYWORD(protected,         受保护,       KEYCXX)           // protected
+ZH_KEYWORD(public,            公开,         KEYCXX)           // public
+ZH_KEYWORD(reinterpret_cast,  重释转换,     KEYCXX)           // reinterpret_cast
+ZH_KEYWORD(static_cast,       静态转换,     KEYCXX)           // static_cast
+ZH_KEYWORD(template,          模板,         KEYCXX)           // template
+ZH_KEYWORD(this,              自身,         KEYCXX)           // this
+ZH_KEYWORD(throw,             抛出,         KEYCXX)           // throw
+ZH_KEYWORD(try,               尝试,         KEYCXX)           // try
+ZH_KEYWORD(typename,          类型名,       KEYCXX)           // typename
+ZH_KEYWORD(typeid,            类型标识,     KEYCXX)           // typeid
+ZH_KEYWORD(using,             使用,         KEYCXX)           // using
+ZH_KEYWORD(virtual,           虚拟,         KEYCXX)           // virtual：运行时决定调用哪个实现
+
+// 宽字符 / 定宽字符类型
+ZH_KEYWORD(wchar_t,           宽字符,       WCHARSUPPORT)              // wchar_t
+ZH_KEYWORD(char8_t,           字符8位,      CHAR8SUPPORT)              // char8_t
+ZH_KEYWORD(char16_t,          字符16位,     KEYCXX11 | KEYNOMS18)      // char16_t
+ZH_KEYWORD(char32_t,          字符32位,     KEYCXX11 | KEYNOMS18)      // char32_t
+
+//===----------------------------------------------------------------------===//
+// 三、C++11 关键字
+//===----------------------------------------------------------------------===//
+
+ZH_KEYWORD(alignas,       对齐,       KEYCXX11 | KEYC23)                // alignas
+ZH_KEYWORD(alignof,       对齐值,     KEYCXX11 | KEYC23)                // alignof
+ZH_KEYWORD(constexpr,     常量表达式, KEYCXX11 | KEYC23)                // constexpr
+ZH_KEYWORD(decltype,      声明类型,   KEYCXX11)                         // decltype
+ZH_KEYWORD(noexcept,      不抛出,     KEYCXX11)                         // noexcept
+ZH_KEYWORD(nullptr,       空指针,     KEYCXX11 | KEYC23)                // nullptr
+ZH_KEYWORD(static_assert, 静态断言,   KEYCXX11 | KEYMSCOMPAT | KEYC23)  // static_assert
+ZH_KEYWORD(thread_local,  线程局部,   KEYCXX11 | KEYC23)                // thread_local
+
+//===----------------------------------------------------------------------===//
+// 四、C++20 关键字（含概念、模块与协程）
+//===----------------------------------------------------------------------===//
+
+ZH_KEYWORD(concept,    概念,        KEYCXX20)                  // concept
+ZH_KEYWORD(consteval,  立即求值,    KEYCXX20)                  // consteval
+ZH_KEYWORD(constinit,  常量初始化,  KEYCXX20)                  // constinit
+ZH_KEYWORD(requires,   约束,        KEYCXX20)                  // requires：为模板指定约束
+
+ZH_KEYWORD(module,     模块,        KEYMODULES)                // module
+ZH_KEYWORD(import,     导入,        KEYMODULES)                // import
+
+ZH_KEYWORD(co_await,   协程等待,    KEYCXX20 | KEYCOROUTINES)  // co_await
+ZH_KEYWORD(co_return,  协程返回,    KEYCXX20 | KEYCOROUTINES)  // co_return
+ZH_KEYWORD(co_yield,   协程产出,    KEYCXX20 | KEYCOROUTINES)  // co_yield
+
+//===----------------------------------------------------------------------===//
+// 五、C23 / GNU 扩展关键字
+//===----------------------------------------------------------------------===//
+
+ZH_KEYWORD(typeof,        取类型,        KEYC23 | KEYGNU)  // typeof：运算符，取出表达式类型
+ZH_KEYWORD(typeof_unqual, 取无修饰类型,  KEYC23)           // typeof_unqual
+
+//===----------------------------------------------------------------------===//
+// 六、上下文关键字（不是 tok::kw_*，由语法分析器按【标识符】识别）
+//===----------------------------------------------------------------------===//
+//
+//  这几个词在 C++ 里【不是关键字】，而是「有特殊含义的标识符」：
+//
+//      void f() override;     void f() final;     class X final {};
+//
+//  它们可以合法地当普通标识符使用（`整数 final = 1;` 是合法的），所以本表
+//  对它们【只增不改】：中文拼写与英文拼写并存，英文依旧可用。这与上面那 86 个
+//  保留字不同——那些不可能是标识符，中英才可以完全等价。
+//
+//  用法：clang/lib/Parse/ParseDeclCXX.cpp 的 isCXX11VirtSpecifier() 取这些拼写
+//        对应的 IdentifierInfo，再做指针比较。
+//
+//  译名说明：「重写」指重写基类的虚函数，**不要与「重载 = overload」混淆**——
+//            重载是另一个概念（同名不同参）。
+
+#ifndef ZH_VIRT_SPECIFIER
+#define ZH_VIRT_SPECIFIER(NAME, ZH)
+#endif
+
+ZH_VIRT_SPECIFIER(override, 重写)     // override：重写基类的虚函数（≠ 重载）
+ZH_VIRT_SPECIFIER(final,    最终)     // final：到此为止，不能再被继承／不能被重写
+
+#undef ZH_VIRT_SPECIFIER
+
+//===----------------------------------------------------------------------===//
+// 七、运算符替代拼写（and / or / not 一族）
+//===----------------------------------------------------------------------===//
+//
+//  这 11 个不是普通关键字，而是 && || ! ^ & | ~ &= |= ^= != 的【替代拼写】。
+//  TokenKinds.def 里用 CXX_KEYWORD_OPERATOR(名字, 对应符号) 登记，注册路径是
+//  AddCXXOperatorKeyword() 而不是 AddKeyword()，所以这里用单独的宏。
+//
+//  它们同样可以当普通标识符用，所以中文也是【增加】而非替换。译名一律取两个字
+//  以上，正是为了尽量不与用户标识符冲突（与本表开头的「至少两字」约束一致）。
+//
+//  用法：clang/lib/Basic/IdentifierTable.cpp
+//
+//  这些中文拼写不进入「正式拼写」——getKeywordSpelling() 对它们仍返回空，
+//  所以诊断与 AST 打印照旧显示 && || ! 等符号，不受影响。
+
+#ifndef ZH_OPERATOR_KEYWORD
+#define ZH_OPERATOR_KEYWORD(ZH, ALIAS)
+#endif
+
+ZH_OPERATOR_KEYWORD(并且,     ampamp)        // 并且     = and     = &&
+ZH_OPERATOR_KEYWORD(或者,     pipepipe)      // 或者     = or      = ||
+ZH_OPERATOR_KEYWORD(并非,     exclaim)       // 并非     = not     = !
+ZH_OPERATOR_KEYWORD(异或,     caret)         // 异或     = xor     = ^
+ZH_OPERATOR_KEYWORD(位与,     amp)           // 位与     = bitand  = &
+ZH_OPERATOR_KEYWORD(位或,     pipe)          // 位或     = bitor   = |
+ZH_OPERATOR_KEYWORD(取反,     tilde)         // 取反     = compl   = ~
+ZH_OPERATOR_KEYWORD(与赋值,   ampequal)      // 与赋值   = and_eq  = &=
+ZH_OPERATOR_KEYWORD(或赋值,   pipeequal)     // 或赋值   = or_eq   = |=
+ZH_OPERATOR_KEYWORD(异或赋值, caretequal)    // 异或赋值 = xor_eq  = ^=
+ZH_OPERATOR_KEYWORD(不等于,   exclaimequal)  // 不等于   = not_eq  = !=
+
+#undef ZH_OPERATOR_KEYWORD
+
+//===----------------------------------------------------------------------===//
+// 八、上下文关键字（module / import）
+//===----------------------------------------------------------------------===//
+//
+//  这两个在 clang 里【不是词法关键字】，而是「只在特定位置才有特殊含义的标识符」。
+//  证据：TokenKinds.def 给它们的 KEYWORD 用的是 KEYMODULES 标志，而
+//  IdentifierTable.cpp 的 getKeywordStatusHelper() 对 KEYMODULES 刻意返回
+//  KS_Unknown（于是 getKeywordStatus() 归为 KS_Disabled，AddKeyword() 直接跳过、
+//  且不报错）。这是【故意设计】：为了 `int module = 1;` 这类既有代码继续合法。
+//
+//  英文真正生效靠的是 IdentifierTable.cpp 里硬写死的两行：
+//      get("import").setKeywordImport(true);
+//      get("module").setModuleKeyword(true);
+//
+//  所以中文必须走【同一扇门】。也就是说，本表第一～五节里 module / import 那两行
+//  ZH_KEYWORD 在这种情形下是空操作（忠实地照抄了英文的空操作），真正让中文生效的
+//  是下面这一节。
+//
+//  用法：clang/lib/Basic/IdentifierTable.cpp，紧跟在那两行英文之后。
+//
+//  【为什么中文必须写在本文件，而不能直接写死在 .cpp 里】
+//  tools/zh_to_en.py（「无锁定」证明工具）只解析本文件。中文若硬写进 .cpp，
+//  转换器就翻不出来，转换后的源码仍含汉字、stock clang 编不过，证明链断掉。
+//
+//  【不要试图把它们改成真关键字】给 module / import 换成 KEYCXX 之类确实能让
+//  AddKeyword() 生效，但那会让 `int module = 1;` 全部失效——那不是「多一种写法」，
+//  而是砸掉生态。上下文关键字这条路是唯一不破坏既有代码的选择。
+
+#ifndef ZH_CONTEXTUAL_KEYWORD
+#define ZH_CONTEXTUAL_KEYWORD(NAME, ZH, SETTER)
+#endif
+
+ZH_CONTEXTUAL_KEYWORD(import, 导入, setKeywordImport)   // 导入 = import
+ZH_CONTEXTUAL_KEYWORD(module, 模块, setModuleKeyword)   // 模块 = module
+
+#undef ZH_CONTEXTUAL_KEYWORD
+
+//===----------------------------------------------------------------------===//
+//
+//  未纳入本表的关键字，及其原因：
+//
+//   * 以下划线开头者（_Bool、_Atomic、_Alignas、_Thread_local、
+//     _Static_assert、_Generic、_Complex、_Decimal32 等）：这些是标准中
+//     为实现保留的拼写，用户代码不应直接书写。它们的中文别名若加入，
+//     还会与既有译名冲突（例如 _Bool 与 bool 都应译作「布尔」）。
+//
+//   * 双下划线开头者（__attribute__、__int128、__builtin_*、
+//     __is_abstract 等全部类型萃取）：属实现内建扩展，保持英文原文，
+//     中文化只会干扰内建机制与诊断。
+//
+//   * HLSL / OpenCL / CUDA / Altivec / ObjC / MS 扩展关键字（cbuffer、tbuffer、
+//     groupshared、__global、__kernel、__declspec 等）：面向特定后端，
+//     非通用 C++ 写作场景。
+//
+//  以上三类合计约 124 个（其中下划线/双下划线开头 111 个），有意保持英文。
+//
+//  上下文关键字（override、final）见【第六节】；
+//  运算符替代拼写（and、or、not 等 11 个）见【第七节】；
+//  上下文关键字（module、import）见【第八节】。
+//
+//  如需为上述任一类别增加中文支持，请另行设计对应的宏与注册点，
+//  不要在下方表中直接添加，以免破坏上述设计约束。
+//
+//===----------------------------------------------------------------------===//
+
+#undef ZH_KEYWORD
