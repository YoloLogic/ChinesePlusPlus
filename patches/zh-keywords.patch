diff --git a/clang/include/clang/Basic/IdentifierTable.h b/clang/include/clang/Basic/IdentifierTable.h
index 79a2aec..30f3024 100644
--- a/clang/include/clang/Basic/IdentifierTable.h
+++ b/clang/include/clang/Basic/IdentifierTable.h
@@ -695,6 +695,24 @@ class IdentifierTable {
   // Shark shows that using MallocAllocator is *much* slower than using this
   // BumpPtrAllocator!
   using HashTableTy = llvm::StringMap<IdentifierInfo *, llvm::BumpPtrAllocator>;
+  /// Chinese identifier alias: resolve a Chinese spelling to the English
+  /// identifier it denotes.
+  ///
+  /// Currently exactly one entry: the Chinese spelling of the program entry
+  /// point resolves to `main` (user decision, 2026-09-24).
+  ///
+  /// WHY THE BODY IS NOT IN THIS HEADER
+  /// This is a PUBLIC header, included by external projects that do not
+  /// necessarily compile with /utf-8. Non-ASCII bytes read under the wrong
+  /// source charset can be mis-decoded and even swallow a line ending, folding
+  /// following code into a comment -- this project has actually been bitten by
+  /// that. So the Chinese literal lives in IdentifierTable.cpp and this header
+  /// stays pure ASCII. See tests\checks\verify_chinese_keywords.py section 9.
+  ///
+  /// Only called when the name has a non-ASCII first byte, so the English path
+  /// costs nothing.
+  static StringRef aliasChineseIdentifier(StringRef Name);
+
   HashTableTy HashTable;
 
   IdentifierInfoLookup* ExternalLookup;
@@ -725,6 +743,12 @@ public:
   /// Return the identifier token info for the specified named
   /// identifier.
   IdentifierInfo &get(StringRef Name) {
+    // Resolve a Chinese spelling to its English identifier first, so the two
+    // are ONE IdentifierInfo rather than two names denoting one symbol.
+    // Rationale lives in aliasChineseIdentifier().
+    if (!Name.empty() && static_cast<unsigned char>(Name[0]) >= 0x80)
+      Name = aliasChineseIdentifier(Name);
+
     auto &Entry = *HashTable.try_emplace(Name, nullptr).first;
 
     IdentifierInfo *&II = Entry.second;
