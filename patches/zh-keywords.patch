+bool Parser::DiagnoseChineseKeywordSpellingAt(SourceLocation Loc) {
+  // 为什么定义在这里而不是 Parser.h 里内联：clang 的诊断 ID 按类别拆开
+  // （DiagnosticParseInterface.inc 通过 clang/Basic/DiagnosticParse.h 引入），
+  // 而 Parser.h **不**包含它 —— 内联会在没包含该头的 TU 里报
+  // "err_chinese_keyword_as_identifier 不是 clang::diag 的成员"（2026-10-03 实测）。
+  // 与 isCXX11VirtSpecifier() 同一个理由、同一个做法。
+  if (!Loc.isValid())
+    return false;
+
+  const SourceManager &SM = PP.getSourceManager();
+  SmallVector<char, 32> Buf;
+  StringRef Name = Lexer::getSpelling(Loc, Buf, SM, getLangOpts());
+  if (Name.empty())
+    return false;
+
+  // 只在【拼写是中文】时才认（含非 ASCII 字节的拼写）。
+  // `int if = 1;` 这类英文写法因此仍然走上游原来的诊断，英文行为一个字节不变。
+  bool 是中文拼写 = false;
+  for (char C : Name)
+    if (static_cast<unsigned char>(C) >= 0x80) {
+      是中文拼写 = true;
+      break;
+    }
+  if (!是中文拼写)
+    return false;
+
+  // 拼写要在本语言模式下【真是关键字】才发（否则用户只是起了个中文名字，与关键字无关）
+  IdentifierInfo &II = PP.getIdentifierTable().get(Name);
+  if (!II.isKeyword(getLangOpts()))
+    return false;
+
+  Diag(Loc, diag::err_chinese_keyword_as_identifier) << Name.str();
+  return true;
+}
