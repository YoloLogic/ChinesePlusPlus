+//===----------------------------------------------------------------------===//
+// 中文诊断正文（Chinese diagnostic messages）
+//===----------------------------------------------------------------------===//
+
+/// 取出某条诊断的中文正文；表里没有这一条时返回空，调用方自动保持英文。
+///
+/// 表在 clang/Basic/ChineseDiagnostics.def。写错的诊断 ID 会让这个 switch
+/// 编译不过（没有这个 case），占位符写错则由
+///     python tools/diag_id_lookup.py --check-table
+/// 逐条机器校核。查不到就回退英文，所以这张表可以分批做、永远不完整。
+static StringRef getChineseDiagnosticText(unsigned DiagID) {
+  switch (DiagID) {
+#define ZH_DIAG(NAME, TEXT)                                                    \
+  case diag::NAME:                                                             \
+    return TEXT;
+#include "clang/Basic/ChineseDiagnostics.def"
+#undef ZH_DIAG
+  default:
+    return StringRef();
+  }
+}
+
 /// FormatDiagnostic - Format this diagnostic into a string, substituting the
 /// formal arguments into the %0 slots.  The result is appended onto the Str
 /// array.
@@ -1036,7 +1059,17 @@ void Diagnostic::FormatDiagnostic(SmallVectorImpl<char> &OutStr) const {
     return;
   }
 
-  StringRef Diag = getDiags()->getDiagnosticIDs()->getDescription(getID());
+  const DiagnosticsEngine *Diags = getDiags();
+  StringRef Diag = Diags->getDiagnosticIDs()->getDescription(getID());
+
+  // 中文诊断：只替换消息正文。error:/warning: 前缀、[-Wxxx] 选项名、行列号、
+  // 源码片段、fix-it 都在别处生成，一律不受影响。默认开启，
+  // -fno-chinese-diagnostics 可关掉（跑上游 clang/test 时需要）。
+  if (Diags->getDiagnosticOptions().ChineseDiagnostics) {
+    StringRef ZH = getChineseDiagnosticText(getID());
+    if (!ZH.empty())
+      Diag = ZH;
+  }
 
   FormatDiagnostic(Diag.begin(), Diag.end(), OutStr);
 }
