// <输入输出状态> —— ios 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   铁律③：ios_base/basic_ios 身份参与语义（流的状态位、locale 绑定都挂在它上面）；操纵器（boolalpha 等）是 CRT 提供的（_MRTIMP2），改名会链不上（§17.19.24 实测）。
//   这类头一旦抄一份，就会和 std 里那份成为两套互不相认的东西。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变体（英文里带 _v 的变量模板形式）暂未提供中文名，属"必须的妥协"，见方案 §六。
#pragma once
#include <ios>

名域 标准 {
    #ifndef _ZH_流类型名
    #define _ZH_流类型名
    模板 <类型名 元素, 类型名 特征 = std::char_traits<元素>> 使用 基础流状态 = std::basic_ios<元素, 特征>;
    使用 输入输出状态 = std::ios;
    使用 输入输出基类 = std::ios_base;
    #endif // _ZH_流类型名
    #ifndef _ZH_流操纵器
    #define _ZH_流操纵器
    模板 <类型名... 参数> 声明类型(自动) 布尔文本(参数&&... 值) { 返回 std::boolalpha(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 非布尔文本(参数&&... 值) { 返回 std::noboolalpha(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 显示基数(参数&&... 值) { 返回 std::showbase(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 不显示基数(参数&&... 值) { 返回 std::noshowbase(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 显示正号(参数&&... 值) { 返回 std::showpos(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 不显示正号(参数&&... 值) { 返回 std::noshowpos(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 跳过空白(参数&&... 值) { 返回 std::skipws(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 不跳过空白(参数&&... 值) { 返回 std::noskipws(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 大写输出(参数&&... 值) { 返回 std::uppercase(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 非大写输出(参数&&... 值) { 返回 std::nouppercase(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 左对齐(参数&&... 值) { 返回 std::left(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 右对齐(参数&&... 值) { 返回 std::right(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 置十进制(参数&&... 值) { 返回 std::dec(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 置十六进制(参数&&... 值) { 返回 std::hex(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 八进制(参数&&... 值) { 返回 std::oct(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 置定点(参数&&... 值) { 返回 std::fixed(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 科学计数(参数&&... 值) { 返回 std::scientific(static_cast<参数&&>(值)...); }
    #endif // _ZH_流操纵器
}