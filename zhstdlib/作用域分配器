//  第二层：在【中文的基础上】派生，把英文原名补回来
//  · 第一层 标准::细节::作用域分配器适配器实现 是抄自微软的中文实现，成员名全中文
//  · 本层加回英文原名，所以两种名字在【同一个对象】上都能用
//  · 与微软的原类型并存：它是【另一个类型】，不碰 std 里的定义
// ============================================================================
名域 标准 {
模板 <类型名 外层, 类型名... 内层>
类型 作用域分配器 : 公开 细节::作用域分配器适配器实现<外层, 内层...> {
公开:
    使用 基类 = 细节::作用域分配器适配器实现<外层, 内层...>;
    使用 基类::基类;

    // 嵌套类型名也要补回英文（数据成员不行 —— 那会改布局）


    // 英文原名，一模板转发回中文名（不需要写签名，重载也自动跟过去）
    模板 <类型名... 参数> 自动 inner_allocator(参数&&... 值) { 返回 基类::内层分配器(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 inner_allocator(参数&&... 值) 常量 { 返回 基类::内层分配器(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 outer_allocator(参数&&... 值) { 返回 基类::外层分配器(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 outer_allocator(参数&&... 值) 常量 { 返回 基类::外层分配器(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 select_on_container_copy_construction(参数&&... 值) { 返回 基类::复制时选择(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 select_on_container_copy_construction(参数&&... 值) 常量 { 返回 基类::复制时选择(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 construct(参数&&... 值) { 返回 基类::构造(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 construct(参数&&... 值) 常量 { 返回 基类::构造(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 destroy(参数&&... 值) { 返回 基类::析构(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 destroy(参数&&... 值) 常量 { 返回 基类::析构(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 max_size(参数&&... 值) { 返回 基类::最大尺寸(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 max_size(参数&&... 值) 常量 { 返回 基类::最大尺寸(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 allocate(参数&&... 值) { 返回 基类::分配(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 allocate(参数&&... 值) 常量 { 返回 基类::分配(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 deallocate(参数&&... 值) { 返回 基类::释放(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 deallocate(参数&&... 值) 常量 { 返回 基类::释放(static_cast<参数&&>(值)...); }
};
