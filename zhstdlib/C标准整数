// <C标准整数> —— cstdint 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   C 包装头自己没有实现，只是把 C 库名字搬进 std；而 std::int8_t 这类
//   **必须与全局那个是同一个类型**（对齐 / ABI）。抄一份就变成"另一种类型"。
//   实测抄 cstddef 直接炸：「using _STD max_align_t;」那条"桥"搬名域后断链。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
#pragma once
#include <cstdint>

名域 标准 {
    使用 整数8位               = std::int8_t;
    使用 整数16位              = std::int16_t;
    使用 整数32位              = std::int32_t;
    使用 整数64位              = std::int64_t;
    使用 无符号整数8位            = std::uint8_t;
    使用 无符号整数16位           = std::uint16_t;
    使用 无符号整数32位           = std::uint32_t;
    使用 无符号整数64位           = std::uint64_t;
    使用 指针整数               = std::intptr_t;
    使用 无符号指针整数            = std::uintptr_t;
    使用 最大整数               = std::intmax_t;
    使用 最大无符号整数            = std::uintmax_t;

}