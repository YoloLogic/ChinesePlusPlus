_EXPORT_STD template <class _元素, class _特征, class _分配器>
basic_istream<_元素, _特征>& operator>>(
    basic_istream<_元素, _特征>& _Istr, 基础字符串实现<_元素, _特征, _分配器>& _Str) {
    using _我的输入流   = basic_istream<_元素, _特征>;
    using _字符类型  = typename _我的输入流::_字符类型;
    using _我的字符串  = 基础字符串实现<_元素, _特征, _分配器>;
    using _我的尺寸类型 = typename _我的字符串::size_type;

    typename _我的输入流::iostate _State = _我的输入流::goodbit;
    bool _Changed                  = false;
    const typename _我的输入流::sentry _成功(_Istr);

    if (_成功) { // state okay, extract characters
        const _字符类型& _Ctype_fac = _STD use_facet<_字符类型>(_Istr.getloc());
        _Str.擦除();

        _TRY_IO_BEGIN
        _我的尺寸类型 _Size;
        if (0 < _Istr.width() && static_cast<_我的尺寸类型>(_Istr.width()) < _Str.max_size()) {
            _Size = static_cast<_我的尺寸类型>(_Istr.width());
        } else {
            _Size = _Str.max_size();
        }

        typename _特征::int_type _Meta = _Istr.rdbuf()->sgetc();

        for (; 0 < _Size; --_Size, _Meta = _Istr.rdbuf()->snextc()) {
            if (_特征::eq_int_type(_特征::eof(), _Meta)) { // 结束 of file, quit
                _State |= _我的输入流::eofbit;
                break;
            } else if (_Ctype_fac.is(_字符类型::space, _特征::to_char_type(_Meta))) {
                break; // whitespace, quit
            } else { // add character to string
                _Str.尾插(_特征::to_char_type(_Meta));
                _Changed = true;
            }
        }
        _CATCH_IO_(_我的输入流, _Istr)
    }

    _Istr.width(0);
    if (!_Changed) {
        _State |= _我的输入流::failbit;
    }

    _Istr.setstate(_State);
    return _Istr;
}

