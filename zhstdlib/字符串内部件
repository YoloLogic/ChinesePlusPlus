    template <_分配策略 _Policy = _分配策略::_At_least>
    _NODISCARD static _CONSTEXPR20 pointer _按容量分配(_分配器类型& _Al, size_type& _Capacity) {
        _STL_INTERNAL_CHECK(_Capacity > _Small_string_capacity);
        ++_Capacity; // Take null terminator into consideration

        pointer _Fancy_ptr = nullptr;
        if constexpr (_Policy == _分配策略::_At_least) {
