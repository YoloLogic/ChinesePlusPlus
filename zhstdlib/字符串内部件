    friend 基础字符串缓冲<_元素, _特征, _分配器>;

    using _分配器类型        = _重绑定分配器类型<_分配器, _元素>;
    using _分配器特征 = allocator_traits<_分配器类型>;

    using _迭代器检查值 = _字符串值<conditional_t<_Is_simple_alloc_v<_分配器类型>, _简单类型集<_元素>,
        _字符串迭代类型集<_元素, typename _分配器特征::size_type, typename _分配器特征::difference_type,
            typename _分配器特征::pointer, typename _分配器特征::const_pointer>>>;

    static_assert(!_ENFORCE_MATCHING_ALLOCATORS || is_same_v<_元素, typename _分配器::value_type>,
        _MISMATCHED_ALLOCATOR_MESSAGE("基础字符串实现<T, Traits, Allocator>", "T"));

    static_assert(is_same_v<_元素, typename _特征::char_type>,
        "N4950 [string.require]/3 requires that the supplied "
        "char_traits character type match the string's character type.");

    static_assert(!is_array_v<_元素> && is_trivially_copyable_v<_元素> && is_trivially_default_constructible_v<_元素>
                      && is_standard_layout_v<_元素>,
        "The character type of 基础字符串实现 must be a non-array trivially copyable standard-layout type T where "
        "is_trivially_default_constructible_v<T> is true. See N5001 [strings.general]/1.");

public:
    using traits_type    = _特征;
    using 分配器类型 = _分配器;

    using value_type      = _元素;
    using size_type       = typename _分配器特征::size_type;
    using difference_type = typename _分配器特征::difference_type;
    using pointer         = typename _分配器特征::pointer;
    using const_pointer   = typename _分配器特征::const_pointer;
