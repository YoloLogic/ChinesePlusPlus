    template <_构造策略 _Strat, class _Char_or_ptr>
    _CONSTEXPR20 void _构造(const _Char_or_ptr _Arg, _CRT_GUARDOVERFLOW const size_type _Count) {
        auto& _My_data = _Mypair._Myval2;
        _STL_INTERNAL_CHECK(!_My_data._已启用大串模式());

        if constexpr (_Strat == _构造策略::_From_char) {
            _STL_INTERNAL_STATIC_ASSERT(is_same_v<_Char_or_ptr, _元素>);
        } else {
            _STL_INTERNAL_STATIC_ASSERT(_是元素字符指针<_Char_or_ptr>::value);
        }

        if (_Count > max_size()) {
            _Xlen_string(); // result too long
        }

        auto& _Al       = _取分配器();
        auto&& _Alproxy = _取代理分配器(_分配器类型, _Al);
        _容器代理指针<_分配器类型> _代理(_Alproxy, _My_data);

        if (_Count <= _Small_string_capacity) {
            _My_data._我的尺寸 = _Count;
            _My_data._Myres  = _Small_string_capacity;

            if constexpr (_Strat == _构造策略::_From_char) {
                _特征::assign(_My_data._Bx._Buf, _Count, _Arg);
