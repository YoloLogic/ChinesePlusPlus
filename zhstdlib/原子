_NODISCARD inline 内存序 _合并CAS内存序(
    const 内存序 _Success, const 内存序 _Failure) noexcept {
    // Finds upper bound of a compare/置换 memory order
    // pair, according to the following partial order:
    //     seq_cst
    //        |
    //     acq_rel
    //     /     \
    // acquire  release
    //    |       |
    // consume    |
    //     \     /
    //     relaxed
    static constexpr 内存序 _Combined_memory_orders[6][6] = {// combined upper bounds
        {内存序松弛, 内存序消费, 内存序获取, 内存序释放, 内存序获取释放,
            内存序顺序一致},
        {内存序消费, 内存序消费, 内存序获取, 内存序获取释放, 内存序获取释放,
            内存序顺序一致},
        {内存序获取, 内存序获取, 内存序获取, 内存序获取释放, 内存序获取释放,
            内存序顺序一致},
        {内存序释放, 内存序获取释放, 内存序获取释放, 内存序释放, 内存序获取释放,
            内存序顺序一致},
        {内存序获取释放, 内存序获取释放, 内存序获取释放, 内存序获取释放, 内存序获取释放,
            内存序顺序一致},
        {内存序顺序一致, 内存序顺序一致, 内存序顺序一致, 内存序顺序一致, 内存序顺序一致,
            内存序顺序一致}};

    _检查内存序(static_cast<unsigned int>(_Success));
    _检查载入内存序(_Failure);
    return _Combined_memory_orders[static_cast<int>(_Success)][static_cast<int>(_Failure)];
}

template <class _Integral, class _类型>
_NODISCARD _Integral _原子重解释为(const _类型& _Source) noexcept {
    // interprets _Source as the supplied integral type
    static_assert(is_integral_v<_Integral>, "Tried to reinterpret memory as non-integral");
    if constexpr (is_integral_v<_类型> && sizeof(_Integral) == sizeof(_类型)) {
        return static_cast<_Integral>(_Source);
    } else if constexpr (is_pointer_v<_类型> && sizeof(_Integral) == sizeof(_类型)) {
        return reinterpret_cast<_Integral>(_Source);
    } else {
        _Integral _结果{}; // zero padding bits
        _CSTD memcpy(&_结果, _STD addressof(_Source), sizeof(_Source));
        return _结果;
    }
}

