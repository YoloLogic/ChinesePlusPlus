template <class _类型>
class _Locked_pointer {
public:
    static_assert(alignof(_类型) >= (1 << 2), "2 low order bits are needed by _Locked_pointer");
    static constexpr uintptr_t _Lock_mask                = 3;
    static constexpr uintptr_t _Not_locked               = 0;
    static constexpr uintptr_t _Locked_notify_not_needed = 1;
    static constexpr uintptr_t _Locked_notify_needed     = 2;
    static constexpr uintptr_t _Ptr_value_mask           = ~_Lock_mask;

    constexpr _Locked_pointer() noexcept : _Storage{} {}
    explicit _Locked_pointer(_类型* const _Ptr) noexcept : _Storage{reinterpret_cast<uintptr_t>(_Ptr)} {}

    _Locked_pointer(const _Locked_pointer&)            = delete;
    _Locked_pointer& operator=(const _Locked_pointer&) = delete;

    _NODISCARD _类型* _Lock_and_load() noexcept {
        uintptr_t _表示 = _Storage.载入(内存序松弛);
        for (;;) {
            switch (_表示 & _Lock_mask) {
            case _Not_locked: // Can try to lock now
                if (_Storage.比较交换弱(_表示, _表示 | _Locked_notify_not_needed)) {
                    return reinterpret_cast<_类型*>(_表示);
                }
                _YIELD_PROCESSOR();
                break;

            case _Locked_notify_not_needed: // Try to set "notify needed" and 等待
                if (!_Storage.比较交换弱(_表示, (_表示 & _Ptr_value_mask) | _Locked_notify_needed)) {
                    // Failed to set notify needed flag, try again
                    _YIELD_PROCESSOR();
                    break;
                }
                _表示 = (_表示 & _Ptr_value_mask) | _Locked_notify_needed;
                [[fallthrough]];

            case _Locked_notify_needed: // "Notify needed" is already set, just 等待
                _Storage.等待(_表示, 内存序松弛);
                _表示 = _Storage.载入(内存序松弛);
                break;

            default: // Unrecognized bit pattern
                _CSTD abort();
            }
        }
    }

    void _存储并解锁(_类型* const _Value) noexcept {
        const auto _表示 = _Storage.置换(reinterpret_cast<uintptr_t>(_Value));
        if ((_表示 & _Lock_mask) == _Locked_notify_needed) {
            // As we don't count waiters, every waiter is notified, and then some may re-request notification
            _Storage.通知全部();
        }
    }

    _NODISCARD _类型* _Unsafe_load_relaxed() const noexcept {
        return reinterpret_cast<_类型*>(_Storage.载入(内存序松弛));
    }

private:
    原子实现<uintptr_t> _Storage;
};
