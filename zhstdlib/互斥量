_EXPORT_STD class 条件变量实现 { // class for waiting for conditions
public:
#ifdef _DISABLE_CONSTEXPR_MUTEX_CONSTRUCTOR
    条件变量实现() noexcept /* strengthened */ {
        _Cnd_init_in_situ(_Mycnd());
    }
#else // ^^^ defined(_DISABLE_CONSTEXPR_MUTEX_CONSTRUCTOR) / !defined(_DISABLE_CONSTEXPR_MUTEX_CONSTRUCTOR) vvv
    条件变量实现() noexcept /* strengthened */ = default;
#endif // ^^^ !defined(_DISABLE_CONSTEXPR_MUTEX_CONSTRUCTOR) ^^^

    ~条件变量实现() noexcept = default;

    条件变量实现(const 条件变量实现&)            = delete;
    条件变量实现& operator=(const 条件变量实现&) = delete;

    void notify_one() noexcept { // wake up one waiter
        _Cnd_signal(_Mycnd());
    }

    void notify_all() noexcept { // wake up all waiters
        _Cnd_broadcast(_Mycnd());
    }

    void wait(独占锁实现<互斥量实现>& _Lck) noexcept /* strengthened */ { // wait for signal
        // Nothing to do to comply with LWG-2135 because std::互斥量实现 加锁/解锁 are nothrow
        _Cnd_wait(_Mycnd(), _Lck.互斥量实现()->_Mymtx());
    }

    template <class _Predicate>
    void wait(独占锁实现<互斥量实现>& _Lck, _Predicate _Pred) { // wait for signal and test predicate
        while (!_Pred()) {
            wait(_Lck);
        }
    }

    template <class _Rep, class _Period>
    cv_status wait_for(独占锁实现<互斥量实现>& _Lck, const chrono::duration<_Rep, _Period>& _Rel_time) {
        // wait for duration
        if (_Rel_time <= chrono::duration<_Rep, _Period>::zero()) {
            // we don't 解锁-and-relock _Lck for this case because it's not observable
            return cv_status::timeout;
        }
        return wait_until(_Lck, _To_absolute_time(_Rel_time));
    }

    template <class _Rep, class _Period, class _Predicate>
    bool wait_for(独占锁实现<互斥量实现>& _Lck, const chrono::duration<_Rep, _Period>& _Rel_time, _Predicate _Pred) {
        // wait for signal with timeout and check predicate
        return wait_until(_Lck, _To_absolute_time(_Rel_time), _STD _Pass_fn(_Pred));
    }

    template <class _Clock, class _Duration>
    cv_status wait_until(独占锁实现<互斥量实现>& _Lck, const chrono::time_point<_Clock, _Duration>& _Abs_time) {
        // wait until time point
        static_assert(chrono::_Is_clock_v<_Clock>, "Clock type required");
#if _ITERATOR_DEBUG_LEVEL != 0
        _STL_VERIFY(
            _Lck.持有锁(), "wait_until's caller must own the 加锁 argument (N4958 [thread.condition.condvar]/17)");
        _STL_VERIFY(_Mtx_current_owns(_Lck.互斥量实现()->_Mymtx()),
            "wait_until's calling thread must hold the 加锁 argument's 互斥量实现 (N4958 [thread.condition.condvar]/17)");
#endif // _ITERATOR_DEBUG_LEVEL != 0
        for (;;) {
            const auto _Now = _Clock::now();
            if (_Abs_time <= _Now) {
                // we don't 解锁-and-relock _Lck for this case because it's not observable
                return cv_status::timeout;
            }

            const unsigned long _Rel_ms_count = _Clamped_rel_time_ms_count(_Abs_time - _Now)._Count;

            const _Thrd_result _Res = _Cnd_timedwait_for_unchecked(_Mycnd(), _Lck.互斥量实现()->_Mymtx(), _Rel_ms_count);
            if (_Res == _Thrd_result::_Success) {
                return cv_status::no_timeout;
            }
        }
    }

    template <class _Clock, class _Duration, class _Predicate>
    bool wait_until(
        独占锁实现<互斥量实现>& _Lck, const chrono::time_point<_Clock, _Duration>& _Abs_time, _Predicate _Pred) {
        // wait for signal with timeout and check predicate
        static_assert(chrono::_Is_clock_v<_Clock>, "Clock type required");
        while (!_Pred()) {
            if (wait_until(_Lck, _Abs_time) == cv_status::timeout) {
                return _Pred();
            }
        }

        return true;
    }

