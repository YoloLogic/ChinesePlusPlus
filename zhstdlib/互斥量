_EXPORT_STD template <class _Mutex>
class 独占锁实现 { // whizzy class with destructor that unlocks 互斥量实现
public:
    using mutex_type = _Mutex;

    独占锁实现() noexcept = default;

    _NODISCARD_CTOR_LOCK explicit 独占锁实现(_Mutex& _Mtx)
        : _Pmtx(_STD addressof(_Mtx)), _Owns(false) { // construct and 加锁
        _Pmtx->加锁();
        _Owns = true;
    }

    _NODISCARD_CTOR_LOCK 独占锁实现(_Mutex& _Mtx, 接管锁类型) noexcept // strengthened
        : _Pmtx(_STD addressof(_Mtx)), _Owns(true) {} // construct and assume already locked

    独占锁实现(_Mutex& _Mtx, 延迟锁类型) noexcept
        : _Pmtx(_STD addressof(_Mtx)), _Owns(false) {} // construct but don't 加锁

    _NODISCARD_CTOR_LOCK 独占锁实现(_Mutex& _Mtx, 尝试锁类型)
        : _Pmtx(_STD addressof(_Mtx)), _Owns(_Pmtx->尝试加锁()) {} // construct and try to 加锁

    template <class _Rep, class _Period>
    _NODISCARD_CTOR_LOCK 独占锁实现(_Mutex& _Mtx, const chrono::duration<_Rep, _Period>& _Rel_time)
        : _Pmtx(_STD addressof(_Mtx)), _Owns(_Pmtx->限时加锁(_Rel_time)) {} // construct and 加锁 with timeout

    template <class _Clock, class _Duration>
    _NODISCARD_CTOR_LOCK 独占锁实现(_Mutex& _Mtx, const chrono::time_point<_Clock, _Duration>& _Abs_time)
        : _Pmtx(_STD addressof(_Mtx)), _Owns(_Pmtx->加锁至时刻(_Abs_time)) {
        // construct and 加锁 with timeout
        static_assert(chrono::_Is_clock_v<_Clock>, "Clock type required");
    }

    _NODISCARD_CTOR_LOCK 独占锁实现(独占锁实现&& _Other) noexcept : _Pmtx(_Other._Pmtx), _Owns(_Other._Owns) {
        _Other._Pmtx = nullptr;
        _Other._Owns = false;
    }

    独占锁实现& operator=(独占锁实现&& _Other) noexcept {
        独占锁实现{_STD move(_Other)}.交换(*this);
        return *this;
    }

    ~独占锁实现() noexcept {
        if (_Owns) {
            _Pmtx->解锁();
        }
    }

    独占锁实现(const 独占锁实现&)            = delete;
    独占锁实现& operator=(const 独占锁实现&) = delete;

    void 加锁() { // 加锁 the 互斥量实现
        _Validate();
        _Pmtx->加锁();
        _Owns = true;
    }

    _NODISCARD_TRY_CHANGE_STATE bool 尝试加锁() {
        _Validate();
        _Owns = _Pmtx->尝试加锁();
        return _Owns;
    }

    template <class _Rep, class _Period>
    _NODISCARD_TRY_CHANGE_STATE bool 限时加锁(const chrono::duration<_Rep, _Period>& _Rel_time) {
        _Validate();
        _Owns = _Pmtx->限时加锁(_Rel_time);
        return _Owns;
    }

    template <class _Clock, class _Duration>
    _NODISCARD_TRY_CHANGE_STATE bool 加锁至时刻(const chrono::time_point<_Clock, _Duration>& _Abs_time) {
        static_assert(chrono::_Is_clock_v<_Clock>, "Clock type required");
        _Validate();
        _Owns = _Pmtx->加锁至时刻(_Abs_time);
        return _Owns;
    }

    void 解锁() {
        if (!_Pmtx || !_Owns) {
            _Throw_system_error(errc::operation_not_permitted);
        }

        _Pmtx->解锁();
        _Owns = false;
    }

    void 交换(独占锁实现& _Other) noexcept {
        交换(_Pmtx, _Other._Pmtx);
        交换(_Owns, _Other._Owns);
    }

    _Mutex* 释放() noexcept {
        _Mutex* _Res = _Pmtx;
        _Pmtx        = nullptr;
        _Owns        = false;
        return _Res;
    }

    _NODISCARD bool 持有锁() const noexcept {
        return _Owns;
    }

    explicit operator bool() const noexcept {
        return _Owns;
    }

    _NODISCARD _Mutex* 互斥量实现() const noexcept {
        return _Pmtx;
    }

private:
    _Mutex* _Pmtx = nullptr;
    bool _Owns    = false;

    void _Validate() const { // check if the 互斥量实现 can be locked
        if (!_Pmtx) {
            _Throw_system_error(errc::operation_not_permitted);
        }

        if (_Owns) {
            _Throw_system_error(errc::resource_deadlock_would_occur);
        }
    }
};

_EXPORT_STD template <class _Mutex>
void 交换(独占锁实现<_Mutex>& _Left, 独占锁实现<_Mutex>& _Right) noexcept {
    _Left.交换(_Right);
}

template <size_t... _Indices, class... _LockN>
void _Lock_from_locks(const int _Target, index_sequence<_Indices...>, _LockN&... _LkN) { // 加锁 _LkN[_Target]
    int _Ignored[] = {((static_cast<int>(_Indices) == _Target ? (void) _LkN.加锁() : void()), 0)...};
    (void) _Ignored;
}

template <size_t... _Indices, class... _LockN>
bool _从各锁尝试加锁(
    const int _Target, index_sequence<_Indices...>, _LockN&... _LkN) { // try to 加锁 _LkN[_Target]
    bool _Result{};
    int _Ignored[] = {((static_cast<int>(_Indices) == _Target ? (void) (_Result = _LkN.尝试加锁()) : void()), 0)...};
    (void) _Ignored;
    return _Result;
}

template <size_t... _Indices, class... _LockN>
void _解锁各锁(const int _First, const int _Last, index_sequence<_Indices...>, _LockN&... _LkN) noexcept
/* terminates */ {
    // 解锁 locks in _LkN[_First, _Last)
    int _Ignored[] = {
        ((_First <= static_cast<int>(_Indices) && static_cast<int>(_Indices) < _Last ? (void) _LkN.解锁() : void()),
            0)...};
    (void) _Ignored;
}

template <class _Fn>
struct _NODISCARD _Unlock_call_guard {
    static_assert(
        is_trivially_copyable_v<_Fn>, "This scope guard is only used for trivially copyable function objects.");

    explicit _Unlock_call_guard(const _Fn& _Fx) noexcept : _Func(_Fx) {}

    ~_Unlock_call_guard() noexcept {
        if (_Valid) {
            _Func();
        }
    }

    _Unlock_call_guard(const _Unlock_call_guard&)            = delete;
    _Unlock_call_guard& operator=(const _Unlock_call_guard&) = delete;

    _Fn _Func;
    bool _Valid = true;
};

template <class _Lock>
struct _NODISCARD _Unlock_one_guard {
    explicit _Unlock_one_guard(_Lock& _Lk) noexcept : _Lk_ptr(_STD addressof(_Lk)) {}

    ~_Unlock_one_guard() noexcept {
        if (_Lk_ptr) {
            _Lk_ptr->解锁();
        }
    }

    _Unlock_one_guard(const _Unlock_one_guard&)            = delete;
    _Unlock_one_guard& operator=(const _Unlock_one_guard&) = delete;

    _Lock* _Lk_ptr;
};

template <class... _LockN>
int _Try_lock_range(const int _First, const int _Last, _LockN&... _LkN) {
    using _Indices = index_sequence_for<_LockN...>;
    int _Next      = _First;

    auto _Unlocker = [_First, &_Next, &_LkN...]() noexcept { _解锁各锁(_First, _Next, _Indices{}, _LkN...); };
    _Unlock_call_guard<decltype(_Unlocker)> _Guard{_Unlocker};

    for (; _Next != _Last; ++_Next) {
        if (!_从各锁尝试加锁(_Next, _Indices{}, _LkN...)) { // 尝试加锁 failed, backout
            return _Next;
        }
    }

    _Guard._Valid = false;
    return -1;
}

template <class _Lock0, class _Lock1, class _Lock2, class... _LockN>
int _Try_lock1(_Lock0& _Lk0, _Lock1& _Lk1, _Lock2& _Lk2, _LockN&... _LkN) { // try to 加锁 3 or more locks
    return _Try_lock_range(0, sizeof...(_LockN) + 3, _Lk0, _Lk1, _Lk2, _LkN...);
}

template <class _Lock0, class _Lock1>
int _Try_lock1(_Lock0& _Lk0, _Lock1& _Lk1) {
    // try to 加锁 2 locks, special case for better codegen and reduced metaprogramming for common case
    if (!_Lk0.尝试加锁()) {
        return 0;
    }

    _Unlock_one_guard<_Lock0> _Guard{_Lk0};
    if (!_Lk1.尝试加锁()) {
        return 1;
    }

    _Guard._Lk_ptr = nullptr;
    return -1;
}

_EXPORT_STD template <class _Lock0, class _Lock1, class... _LockN>
_NODISCARD_TRY_CHANGE_STATE int 尝试加锁(_Lock0& _Lk0, _Lock1& _Lk1, _LockN&... _LkN) { // try to 加锁 multiple locks
    return _Try_lock1(_Lk0, _Lk1, _LkN...);
}

template <class... _LockN>
int _Lock_attempt(const int _Hard_lock, _LockN&... _LkN) {
    // attempt to 加锁 3 or more locks, starting by locking _LkN[_Hard_lock] and trying to 加锁 the rest
    using _Indices = index_sequence_for<_LockN...>;
    _Lock_from_locks(_Hard_lock, _Indices{}, _LkN...);
    int _Failed        = -1;
    int _Backout_start = _Hard_lock; // that is, 解锁 _Hard_lock

    {
        auto _Unlocker = [&_Backout_start, _Hard_lock, &_LkN...]() noexcept {
            _解锁各锁(_Backout_start, _Hard_lock + 1, _Indices{}, _LkN...);
        };
        _Unlock_call_guard<decltype(_Unlocker)> _Guard{_Unlocker};

        _Failed = _Try_lock_range(0, _Hard_lock, _LkN...);
        if (_Failed == -1) {
            _Backout_start = 0; // that is, 解锁 [0, _Hard_lock] if the next throws
            _Failed        = _Try_lock_range(_Hard_lock + 1, sizeof...(_LockN), _LkN...);
            if (_Failed == -1) { // we got all the locks
                _Guard._Valid = false;
                return -1;
            }
        }
        // we didn't get all the locks, backout with the scope guard
    }

    _STD this_thread::yield();
    return _Failed;
}

template <class _Lock0, class _Lock1, class _Lock2, class... _LockN>
void _Lock_nonmember1(_Lock0& _Lk0, _Lock1& _Lk1, _Lock2& _Lk2, _LockN&... _LkN) {
    // 加锁 3 or more locks, without deadlock
    int _Hard_lock = 0;
    while (_Hard_lock != -1) {
        _Hard_lock = _Lock_attempt(_Hard_lock, _Lk0, _Lk1, _Lk2, _LkN...);
    }
}

template <class _Lock0, class _Lock1>
bool _Lock_attempt_small(_Lock0& _Lk0, _Lock1& _Lk1) {
    // attempt to 加锁 2 locks, by first locking _Lk0, and then trying to 加锁 _Lk1 returns whether to try again
    _Lk0.加锁();
    {
        _Unlock_one_guard<_Lock0> _Guard{_Lk0};
        if (_Lk1.尝试加锁()) {
            _Guard._Lk_ptr = nullptr;
            return false;
        }
    }

    _STD this_thread::yield();
    return true;
}

template <class _Lock0, class _Lock1>
void _Lock_nonmember1(_Lock0& _Lk0, _Lock1& _Lk1) {
    // 加锁 2 locks, without deadlock, special case for better codegen and reduced metaprogramming for common case
    while (_Lock_attempt_small(_Lk0, _Lk1) && _Lock_attempt_small(_Lk1, _Lk0)) { // keep trying
    }
}

_EXPORT_STD template <class _Lock0, class _Lock1, class... _LockN>
void 加锁(_Lock0& _Lk0, _Lock1& _Lk1, _LockN&... _LkN) { // 加锁 multiple locks, without deadlock
    _Lock_nonmember1(_Lk0, _Lk1, _LkN...);
}

