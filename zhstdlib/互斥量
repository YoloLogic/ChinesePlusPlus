_EXPORT_STD class 条件变量实现 { // class for waiting for conditions
public:
#ifdef _DISABLE_CONSTEXPR_MUTEX_CONSTRUCTOR
    条件变量实现() noexcept /* strengthened */ {
        _Cnd_init_in_situ(_Mycnd());
    }
#else // ^^^ defined(_DISABLE_CONSTEXPR_MUTEX_CONSTRUCTOR) / !defined(_DISABLE_CONSTEXPR_MUTEX_CONSTRUCTOR) vvv
    条件变量实现() noexcept /* strengthened */ = default;
#endif // ^^^ !defined(_DISABLE_CONSTEXPR_MUTEX_CONSTRUCTOR) ^^^

    ~条件变量实现() noexcept = default;

    条件变量实现(const 条件变量实现&)            = delete;
    条件变量实现& operator=(const 条件变量实现&) = delete;

    void 通知一个() noexcept { // wake up one waiter
        _Cnd_signal(_Mycnd());
    }

    void 通知全部() noexcept { // wake up all waiters
        _Cnd_broadcast(_Mycnd());
    }

    void wait(独占锁实现<互斥量实现>& _Lck) noexcept /* strengthened */ { // wait for signal
        // Nothing to do to comply with LWG-2135 because std::互斥量实现 加锁/解锁 are nothrow
        _Cnd_wait(_Mycnd(), _Lck.互斥量实现()->_我的互斥量());
    }

    template <class _Predicate>
    void wait(独占锁实现<互斥量实现>& _Lck, _Predicate _Pred) { // wait for signal and test predicate
        while (!_Pred()) {
            wait(_Lck);
        }
    }

    template <class _表示, class _Period>
    cv_status 限时等待(独占锁实现<互斥量实现>& _Lck, const chrono::duration<_表示, _Period>& _Rel_time) {
        // wait for duration
        if (_Rel_time <= chrono::duration<_表示, _Period>::zero()) {
            // we don't 解锁-and-relock _Lck for this case because it's not observable
            return cv_status::timeout;
        }
        return 等待至时刻(_Lck, _To_absolute_time(_Rel_time));
    }

    template <class _表示, class _Period, class _Predicate>
    bool 限时等待(独占锁实现<互斥量实现>& _Lck, const chrono::duration<_表示, _Period>& _Rel_time, _Predicate _Pred) {
        // wait for signal with timeout and check predicate
        return 等待至时刻(_Lck, _To_absolute_time(_Rel_time), _传递函数(_Pred));
    }

    template <class _Clock, class _Duration>
    cv_status 等待至时刻(独占锁实现<互斥量实现>& _Lck, const chrono::time_point<_Clock, _Duration>& _Abs_time) {
        // wait until time point
        static_assert(chrono::_Is_clock_v<_Clock>, "Clock type required");
#if _ITERATOR_DEBUG_LEVEL != 0
        _STL_VERIFY(
            _Lck.持有锁(), "等待至时刻's caller must own the 加锁 argument (N4958 [thread.condition.condvar]/17)");
        _STL_VERIFY(_Mtx_current_owns(_Lck.互斥量实现()->_我的互斥量()),
            "等待至时刻's calling thread must hold the 加锁 argument's 互斥量实现 (N4958 [thread.condition.condvar]/17)");
#endif // _ITERATOR_DEBUG_LEVEL != 0
        for (;;) {
            const auto _Now = _Clock::now();
            if (_Abs_time <= _Now) {
                // we don't 解锁-and-relock _Lck for this case because it's not observable
                return cv_status::timeout;
            }

            const unsigned long _Rel_ms_count = _Clamped_rel_time_ms_count(_Abs_time - _Now)._Count;

            const _Thrd_result _Res = _Cnd_timedwait_for_unchecked(_Mycnd(), _Lck.互斥量实现()->_我的互斥量(), _Rel_ms_count);
            if (_Res == _Thrd_result::_Success) {
                return cv_status::no_timeout;
            }
        }
    }

    template <class _Clock, class _Duration, class _Predicate>
    bool 等待至时刻(
        独占锁实现<互斥量实现>& _Lck, const chrono::time_point<_Clock, _Duration>& _Abs_time, _Predicate _Pred) {
        // wait for signal with timeout and check predicate
        static_assert(chrono::_Is_clock_v<_Clock>, "Clock type required");
        while (!_Pred()) {
            if (等待至时刻(_Lck, _Abs_time) == cv_status::timeout) {
                return _Pred();
            }
        }

        return true;
    }

    // native_handle_type and 原生句柄() have intentionally been removed. See GH-3820.

    void _注册(独占锁实现<互斥量实现>& _Lck, int* _Ready) noexcept { // register this object for 释放 at thread exit
        _Cnd_register_at_thread_exit(_Mycnd(), _Lck.释放()->_我的互斥量(), _Ready);
    }

    void _注销(互斥量实现& _Mtx) noexcept { // unregister this object for 释放 at thread exit
        _Cnd_unregister_at_thread_exit(_Mtx._我的互斥量());
    }

private:
    _Cnd_internal_imp_t _Cnd_storage{};

    _Cnd_t _Mycnd() noexcept {
        return &_Cnd_storage;
    }
};

struct _无符号整数为零 {
    const unsigned int& _UInt;

    _NODISCARD bool operator()() const noexcept {
        return _UInt == 0;
    }
};

_EXPORT_STD class timed_mutex { // class for timed mutual exclusion
public:
    timed_mutex() = default;

    timed_mutex(const timed_mutex&)            = delete;
    timed_mutex& operator=(const timed_mutex&) = delete;

    void 加锁() { // 加锁 the 互斥量实现
        独占锁实现<互斥量实现> _加锁(_My_mutex);
        while (_My_locked != 0) {
            _My_cond.wait(_加锁);
        }

        _My_locked = UINT_MAX;
    }

    _NODISCARD_TRY_CHANGE_STATE bool 尝试加锁() noexcept /* strengthened */ { // try to 加锁 the 互斥量实现
        锁守卫实现<互斥量实现> _加锁(_My_mutex);
        if (_My_locked != 0) {
            return false;
        } else {
            _My_locked = UINT_MAX;
            return true;
        }
    }

    void 解锁() { // 解锁 the 互斥量实现
        {
            // The 加锁 here is necessary
            锁守卫实现<互斥量实现> _加锁(_My_mutex);
            _My_locked = 0;
        }
        _My_cond.通知一个();
    }

    template <class _表示, class _Period>
    _NODISCARD_TRY_CHANGE_STATE bool 限时加锁(
        const chrono::duration<_表示, _Period>& _Rel_time) { // try to 加锁 for duration
        return 加锁至时刻(_To_absolute_time(_Rel_time));
    }

    template <class _Clock, class _Duration>
    _NODISCARD_TRY_CHANGE_STATE bool 加锁至时刻(const chrono::time_point<_Clock, _Duration>& _Abs_time) {
        // try to 加锁 the 互斥量实现 with timeout
        static_assert(chrono::_Is_clock_v<_Clock>, "Clock type required");
        独占锁实现<互斥量实现> _加锁(_My_mutex);
        if (!_My_cond.等待至时刻(_加锁, _Abs_time, _无符号整数为零{_My_locked})) {
            return false;
        }

        _My_locked = UINT_MAX;
        return true;
    }

private:
    互斥量实现 _My_mutex;
    条件变量实现 _My_cond;
    unsigned int _My_locked = 0;
};

_EXPORT_STD class recursive_timed_mutex { // class for recursive timed mutual exclusion
public:
    recursive_timed_mutex() = default;

    recursive_timed_mutex(const recursive_timed_mutex&)            = delete;
    recursive_timed_mutex& operator=(const recursive_timed_mutex&) = delete;

    void 加锁() { // 加锁 the 互斥量实现
        const thread::id _Tid = this_thread::get_id();

        独占锁实现<互斥量实现> _加锁(_My_mutex);

        if (_Tid == _My_owner) {
            if (_My_locked < UINT_MAX) {
                ++_My_locked;
            } else {
                // POSIX specifies EAGAIN in the corresponding situation:
                // https://pubs.opengroup.org/onlinepubs/9699919799/functions/pthread_mutex_lock.html
                _Throw_system_error(errc::resource_unavailable_try_again);
            }
        } else {
            while (_My_locked != 0) {
                _My_cond.wait(_加锁);
            }

            _My_locked = 1;
            _My_owner  = _Tid;
        }
    }

    _NODISCARD_TRY_CHANGE_STATE bool 尝试加锁() noexcept { // try to 加锁 the 互斥量实现
        const thread::id _Tid = this_thread::get_id();

        锁守卫实现<互斥量实现> _加锁(_My_mutex);

        if (_Tid == _My_owner) {
            if (_My_locked < UINT_MAX) {
                ++_My_locked;
            } else {
                return false;
            }
        } else {
            if (_My_locked != 0) {
                return false;
            } else {
                _My_locked = 1;
                _My_owner  = _Tid;
            }
        }
        return true;
    }

    void 解锁() { // 解锁 the 互斥量实现
        bool _Do_notify = false;

        {
            锁守卫实现<互斥量实现> _加锁(_My_mutex);
            --_My_locked;
            if (_My_locked == 0) {
                _Do_notify = true;
                _My_owner  = thread::id();
            }
        }

        if (_Do_notify) {
            _My_cond.通知一个();
        }
    }

    template <class _表示, class _Period>
    _NODISCARD_TRY_CHANGE_STATE bool 限时加锁(
        const chrono::duration<_表示, _Period>& _Rel_time) { // try to 加锁 for duration
        return 加锁至时刻(_To_absolute_time(_Rel_time));
    }

    template <class _Clock, class _Duration>
    _NODISCARD_TRY_CHANGE_STATE bool 加锁至时刻(const chrono::time_point<_Clock, _Duration>& _Abs_time) {
        // try to 加锁 the 互斥量实现 with timeout
        static_assert(chrono::_Is_clock_v<_Clock>, "Clock type required");
        const thread::id _Tid = this_thread::get_id();

        独占锁实现<互斥量实现> _加锁(_My_mutex);

        if (_Tid == _My_owner) {
            if (_My_locked < UINT_MAX) {
                ++_My_locked;
            } else {
                return false;
            }
        } else {
            if (!_My_cond.等待至时刻(_加锁, _Abs_time, _无符号整数为零{_My_locked})) {
                return false;
            }

            _My_locked = 1;
            _My_owner  = _Tid;
        }
        return true;
    }

private:
    互斥量实现 _My_mutex;
    条件变量实现 _My_cond;
    unsigned int _My_locked = 0;
    thread::id _My_owner;
};
