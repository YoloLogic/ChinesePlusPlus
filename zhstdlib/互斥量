class _互斥量基类 { // base class for all 互斥量实现 types
public:
#ifdef _DISABLE_CONSTEXPR_MUTEX_CONSTRUCTOR
    _互斥量基类(int _Flags = 0) noexcept {
        _Mtx_init_in_situ(_我的互斥量(), _Flags | _Mtx_try);
    }
#else // ^^^ defined(_DISABLE_CONSTEXPR_MUTEX_CONSTRUCTOR) / !defined(_DISABLE_CONSTEXPR_MUTEX_CONSTRUCTOR) vvv
    constexpr _互斥量基类(int _Flags = 0) noexcept {
        _Mtx_storage._Critical_section = {};
        _Mtx_storage._Thread_id        = -1;
        _Mtx_storage._Type             = _Flags | _Mtx_try;
        _Mtx_storage._Count            = 0;
    }
#endif // ^^^ !defined(_DISABLE_CONSTEXPR_MUTEX_CONSTRUCTOR) ^^^

    _互斥量基类(const _互斥量基类&)            = delete;
    _互斥量基类& operator=(const _互斥量基类&) = delete;

    void 加锁() {
        if (_Mtx_lock(_我的互斥量()) != _Thrd_result::_Success) {
            // undefined behavior, only occurs for plain mutexes (N4950 [thread.互斥量实现.requirements.互斥量实现.general]/6)
            _Throw_Cpp_error(_RESOURCE_DEADLOCK_WOULD_OCCUR);
        }

        if (!_校验所有权层级()) {
            // only occurs for recursive mutexes (N4950 [thread.互斥量实现.recursive]/3)
            // POSIX specifies EAGAIN in the corresponding situation:
            // https://pubs.opengroup.org/onlinepubs/9699919799/functions/pthread_mutex_lock.html
            _Throw_Cpp_error(_RESOURCE_UNAVAILABLE_TRY_AGAIN);
        }
    }

    _NODISCARD_TRY_CHANGE_STATE bool 尝试加锁() noexcept /* strengthened */ {
        // false may be from undefined behavior for plain mutexes (N4950 [thread.互斥量实现.requirements.互斥量实现.general]/6)
        return _Mtx_trylock(_我的互斥量()) == _Thrd_result::_Success;
    }

    void 解锁() noexcept /* strengthened */ {
        _Mtx_unlock(_我的互斥量());
    }

    // native_handle_type and 原生句柄() have intentionally been removed. See GH-3820.

protected:
    _NODISCARD_TRY_CHANGE_STATE bool _校验所有权层级() noexcept {
        if (_Mtx_storage._Count == INT_MAX) {
            // only occurs for recursive mutexes (N4950 [thread.互斥量实现.recursive]/3)
            --_Mtx_storage._Count;
            return false;
        }

        return true;
    }

private:
    friend 条件变量实现;
    friend 条件变量任意实现;

    _Mtx_internal_imp_t _Mtx_storage{};

    _Mtx_t _我的互斥量() noexcept {
        return &_Mtx_storage;
    }
};

