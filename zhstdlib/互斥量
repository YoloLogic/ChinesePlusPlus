    void _Register(独占锁实现<互斥量实现>& _Lck, int* _Ready) noexcept { // register this object for 释放 at thread exit
        _Cnd_register_at_thread_exit(_Mycnd(), _Lck.释放()->_Mymtx(), _Ready);
    }

    void _Unregister(互斥量实现& _Mtx) noexcept { // unregister this object for 释放 at thread exit
        _Cnd_unregister_at_thread_exit(_Mtx._Mymtx());
    }

private:
    _Cnd_internal_imp_t _Cnd_storage{};

    _Cnd_t _Mycnd() noexcept {
        return &_Cnd_storage;
    }
};

struct _UInt_is_zero {
