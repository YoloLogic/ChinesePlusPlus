    模板 <类型名... 参数> 声明类型(自动) merge(参数&&... 值) { 返回 基类::归并(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) equal_range(参数&&... 值) { 返回 基类::相等区间(static_cast<参数&&>(值)...); }

    // 中文转发：insert/erase/find/count/contains/桶数/负载因子 在
    //   基类里【仍是英文】（xhash 没翻那些名字）-> 中文名得手写；
    //   尺寸/为空/清空/开始/结束 基类里已是汉语，这里转发只是保持两个类名字一致。
    // §17.68 方向翻转：抄来那层已是 插入/擦除/计数 ⇒ 这里改成补**英文原名**
    //   （中文名从基类继承，不再手写）。少一条 = 用户的甲.insert(...) 消失（铁律②）。
    // §17.68 花括号初始化列表必须单独发一条**非模板**重载：
    //   可变参模板的形参是 `参数&&...`，而 `甲.insert({1, 2})` 这种花括号列表
    //   **推不出模板实参** ⇒ 模板转发器会报"没有匹配的成员函数" ✗（实测）。
    //   基类那侧是英文 `value_type`（边界名，抄来层不翻）⇒ 参数类型写 `基类::value_type`。
    声明类型(自动) insert(std::initializer_list<基类::value_type> 值) { 返回 基类::插入(值); }
    声明类型(自动) insert(基类::value_type&& 值) { 返回 基类::插入(static_cast<基类::value_type&&>(值)); }
    模板 <类型名... 参数> 声明类型(自动) insert(参数&&... 值) { 返回 基类::插入(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) erase(参数&&... 值) { 返回 基类::擦除(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 查找(参数&&... 值) { 返回 基类::find(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) count(参数&&... 值) 常量 { 返回 基类::计数(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) extract(参数&&... 值) { 返回 基类::提取(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 尺寸(参数&&... 值) 常量 { 返回 基类::尺寸(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 为空(参数&&... 值) 常量 { 返回 基类::为空(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 清空(参数&&... 值) { 返回 基类::清空(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 包含(参数&&... 值) 常量 { 返回 基类::contains(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 开始(参数&&... 值) { 返回 基类::开始(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 结束(参数&&... 值) { 返回 基类::结束(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 桶数(参数&&... 值) 常量 { 返回 基类::桶数(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 负载因子(参数&&... 值) 常量 { 返回 基类::负载因子(static_cast<参数&&>(值)...); }
};

