enum class _修剪结果 : unsigned char { _KeepTrimming, _HaveWorkAfterTrimming, _ReturnFalse, _ReturnTrue };

template <class _BidIt1, class _BidIt2, class _Pr>
_NODISCARD _CONSTEXPR20 _修剪结果 _Trim_equal(
    _BidIt1& _First1, _BidIt1& _Back1, _BidIt2& _First2, _BidIt2& _Back2, _Pr _谓词) {
    // advances the iterators, trimming matching prefixes then matching suffixes
    // from [_First1, _Back1] and [_First2, _Back2]
    _STL_INTERNAL_CHECK(_First1 != _Back1);
    _STL_INTERNAL_CHECK(_STD distance(_First1, _Back1) == _STD distance(_First2, _Back2));
    if (_谓词(*_First1, *_First2)) {
        do {
            ++_First1;
            ++_First2;
            if (_First1 == _Back1) {
                // only one element is left
                return _谓词(*_First1, *_First2) ? _修剪结果::_ReturnTrue : _修剪结果::_ReturnFalse;
            }
        } while (_谓词(*_First1, *_First2));
    } else {
        if (!_谓词(*_Back1, *_Back2)) {
            // nothing to trim
            return _修剪结果::_HaveWorkAfterTrimming;
        }
        --_Back1;
        --_Back2;
    }

    for (;;) {
        if (_First1 == _Back1) {
            // only one element is left, it can't match because it wasn't trimmed by the first loop
            return _修剪结果::_ReturnFalse;
        }

        if (!_谓词(*_Back1, *_Back2)) {
            return _修剪结果::_KeepTrimming;
        }
        --_Back1;
        --_Back2;
    }
}

template <class _BidIt1, class _BidIt2, class _Pr>
_NODISCARD _CONSTEXPR20 _修剪结果 _Trim_reversed(
    _BidIt1& _First1, _BidIt1& _Back1, _BidIt2& _First2, _BidIt2& _Back2, _Pr _谓词) {
    // advances the iterators, trimming each range's prefix that matches the other range's suffix
    // from [_First1, _Back1] and [_First2, _Back2]
    _STL_INTERNAL_CHECK(_First1 != _Back1);
    _STL_INTERNAL_CHECK(_STD distance(_First1, _Back1) == _STD distance(_First2, _Back2));
    if (_谓词(*_First1, *_Back2)) {
        do {
            ++_First1;
            --_Back2;
            if (_First1 == _Back1) {
                // only one element is left
                return _谓词(*_First1, *_First2) ? _修剪结果::_ReturnTrue : _修剪结果::_ReturnFalse;
            }
        } while (_谓词(*_First1, *_Back2));
    } else {
        if (!_谓词(*_Back1, *_First2)) {
            // nothing to trim
            return _修剪结果::_HaveWorkAfterTrimming;
        }
        --_Back1;
        ++_First2;
    }

    for (;;) {
        if (_First1 == _Back1) {
            // only one element is left, it can't match because it wasn't trimmed by the first loop
            return _修剪结果::_ReturnFalse;
        }

        if (!_谓词(*_Back1, *_First2)) {
            return _修剪结果::_KeepTrimming;
        }
        --_Back1;
        ++_First2;
    }
}

template <class _BidIt1, class _BidIt2, class _Pr>
_NODISCARD _CONSTEXPR20 _修剪结果 _Trim_completely(
    _BidIt1& _First1, _BidIt1& _Back1, _BidIt2& _First2, _BidIt2& _Back2, _Pr _谓词) {
    // alternates between calling _Trim_reversed and _Trim_equal until no more trimming is possible
    _修剪结果 _Res = _修剪结果::_KeepTrimming;

    for (bool _Check_reversed = true; _Res == _修剪结果::_KeepTrimming; _Check_reversed = !_Check_reversed) {
        if (_Check_reversed) {
            _Res = _Trim_reversed(_First1, _Back1, _First2, _Back2, _谓词);
        } else {
            _Res = _Trim_equal(_First1, _Back1, _First2, _Back2, _谓词);
        }
    }

    return _Res;
}

template <class _FwdIt1, class _FwdIt2, class _Pr>
_NODISCARD _CONSTEXPR20 bool _检查匹配计数(
    _FwdIt1 _First1, _FwdIt1 _Last1, _FwdIt2 _First2, _FwdIt2 _Last2, _Pr _谓词) {
    // test if [_First1, _Last1) == permuted [_First2, _Last2), after matching prefix removal
    _STL_INTERNAL_CHECK(!_谓词(*_First1, *_First2));
    _STL_INTERNAL_CHECK(_STD distance(_First1, _Last1) == _STD distance(_First2, _Last2));
    if constexpr (_Is_ranges_bidi_iter_v<_FwdIt1> && _Is_ranges_bidi_iter_v<_FwdIt2>) {
        do { // find last inequality
            --_Last1;
            --_Last2;
        } while (_谓词(*_Last1, *_Last2));

        if (_First1 == _Last1) {
            return false;
        }

        const _修剪结果 _Res = _Trim_completely(_First1, _Last1, _First2, _Last2, _谓词);

        if (_Res != _修剪结果::_HaveWorkAfterTrimming) {
            return _Res == _修剪结果::_ReturnTrue;
        }

        ++_Last1;
        ++_Last2;
    }

    for (_FwdIt1 _Next1 = _First1; _Next1 != _Last1; ++_Next1) {
        if (_Next1 == _Find_pr(_First1, _Next1, *_Next1, _谓词)) { // new value, compare match counts
            _迭代器差类型<_FwdIt2> _Count2 = _Count_pr(_First2, _Last2, *_Next1, _谓词);
            if (_Count2 == 0) {
                return false; // second range lacks value, not a permutation
            }

            _FwdIt1 _Skip1                = _下一迭代器(_Next1);
            _迭代器差类型<_FwdIt1> _Count1 = _Count_pr(_Skip1, _Last1, *_Next1, _谓词) + 1;
            if (_Count2 != _Count1) {
                return false; // match counts differ, not a permutation
            }
        }
    }

    return true;
}

_EXPORT_STD template <class _BidIt>
_CONSTEXPR20 void 反转(const _BidIt _首个, const _BidIt _最后) { // 反转 elements in [_首个, _最后)
    _ADL校验范围(_首个, _最后);
    auto _UFirst = _取解包(_首个);
    auto _ULast  = _取解包(_最后);
#if _USE_STD_VECTOR_ALGORITHMS
    using _元素                         = remove_reference_t<_迭代器引用类型<decltype(_UFirst)>>;
    constexpr bool _Allow_vectorization = conjunction_v<bool_constant<_Iterator_is_contiguous<decltype(_UFirst)>>,
        _Is_trivially_swappable<_元素>, negation<is_volatile<_元素>>>;
    constexpr size_t _Nx                = sizeof(_元素);

    if constexpr (_Allow_vectorization && _Nx <= 8 && (_Nx & (_Nx - 1)) == 0) {
#if _HAS_CXX20
        if (!_STD is_constant_evaluated())
#endif // _HAS_CXX20
        {
            _STD _Reverse_vectorized<_Nx>(_取地址(_UFirst), _取地址(_ULast));
            return;
        }
    }
#endif // _USE_STD_VECTOR_ALGORITHMS

    for (; _UFirst != _ULast && _UFirst != --_ULast; ++_UFirst) {
        swap(*_UFirst, *_ULast); // intentional ADL
    }
}

