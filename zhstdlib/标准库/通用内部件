    return pair<_BidIt, _BidIt>(_首个, _最后);
}

_EXPORT_STD template <class _FwdIt>
_CONSTEXPR20 _FwdIt rotate(_FwdIt _首个, _FwdIt _Mid, _FwdIt _最后) {
    // exchange the ranges [_首个, _Mid) and [_Mid, _最后)
    // that is, rotates [_首个, _最后) left by distance(_首个, _Mid) positions
    // returns the iterator pointing at *_首个's new home
    _ADL校验范围(_首个, _Mid);
    _ADL校验范围(_Mid, _最后);
    auto _UFirst      = _取解包(_首个);
    auto _UMid        = _取解包(_Mid);
    const auto _ULast = _取解包(_最后);
    if (_UFirst == _UMid) {
        return _最后;
    }

    if (_UMid == _ULast) {
        return _首个;
    }

    if constexpr (_Is_cpp17_random_iter_v<_FwdIt>) {
        反转(_UFirst, _UMid);
        反转(_UMid, _ULast);
        反转(_UFirst, _ULast);
        _定位包装(_首个, _UFirst + (_ULast - _UMid));
    } else if constexpr (_Is_cpp17_bidi_iter_v<_FwdIt>) {
        反转(_UFirst, _UMid);
        反转(_UMid, _ULast);
        auto _Tmp = _Reverse_until_sentinel_unchecked(_UFirst, _UMid, _ULast);
        反转(_Tmp.first, _Tmp.second);
        _定位包装(_首个, _UMid != _Tmp.first ? _Tmp.first : _Tmp.second);
    } else {
        auto _UNext = _UMid;
        do { // rotate the first cycle
            swap(*_UFirst, *_UNext); // intentional ADL
            ++_UFirst;
            ++_UNext;
            if (_UFirst == _UMid) {
                _UMid = _UNext;
            }
        } while (_UNext != _ULast);
        _定位包装(_首个, _UFirst);
        while (_UMid != _ULast) { // rotate subsequent cycles
            _UNext = _UMid;
            do {
                swap(*_UFirst, *_UNext); // intentional ADL
                ++_UFirst;
                ++_UNext;
                if (_UFirst == _UMid) {
                    _UMid = _UNext;
                }
            } while (_UNext != _ULast);
        }
    }

    return _首个;
}

