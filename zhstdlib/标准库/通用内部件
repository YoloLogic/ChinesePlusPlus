template <class _BidIt>
constexpr pair<_BidIt, _BidIt> _Reverse_until_sentinel_unchecked(_BidIt _首个, _BidIt _哨兵, _BidIt _最后) {
    // 反转 until either _首个 or _最后 hits _哨兵
    while (_首个 != _哨兵 && _最后 != _哨兵) {
