        _STATIC_CALL_OPERATOR constexpr void operator()(_It& _Where, _Se _最后) _CONST_CALL_OPERATOR {
            if constexpr (assignable_from<_It&, _Se>) {
                _Where = static_cast<_Se&&>(_最后);
