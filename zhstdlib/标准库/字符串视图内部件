template <class _元素, class _Int_type>
struct _字符特征基类 { // properties of a string or stream element
    using char_type  = _元素;
    using int_type   = _Int_type;
    using pos_type   = streampos;
    using off_type   = streamoff;
    using state_type = _Mbstatet;
#if _HAS_CXX20
    using comparison_category = strong_ordering;
#endif // _HAS_CXX20

    // For copy/move, we can uniformly call memcpy/memmove (or their builtin versions) for all element types.

    static _CONSTEXPR20 _元素* copy(_Out_writes_all_(_Count) _元素* const _First1,
        _In_reads_(_Count) const _元素* const _First2, const size_t _Count) noexcept /* strengthened */ {
        // copy [_First2, _First2 + _Count) to [_First1, ...)
#if _HAS_MEMCPY_MEMMOVE_INTRINSICS
        __builtin_memcpy(_First1, _First2, _Count * sizeof(_元素));
#else // ^^^ _HAS_MEMCPY_MEMMOVE_INTRINSICS / !_HAS_MEMCPY_MEMMOVE_INTRINSICS vvv
#if _HAS_CXX20
        if (_STD is_constant_evaluated()) {
            // pre: [_First1, _First1 + _Count) and [_First2, _First2 + _Count) do not overlap
            for (size_t _Idx = 0; _Idx != _Count; ++_Idx) {
                _First1[_Idx] = _First2[_Idx];
            }

            return _First1;
        }
#endif // _HAS_CXX20

        _CSTD memcpy(_First1, _First2, _Count * sizeof(_元素));
#endif // ^^^ !_HAS_MEMCPY_MEMMOVE_INTRINSICS ^^^

        return _First1;
    }

    _Pre_satisfies_(_Dest_size >= _Count) static _CONSTEXPR20 _元素* _复制s(_Out_writes_all_(_Dest_size)
                                                                                 _元素* const _First1,
        const size_t _Dest_size, _In_reads_(_Count) const _元素* const _First2, const size_t _Count) noexcept {
        // copy [_First2, _First2 + _Count) to [_First1, _First1 + _Dest_size)
        _STL_VERIFY(_Count <= _Dest_size, "invalid argument");
        return copy(_First1, _First2, _Count);
    }

    static _CONSTEXPR20 _元素* move(_Out_writes_all_(_Count) _元素* const _First1,
        _In_reads_(_Count) const _元素* const _First2, const size_t _Count) noexcept /* strengthened */ {
        // copy [_First2, _First2 + _Count) to [_First1, ...), allowing overlap
#if _HAS_MEMCPY_MEMMOVE_INTRINSICS
        __builtin_memmove(_First1, _First2, _Count * sizeof(_元素));
#else // ^^^ _HAS_MEMCPY_MEMMOVE_INTRINSICS / !_HAS_MEMCPY_MEMMOVE_INTRINSICS vvv
#if _HAS_CXX20
        if (_STD is_constant_evaluated()) {
            // dest: [_First1, _First1 + _Count)
            // src: [_First2, _First2 + _Count)
            // We need to handle overlapping ranges.
            // If _First1 is in the src range, we need a backward loop.
            // Otherwise, the forward loop works (even if the 后 of dest overlaps the 前 of src).

            // Usually, we would compare pointers with less-than, even though they could belong to different arrays.
            // However, we're not allowed to do that during constant evaluation, so we need a linear scan for equality.
            bool _Loop_forward = true;

            for (const _元素* _Src = _First2; _Src != _First2 + _Count; ++_Src) {
                if (_First1 == _Src) {
                    _Loop_forward = false;
                    break;
                }
            }

            if (_Loop_forward) {
                for (size_t _Idx = 0; _Idx != _Count; ++_Idx) {
                    _First1[_Idx] = _First2[_Idx];
                }
            } else {
                for (size_t _Idx = _Count; _Idx != 0; --_Idx) {
                    _First1[_Idx - 1] = _First2[_Idx - 1];
                }
            }

            return _First1;
        }
#endif // _HAS_CXX20

        _CSTD memmove(_First1, _First2, _Count * sizeof(_元素));
#endif // ^^^ !_HAS_MEMCPY_MEMMOVE_INTRINSICS ^^^

        return _First1;
    }

    // For compare/length/find/assign, we can't uniformly call CRT functions (or their builtin versions).
    // 8-bit: memcmp/strlen/memchr/memset; 16-bit: wmemcmp/wcslen/wmemchr/wmemset; 32-bit: nonexistent

    _NODISCARD static _CONSTEXPR17 int compare(_In_reads_(_Count) const _元素* _First1,
        _In_reads_(_Count) const _元素* _First2, size_t _Count) noexcept /* strengthened */ {
        // compare [_First1, _First1 + _Count) with [_First2, ...)
        for (; 0 < _Count; --_Count, ++_First1, ++_First2) {
            if (*_First1 != *_First2) {
                return *_First1 < *_First2 ? -1 : +1;
            }
        }

        return 0;
    }

    _NODISCARD static _CONSTEXPR17 size_t length(_In_z_ const _元素* _首个) noexcept /* strengthened */ {
        // find length of null-terminated sequence
        size_t _Count = 0;
        while (*_首个 != _元素()) {
            ++_Count;
            ++_首个;
        }

        return _Count;
    }

    _NODISCARD static _CONSTEXPR17 const _元素* find(
        _In_reads_(_Count) const _元素* _首个, size_t _Count, const _元素& _Ch) noexcept /* strengthened */ {
        // look for _Ch in [_首个, _首个 + _Count)
        for (; 0 < _Count; --_Count, ++_首个) {
            if (*_首个 == _Ch) {
                return _首个;
            }
        }

        return nullptr;
    }

    static _CONSTEXPR20 _元素* assign(
        _Out_writes_all_(_Count) _元素* const _首个, size_t _Count, const _元素 _Ch) noexcept /* strengthened */ {
        // assign _Count * _Ch to [_首个, ...)
        for (_元素* _Next = _首个; _Count > 0; --_Count, ++_Next) {
            *_Next = _Ch;
        }

        return _首个;
    }

    static _CONSTEXPR17 void assign(_元素& _Left, const _元素& _Right) noexcept {
        _Left = _Right;
    }

    _NODISCARD static constexpr bool eq(const _元素 _Left, const _元素 _Right) noexcept {
        return _Left == _Right;
    }

    _NODISCARD static constexpr bool lt(const _元素 _Left, const _元素 _Right) noexcept {
        return _Left < _Right;
    }

    _NODISCARD static constexpr _元素 to_char_type(const int_type _Meta) noexcept {
        return static_cast<_元素>(_Meta);
    }

    _NODISCARD static constexpr int_type to_int_type(const _元素 _Ch) noexcept {
        return static_cast<int_type>(_Ch);
    }

    _NODISCARD static constexpr bool eq_int_type(const int_type _Left, const int_type _Right) noexcept {
        return _Left == _Right;
    }

    _NODISCARD static constexpr int_type not_eof(const int_type _Meta) noexcept {
        return _Meta != eof() ? _Meta : !eof();
    }

    _NODISCARD static constexpr int_type eof() noexcept {
        return static_cast<int_type>(EOF);
    }
};

template <class _元素>
struct _宽字符特征 : private _字符特征基类<_元素, unsigned short> {
    // char_traits for the char16_t-likes: char16_t, wchar_t, unsigned short
private:
    using _主字符特征 = _字符特征基类<_元素, unsigned short>;

public:
    using char_type  = _元素;
    using int_type   = unsigned short;
    using pos_type   = streampos;
    using off_type   = streamoff;
    using state_type = mbstate_t;
#if _HAS_CXX20
    using comparison_category = strong_ordering;
#endif // _HAS_CXX20

    using _主字符特征::_复制s;
    using _主字符特征::copy;
    using _主字符特征::move;

    _NODISCARD static _CONSTEXPR17 int compare(_In_reads_(_Count) const _元素* const _First1,
        _In_reads_(_Count) const _元素* const _First2, const size_t _Count) noexcept /* strengthened */ {
        // compare [_First1, _First1 + _Count) with [_First2, ...)
#if _HAS_CXX17
        if (_Is_constant_evaluated()) {
            if constexpr (is_same_v<_元素, wchar_t>) {
                return __builtin_wmemcmp(_First1, _First2, _Count);
            } else {
                return _主字符特征::compare(_First1, _First2, _Count);
            }
        }
#endif // _HAS_CXX17

        return _CSTD wmemcmp(
            reinterpret_cast<const wchar_t*>(_First1), reinterpret_cast<const wchar_t*>(_First2), _Count);
    }

    _NODISCARD static _CONSTEXPR17 size_t length(_In_z_ const _元素* _首个) noexcept /* strengthened */ {
        // find length of null-terminated sequence
#if _HAS_CXX17
        if (_Is_constant_evaluated()) {
            if constexpr (is_same_v<_元素, wchar_t>) {
                return __builtin_wcslen(_首个);
            } else {
                return _主字符特征::length(_首个);
            }
        }
#endif // _HAS_CXX17

        return _CSTD wcslen(reinterpret_cast<const wchar_t*>(_首个));
    }

    _NODISCARD static _CONSTEXPR17 const _元素* find(
        _In_reads_(_Count) const _元素* _首个, const size_t _Count, const _元素& _Ch) noexcept /* strengthened */ {
        // look for _Ch in [_首个, _首个 + _Count)
#if _HAS_CXX17
        if (_Is_constant_evaluated()) {
            if constexpr (is_same_v<_元素, wchar_t>) {
                return __builtin_wmemchr(_首个, _Ch, _Count);
            } else {
                return _主字符特征::find(_首个, _Count, _Ch);
            }
        }
#endif // _HAS_CXX17

        return reinterpret_cast<const _元素*>(_CSTD wmemchr(reinterpret_cast<const wchar_t*>(_首个), _Ch, _Count));
    }

    static _CONSTEXPR20 _元素* assign(
        _Out_writes_all_(_Count) _元素* const _首个, size_t _Count, const _元素 _Ch) noexcept /* strengthened */ {
        // assign _Count * _Ch to [_首个, ...)
#if _HAS_CXX20
        if (_STD is_constant_evaluated()) {
            return _主字符特征::assign(_首个, _Count, _Ch);
        }
#endif // _HAS_CXX20

        return reinterpret_cast<_元素*>(_CSTD wmemset(reinterpret_cast<wchar_t*>(_首个), _Ch, _Count));
    }

    static _CONSTEXPR17 void assign(_元素& _Left, const _元素& _Right) noexcept {
#if _HAS_CXX20
        if (_STD is_constant_evaluated()) {
            return _主字符特征::assign(_Left, _Right);
        }
#endif // _HAS_CXX20
        _Left = _Right;
    }

    _NODISCARD static constexpr bool eq(const _元素 _Left, const _元素 _Right) noexcept {
        return _Left == _Right;
    }

    _NODISCARD static constexpr bool lt(const _元素 _Left, const _元素 _Right) noexcept {
        return _Left < _Right;
    }

    _NODISCARD static constexpr _元素 to_char_type(const int_type _Meta) noexcept {
        return _Meta;
    }

    _NODISCARD static constexpr int_type to_int_type(const _元素 _Ch) noexcept {
        return _Ch;
    }

    _NODISCARD static constexpr bool eq_int_type(const int_type _Left, const int_type _Right) noexcept {
        return _Left == _Right;
    }

    _NODISCARD static constexpr int_type not_eof(const int_type _Meta) noexcept {
        return _Meta != eof() ? _Meta : static_cast<int_type>(!eof());
    }

    _NODISCARD static constexpr int_type eof() noexcept {
        return WEOF;
    }
};

