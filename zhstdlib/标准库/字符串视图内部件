template <class _元素, class _特征, class _SizeT>
basic_ostream<_元素, _特征>& _插入字符串(
    basic_ostream<_元素, _特征>& _Ostr, const _元素* const _Data, const _SizeT _Size) {
    // insert a character-type sequence into _Ostr as if through a basic_string copy
    using _输出流类型                    = basic_ostream<_元素, _特征>;
    typename _输出流类型::iostate _State = _输出流类型::goodbit;

    _SizeT _Pad;
    if (_Ostr.width() <= 0 || static_cast<_SizeT>(_Ostr.width()) <= _Size) {
        _Pad = 0;
    } else {
        _Pad = static_cast<_SizeT>(_Ostr.width()) - _Size;
    }

    const typename _输出流类型::sentry _成功(_Ostr);

    if (!_成功) {
        _State |= _输出流类型::badbit;
    } else { // state okay, insert characters
        _TRY_IO_BEGIN
        if ((_Ostr.flags() & _输出流类型::adjustfield) != _输出流类型::left) {
            for (; 0 < _Pad; --_Pad) { // pad on left
                if (_特征::eq_int_type(_特征::eof(), _Ostr.rdbuf()->sputc(_Ostr.fill()))) {
                    _State |= _输出流类型::badbit; // insertion failed, quit
                    break;
                }
            }
        }

        if (_State == _输出流类型::goodbit
            && _Ostr.rdbuf()->sputn(_Data, static_cast<streamsize>(_Size)) != static_cast<streamsize>(_Size)) {
            _State |= _输出流类型::badbit;
        } else {
            for (; 0 < _Pad; --_Pad) { // pad on right
                if (_特征::eq_int_type(_特征::eof(), _Ostr.rdbuf()->sputc(_Ostr.fill()))) {
                    _State |= _输出流类型::badbit; // insertion failed, quit
                    break;
                }
            }
        }

        _Ostr.width(0);
        _CATCH_IO_(_输出流类型, _Ostr)
    }

    _Ostr.setstate(_State);
    return _Ostr;
}

template <class _特征>
using _特征字符类型 = typename _特征::char_type;

template <class _特征>
using _特征指针类型 = const typename _特征::char_type*;

template <class _特征>
constexpr bool _Traits_equal(_In_reads_(_Left_size) const _特征指针类型<_特征> _Left, const size_t _Left_size,
    _In_reads_(_Right_size) const _特征指针类型<_特征> _Right, const size_t _Right_size) noexcept {
    // compare [_Left, _Left + _Left_size) to [_Right, _Right + _Right_size) for equality using _特征
    if (_Left_size != _Right_size) {
        return false;
    }

    if (_Left_size == 0u) {
        return true;
    }

    return _特征::compare(_Left, _Right, _Left_size) == 0;
}

template <class _特征>
constexpr int _Traits_compare(_In_reads_(_Left_size) const _特征指针类型<_特征> _Left, const size_t _Left_size,
    _In_reads_(_Right_size) const _特征指针类型<_特征> _Right, const size_t _Right_size) noexcept {
    // compare [_Left, _Left + _Left_size) to [_Right, _Right + _Right_size) using _特征
    const int _Ans = _特征::compare(_Left, _Right, (_STD min)(_Left_size, _Right_size));

    if (_Ans != 0) {
        return _Ans;
    }

    if (_Left_size < _Right_size) {
        return -1;
    }

    if (_Left_size > _Right_size) {
        return 1;
    }

    return 0;
}

template <class _特征>
constexpr size_t _Traits_find(_In_reads_(_Hay_size) const _特征指针类型<_特征> _Haystack, const size_t _Hay_size,
    const size_t _Start_at, _In_reads_(_Needle_size) const _特征指针类型<_特征> _Needle,
    const size_t _Needle_size) noexcept {
    // search [_Haystack, _Haystack + _Hay_size) for [_Needle, _Needle + _Needle_size), 取值/after _Start_at
    if (_Needle_size > _Hay_size || _Start_at > _Hay_size - _Needle_size) {
        // xpos cannot exist, report failure
        // N4950 [string.view.find]/3 says:
        // 1. _Start_at <= xpos
        // 2. xpos + _Needle_size <= _Hay_size;
        // therefore:
        // 3. _Needle_size <= _Hay_size (by 2) (checked above)
        // 4. _Start_at + _Needle_size <= _Hay_size (substitute 1 into 2)
        // 5. _Start_at <= _Hay_size - _Needle_size (4, move _Needle_size to other side) (also checked above)
        return static_cast<size_t>(-1);
    }

    if (_Needle_size == 0) { // 为空 string always matches if xpos is possible
        return _Start_at;
    }

#if _USE_STD_VECTOR_ALGORITHMS
    if constexpr (_Is_implementation_handled_char_traits<_特征> && sizeof(typename _特征::char_type) <= 2) {
        if (!_Is_constant_evaluated()) {
            const auto _End = _Haystack + _Hay_size;
            const auto _Ptr = _搜索向量化(_Haystack + _Start_at, _End, _Needle, _Needle_size);

            if (_Ptr != _End) {
