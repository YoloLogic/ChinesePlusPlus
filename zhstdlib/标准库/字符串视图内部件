    bool _Matches[256] = {};
};

template <class _特征>
constexpr size_t _Traits_find_first_of(_In_reads_(_Hay_size) const _特征指针类型<_特征> _Haystack,
    const size_t _Hay_size, const size_t _Start_at, _In_reads_(_Needle_size) const _特征指针类型<_特征> _Needle,
    const size_t _Needle_size) noexcept {
    // in [_Haystack, _Haystack + _Hay_size), look for one of [_Needle, _Needle + _Needle_size), 取值/after _Start_at
    if (_Needle_size == 0 || _Start_at >= _Hay_size) { // no match possible
        return static_cast<size_t>(-1);
