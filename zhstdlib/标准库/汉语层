// <汉语层> —— 「用户可全中文调用」的补充层（B 方案：抄高频 + 包装中频 + 别名保身份）
//
// 原则（很重要）：
//   1. 能别名就别名 —— 类型身份不变，std:: 英文照旧，互操作不断
//   2. 别名做不到中文成员时，用「包装结构」把成员包成中文
//      代价：包装类型不等同 std 类型（第三方接口若显式要 std 类型会拒绝）
//   3. 异常绝不包装/抄写 —— catch (std::exception&) 必须继续有效
//
// 命名规则：所有新名字必须避开 185 个中文关键字（类型/选择/如果…），
//           并避开既有头里的重名。定名前跑 tools/check_zh_names.py。
#pragma once
#include <类型特征>
#include <标准异常>
#include <内存>
#include <互斥量>
#include <线程>
#include <工具>
#include <可选>
#include <任意>
#include <变体>
#include <元组>

名域 标准 {

    // ================= 类型特征：中文变量模板（零身份代价）=================
    模板 <类型名 某类型> 内联 常量表达式 布尔 为整数 = std::is_integral_v<某类型>;
    模板 <类型名 某类型> 内联 常量表达式 布尔 为浮点 = std::is_floating_point_v<某类型>;
    模板 <类型名 某类型> 内联 常量表达式 布尔 为空型 = std::is_void_v<某类型>;
    模板 <类型名 某类型> 内联 常量表达式 布尔 为常量 = std::is_const_v<某类型>;
    模板 <类型名 某类型> 内联 常量表达式 布尔 为指针 = std::is_pointer_v<某类型>;
    模板 <类型名 某类型> 内联 常量表达式 布尔 为引用 = std::is_reference_v<某类型>;
    模板 <类型名 某类型> 内联 常量表达式 布尔 为类 = std::is_class_v<某类型>;
    模板 <类型名 某类型> 内联 常量表达式 布尔 为枚举 = std::is_enum_v<某类型>;

    // ================= 异常：中文取文本（异常类型不变）=================
    内联 常量 字符* 文本(常量 std::exception& 错) 不抛出 { 返回 错.what(); }

    // ================= 锁：中文类型名（别名，身份不变）=================
    模板 <类型名 互斥类型> 使用 锁守 = std::lock_guard<互斥类型>;

    // ================= 唯一指针：中文成员版（包装）=================
    模板 <类型名 元素> 结构 唯一指针中 {
        唯一指针<元素> 底_;
        唯一指针中() = 默认;
        唯一指针中(唯一指针<元素> 指针) : 底_(std::move(指针)) {}
        元素* 取原指针() 常量 不抛出 { 返回 底_.get(); }
        空型 重置(元素* 指针 = 空指针) 不抛出 { 底_.reset(指针); }
        元素* 释放所有权() 不抛出 { 返回 底_.release(); }
        元素& 运算符*() 常量 { 返回 *底_; }
        元素* 运算符->() 常量 { 返回 底_.get(); }
        显式 运算符 布尔() 常量 不抛出 { 返回 (布尔)底_; }
    };

    模板 <类型名 元素, 类型名... 诸参数>
    唯一指针中<元素> 造唯一(诸参数&&... 参数) {
        返回 唯一指针中<元素>(构造唯一<元素>(std::forward<诸参数>(参数)...));
    }

    // ================= 共享指针：中文成员版（包装）=================
    模板 <类型名 元素> 结构 共享指针中 {
        共享指针<元素> 底_;
        共享指针中() = 默认;
        共享指针中(共享指针<元素> 指针) : 底_(std::move(指针)) {}
        元素* 取原指针() 常量 不抛出 { 返回 底_.get(); }
        空型 重置(元素* 指针 = 空指针) 不抛出 { 底_.reset(指针); }
        长型 引用计数() 常量 不抛出 { 返回 底_.use_count(); }
        元素& 运算符*() 常量 { 返回 *底_; }
        元素* 运算符->() 常量 { 返回 底_.get(); }
        弱指针<元素> 转弱() 常量 不抛出 { 返回 底_; }
    };

    模板 <类型名 元素, 类型名... 诸参数>
    共享指针中<元素> 造共享(诸参数&&... 参数) {
        返回 共享指针中<元素>(构造共享<元素>(std::forward<诸参数>(参数)...));
    }
    // ================= 可选：中文取值 =================
    模板 <类型名 元素>
    内联 元素& 可选取值(可选<元素>& 值) { 返回 *值; }

    模板 <类型名 元素>
    内联 常量 元素& 可选取值(常量 可选<元素>& 值) { 返回 *值; }

    模板 <类型名 元素, 类型名 备用>
    内联 元素 值或(常量 可选<元素>& 值, 备用&& 默认值) {
        返回 值 ? *值 : static_cast<元素>(std::forward<备用>(默认值));
    }

    // ================= 元组：中文取元素 =================
    模板 <整数 下标, 类型名... 元素>
    内联 自动& 元取(元组<元素...>& 表) { 返回 std::get<下标>(表); }

    模板 <整数 下标, 类型名... 元素>
    内联 常量 自动& 元取(常量 元组<元素...>& 表) { 返回 std::get<下标>(表); }

    // 说明：变体/任意 是「抄实现」的中文类型（标准库\变体、标准库\任意），
    // 与 std::variant / std::any 不是同一类型，所以不能用 std::get / std::any_cast。
    // 它们的中文取用等下一步在各自头里补（需要先查它们内部的中文访问器名）。
}
