_NODISCARD_REMOVE_ALG _CONSTEXPR20 _FwdIt remove(_FwdIt _首个, const _FwdIt _最后, const _类型& _Val) {
    // remove each matching _Val
    _ADL校验范围(_首个, _最后);
    auto _UFirst      = _取解包(_首个);
    const auto _ULast = _取解包(_最后);
    _UFirst           = _查找非检查(_UFirst, _ULast, _Val);
    auto _UNext       = _UFirst;
    if (_UFirst != _ULast) {
#if _USE_STD_VECTOR_ALGORITHMS
        if constexpr (_Vector_alg_in_find_is_safe<decltype(_UFirst), _类型>) {
#if _HAS_CXX20
