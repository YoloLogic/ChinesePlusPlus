basic_istream<_元素, _Tr>& operator>>(basic_istream<_元素, _Tr>& _Istr, 复数实现<_类型>& _Right) {
    const ctype<_元素>& _Ctype_fac = _STD use_facet<ctype<_元素>>(_Istr.getloc());
    _元素 _Ch                      = 0;
    long double _Real              = 0;
    long double _Imag              = 0;

    if (_Istr >> _Ch && _Ch != _Ctype_fac.widen('(')) { // no leading '(', treat as 实部 only
        _Istr.putback(_Ch);
        _Istr >> _Real;
        _Imag = 0;
    } else if (_Istr >> _Real >> _Ch && _Ch != _Ctype_fac.widen(',')) {
        if (_Ch == _Ctype_fac.widen(')')) {
            _Imag = 0; // (实部)
        } else { // no trailing ')' after 实部, treat as bad field
            _Istr.putback(_Ch);
            _Istr.setstate(ios_base::failbit);
        }
    } else if (_Istr >> _Imag >> _Ch && _Ch != _Ctype_fac.widen(')')) { // no 虚部 or trailing ')', treat as bad field
        _Istr.putback(_Ch);
        _Istr.setstate(ios_base::failbit);
    }

    if (!_Istr.fail()) { // store valid result
        _类型 _实分量(static_cast<_类型>(_Real)), _虚分量(static_cast<_类型>(_Imag));
        _Right = 复数实现<_类型>(_实分量, _虚分量);
    }
    return _Istr;
}

_EXPORT_STD template <class _类型, class _元素, class _Tr>
basic_ostream<_元素, _Tr>& operator<<(basic_ostream<_元素, _Tr>& _Ostr, const 复数实现<_类型>& _Right) {
    const ctype<_元素>& _Ctype_fac = _STD use_facet<ctype<_元素>>(_Ostr.getloc());
    basic_ostringstream<_元素, _Tr, allocator<_元素>> _Sstr;

    _Sstr.flags(_Ostr.flags());
    _Sstr.imbue(_Ostr.getloc());
    _Sstr.precision(_Ostr.precision());
    _Sstr << _Ctype_fac.widen('(') << 实部(_Right) << _Ctype_fac.widen(',') << 虚部(_Right) << _Ctype_fac.widen(')');

    return _Ostr << _Sstr.str();
}

