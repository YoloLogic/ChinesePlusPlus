// TRANSITION, workaround x86 ABI
// On x86 ABI, floating-point by-value arguments and return values are passed in 80-bit x87 registers.
// When the value is a 32-bit or 64-bit signaling NaN, the conversion to/from 80-bit raises FE_INVALID
// and turns it into a quiet NaN. This behavior is undesirable if we want to test for signaling NaNs.
template <class _类型, enable_if_t<is_floating_point_v<_类型>, int> = 0>
_NODISCARD constexpr bool _Is_signaling_nan(const _类型& _Xx) noexcept { // returns true if input is a signaling NaN
    using _特征        = _Floating_type_traits<_类型>;
    const auto _Abs_bits = _Float_abs_bits(_Xx);
    return _Abs_bits > _特征::_Shifted_exponent_mask && ((_Abs_bits & _特征::_Special_nan_mantissa_mask) == 0);
}

template <class _类型, enable_if_t<is_floating_point_v<_类型>, int> = 0>
_NODISCARD constexpr bool _Is_inf(const _类型 _Xx) noexcept { // constexpr isinf()
    using _特征 = _Floating_type_traits<_类型>;
    return _Float_abs_bits(_Xx) == _特征::_Shifted_exponent_mask;
}

// implements multi-precision floating-point arithmetic for numerical algorithms
#pragma float_control(precise, on, push)
namespace _Float_multi_prec {
    // multi-precision floating-point types
    template <class _类型, int _Prec>
    struct _Fmp_t;

    template <class _类型>
    struct _Fmp_t<_类型, 2> {
        static_assert(is_floating_point_v<_类型>, "_类型 must be floating-point");
        _类型 _Val0; // most significant numeric_limits<_类型>::precision bits
        _类型 _Val1; // least significant numeric_limits<_类型>::precision bits
    };

    // addition

    // 1x precision + 1x precision -> 2x precision
    // the result is exact when:
    // 1) no internal overflow occurs
    // 2) either underflow is gradual, or no internal underflow occurs
    // 3) intermediate precision is either the same as _类型, or greater than twice the precision of _类型
    // 4) parameters and local variables do not retain extra intermediate precision
    // 5) rounding mode is rounding to nearest
    // violation of condition 3 or 5 could lead to relative error on the order of epsilon^2
    // violation of other conditions could lead to worse results
    template <class _类型>
    _NODISCARD constexpr _Fmp_t<_类型, 2> _加双倍(const _类型 _Xval, const _类型 _Yval) noexcept {
        const _类型 _Sum0 = _Xval + _Yval;
        const _类型 _Ymod = _Sum0 - _Xval;
        const _类型 _Xmod = _Sum0 - _Ymod;
        const _类型 _Yerr = _Yval - _Ymod;
        const _类型 _Xerr = _Xval - _Xmod;
        return {_Sum0, _Xerr + _Yerr};
    }

    // 1x precision + 1x precision -> 2x precision
    // requires: exponent(_Xval) + countr_zero(significand(_Xval)) >= exponent(_Yval) || _Xval == 0
    // the result is exact when:
    // 0) the requirement above is satisfied
    // 1) the result doesn't overflow
    // 2) either underflow is gradual, or no internal underflow occurs
    // 3) intermediate precision is either the same as _类型, or greater than twice the precision of _类型
    // 4) parameters and local variables do not retain extra intermediate precision
    // 5) rounding mode is rounding to nearest
    // violation of condition 3 or 5 could lead to relative error on the order of epsilon^2
    // violation of other conditions could lead to worse results
    template <class _类型>
    _NODISCARD constexpr _Fmp_t<_类型, 2> _Add_small_x2(const _类型 _Xval, const _类型 _Yval) noexcept {
        const _类型 _Sum0 = _Xval + _Yval;
        const _类型 _Ymod = _Sum0 - _Xval;
        const _类型 _Yerr = _Yval - _Ymod;
        return {_Sum0, _Yerr};
    }

    // 1x precision + 2x precision -> 2x precision
    // requires: exponent(_Xval) + countr_zero(significand(_Xval)) >= exponent(_Yval._Val0) || _Xval == 0
    template <class _类型>
    _NODISCARD constexpr _Fmp_t<_类型, 2> _Add_small_x2(const _类型 _Xval, const _Fmp_t<_类型, 2>& _Yval) noexcept {
        const _Fmp_t<_类型, 2> _Sum0 = _Add_small_x2(_Xval, _Yval._Val0);
        return _Add_small_x2(_Sum0._Val0, _Sum0._Val1 + _Yval._Val1);
    }

    // 2x precision + 2x precision -> 1x precision
    template <class _类型>
    _NODISCARD constexpr _类型 _Add_x1(const _Fmp_t<_类型, 2>& _Xval, const _Fmp_t<_类型, 2>& _Yval) noexcept {
        const _Fmp_t<_类型, 2> _Sum00 = _加双倍(_Xval._Val0, _Yval._Val0);
        return _Sum00._Val0 + (_Sum00._Val1 + (_Xval._Val1 + _Yval._Val1));
    }

    // multiplication

    // round to 26 significant bits, ties toward zero
    _NODISCARD constexpr double _高半部(const double _Val) noexcept {
        const auto _Bits           = _Bit_cast<unsigned long long>(_Val);
        const auto _High_half_bits = (_Bits + 0x3ff'ffffULL) & 0xffff'ffff'f800'0000ULL;
        return _Bit_cast<double>(_High_half_bits);
    }

    // _Xval * _Xval - _Prod0
    // the result is exact when:
    // 1) _Prod0 is _Xval^2 faithfully rounded
    // 2) no internal overflow or underflow occurs
    // violation of condition 1 could lead to relative error on the order of epsilon
    _NODISCARD constexpr double _平方误差回退(const double _Xval, const double _Prod0) noexcept {
        const double _Xhigh = _高半部(_Xval);
        const double _Xlow  = _Xval - _Xhigh;
        return ((_Xhigh * _Xhigh - _Prod0) + 2.0 * _Xhigh * _Xlow) + _Xlow * _Xlow;
    }

#ifdef _FMP_USING_X86_X64_INTRINSICS_汉
    _NODISCARD inline double _平方误差x86x64融合乘加(const double _Xval, const double _Prod0) noexcept {
        const __m128d _Mx      = _mm_set_sd(_Xval);
        const __m128d _Mprod0  = _mm_set_sd(_Prod0);
        const __m128d _Mresult = _mm_fmsub_sd(_Mx, _Mx, _Mprod0);
        double _结果;
        _mm_store_sd(&_结果, _Mresult);
        return _结果;
    }
#endif // defined(_FMP_USING_X86_X64_INTRINSICS_汉)

#ifdef _FMP_USING_STD_FMA_汉
    _NODISCARD inline double _平方误差标准融合乘加(const double _Xval, const double _Prod0) noexcept {
        return _STD fma(_Xval, _Xval, -_Prod0);
    }
#endif // defined(_FMP_USING_STD_FMA_汉)

    // square(1x precision) -> 2x precision
    // the result is exact when no internal overflow or underflow occurs
    _NODISCARD inline _Fmp_t<double, 2> _Sqr_x2(const double _Xval) noexcept {
        const double _Prod0 = _Xval * _Xval;

#if defined(_FMP_USING_X86_X64_INTRINSICS_汉)

#ifdef __AVX2__
        return {_Prod0, _平方误差x86x64融合乘加(_Xval, _Prod0)};
#else // ^^^ defined(__AVX2__) / !defined(__AVX2__) vvv
        const bool _Definitely_have_fma = __isa_available >= _Stl_isa_available_avx2;
        if (_Definitely_have_fma) {
            return {_Prod0, _平方误差x86x64融合乘加(_Xval, _Prod0)};
        } else {
            return {_Prod0, _平方误差回退(_Xval, _Prod0)};
        }
#endif // ^^^ !defined(__AVX2__) ^^^

#elif defined(_FMP_USING_STD_FMA_汉)
        return {_Prod0, _平方误差标准融合乘加(_Xval, _Prod0)};
#else // ^^^ defined(_FMP_USING_STD_FMA_汉) / not using intrinsics vvv
        return {_Prod0, _平方误差回退(_Xval, _Prod0)};
#endif // ^^^ not using intrinsics ^^^
    }
} // namespace _Float_multi_prec
