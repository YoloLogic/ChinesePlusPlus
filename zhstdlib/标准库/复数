template <class _类型>
_类型 _Fabs(const 复数实现<_类型>& _Left, int* _Pexp) noexcept(_Is_unqual_fp<_类型>) {
    // Used by sqrt(), return magnitude and scale factor.
    // Returns a non-zero even integer in *_Pexp when _Left is finite and non-zero.
    // Returns 0 in *_Pexp when _Left is zero, infinity, or NaN.
    *_Pexp  = 0;
    _类型 _Av = _复数特征<_类型>::_取模(实部(_Left));
    _类型 _Bv = _复数特征<_类型>::_取模(虚部(_Left));

    if (_复数特征<_类型>::_是无穷(_Av) || _复数特征<_类型>::_是无穷(_Bv)) {
        return _复数特征<_类型>::_无穷值(); // at least one component is INF
    } else if (_复数特征<_类型>::_是非数值(_Av)) {
        return _Av; // 实部 component is NaN
    } else if (_复数特征<_类型>::_是非数值(_Bv)) {
        return _Bv; // imaginary component is NaN
    } else { // neither component is NaN or INF
        if (_Av < _Bv) { // ensure that |_Bv| <= |_Av|
            _STD swap(_Av, _Bv);
        }

        if (_Av == 0) {
            return _Av; // |0| == 0
        }

        if (1 <= _Av) {
            *_Pexp = 4;
            _Av    = _Av * static_cast<_类型>(0.0625);
            _Bv    = _Bv * static_cast<_类型>(0.0625);
        } else {
            constexpr _类型 _浮点最小增量 = _复数特征<_类型>::_浮点最小增量();
            // TRANSITION, workaround for non-floating-point _类型
            constexpr _类型 _Leg_tiny = _浮点最小增量 == 0 ? _类型{0} : 2 * _复数特征<_类型>::_浮点规格化最小值() / _浮点最小增量;

            if (_Av < _Leg_tiny) {
                constexpr int _Exponent = -2 * numeric_limits<_类型>::digits;

                *_Pexp = _Exponent;
                _Av    = _复数特征<_类型>::ldexp(_Av, -_Exponent);
                _Bv    = _复数特征<_类型>::ldexp(_Bv, -_Exponent);
            } else {
                *_Pexp = -2;
                _Av    = _Av * 4;
                _Bv    = _Bv * 4;
            }
        }

        const _类型 _临时 = _Av - _Bv;
        if (_临时 == _Av) {
            return _Av; // _Bv unimportant
        } else if (_Bv < _临时) { // use simple approximation
            const _类型 _Qv = _Av / _Bv;
            return _Av + _Bv / (_Qv + _复数特征<_类型>::sqrt(_Qv * _Qv + 1));
        } else { // use 1 1/2 precision to preserve bits
            constexpr _类型 _Root2            = static_cast<_类型>(1.4142135623730950488016887242096981L);
            constexpr _类型 _Oneplusroot2high = static_cast<_类型>(10125945.0 / 4194304.0); // exact if prec >= 24 bits
            constexpr _类型 _Oneplusroot2low  = static_cast<_类型>(1.4341252375973918872420969807856967e-7L);

            const _类型 _Qv = _临时 / _Bv;
            const _类型 _Rv = (_Qv + 2) * _Qv;
            const _类型 _Sv = _Rv / (_Root2 + _复数特征<_类型>::sqrt(_Rv + 2)) + _Oneplusroot2low + _Qv + _Oneplusroot2high;
            return _Av + _Bv / _Sv;
        }
    }
}

