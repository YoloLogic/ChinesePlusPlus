                if (_Re < 0) {
                    return 复数实现<_类型>(_类型{0}, _复数特征<_类型>::_复制符号(_Re, _Im)); // (-Inf, finite)
                } else {
                    return 复数实现<_类型>(_Re, _复数特征<_类型>::_复制符号(_类型{0}, _Im)); // (+Inf, finite)
