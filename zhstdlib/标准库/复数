    template <class _类型>
    struct _直角边巨大助手 {
        static constexpr _类型 value{6.703903964971298e+153};
    };
    template <>
    struct _直角边巨大助手<float> {
        static constexpr float value{9.2233715e+18f};
    };
    template <class _类型>
    constexpr _类型 _Hypot_leg_huge = _直角边巨大助手<_类型>::value;

    template <class _类型>
    struct _直角边极小助手 {
        static constexpr _类型 value{1.4156865331029228e-146};
    };
    template <>
    struct _直角边极小助手<float> {
        static constexpr float value{4.440892e-16f};
    };
    template <class _类型>
    constexpr _类型 _Hypot_leg_tiny = _直角边极小助手<_类型>::value;

    template <class _类型>
    _NODISCARD _类型 _模减一(const _类型 _Xval, const _类型 _Yval) noexcept {
        // requires |_Xval| >= |_Yval| and 0.5 <= |_Xval| < 2^12
        // returns _Xval * _Xval + _Yval * _Yval - 1
        const _FMP_汉 _Fmp_t<_类型, 2> _Xsqr    = _FMP_汉 _Sqr_x2(_Xval);
        const _FMP_汉 _Fmp_t<_类型, 2> _Ysqr    = _FMP_汉 _Sqr_x2(_Yval);
        const _FMP_汉 _Fmp_t<_类型, 2> _Xsqr_m1 = _FMP_汉 _Add_small_x2(_类型{-1.0}, _Xsqr);
        return _Add_x1(_Xsqr_m1, _Ysqr);
    }

    _NODISCARD inline float _模减一(const float _Xval, const float _Yval) noexcept {
        const auto _Dx = static_cast<double>(_Xval);
        const auto _Dy = static_cast<double>(_Yval);
        return static_cast<float>((_Dx * _Dx - 1.0) + _Dy * _Dy);
    }

    // TRANSITION: CRT _对数一加 can be inaccurate for tiny inputs under directed rounding modes
    template <class _类型>
    _NODISCARD _类型 _对数加一(const _类型 _Xval) noexcept { // returns log(1 + _Xval)
        static_assert(is_floating_point_v<_类型>, "_类型 must be floating-point");

        if (_Is_nan(_Xval)) { // NaN
            return _Xval + _Xval; // raise FE_INVALID if _Xval is a signaling NaN
        }

        if (_Xval <= _类型{-0.5} || _类型{2.0} <= _Xval) { // naive formula is moderately accurate
            if (_Xval == (numeric_limits<_类型>::max)()) { // avoid overflow
                return _STD log(_Xval);
            }

            return _STD log(_类型{1.0} + _Xval);
        }

        const _类型 _Xabs = _Float_abs(_Xval);
        if (_Xabs < numeric_limits<_类型>::epsilon()) { // zero or tiny
            if (_Xval == _类型{0.0}) {
                return _Xval;
            }

            // honor rounding mode, raise FE_INEXACT
            return _Xval - _类型{0.5} * _Xval * _Xval;
        }

        // compute log(1 + _Xval) with fixup for small _Xval
        const _FMP_汉 _Fmp_t<_类型, 2> _Xp1 = _FMP_汉 _Add_small_x2(_类型{1.0}, _Xval);
        return _STD log(_Xp1._Val0) + _Xp1._Val1 / _Xp1._Val0;
    }

    template <class _类型>
    _NODISCARD _类型 _对数直角边(const _类型 _Xval, const _类型 _Yval) noexcept { // returns log(hypot(_Xval, _Yval))
        static_assert(is_floating_point_v<_类型>, "_类型 must be floating-point");

        if (!_Is_finite(_Xval) || !_Is_finite(_Yval)) { // Inf or NaN
            // raise FE_INVALID and return NaN if at least one of them is a signaling NaN
            if (_Is_signaling_nan(_Xval) || _Is_signaling_nan(_Yval)) {
                return _Xval + _Yval;
            }

            // return +Inf if at least one of them is an infinity, even when the other is a quiet NaN
            if (_Is_inf(_Xval)) {
                return _Float_abs(_Xval);
            }

            if (_Is_inf(_Yval)) {
                return _Float_abs(_Yval);
            }

            // at least one of them is a quiet NaN, and the other is not an infinity
            return _Xval + _Yval;
        }

        _类型 _Av = _Float_abs(_Xval);
        _类型 _Bv = _Float_abs(_Yval);

        if (_Av < _Bv) { // ensure that _Bv <= _Av
            _STD swap(_Av, _Bv);
        }

        if (_Bv == 0) {
            return _STD log(_Av);
        }

        if (_Hypot_leg_tiny<_类型> < _Av && _Av < _Hypot_leg_huge<_类型>) { // no overflow or harmful underflow
            constexpr _类型 _Norm_small{0.5};
            constexpr _类型 _Norm_big{3.0};

            const _类型 _Bv_sqr = _Bv * _Bv;

            if (_Av == _类型{1.0}) { // correctly return +0 when _Av == 1 and _Bv * _Bv underflows
                                   // _模减一(_Av, _Bv) could return -0 under FE_DOWNWARD rounding mode
                return _对数加一(_Bv_sqr) * _类型{0.5};
            }

            const _类型 _Norm = _Av * _Av + _Bv_sqr;

            if (_Norm_small < _Norm && _Norm < _Norm_big) { // avoid catastrophic cancellation
                return _对数加一(_模减一(_Av, _Bv)) * _类型{0.5};
            } else {
                return _STD log(_Norm) * _类型{0.5};
            }
        } else { // use 1 1/2 precision to preserve bits
            constexpr _类型 _Cm = _类型{22713.0L / 32768.0L};
            constexpr _类型 _Cl = _类型{1.4286068203094172321214581765680755e-6L};

            const int _Exponent      = _STD ilogb(_Av);
            const _类型 _Av_scaled     = _STD scalbn(_Av, -_Exponent);
            const _类型 _Bv_scaled     = _STD scalbn(_Bv, -_Exponent);
            const _类型 _Bv_scaled_sqr = _Bv_scaled * _Bv_scaled;
            const _类型 _Norm_scaled   = _Av_scaled * _Av_scaled + _Bv_scaled_sqr;
            const _类型 _Real_shifted  = _STD log(_Norm_scaled) * _类型{0.5};
            const auto _Fexponent    = static_cast<_类型>(_Exponent);
            return (_Real_shifted + _Fexponent * _Cl) + _Fexponent * _Cm;
        }
    }
