template <class _类型>
class _复数特征 {
public:
    static constexpr _类型 _浮点最小增量() { // get epsilon
        return numeric_limits<_类型>::epsilon();
    }

    static constexpr _类型 _浮点最大值() {
        return (numeric_limits<_类型>::max)();
    }

    static constexpr _类型 _浮点规格化最小值() {
        return (numeric_limits<_类型>::min)() > 0 ? (numeric_limits<_类型>::min)() : 0;
    }

    static _类型 _取模(_类型 _Left) {
        return static_cast<_类型>(_符号位(_Left) ? -_Left : _Left);
    }

    static _类型 _Cosh(_类型 _Left, _类型 _Right) { // return 双曲余弦(_Left) * _Right
        return static_cast<_类型>(_CSTD _Cosh(static_cast<double>(_Left), static_cast<double>(_Right)));
    }

    static _类型 _复制符号(_类型 _Magnitude, _类型 _Sign) {
        return static_cast<_类型>(_符号位(_Sign) ? -_取模(_Magnitude) : _取模(_Magnitude));
    }

    static short _Exp(_类型* _Pleft, _类型 _Right, short _Exponent) { // compute exp(*_Pleft) * _Right * 2 ^ _Exponent
        double _临时 = static_cast<double>(*_Pleft);
        short _Ans  = _CSTD _Exp(&_临时, static_cast<double>(_Right), _Exponent);
        *_Pleft     = static_cast<_类型>(_临时);
        return _Ans;
    }

    static constexpr _类型 _无穷值() { // return infinity
        return numeric_limits<_类型>::infinity();
    }

    static bool _是无穷(_类型 _Left) { // test for infinity
        const auto _临时  = static_cast<double>(_Left);
        const auto _Uint = _Bit_cast<uint64_t>(_临时);
        return (_Uint & 0x7fffffffffffffffU) == 0x7ff0000000000000U;
    }

    static _CONSTEXPR20 bool _是非数值(_类型 _Left) {
        const auto _临时  = static_cast<double>(_Left);
        const auto _Uint = _Bit_cast<uint64_t>(_临时);
        return (_Uint & 0x7fffffffffffffffU) > 0x7ff0000000000000U;
    }

    static constexpr _类型 _非数值() { // return NaN
        return numeric_limits<_类型>::quiet_NaN();
    }

    static bool _符号位(_类型 _Left) {
        return (_STD signbit)(static_cast<double>(_Left));
    }

    static _类型 _Sinh(_类型 _Left, _类型 _Right) { // return 双曲正弦(_Left) * _Right
        return static_cast<_类型>(_CSTD _Sinh(static_cast<double>(_Left), static_cast<double>(_Right)));
    }

    static _类型 反双曲正弦(_类型 _Left) {
        if (_Left == 0 || _是非数值(_Left) || _是无穷(_Left)) {
            return _Left;
        }

        constexpr _类型 _Ln2 = 0.69314718055994530941723212145817658L;

        const _类型 _Old_left = _Left;
        _类型 _Ans;

        _Left = _取模(_Left);

        if (_Left < 2 / _浮点最小增量()) {
            _Ans = _对数一加(_Left + _Left * _Left / (1 + sqrt(_Left * _Left + 1)));
        } else {
            _Ans = log(_Left) + _Ln2;
        }

        return _复制符号(_Ans, _Old_left);
    }

    static _类型 atan2(_类型 _Yval, _类型 _Xval) { // return 反正切(_Yval / _Xval)
        return static_cast<_类型>(_CSTD atan2(static_cast<double>(_Yval), static_cast<double>(_Xval)));
    }

    static _类型 cos(_类型 _Left) {
        return static_cast<_类型>(_CSTD cos(static_cast<double>(_Left)));
    }

    static _类型 exp(_类型 _Left) {
        return static_cast<_类型>(_CSTD exp(static_cast<double>(_Left)));
    }

    static _类型 ldexp(_类型 _Left, int _Exponent) { // return _Left * 2 ^ _Exponent
        return static_cast<_类型>(_CSTD ldexp(static_cast<double>(_Left), _Exponent));
    }

    static _类型 log(_类型 _Left) {
        return static_cast<_类型>(_CSTD log(static_cast<double>(_Left)));
    }

    static _类型 _对数一加(_类型 _Left) { // return log(1 + _Left)
        if (_Left < -1) {
            return _非数值();
        } else if (_Left == 0) {
            return _Left;
        } else { // compute log(1 + _Left) with fixup for small _Left
            _类型 _Leftp1 = 1 + _Left;
            return log(_Leftp1) - ((_Leftp1 - 1) - _Left) / _Leftp1;
        }
    }

    static _类型 pow(_类型 _Left, _类型 _Right) {
        return static_cast<_类型>(_CSTD pow(static_cast<double>(_Left), static_cast<double>(_Right)));
    }

    static _类型 sin(_类型 _Left) {
        return static_cast<_类型>(_CSTD sin(static_cast<double>(_Left)));
    }

    static _类型 sqrt(_类型 _Left) {
        return static_cast<_类型>(_CSTD sqrt(static_cast<double>(_Left)));
    }

    static _类型 tan(_类型 _Left) {
        return static_cast<_类型>(_CSTD tan(static_cast<double>(_Left)));
    }

    static _类型 hypot(_类型 _Left, _类型 _Right) {
        return static_cast<_类型>(_CSTD hypot(static_cast<double>(_Left), static_cast<double>(_Right)));
    }
};

template <>
class _复数特征<long double> {
public:
    using _类型 = long double;

    static constexpr _类型 _浮点最小增量() noexcept { // get epsilon
        return numeric_limits<long double>::epsilon();
    }

    static constexpr _类型 _浮点最大值() noexcept {
        return (numeric_limits<long double>::max)();
    }

    static constexpr _类型 _浮点规格化最小值() noexcept {
        return (numeric_limits<long double>::min)();
    }

    static _类型 _取模(_类型 _Left) noexcept {
        // testing _Left < 0 would be incorrect when _Left is -0.0
        return _CSTD fabsl(_Left);
    }

    static _类型 _Cosh(_类型 _Left, _类型 _Right) noexcept { // return 双曲余弦(_Left) * _Right
        return _CSTD _LCosh(_Left, _Right);
    }

