        if (0 <= 实部(_Left)) {
            return 复数实现<_类型>(_Rho, 虚部(_Left) / (2 * _Rho));
        } else {
            return 复数实现<_类型>(
                _复数特征<_类型>::_取模(虚部(_Left) / (2 * _Rho)), _复数特征<_类型>::_复制符号(_Rho, 虚部(_Left)));
        }
    }
