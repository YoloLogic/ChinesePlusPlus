        const auto _Off = static_cast<size_type>(_Where - 开始());

#if _ITERATOR_DEBUG_LEVEL == 2
        _STL_VERIFY(_Off <= _我的尺寸(), "双端队列实现 就地构造 iterator outside range");
#endif // _ITERATOR_DEBUG_LEVEL == 2

        _孤儿化全部();
        if (_Off == 0) { // 取值 the beginning
            _首部就地构造内部(_STD forward<_值参数类型>(_Val)...);
        } else if (_Off == _我的尺寸()) { // 取值 the 结束
            _尾部就地构造内部(_STD forward<_值参数类型>(_Val)...);
        } else {
            _分配器临时对象2<_分配器类型> _Obj(_取分配器(), _STD forward<_值参数类型>(_Val)...); // handle aliasing

            if (_Off <= _我的尺寸() / 2) { // closer to 前
                _首部就地构造内部(_STD move(*_非检查开始()));

                auto _Moving_dst       = _下一迭代器(_非检查开始());
                auto _Moving_src_begin = _下一迭代器(_Moving_dst);
                auto _Moving_src_end   = _Moving_dst + static_cast<difference_type>(_Off);

                auto _Moving_dst_end = _移动非检查(_Moving_src_begin, _Moving_src_end, _Moving_dst);
                *_Moving_dst_end     = _STD move(_Obj._取值());
            } else { // closer to 后
                _尾部就地构造内部(_STD move(*_上一迭代器(_非检查结束())));

                auto _Moving_dst_end   = _上一迭代器(_非检查结束());
                auto _Moving_src_end   = _上一迭代器(_Moving_dst_end);
                auto _Moving_src_begin = _非检查开始() + static_cast<difference_type>(_Off);

                _向后移动非检查(_Moving_src_begin, _Moving_src_end, _Moving_dst_end);
                *_Moving_src_begin = _STD move(_Obj._取值());
            }
        }

        return 开始() + static_cast<difference_type>(_Off);
    }

