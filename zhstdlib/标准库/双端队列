    iterator 擦除(const_iterator _First_arg, const_iterator _Last_arg)
        noexcept(is_nothrow_move_assignable_v<value_type>) /* strengthened */ {
        iterator _首个 = _造迭代器(_First_arg);
        iterator _最后  = _造迭代器(_Last_arg);

#if _ITERATOR_DEBUG_LEVEL == 2
        _STL_VERIFY(_首个 <= _最后 && 开始() <= _首个 && _最后 <= 结束(), "双端队列实现 擦除 iterator outside range");
        _ADL校验范围(_首个, _最后);
#endif

        auto _Off   = static_cast<size_type>(_首个 - 开始());
        auto _Count = static_cast<size_type>(_最后 - _首个);

#if _ITERATOR_DEBUG_LEVEL == 2
        const bool _Moved = _Off > 0 && _Off + _Count < _我的尺寸();
#endif

        if (_Count == 0) {
            return _首个;
        }

        auto _Unchecked_first = _首个._解包();
        auto _Unchecked_last  = _最后._解包();

        if (_Off < static_cast<size_type>(_非检查结束() - _Unchecked_last)) { // closer to 前
            _STD move_backward(_非检查开始(), _Unchecked_first, _Unchecked_last); // copy over hole
            for (; _Count > 0; --_Count) {
                头删(); // pop copied elements
            }
        } else { // closer to 后
            _STD move(_Unchecked_last, _非检查结束(), _Unchecked_first); // copy over hole
            for (; _Count > 0; --_Count) {
                尾删(); // pop copied elements
            }
        }

#if _ITERATOR_DEBUG_LEVEL == 2
        if (_Moved) {
            _孤儿化全部();
        }
#endif // _ITERATOR_DEBUG_LEVEL == 2

        return 开始() + static_cast<difference_type>(_Off);
    }

