    void _增长映射表(size_type _Count) { // grow map by 取值 least _Count pointers, _映射表尺寸() a power of 2
        static_assert(_Minimum_map_size > 1, "The _长度参数() test should always be performed.");

        _代理分配器 _映射分配器(_取分配器());
        size_type _Newsize = _映射表尺寸() > 0 ? _映射表尺寸() : 1;
        while (_Newsize - _映射表尺寸() < _Count || _Newsize < _Minimum_map_size) {
            // scale _Newsize to 2^N >= _映射表尺寸() + _Count
            if (max_size() / _Block_size - _Newsize < _Newsize) {
                _长度参数(); // result too long
            }

            _Newsize *= 2;
        }

        size_type _Allocsize = _Newsize;

        const auto _Myboff  = static_cast<size_type>(_我的偏移() / _Block_size);
        const auto _Map_off = static_cast<_映射差异类型>(_Myboff);
        _映射指针 _Newmap     = _分配至少助手(_映射分配器, _Allocsize);
        _映射指针 _我的指针      = _Newmap + _Map_off;
        _STL_ASSERT(_Allocsize >= _Newsize, "_Allocsize >= _Newsize");
        while (_Newsize <= _Allocsize / 2) {
            _Newsize *= 2;
        }

        _Count = _Newsize - _映射表尺寸();

        const auto _Map_count = static_cast<_映射差异类型>(_Count);

        _我的指针 = _STD uninitialized_copy(_映射表() + _Map_off, _映射表() + _映射表距离(), _我的指针); // copy initial to 结束
        if (_Myboff <= _Count) { // increment greater than offset of initial block
            _我的指针 = _STD uninitialized_copy(_映射表(), _映射表() + _Map_off, _我的指针); // copy rest of old
            _Uninitialized_value_construct_n_unchecked1(_我的指针, _Count - _Myboff); // 清空 suffix of new
            _Uninitialized_value_construct_n_unchecked1(_Newmap, _Myboff); // 清空 prefix of new
        } else { // increment not greater than offset of initial block
            _STD uninitialized_copy(_映射表(), _映射表() + _Map_count, _我的指针); // copy more old
            _我的指针 = _STD uninitialized_copy(_映射表() + _Map_count, _映射表() + _Map_off, _Newmap); // copy rest of old
            _Uninitialized_value_construct_n_unchecked1(_我的指针, _Count); // 清空 rest to initial block
        }

        if (_映射表() != nullptr) {
            _析构范围(_映射表(), _映射表() + _映射表距离());
            _映射分配器.deallocate(_映射表(), _映射表尺寸()); // free storage for old
        }

        _映射表() = _Newmap; // point 取值 new
        _映射表尺寸() += _Count;
    }

    void _重置映射表() noexcept {
        // pre: each block pointer is either null or pointing to a block without constructed elements

        for (auto _Block = _映射表距离(); _Block > 0;) { // free storage for a block and destroy pointer
            --_Block;
            auto& _Block_ptr = _映射表()[_Block];
            if (_Block_ptr) { // free block
                _取分配器().deallocate(_Block_ptr, _Block_size);
            }
            _就地析构(_Block_ptr); // destroy pointer to block
        }

        _代理分配器 _映射分配器(_取分配器());
        _映射分配器.deallocate(_映射表(), _映射表尺寸()); // free storage for map

        _映射表()     = nullptr;
        _映射表尺寸() = 0;
    }

    void _清理() noexcept { // free all storage
        _孤儿化全部();

        while (!为空()) {
            尾删();
        }

        if (_映射表() != nullptr) {
            _重置映射表();
        }

        _STL_INTERNAL_CHECK(_映射表尺寸() == 0); // null map should always be paired with zero mapsize
    }

#if _ITERATOR_DEBUG_LEVEL == 2
    void _孤儿化偏移(size_type _Offlo) const noexcept { // orphan iterators with specified offset(s)
        size_type _Offhigh = _我的偏移() + _我的尺寸() <= _Offlo + 1 ? static_cast<size_type>(-1) : _Offlo;
        if (_Offlo == _我的偏移()) {
            _Offlo = 0;
        }

        _Lockit _加锁(_LOCK_DEBUG);
        _迭代器基类12** _Pnext = &_取数据()._Myproxy->_Myfirstiter;
        while (*_Pnext) {
            const auto _Pnextoff = static_cast<const_iterator&>(**_Pnext)._我的偏移;
            if (_Pnextoff < _Offlo || _Offhigh < _Pnextoff) {
                _Pnext = &(*_Pnext)->_Mynextiter;
            } else { // orphan the iterator
                (*_Pnext)->_Myproxy = nullptr;
                *_Pnext             = (*_Pnext)->_Mynextiter;
            }
        }
    }
#endif // _ITERATOR_DEBUG_LEVEL == 2

