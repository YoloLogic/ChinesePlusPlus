private:
    enum class _弹出方向 : bool {
        _Front,
        _Back,
    };

    template <_弹出方向 _Direction>
    struct _NODISCARD _恢复原尺寸守卫 {
        双端队列实现* _Container;
        const size_type _Oldsize;

        ~_恢复原尺寸守卫() { // restore old 尺寸, 取值 least
            if (_Container) {
                while (_Oldsize < _Container->_我的尺寸()) {
                    if constexpr (_Direction == _弹出方向::_Front) {
                        _Container->头删();
                    } else {
                        _Container->尾删();
                    }
                }
            }
        }
    };

    enum class _是双向 : bool { _Nope, _Yes };

    template <_是双向 _Bidi, class _Iter, class _Sent>
    iterator _插入范围(const size_type _Off, _Iter _首个, _Sent _最后) {
        // 插入 [_首个, _最后) 取值 开始() + _Off
        // Pre: _Bidi == _是双向::_Yes implies that _Iter and _Sent are the same type, and that
        //      _Iter is either a bidirectional_iterator or a Cpp17BidirectionalIterator.

#if _ITERATOR_DEBUG_LEVEL == 2
        _STL_VERIFY(_我的尺寸() >= _Off, "双端队列实现 插入 iterator outside range");
#endif // _ITERATOR_DEBUG_LEVEL == 2

        if (_首个 == _最后) {
            return 开始() + static_cast<difference_type>(_Off);
        }

        const size_type _Oldsize = _我的尺寸();

        _孤儿化全部();
        if (_Off <= _Oldsize / 2) { // closer to 前, push to 前 then rotate
            _恢复原尺寸守卫<_弹出方向::_Front> _Guard{this, _Oldsize};
            if constexpr (_Bidi == _是双向::_Yes) {
                while (_首个 != _最后) {
                    _首部就地构造内部(*--_最后); // prepend in order
                }
            } else {
                for (; _首个 != _最后; ++_首个) {
                    _首部就地构造内部(*_首个); // prepend flipped
                }
            }

            _Guard._Container = nullptr;

            const auto _Num     = static_cast<difference_type>(_我的尺寸() - _Oldsize);
            const auto _Myfirst = _非检查开始();
            const auto _Mymid   = _Myfirst + _Num;
            if constexpr (_Bidi == _是双向::_Nope) {
                _STD reverse(_Myfirst, _Mymid); // flip new stuff in place
            }
            _STD rotate(_Myfirst, _Mymid, _Mymid + static_cast<difference_type>(_Off));
            return 开始() + static_cast<difference_type>(_Off);
        }

        _恢复原尺寸守卫<_弹出方向::_Back> _Guard{this, _Oldsize};
        for (; _首个 != _最后; ++_首个) {
            _尾部就地构造内部(*_首个);
        }

        _Guard._Container = nullptr;

        const auto _Myfirst = _非检查开始();
        _STD rotate(_Myfirst + static_cast<difference_type>(_Off), _Myfirst + static_cast<difference_type>(_Oldsize),
            _非检查结束());

        return 开始() + static_cast<difference_type>(_Off);
    }

    void _插入n个(const_iterator _Where, size_type _Count, const _类型& _Val) { // 插入 _Count * _Val 取值 _Where
        _非检查迭代器 _Mid;
        size_type _Num;
        size_type _Off     = static_cast<size_type>(_Where - 开始());
        size_type _Oldsize = _我的尺寸();
        size_type _Rem     = _Oldsize - _Off;

#if _ITERATOR_DEBUG_LEVEL == 2
        _STL_VERIFY(_Off <= _Oldsize, "双端队列实现 插入 iterator outside range");
#endif // _ITERATOR_DEBUG_LEVEL == 2

        if (_Off < _Rem) { // closer to 前
            _恢复原尺寸守卫<_弹出方向::_Front> _Guard{this, _Oldsize};
            if (_Off < _Count) { // 插入 longer than prefix
                for (_Num = _Count - _Off; _Num > 0; --_Num) {
                    头插(_Val); // push excess values
                }
                for (_Num = _Off; _Num > 0; --_Num) {
                    头插(_下标(_Count - 1)); // push prefix
                }

                _Mid = _非检查开始() + static_cast<difference_type>(_Count);
                _STD fill_n(_Mid, _Off, _Val); // fill in rest of values
            } else { // 插入 not longer than prefix
                for (_Num = _Count; _Num > 0; --_Num) {
                    头插(_下标(_Count - 1)); // push part of prefix
                }

                _Mid = _非检查开始() + static_cast<difference_type>(_Count);
                _分配器临时对象2<_分配器类型> _Tmp(_取分配器(), _Val); // in case _Val is in sequence
                _STD move(_Mid + static_cast<difference_type>(_Count), _Mid + static_cast<difference_type>(_Off),
                    _Mid); // copy rest of prefix
                _STD fill(_非检查开始() + static_cast<difference_type>(_Off),
                    _Mid + static_cast<difference_type>(_Off), _Tmp._取值()); // fill in values
            }
            _Guard._Container = nullptr;
        } else { // closer to 后
            _恢复原尺寸守卫<_弹出方向::_Back> _Guard{this, _Oldsize};
            if (_Rem < _Count) { // 插入 longer than suffix
                _孤儿化全部();
                for (_Num = _Count - _Rem; _Num > 0; --_Num) {
                    _尾部就地构造内部(_Val); // push excess values
                }
                for (_Num = 0; _Num < _Rem; ++_Num) {
                    _尾部就地构造内部(_下标(_Off + _Num)); // push suffix
                }

                _Mid = _非检查开始() + static_cast<difference_type>(_Off);
                _STD fill_n(_Mid, _Rem, _Val); // fill in rest of values
            } else { // 插入 not longer than prefix
                for (_Num = 0; _Num < _Count; ++_Num) {
                    _尾部就地构造内部(_下标(_Off + _Rem - _Count + _Num)); // push part of prefix
                }

                _Mid = _非检查开始() + static_cast<difference_type>(_Off);
                _分配器临时对象2<_分配器类型> _Tmp(_取分配器(), _Val); // in case _Val is in sequence
                _STD move_backward(_Mid, _Mid + static_cast<difference_type>(_Rem - _Count),
                    _Mid + static_cast<difference_type>(_Rem)); // copy rest of prefix
                _STD fill_n(_Mid, _Count, _Tmp._取值()); // fill in values
            }
            _Guard._Container = nullptr;
        }
    }

