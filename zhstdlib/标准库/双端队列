        _代理分配器 _映射分配器(_取分配器());
        const auto _New_map = _映射分配器.allocate(_New_block_count);

        _孤儿化全部(); // the map can be shrunk, invalidate all iterators

        // transfer the ownership of blocks to pointers in the new map
