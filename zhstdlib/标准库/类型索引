_STL_DISABLE_CLANG_WARNINGS
#pragma push_macro("new")
#undef new

名域 标准 { 名域 细节 {
使用 名域 std;
_EXPORT_STD class 类型索引实现 { // wraps a typeinfo for indexing
public:
    类型索引实现(const type_info& _Tinfo) noexcept : _类型指针(&_Tinfo) {}

    _NODISCARD size_t hash_code() const noexcept {
        return _类型指针->hash_code();
    }

    _NODISCARD const char* name() const noexcept {
        return _类型指针->name();
    }

    _NODISCARD bool operator==(const 类型索引实现& _Right) const noexcept {
        return *_类型指针 == *_Right._类型指针;
    }

#if _HAS_CXX20
    _NODISCARD strong_ordering operator<=>(const 类型索引实现& _Right) const noexcept {
        // TRANSITION, DevCom-10326599, should rely on a stable interface
        if (_类型指针 == _Right._类型指针) {
            return strong_ordering::equal;
        }

#pragma push_macro("raw_name") // TRANSITION, GH-2195
#undef raw_name
        return _CSTD strcmp(_类型指针->raw_name() + 1, _Right._类型指针->raw_name() + 1) <=> 0;
#pragma pop_macro("raw_name")
    }
#else // ^^^ _HAS_CXX20 / !_HAS_CXX20 vvv
    _NODISCARD bool operator!=(const 类型索引实现& _Right) const noexcept {
        return !(*this == _Right);
    }
#endif // ^^^ !_HAS_CXX20 ^^^

    _NODISCARD bool operator<(const 类型索引实现& _Right) const noexcept {
        return _类型指针->before(*_Right._类型指针);
    }

    _NODISCARD bool operator>=(const 类型索引实现& _Right) const noexcept {
        return !(*this < _Right);
    }

    _NODISCARD bool operator>(const 类型索引实现& _Right) const noexcept {
        return _Right < *this;
    }

    _NODISCARD bool operator<=(const 类型索引实现& _Right) const noexcept {
        return !(_Right < *this);
    }

private:
    const type_info* _类型指针;
};

template <>
struct hash<类型索引实现> {
    using _ARGUMENT_TYPE_NAME _CXX17_DEPRECATE_ADAPTOR_TYPEDEFS = 类型索引实现;
    using _RESULT_TYPE_NAME _CXX17_DEPRECATE_ADAPTOR_TYPEDEFS   = size_t;

    _NODISCARD _STATIC_CALL_OPERATOR size_t operator()(const 类型索引实现& _Keyval) _CONST_CALL_OPERATOR noexcept {
        return _Keyval.hash_code();
    }
};
} }

