template <class _Base>
struct _非平凡复制 : _Base { // non-trivial copy construction facade
    using _Base::_Base;

    _非平凡复制() = default;
    _CONSTEXPR20 _非平凡复制(const _非平凡复制& _That)
        noexcept(noexcept(_Base::_由之构造(static_cast<const _Base&>(_That)))) {
        _Base::_由之构造(static_cast<const _Base&>(_That));
    }
    _非平凡复制(_非平凡复制&&)                 = default;
    _非平凡复制& operator=(const _非平凡复制&) = default;
    _非平凡复制& operator=(_非平凡复制&&)      = default;
};

template <class _Base>
struct _删除复制 : _Base { // deleted copy construction facade
    using _Base::_Base;

    _删除复制()                                = default;
    _删除复制(const _删除复制&)            = delete;
    _删除复制(_删除复制&&)                 = default;
    _删除复制& operator=(const _删除复制&) = default;
    _删除复制& operator=(_删除复制&&)      = default;
};

template <class _Base, class... _Types>
using _特殊成员控制复制 = conditional_t<conjunction_v<is_trivially_copy_constructible<_Types>...>, _Base,
    conditional_t<conjunction_v<is_copy_constructible<_Types>...>, _非平凡复制<_Base>, _删除复制<_Base>>>;

template <class _Base, class... _Types>
struct _非平凡移动 : _特殊成员控制复制<_Base, _Types...> { // non-trivial move construction facade
    using _我的基类 = _特殊成员控制复制<_Base, _Types...>;
    using _我的基类::_我的基类;

    _非平凡移动()                         = default;
    _非平凡移动(const _非平凡移动&) = default;
    _CONSTEXPR20 _非平凡移动(_非平凡移动&& _That)
        noexcept(noexcept(_我的基类::_由之构造(static_cast<_Base&&>(_That)))) {
        _我的基类::_由之构造(static_cast<_Base&&>(_That));
    }
    _非平凡移动& operator=(const _非平凡移动&) = default;
    _非平凡移动& operator=(_非平凡移动&&)      = default;
};

template <class _Base, class... _Types>
struct _删除移动 : _特殊成员控制复制<_Base, _Types...> { // deleted move construction facade
    using _我的基类 = _特殊成员控制复制<_Base, _Types...>;
    using _我的基类::_我的基类;

    _删除移动()                                = default;
    _删除移动(const _删除移动&)            = default;
    _删除移动(_删除移动&&)                 = delete;
    _删除移动& operator=(const _删除移动&) = default;
    _删除移动& operator=(_删除移动&&)      = default;
};

template <class _Base, class... _Types>
using _特殊成员控制移动 =
    conditional_t<conjunction_v<is_trivially_move_constructible<_Types>...>, _特殊成员控制复制<_Base, _Types...>,
        conditional_t<conjunction_v<is_move_constructible<_Types>...>, _非平凡移动<_Base, _Types...>,
            _删除移动<_Base, _Types...>>>;

template <class _Base, class... _Types>
struct _非平凡复制赋值 : _特殊成员控制移动<_Base, _Types...> { // non-trivial copy assignment facade
    using _我的基类 = _特殊成员控制移动<_Base, _Types...>;
    using _我的基类::_我的基类;

    _非平凡复制赋值()                                = default;
    _非平凡复制赋值(const _非平凡复制赋值&) = default;
    _非平凡复制赋值(_非平凡复制赋值&&)      = default;

    _CONSTEXPR20 _非平凡复制赋值& operator=(const _非平凡复制赋值& _That)
        noexcept(noexcept(_我的基类::_由之赋值(static_cast<const _Base&>(_That)))) {
        _我的基类::_由之赋值(static_cast<const _Base&>(_That));
        return *this;
    }
    _非平凡复制赋值& operator=(_非平凡复制赋值&&) = default;
};

template <class _Base, class... _Types>
struct _删除复制赋值 : _特殊成员控制移动<_Base, _Types...> { // deleted copy assignment facade
    using _我的基类 = _特殊成员控制移动<_Base, _Types...>;
    using _我的基类::_我的基类;

    _删除复制赋值()                                       = default;
    _删除复制赋值(const _删除复制赋值&)            = default;
    _删除复制赋值(_删除复制赋值&&)                 = default;
    _删除复制赋值& operator=(const _删除复制赋值&) = delete;
    _删除复制赋值& operator=(_删除复制赋值&&)      = default;
};

template <class _Base, class... _Types>
using _特殊成员控制复制赋值 =
    conditional_t<conjunction_v<is_trivially_destructible<_Types>..., is_trivially_copy_constructible<_Types>...,
                      is_trivially_copy_assignable<_Types>...>,
        _特殊成员控制移动<_Base, _Types...>,
        conditional_t<conjunction_v<is_copy_constructible<_Types>..., is_copy_assignable<_Types>...>,
            _非平凡复制赋值<_Base, _Types...>, _删除复制赋值<_Base, _Types...>>>;

template <class _Base, class... _Types>
struct _非平凡移动赋值 : _特殊成员控制复制赋值<_Base, _Types...> { // non-trivial move assignment facade
    using _我的基类 = _特殊成员控制复制赋值<_Base, _Types...>;
    using _我的基类::_我的基类;

    _非平凡移动赋值()                                           = default;
    _非平凡移动赋值(const _非平凡移动赋值&)            = default;
    _非平凡移动赋值(_非平凡移动赋值&&)                 = default;
    _非平凡移动赋值& operator=(const _非平凡移动赋值&) = default;

    _CONSTEXPR20 _非平凡移动赋值& operator=(_非平凡移动赋值&& _That)
        noexcept(noexcept(_我的基类::_由之赋值(static_cast<_Base&&>(_That)))) {
        _我的基类::_由之赋值(static_cast<_Base&&>(_That));
        return *this;
    }
};

template <class _Base, class... _Types>
struct _删除移动赋值 : _特殊成员控制复制赋值<_Base, _Types...> { // deleted move assignment facade
    using _我的基类 = _特殊成员控制复制赋值<_Base, _Types...>;
    using _我的基类::_我的基类;

    _删除移动赋值()                                       = default;
    _删除移动赋值(const _删除移动赋值&)            = default;
    _删除移动赋值(_删除移动赋值&&)                 = default;
    _删除移动赋值& operator=(const _删除移动赋值&) = default;
    _删除移动赋值& operator=(_删除移动赋值&&)      = delete;
};

template <class _Base, class... _Types>
using _特殊成员控制移动赋值 =
    conditional_t<conjunction_v<is_trivially_destructible<_Types>..., is_trivially_move_constructible<_Types>...,
                      is_trivially_move_assignable<_Types>...>,
        _特殊成员控制复制赋值<_Base, _Types...>,
        conditional_t<conjunction_v<is_move_constructible<_Types>..., is_move_assignable<_Types>...>,
            _非平凡移动赋值<_Base, _Types...>, _删除移动赋值<_Base, _Types...>>>;

template <class _Base, class... _Types>
using _特殊成员控制 = _特殊成员控制移动赋值<_Base, _Types...>;

