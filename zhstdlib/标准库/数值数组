#pragma pack(pop)
#endif // _STL_COMPILER_PREPROCESSOR
// [ZH-DERIVE-LAYER] 汉语派生层（英文兼容层）从这一行开始 —— 本行【以上】属抄来那层，有英文名就是欠账
// ============================================================================
//  第二层：在【中文的基础上】派生，把英文原名补回来
//  · 第一层 标准::细节::数值数组实现 是抄自微软的中文实现，成员名全中文
//  · 本层加回英文原名，所以两种名字在【同一个对象】上都能用
//  · 与微软的原类型并存：它是【另一个类型】，不碰 std 里的定义
// ============================================================================
名域 标准 {
模板 <类型名 元素>
类型 数值数组 : 公开 细节::数值数组实现<元素> {
公开:
    使用 基类 = 细节::数值数组实现<元素>;
    使用 基类::基类;

    // 嵌套类型名也要补回英文（数据成员不行 —— 那会改布局）


    // 英文原名，一模板转发回中文名（不需要写签名，重载也自动跟过去）
    模板 <类型名... 参数> 声明类型(自动) size(参数&&... 值) { 返回 基类::尺寸(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) size(参数&&... 值) 常量 { 返回 基类::尺寸(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) sum(参数&&... 值) { 返回 基类::求和(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) sum(参数&&... 值) 常量 { 返回 基类::求和(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) min(参数&&... 值) { 返回 基类::最小(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) min(参数&&... 值) 常量 { 返回 基类::最小(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) max(参数&&... 值) { 返回 基类::最大(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) max(参数&&... 值) 常量 { 返回 基类::最大(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) shift(参数&&... 值) { 返回 基类::移位(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) shift(参数&&... 值) 常量 { 返回 基类::移位(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) cshift(参数&&... 值) { 返回 基类::循环移位(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) cshift(参数&&... 值) 常量 { 返回 基类::循环移位(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) apply(参数&&... 值) { 返回 基类::应用(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) apply(参数&&... 值) 常量 { 返回 基类::应用(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) resize(参数&&... 值) { 返回 基类::调整尺寸(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) resize(参数&&... 值) 常量 { 返回 基类::调整尺寸(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) begin(参数&&... 值) { 返回 基类::开始(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) begin(参数&&... 值) 常量 { 返回 基类::开始(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) end(参数&&... 值) { 返回 基类::结束(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) end(参数&&... 值) 常量 { 返回 基类::结束(static_cast<参数&&>(值)...); }

    // 表里给的额外成员（deriveExtra）—— 【中文】转发，用来给"继承自借用基类"的
    // API 补中文名（那些名字不在本文件里，members 表改不到，见方案 §3.16）
    // §17.19.3：shift / cshift / apply / operator+ 按值返回【实现类型】，必须有转发构造。
    模板 <类型名 源> 数值数组(常量 源& 值) : 基类(值) {}
};
}
名域 标准 {

// 辅助类：描述符 / 代理，身份不参与语义 -> 用别名公开（英文用法照旧走 std）。
使用 切片         = 细节::切片;
使用 通用切片     = 细节::通用切片;
模板 <类型名 元素> 使用 切片数组     = 细节::切片数组<元素>;
模板 <类型名 元素> 使用 通用切片数组 = 细节::通用切片数组<元素>;
模板 <类型名 元素> 使用 掩码数组     = 细节::掩码数组<元素>;
模板 <类型名 元素> 使用 间接数组     = 细节::间接数组<元素>;

}  // 名域 标准

