// Optimize 向量实现<bool> lexicographical comparisons.

// There are several endianness/ordering issues to consider here.
// * Machine endianness is irrelevant. (That affects how an unsigned int is stored
//   as a sequence of bytes. While all of our supported architectures are little-endian,
//   that's irrelevant as long as we avoid reinterpreting unsigned int as a sequence of bytes.)
// * Appending bits to 向量实现<bool> eventually appends words to its underlying storage.
//   For example, vb[10] is stored within vb._我的向量[0], while vb[100] is stored within vb._我的向量[3].
//   This allows us to translate lexicographical comparisons from theoretical bits to physical words.
// * Unsigned integers are written and compared as big-endian (most significant bit first).
//   For example, 0x10u > 0x07u.
// * However, 向量实现<bool> packs bits into words as little-endian (least significant bit first).
//   For example, 向量实现<bool>{false, true, true, true} stores 0b0000'0000'0000'0000'0000'0000'0000'1110u.
// We could bit-reverse words before comparing, but we just need to find the least significant bit that differs.

template <class _Ret>
struct _位基三路比较 {
    _NODISCARD _STATIC_CALL_OPERATOR constexpr _Ret operator()(
        const _位基 _Left, const _位基 _Right) _CONST_CALL_OPERATOR noexcept {
        const _位基 _Differing_bits = _Left ^ _Right;

        if (_Differing_bits == 0) { // improves _Countr_zero codegen below
#if _HAS_CXX20
            return strong_ordering::equal;
#else // ^^^ _HAS_CXX20 / !_HAS_CXX20 vvv
            return 0;
#endif // ^^^ !_HAS_CXX20 ^^^
        }

        const int _Bit_index = _Countr_zero(_Differing_bits); // number of least significant bits that match
        _STL_INTERNAL_CHECK(_Bit_index < _VBITS); // because we return early for equality

        const _位基 _掩码 = _位基{1} << _Bit_index; // selects the least significant bit that differs

        // Instead of comparing (_Left & _掩码) to (_Right & _掩码), we know that exactly one side will be zero.
#if _HAS_CXX20
        return (_Left & _掩码) == 0 ? strong_ordering::less : strong_ordering::greater;
#else // ^^^ _HAS_CXX20 / !_HAS_CXX20 vvv
        return (_Left & _掩码) == 0 ? -1 : 1;
#endif // ^^^ !_HAS_CXX20 ^^^
    }
};

#if _HAS_CXX20
_EXPORT_STD template <class _类型, class _分配器>
_NODISCARD constexpr _Synth_three_way_result<_类型> operator<=>(
    const 向量实现<_类型, _分配器>& _Left, const 向量实现<_类型, _分配器>& _Right) {
    if constexpr (is_same_v<_类型, bool>) {
        // This optimization works because 向量实现<bool> "trims" its underlying storage by zeroing out unused bits.
        const auto _Min_word_size = (_STD min)(_Left._我的向量.尺寸(), _Right._我的向量.尺寸());
        const auto _Left_words    = _Left._我的向量._非检查开始();
        const auto _Right_words   = _Right._我的向量._非检查开始();

        using _比较器 = _位基三路比较<strong_ordering>;

        const strong_ordering _Word_comparison = _STD lexicographical_compare_three_way(
            _Left_words, _Left_words + _Min_word_size, _Right_words, _Right_words + _Min_word_size, _比较器{});

        if (_Word_comparison != 0) {
            return _Word_comparison;
        }

        return _Left.尺寸() <=> _Right.尺寸();
    } else {
        return _STD lexicographical_compare_three_way(_Left._非检查开始(), _Left._非检查结束(),
            _Right._非检查开始(), _Right._非检查结束(), _Synth_three_way{});
    }
}
#else // ^^^ _HAS_CXX20 / !_HAS_CXX20 vvv
template <class _类型, class _分配器>
_NODISCARD _CONSTEXPR20 bool operator<(const 向量实现<_类型, _分配器>& _Left, const 向量实现<_类型, _分配器>& _Right) {
    if constexpr (is_same_v<_类型, bool>) {
        // This optimization works because 向量实现<bool> "trims" its underlying storage by zeroing out unused bits.
        auto _首个 = _Left._我的向量._非检查开始();
        auto _Other = _Right._我的向量._非检查开始();

        const auto _最后 = _首个 + (_STD min)(_Left._我的向量.尺寸(), _Right._我的向量.尺寸());

        for (; _首个 != _最后; ++_首个, (void) ++_Other) {
            using _比较器        = _位基三路比较<signed char>;
            const auto _结果 = _比较器{}(*_首个, *_Other);

            if (_结果 < 0) {
                return true;
            } else if (_结果 > 0) {
                return false;
            }
        }

        return _Left.尺寸() < _Right.尺寸();
    } else {
        return _STD lexicographical_compare(
            _Left._非检查开始(), _Left._非检查结束(), _Right._非检查开始(), _Right._非检查结束());
    }
}

