// [ZH-DERIVE-LAYER] 汉语派生层（英文兼容层）从这一行开始 —— 本行【以上】属抄来那层，有英文名就是欠账
// ============================================================================
//  第二层：在【中文的基础上】派生，把英文原名补回来
//  · 第一层 标准::细节::栈实现 是抄自微软的中文实现，成员名全中文
//  · 本层加回英文原名，所以两种名字在【同一个对象】上都能用
//  · 与微软的原类型并存：它是【另一个类型】，不碰 std 里的定义
// ============================================================================
名域 标准 {
模板 <类型名 元素, 类型名 容器 = std::deque<元素>>
类型 栈 : 公开 细节::栈实现<元素, 容器> {
公开:
    使用 基类 = 细节::栈实现<元素, 容器>;
    使用 基类::基类;

    // 嵌套类型名也要补回英文（数据成员不行 —— 那会改布局）
    使用 container_type = 基类::容器类型;

    // 英文原名，一模板转发回中文名（不需要写签名，重载也自动跟过去）
    模板 <类型名... 参数> 声明类型(自动) emplace(参数&&... 值) { 返回 基类::就地构造(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) emplace(参数&&... 值) 常量 { 返回 基类::就地构造(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) empty(参数&&... 值) { 返回 基类::为空(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) empty(参数&&... 值) 常量 { 返回 基类::为空(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) pop(参数&&... 值) { 返回 基类::弹出(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) pop(参数&&... 值) 常量 { 返回 基类::弹出(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) push(参数&&... 值) { 返回 基类::压入(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) push(参数&&... 值) 常量 { 返回 基类::压入(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) push_range(参数&&... 值) { 返回 基类::范围压入(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) push_range(参数&&... 值) 常量 { 返回 基类::范围压入(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) top(参数&&... 值) { 返回 基类::栈顶(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) top(参数&&... 值) 常量 { 返回 基类::栈顶(static_cast<参数&&>(值)...); }

    // 表里给的额外成员（deriveExtra）—— 【中文】转发，用来给"继承自借用基类"的
    // API 补中文名（那些名字不在本文件里，members 表改不到，见方案 §3.16）
    模板 <类型名... 参数> 声明类型(自动) 交换(参数&&... 值) { 返回 基类::swap(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 尺寸(参数&&... 值) 常量 { 返回 基类::size(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 为空(参数&&... 值) 常量 { 返回 基类::empty(static_cast<参数&&>(值)...); }
};
