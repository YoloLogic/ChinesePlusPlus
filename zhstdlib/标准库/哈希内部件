            const bool _Update_lo  = _Bucket_lo == _Eraser._Next;
            const _结点指针 _Old_hi = _Bucket_hi;
            for (;;) { // remove elements until we hit the 结束 of the 桶
                const bool _At_bucket_back = _Eraser._Next == _Old_hi;
                _Eraser._递增已擦除();
                if (_At_bucket_back) {
