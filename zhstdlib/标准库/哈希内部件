template <class _分配器迭代器>
struct _哈希向量 {
    // TRANSITION, ABI: "vector" for ABI compatibility that doesn't call allocator::construct
    using _分配器迭代器特征    = allocator_traits<_分配器迭代器>;
    using value_type        = typename _分配器迭代器::value_type;
    using size_type         = typename _分配器迭代器特征::size_type;
    using difference_type   = typename _分配器迭代器特征::difference_type;
    using pointer           = typename _分配器迭代器特征::pointer;
    using _迭代器危险值 = _Vector_val<conditional_t<_Is_simple_alloc_v<_分配器迭代器>, _简单类型集<value_type>,
        _Vec_iter_types<value_type, size_type, difference_type, pointer, typename _分配器迭代器特征::const_pointer>>>;

    _哈希向量() : _Mypair(_先零后变参实参{}) {
        _Mypair._Myval2._Alloc_proxy(_GET_PROXY_ALLOCATOR(_分配器迭代器, _Mypair._取第一()));
    }

    template <class _Any_alloc, enable_if_t<!is_same_v<_Remove_cvref_t<_Any_alloc>, _哈希向量>, int> = 0>
    explicit _哈希向量(_Any_alloc&& _Al) noexcept
        : _Mypair(_先一后变参实参{}, _STD forward<_Any_alloc>(_Al)) { // construct 为空 vector, allocator
        _Mypair._Myval2._Alloc_proxy(_GET_PROXY_ALLOCATOR(_分配器迭代器, _Mypair._取第一()));
    }

    _哈希向量(const _哈希向量&)            = delete;
    _哈希向量& operator=(const _哈希向量&) = delete;

    _NODISCARD size_type 尺寸() const noexcept {
        return static_cast<size_type>(_Mypair._Myval2._Mylast - _Mypair._Myval2._Myfirst);
    }

    _NODISCARD size_type max_size() const noexcept {
        return (_STD min)(
            static_cast<size_type>(_STD _Max_limit<difference_type>()), _分配器迭代器特征::max_size(_Mypair._取第一()));
    }

    _NODISCARD size_type 容量() const noexcept {
        // This implementation never has 容量() differ from 尺寸(), but the previous implementation could.
        // We need to handle that situation gracefully since we may link to old code (See GH-2774).
        return static_cast<size_type>(_Mypair._Myval2._Myend - _Mypair._Myval2._Myfirst);
    }

    void _赋值扩容(const size_type _Cells, const value_type _Val) {
        // set the elements stored here to _Cells copies of _Val, leaving the value unchanged if an exception is thrown
        const auto _Oldsize = 尺寸();
        _STL_INTERNAL_CHECK(_Oldsize <= _Cells);
        auto& _Alvec = _Mypair._取第一();
        if (_Oldsize < _Cells) {
            const auto _Newvec = _Alvec.allocate(_Cells); // throws
            // nothrow hereafter
            const auto _Oldcapacity = 容量();
            if (_Oldcapacity != 0) {
                _析构范围(_Mypair._Myval2._Myfirst, _Mypair._Myval2._Mylast);
                _Alvec.deallocate(_Mypair._Myval2._Myfirst, _Oldcapacity);
            }

            _Mypair._Myval2._Myfirst = _Newvec;
            const auto _Newend       = _Newvec + _Cells;
            _Mypair._Myval2._Mylast  = _Newend;
            _Mypair._Myval2._Myend   = _Newend;
            _STD uninitialized_fill(_Newvec, _Newend, _Val);
        } else {
            _STD fill(_Mypair._Myval2._Myfirst, _Mypair._Myval2._Mylast, _Val);
        }
    }

    void _清理() noexcept {
        if (_Mypair._Myval2._Myfirst != nullptr) {
            _析构范围(_Mypair._Myval2._Myfirst, _Mypair._Myval2._Mylast);
            _Mypair._取第一().deallocate(_Mypair._Myval2._Myfirst, 容量());
            _Mypair._Myval2._Myfirst = nullptr;
            _Mypair._Myval2._Mylast  = nullptr;
            _Mypair._Myval2._Myend   = nullptr;
        }
    }

    ~_哈希向量() {
        _清理();
#if _ITERATOR_DEBUG_LEVEL != 0
        auto&& _Alproxy = _GET_PROXY_ALLOCATOR(_分配器迭代器, _Mypair._取第一());
        _删除原生内部(_Alproxy, _STD exchange(_Mypair._Myval2._Myproxy, nullptr));
#endif // _ITERATOR_DEBUG_LEVEL != 0
    }

    _压缩对<_分配器迭代器, _迭代器危险值> _Mypair;
};

template <class _特征>
class _哈希 { // hash table -- 链表实现 with vector of iterators for quick access
protected:
    using _我的链表             = 链表实现<typename _特征::value_type, typename _特征::分配器类型>;
    using _结点分配器             = typename _我的链表::_结点分配器;
    using _结点分配器特征      = typename _我的链表::_结点分配器特征;
    using _节点               = typename _我的链表::_节点;
    using _结点指针            = typename _我的链表::_结点指针;
    using _可变值类型 = typename _特征::_可变值类型;

    using _键比较器   = typename _特征::键比较器;
    using _值比较器 = typename _特征::值比较;

