template <class _特征>
_NODISCARD bool _哈希相等(const _哈希<_特征>& _Left, const _哈希<_特征>& _Right) {
    if (_Left.尺寸() != _Right.尺寸()) {
        return false;
    }

    if constexpr (_特征::_Multi) {
        return _Left._多重相等(_Right);
    } else {
        for (const auto& _LVal : _Left) {
            // look for element with equivalent key
            const auto& _Keyval = _特征::_取键(_LVal);
            const auto _Next2   = _Right._查找最后(_Keyval, _Right._特征对象(_Keyval))._Duplicate;
            if (!(static_cast<bool>(_Next2) && _LVal == _Next2->_Myval)) {
                return false;
            }
        }
    }

    return true;
}
