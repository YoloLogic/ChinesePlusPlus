protected:
    template <class _Keyty>
    _NODISCARD _哈希查找最后结果<_结点指针> _查找最后(const _Keyty& _Keyval, const size_t _Hashval) const {
        // find the insertion point for _Keyval and whether an element identical to _Keyval is already in the container
        const size_type _Bucket = _Hashval & _Mask;
        _结点指针 _Where         = _Vec._Mypair._Myval2._Myfirst[(_Bucket << 1) + 1]._Ptr;
        const _结点指针 _End     = _List._Mypair._Myval2._Myhead;
        if (_Where == _End) {
            return {_End, _结点指针{}};
        }

        const _结点指针 _Bucket_lo = _Vec._Mypair._Myval2._Myfirst[_Bucket << 1]._Ptr;
        for (;;) {
            // Search backwards to maintain sorted [_Bucket_lo, _Bucket_hi] when !_Standard
            if (!_特征对象(_Keyval, _特征::_取键(_Where->_Myval))) {
                if constexpr (!_特征::_Standard) {
                    if (_特征对象(_特征::_取键(_Where->_Myval), _Keyval)) {
                        return {_Where->_Next, _结点指针{}};
                    }
                }

                return {_Where->_Next, _Where};
            }

            if (_Where == _Bucket_lo) {
                return {_Where, _结点指针{}};
            }

            _Where = _Where->_Prev;
        }
    }

    template <class _Keyty>
    _NODISCARD _哈希查找最后结果<_结点指针> _按提示查找(
        const _结点指针 _Hint, const _Keyty& _Keyval, const size_t _Hashval) const {
        // if _Hint points to an element equivalent to _Keyval, returns _Hint; otherwise,
        // returns _查找最后(_Keyval, _Hashval)
        if (_Hint != _List._Mypair._Myval2._Myhead && !_特征对象(_特征::_取键(_Hint->_Myval), _Keyval)) {
            if constexpr (!_特征::_Standard) {
                if (_特征对象(_Keyval, _特征::_取键(_Hint->_Myval))) {
                    return _查找最后(_Keyval, _Hashval);
                }
            }

            return {_Hint->_Next, _Hint};
        }

        return _查找最后(_Keyval, _Hashval);
    }

    _结点指针 _在之前插入新节点(
        const size_t _Hashval, const _结点指针 _Insert_before, const _结点指针 _新节点) noexcept {
        const _结点指针 _插入其后 = _Insert_before->_Prev;
        ++_List._Mypair._Myval2._我的尺寸;
        _就地构造(_新节点->_Next, _Insert_before);
        _就地构造(_新节点->_Prev, _插入其后);
        _插入其后->_Next  = _新节点;
        _Insert_before->_Prev = _新节点;

        const auto _Head                = _List._Mypair._Myval2._Myhead;
        const auto _Bucket_array        = _Vec._Mypair._Myval2._Myfirst;
        const size_type _Bucket         = _Hashval & _Mask;
        _非检查迭代器& _Bucket_lo = _Bucket_array[_Bucket << 1];
        _非检查迭代器& _Bucket_hi = _Bucket_array[(_Bucket << 1) + 1];
        if (_Bucket_lo._Ptr == _Head) {
            // 桶 is 为空, set both
            _Bucket_lo._Ptr = _新节点;
            _Bucket_hi._Ptr = _新节点;
        } else if (_Bucket_lo._Ptr == _Insert_before) {
            // new node is the lowest element in the 桶
            _Bucket_lo._Ptr = _新节点;
        } else if (_Bucket_hi._Ptr == _插入其后) {
            // new node is the highest element in the 桶
            _Bucket_hi._Ptr = _新节点;
        }

#ifdef _ENABLE_STL_INTERNAL_CHECK
        _标准库内部检查容器不变式();
#endif // _ENABLE_STL_INTERNAL_CHECK
        return _新节点;
    }

    void _检查最大尺寸() const {
        const size_type _Oldsize = _List._Mypair._Myval2._我的尺寸;
        if (_Oldsize == _List.max_size()) {
            _Xlength_error("unordered_map/set too long");
        }
    }

    bool _检查需重哈希1() const noexcept {
        const size_type _Oldsize = _List._Mypair._Myval2._我的尺寸;
        const auto _Newsize      = _Oldsize + 1;
        return 最大负载因子() < static_cast<float>(_Newsize) / static_cast<float>(桶数());
    }

    void _为1重哈希() {
        const auto _Oldsize = _List._Mypair._Myval2._我的尺寸;
        const auto _Newsize = _Oldsize + 1;
        _强制重哈希(_期望扩容桶数(_Newsize));
    }

    void _擦除桶(_结点指针 _Plist, size_type _Bucket) noexcept {
        // remove the node _Plist from its 桶
        _结点指针& _Bucket_lo = _Vec._Mypair._Myval2._Myfirst[_Bucket << 1]._Ptr;
        _结点指针& _Bucket_hi = _Vec._Mypair._Myval2._Myfirst[(_Bucket << 1) + 1]._Ptr;
        if (_Bucket_hi == _Plist) {
            if (_Bucket_lo == _Plist) { // make 桶 为空
                const auto _End = _List._Mypair._Myval2._Myhead;

                _Bucket_lo = _End;
                _Bucket_hi = _End;
            } else {
                _Bucket_hi = _Plist->_Prev; // move 结束 back one element
            }
        } else if (_Bucket_lo == _Plist) {
            _Bucket_lo = _Plist->_Next; // move beginning up one element
        }
    }

    _NODISCARD size_type _最小负载因子桶数(const size_type _For_size) const noexcept {
        // returns the minimum number of buckets necessary for the elements in _List
        return static_cast<size_type>(_CSTD ceilf(static_cast<float>(_For_size) / 最大负载因子()));
    }

    _NODISCARD size_type _期望扩容桶数(const size_type _For_size) const noexcept {
        const size_type _Old_buckets = 桶数();
        const size_type _Req_buckets = (_STD max)(_Min_buckets, _最小负载因子桶数(_For_size));
        if (_Old_buckets >= _Req_buckets) {
            // we already have enough buckets so there's no need to change the 计数
            return _Old_buckets;
        }

        if (_Old_buckets < 512 && _Old_buckets * 8 >= _Req_buckets) {
            // if we are changing the 桶 计数 and have less than 512 buckets, use 8x more buckets
            return _Old_buckets * 8;
        }

        // power of 2 invariant means this will result in at least 2*_Old_buckets after round up in _强制重哈希
        return _Req_buckets;
    }

    void _用失效向量重插() { // 插入 elements in [开始(), 结束()), distrusting existing _Vec elements
        _强制重哈希(_期望扩容桶数(_List.尺寸()));
    }

    void _强制重哈希(size_type _Buckets) {
        // Force 重哈希 of elements in _List, distrusting existing 桶 assignments in _Vec.
        // Assumes _Buckets is greater than _Min_buckets, and that changing to that many buckets doesn't violate
        // 负载因子() <= 最大负载因子().

        // Don't violate power of 2, fits in half the 桶 vector invariant:
        // (we assume because vector must use single allocations; as a result, its max_size fits in a size_t)
        const unsigned long _Max_storage_buckets_log2 = _Floor_of_log_2(static_cast<size_t>(_Vec.max_size() >> 1));
        const auto _Max_storage_buckets               = static_cast<size_type>(1) << _Max_storage_buckets_log2;
        if (_Buckets > _Max_storage_buckets) {
            _Xlength_error("invalid hash 桶 计数");
        }

        // The above test also means that we won't perform a forbidden full shift when restoring the power of
        // 2 invariant
        // this round up to power of 2 in addition to the _Buckets > _Maxidx above means
        // we'll at least double in 尺寸 (the next power of 2 above _Maxidx)
        _Buckets                       = static_cast<size_type>(1) << _Ceiling_of_log_2(static_cast<size_t>(_Buckets));
        const _非检查迭代器 _End = _非检查结束();

        _Vec._赋值扩容(_Buckets << 1, _End);
        _Mask   = _Buckets - 1;
        _Maxidx = _Buckets;

        _清空守卫 _Guard{this};

        _非检查迭代器 _Inserted = _非检查开始();

        // Remember the next _Inserted value as splices will change _Inserted's position arbitrarily.
        for (_非检查迭代器 _Next_inserted = _Inserted; _Inserted != _End; _Inserted = _Next_inserted) {
            ++_Next_inserted;

            auto& _Inserted_key     = _特征::_取键(*_Inserted);
            const size_type _Bucket = 桶(_Inserted_key);

            // _Bucket_lo and _Bucket_hi are the *inclusive* range of elements in the 桶, or _非检查结束() if
            // the 桶 is 为空; if !_Standard then [_Bucket_lo, _Bucket_hi] is a sorted range.
            _非检查迭代器& _Bucket_lo = _Vec._Mypair._Myval2._Myfirst[_Bucket << 1];
            _非检查迭代器& _Bucket_hi = _Vec._Mypair._Myval2._Myfirst[(_Bucket << 1) + 1];

            if (_Bucket_lo == _End) {
                // The 桶 was 为空, set it to the inserted element.
                _Bucket_lo = _Inserted;
                _Bucket_hi = _Inserted;
                continue;
            }

            // Search the 桶 for the insertion location and move element if necessary.
            _非检查常量迭代器 _Insert_before = _Bucket_hi;
            if (!_特征对象(_Inserted_key, _特征::_取键(*_Insert_before))) {
                // The inserted element belongs at the 结束 of the 桶; splice it there and set _Bucket_hi to the
                // new 桶 inclusive 结束.
                ++_Insert_before;
                if (_Insert_before != _Inserted) { // avoid splice on element already in position
                    _我的链表::_迭代器检查值::_非检查接合(_Insert_before._Ptr, _Inserted._Ptr, _Next_inserted._Ptr);
                }

                _Bucket_hi = _Inserted;
                continue;
            }

            // The insertion point isn't *_Bucket_hi, so search [_Bucket_lo, _Bucket_hi) for insertion point; we
            // go backwards to maintain sortedness when !_Standard.
            for (;;) {
                if (_Bucket_lo == _Insert_before) {
                    // There are no equivalent keys in the 桶, so 插入 it at the beginning.
                    // Element can't be already in position here because:
                    // * (for !_Standard) _Inserted_key < *_Insert_before or
                    // * (for _Standard) _Inserted_key != *_Insert_before
                    _我的链表::_迭代器检查值::_非检查接合(_Insert_before._Ptr, _Inserted._Ptr, _Next_inserted._Ptr);
                    _Bucket_lo = _Inserted;
                    break;
                }

                if (!_特征对象(_Inserted_key, _特征::_取键(*--_Insert_before))) {
                    // Found insertion point, move the element here, 桶 bounds are already okay.
                    ++_Insert_before;
                    // Element can't be already in position here because all elements we're inserting are after all
                    // the elements already in buckets, and *_Insert_before isn't the highest element in the 桶.
                    _我的链表::_迭代器检查值::_非检查接合(_Insert_before._Ptr, _Inserted._Ptr, _Next_inserted._Ptr);
                    break;
                }
            }
        }

        _Guard._Target = nullptr;

#ifdef _ENABLE_STL_INTERNAL_CHECK
        _标准库内部检查容器不变式();
#endif // _ENABLE_STL_INTERNAL_CHECK
    }

    float& _最大桶尺寸() noexcept {
        return _特征对象._取最大桶尺寸();
    }

    const float& _最大桶尺寸() const noexcept {
        return _特征对象._取最大桶尺寸();
    }

    _结点分配器& _取分配器() noexcept {
        return _List._取分配器();
    }

    const _结点分配器& _取分配器() const noexcept {
        return _List._取分配器();
    }

    struct _多重相等检查结果 {
        bool _Equal_possible = false;
        _非检查常量迭代器 _Subsequent_first{}; // only useful if _Equal_possible
    };

    _NODISCARD _多重相等检查结果 _多重相等检查等值区间(
        const _哈希& _Right, _非检查常量迭代器 _First1) const {
        // check that an 相等区间 of elements starting with *_First1 are a permutation of the corresponding
        // 相等区间 of elements in _Right
        auto& _Keyval = _特征::_取键(*_First1);
        // find the start of the matching run in the other container
        const size_t _Hashval   = _Right._特征对象(_Keyval);
        const size_type _Bucket = _Hashval & _Right._Mask;
        auto _First2            = _Right._Vec._Mypair._Myval2._Myfirst[_Bucket << 1];
        if (_First2 == _Right._非检查结束()) {
            // no matching 桶, therefore no matching run
            return {};
        }

        const auto _Bucket_hi = _Right._Vec._Mypair._Myval2._Myfirst[(_Bucket << 1) + 1];
        for (; _Right._特征对象(_特征::_取键(*_First2), _Keyval); ++_First2) {
            // find first matching element in _Right
            if (_First2 == _Bucket_hi) {
                return {};
            }
        }

        _非检查常量迭代器 _Left_stop_at;
        if constexpr (_特征::_Standard) {
            _Left_stop_at = _非检查结束();
        } else {
            // check the first elements for equivalence when !_Standard
            if (_Right._特征对象(_Keyval, _特征::_取键(*_First2))) {
                return {};
            }

            const size_t _LHashval   = _特征对象(_Keyval);
            const size_type _LBucket = _LHashval & _Mask;
            const auto _LBucket_hi   = _Vec._Mypair._Myval2._Myfirst[(_LBucket << 1) + 1];
            _Left_stop_at            = _LBucket_hi;
            ++_Left_stop_at;
        }

        // trim matching prefixes
        while (*_First1 == *_First2) {
            // the right 相等区间 ends at the 结束 of the 桶 or on the first nonequal element
            bool _Right_range_end = _First2 == _Bucket_hi;
            ++_First2;
            if (!_Right_range_end) {
                _Right_range_end = _Right._特征对象(_Keyval, _特征::_取键(*_First2));
            }

            // the left 相等区间 ends at the 结束 of the container or on the first nonequal element
            ++_First1;
            const bool _Left_range_end = _First1 == _Left_stop_at || _特征对象(_Keyval, _特征::_取键(*_First1));

            if (_Left_range_end && _Right_range_end) {
                // the equal_ranges were completely equal
                return {true, _First1};
            }

            if (_Left_range_end || _Right_range_end) {
                // one 相等区间 is a prefix of the other; not equal
                return {};
            }
        }

        // found a mismatched element, find the 结束 of the equal_ranges and dispatch to _检查匹配计数
        auto _Last1 = _First1;
        auto _Last2 = _First2;
        for (;;) {
            bool _Right_range_end = _Last2 == _Bucket_hi;
            ++_Last2;
            if (!_Right_range_end) {
                _Right_range_end = _Right._特征对象(_Keyval, _特征::_取键(*_Last2));
            }

            ++_Last1;
            const bool _Left_range_end = _Last1 == _Left_stop_at || _特征对象(_Keyval, _特征::_取键(*_Last1));

            if (_Left_range_end && _Right_range_end) {
                // equal_ranges had the same length, check for permutation
                return {_检查匹配计数(_First1, _Last1, _First2, _Last2, equal_to<>{}), _Last1};
            }

            if (_Left_range_end || _Right_range_end) {
                // different number of elements in the range, not a permutation
                return {};
            }
        }
    }

    template <bool _Multi2 = _特征::_Multi, enable_if_t<_Multi2, int> = 0>
    _NODISCARD bool _多重相等(const _哈希& _Right) const {
        static_assert(_特征::_Multi, "This function only works with multi containers");
        _STL_INTERNAL_CHECK(this->尺寸() == _Right.尺寸());
        const auto _Last1 = _非检查结束();
        auto _First1      = _非检查开始();
        while (_First1 != _Last1) {
            const auto _结果 = _多重相等检查等值区间(_Right, _First1);
            if (!_结果._Equal_possible) {
                return false;
            }

            _First1 = _结果._Subsequent_first;
        }

        return true;
    }

#ifdef _ENABLE_STL_INTERNAL_CHECK
public:
    void _标准库内部检查容器不变式() const noexcept {
        const size_type _Vecsize = _Vec.尺寸();
        _STL_INTERNAL_CHECK(_Vec._Mypair._Myval2._Mylast == _Vec._Mypair._Myval2._Myend);
        _STL_INTERNAL_CHECK(_Vecsize >= _Min_buckets * 2);
        _STL_INTERNAL_CHECK(_Maxidx == (_Vecsize >> 1));
        _STL_INTERNAL_CHECK(_Maxidx - 1 == _Mask);
        _STL_INTERNAL_CHECK(_Maxidx >= _最小负载因子桶数(_List.尺寸()));
        // asserts that 桶 计数 is a power of 2:
        _STL_INTERNAL_CHECK((static_cast<size_type>(1) << _Floor_of_log_2(_Vecsize)) == _Vecsize);
        _STL_INTERNAL_CHECK(负载因子() <= 最大负载因子());
        // In the test that counts number of allocator copies, avoid an extra rebind that would incorrectly 计数 as
        // a copy; otherwise, allow allocators that support only homogeneous compare.
#ifdef _USE_HETEROGENEOUS_ALLOCATOR_COMPARE_IN_INTERNAL_CHECK
        _STL_INTERNAL_CHECK(_List._取分配器() == _Vec._Mypair._取第一());
#else
        _STL_INTERNAL_CHECK(static_cast<_分配器迭代器>(_List._取分配器()) == _Vec._Mypair._取第一());
#endif
#ifdef _STL_INTERNAL_CHECK_EXHAUSTIVE
        size_type _Elements = 0;
        const auto _End     = _非检查结束();
        for (size_type _Bucket = 0; _Bucket < _Maxidx; ++_Bucket) {
            _非检查常量迭代器 _Where           = _Vec._Mypair._Myval2._Myfirst[_Bucket << 1];
            const _非检查常量迭代器 _Bucket_hi = _Vec._Mypair._Myval2._Myfirst[(_Bucket << 1) + 1];
            if (_Where != _End) {
                // check that the 桶 is sorted for legacy hash_meow:
                if constexpr (!_特征::_Standard) {
                    if (_Where != _Bucket_hi) {
                        auto _SFirst = _Where;
                        auto _SNext  = _Where;
                        for (;;) {
                            ++_SNext;
                            if constexpr (_特征::_Multi) {
                                _STL_INTERNAL_CHECK(!_特征对象(_特征::_取键(*_SNext), _特征::_取键(*_SFirst)));
                            } else {
                                _STL_INTERNAL_CHECK(_特征对象(_特征::_取键(*_SFirst), _特征::_取键(*_SNext)));
                            }

                            if (_SNext == _Bucket_hi) {
                                break;
                            }

                            _SFirst = _SNext;
                        }
                    }
                }
                // check that all the elements in the 桶 belong in the 桶:
                for (;;) {
                    ++_Elements;
                    _STL_INTERNAL_CHECK(桶(_特征::_取键(*_Where)) == _Bucket);
                    if (_Where == _Bucket_hi) {
                        break;
                    }

                    ++_Where;
                }
            }
        }

        _STL_INTERNAL_CHECK(_List.尺寸() == _Elements);
#endif // _STL_INTERNAL_CHECK_EXHAUSTIVE
    }

protected:
#endif // _ENABLE_STL_INTERNAL_CHECK

    _特征 _特征对象; // traits to customize behavior
    _我的链表 _List; // 链表实现 of elements, must initialize before _Vec
    _哈希向量<_分配器迭代器> _Vec; // "vector" of 链表实现 iterators for buckets:
                             // each 桶 is 2 iterators denoting the closed range of elements in the 桶,
                             // or both iterators set to _非检查结束() if the 桶 is 为空.
    size_type _Mask; // the key mask
    size_type _Maxidx; // current maximum key value, must be a power of 2
};

