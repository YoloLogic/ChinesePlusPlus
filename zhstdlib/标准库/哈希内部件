        _Vec._赋值扩容(_Right._Vec.尺寸(), _List._非检查结束());
        _插入范围非检查(_Right._非检查开始(), _Right._非检查结束());
#ifdef _ENABLE_STL_INTERNAL_CHECK
        _标准库内部检查容器不变式();
        _Right._标准库内部检查容器不变式();
#endif // _ENABLE_STL_INTERNAL_CHECK
