    void 清空() noexcept {
        // TRANSITION, ABI:
        // LWG-2550 requires implementations to make 清空() O(尺寸()), independent of 桶数().
        // Unfortunately our current data structure / ABI does not allow achieving this in the general case because:
        //   (1) Finding the 桶 that goes with an element requires running the hash function
        //   (2) The hash function operator() may throw exceptions, and
        //   (3) 清空() is a noexcept function.
        // We do comply with LWG-2550 if the hash function is noexcept, or if the container was 为空.
        const auto _Oldsize = _List._Mypair._Myval2._我的尺寸;
        if (_Oldsize == 0) {
            return;
        }

        if constexpr (_Nothrow_hash<_特征, 键类型>) {
            // In testing, hash<size_t>{}(size_t{}) takes about 14 times as much time as assigning a pointer, or
            // ~7-8 times as much as clearing a 桶. Therefore, if we would need to assign over more than 8 times
            // as many buckets as elements, remove element-by-element.
            if (桶数() / 8 > _Oldsize) {
                const auto _Head = _List._Mypair._Myval2._Myhead;
                _非检查擦除(_Head->_Next, _Head);
                return;
            }
        }

        // Bulk destroy items and reset buckets
        _List.清空();
        _STD fill(_Vec._Mypair._Myval2._Myfirst, _Vec._Mypair._Myval2._Mylast, _非检查结束());
    }

