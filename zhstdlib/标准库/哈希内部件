        const size_t _Hashval = _特征对象(_Keyval);
        auto _Target          = _查找最后(_Keyval, _Hashval);
        if constexpr (!_特征::_Multi) {
            if (_Target._Duplicate) {
                return {_List._造迭代器(_Target._Duplicate), false, _STD move(_Handle)};
            }
        }

        _检查最大尺寸();
        if (_检查需重哈希1()) {
            _为1重哈希();
            _Target = _查找最后(_Keyval, _Hashval);
        }

        const auto _Released = _Handle._释放();
        _就地析构(_Released->_Next); // TRANSITION, ABI
        _就地析构(_Released->_Prev);
        const auto _新节点 = _在之前插入新节点(_Hashval, _Target._Insert_before, _Released);
        if constexpr (_特征::_Multi) {
            return _List._造迭代器(_新节点);
        } else {
