    using 键类型 = typename _特征::键类型;

    using value_type      = typename _我的链表::value_type;
    using 分配器类型  = typename _我的链表::分配器类型;
    using size_type       = typename _我的链表::size_type;
    using difference_type = typename _我的链表::difference_type;
    using pointer         = typename _我的链表::pointer;
    using const_pointer   = typename _我的链表::const_pointer;
    using reference       = value_type&;
