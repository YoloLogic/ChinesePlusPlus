    _哈希(_哈希&& _Right)
        : _特征对象(_Right._特征对象), _List(_移动分配器标记{}, _Right._List._取分配器()),
          _Vec(_STD move(_Right._Vec._Mypair._取第一())) {
        _Vec._赋值扩容(_Min_buckets * 2, _非检查结束());
        _List._交换值(_Right._List);
        _Vec._Mypair._Myval2._交换值(_Right._Vec._Mypair._Myval2);
        _Mask   = _STD exchange(_Right._Mask, _Min_buckets - 1);
        _Maxidx = _STD exchange(_Right._Maxidx, _Min_buckets);
