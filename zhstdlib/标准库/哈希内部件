template <class _Hasher>
concept _Hasher_for_container = !integral<_Hasher> && !_Allocator_for_container<_Hasher>;

template <class _Hasher>
using _是哈希器 = bool_constant<_Hasher_for_container<_Hasher>>;
#else // ^^^ _HAS_CXX23 / !_HAS_CXX23 vvv
template <class _Hasher>
using _是哈希器 = negation<disjunction<is_integral<_Hasher>, _Is_allocator<_Hasher>>>;
