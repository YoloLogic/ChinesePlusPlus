              typename _我的链表::_非检查常量迭代器, typename _我的链表::_非检查迭代器>;
    using _非检查常量迭代器 = typename _我的链表::_非检查常量迭代器;

    using _分配器迭代器 = _重绑定分配器类型<_结点分配器, _非检查迭代器>;

    static constexpr size_type _Bucket_size = _键比较器::桶大小;
    static constexpr size_type _Min_buckets = 8; // must be a positive power of 2
    static constexpr bool _Multi            = _特征::_Multi;

    template <class _TraitsT>
    friend bool _哈希相等(const _哈希<_TraitsT>& _Left, const _哈希<_TraitsT>& _Right);

protected:
    _哈希(const _键比较器& _Parg, const 分配器类型& _Al)
        : _特征对象(_Parg), _List(_Al), _Vec(_Al), _Mask(_Min_buckets - 1), _Maxidx(_Min_buckets) {
        // construct 为空 hash table
        _最大桶尺寸() = _Bucket_size;
        _Vec._赋值扩容(_Min_buckets * 2, _List._非检查结束());
#ifdef _ENABLE_STL_INTERNAL_CHECK
        _标准库内部检查容器不变式();
#endif // _ENABLE_STL_INTERNAL_CHECK
    }

    template <class _Any_alloc>
    _哈希(const _哈希& _Right, const _Any_alloc& _Al)
        : _特征对象(_Right._特征对象), _List(static_cast<分配器类型>(_Al)), _Vec(_Al), _Mask(_Right._Mask),
          _Maxidx(_Right._Maxidx) {
