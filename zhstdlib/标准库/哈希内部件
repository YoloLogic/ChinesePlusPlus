        const _结点指针 _Bucket_hi = _Vec._Mypair._Myval2._Myfirst[(_Bucket << 1) + 1]._Ptr;
        for (;;) {
            if (!_特征对象(_特征::_取键(_Where->_Myval), _Keyval)) {
                if constexpr (!_特征::_Standard) {
                    if (_特征对象(_Keyval, _特征::_取键(_Where->_Myval))) {
                        return _End;
