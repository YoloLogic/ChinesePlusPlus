_EXPORT_STD class 共享互斥量实现 { // class for mutual exclusion shared across threads
public:
    using native_handle_type = _Smtx_t*;

    共享互斥量实现()                               = default;
    共享互斥量实现(const 共享互斥量实现&)            = delete;
    共享互斥量实现& operator=(const 共享互斥量实现&) = delete;

    void 加锁() noexcept /* strengthened */ { // 加锁 exclusive
        _Smtx_lock_exclusive(&_Myhandle);
    }

    _NODISCARD_TRY_CHANGE_STATE bool 尝试加锁() noexcept /* strengthened */ { // try to 加锁 exclusive
        return _Smtx_try_lock_exclusive(&_Myhandle) != 0;
    }

    void 解锁() noexcept /* strengthened */ { // 解锁 exclusive
        _Smtx_unlock_exclusive(&_Myhandle);
    }

    void 共享加锁() noexcept /* strengthened */ { // 加锁 non-exclusive
        _Smtx_lock_shared(&_Myhandle);
    }

    _NODISCARD_TRY_CHANGE_STATE bool 尝试共享加锁() noexcept /* strengthened */ { // try to 加锁 non-exclusive
        return _Smtx_try_lock_shared(&_Myhandle) != 0;
    }

    void 共享解锁() noexcept /* strengthened */ { // 解锁 non-exclusive
        _Smtx_unlock_shared(&_Myhandle);
    }

    _NODISCARD native_handle_type 原生句柄() noexcept /* strengthened */ { // get native handle
        return &_Myhandle;
    }

private:
    _Smtx_t _Myhandle = nullptr;
};

_EXPORT_STD class 限时共享互斥量实现 { // class for mutual exclusion shared across threads
private:
    using _读计数类型 = unsigned int;

    static constexpr _读计数类型 _Max_readers = static_cast<_读计数类型>(-1);

public:
    限时共享互斥量实现() = default;

    限时共享互斥量实现(const 限时共享互斥量实现&)            = delete;
    限时共享互斥量实现& operator=(const 限时共享互斥量实现&) = delete;

    void 加锁() { // 加锁 exclusive
        独占锁实现<互斥量实现> _加锁(_我的互斥量);
        while (_Writing) {
            _Write_queue.wait(_加锁);
        }

        _Writing = true;
        while (0 < _Readers) {
            _Read_queue.wait(_加锁); // wait for writing, no readers
        }
    }

    _NODISCARD_TRY_CHANGE_STATE bool 尝试加锁() { // try to 加锁 exclusive
        锁守卫实现<互斥量实现> _加锁(_我的互斥量);
        if (_Writing || 0 < _Readers) {
            return false;
        } else { // set writing, no readers
            _Writing = true;
            return true;
        }
    }

    template <class _表示, class _Period>
    _NODISCARD_TRY_CHANGE_STATE bool 限时加锁(
        const chrono::duration<_表示, _Period>& _Rel_time) { // try to 加锁 for duration
        return 加锁至时刻(_To_absolute_time(_Rel_time));
    }

    template <class _Clock, class _Duration>
    _NODISCARD_TRY_CHANGE_STATE bool 加锁至时刻(const chrono::time_point<_Clock, _Duration>& _Abs_time) {
        // try to 加锁 until time point
        static_assert(chrono::_Is_clock_v<_Clock>, "Clock type required");
        auto _Not_writing  = [this] { return !_Writing; };
        auto _Zero_readers = [this] { return _Readers == 0; };
        独占锁实现<互斥量实现> _加锁(_我的互斥量);

        if (!_Write_queue.等待至时刻(_加锁, _Abs_time, _Not_writing)) {
            return false;
        }

        _Writing = true;

        if (!_Read_queue.等待至时刻(_加锁, _Abs_time, _Zero_readers)) { // timeout, leave writing state
            _Writing = false;
            _加锁.解锁(); // 解锁 before notifying, for efficiency
            _Write_queue.通知全部();
            return false;
        }

        return true;
    }

    void 解锁() { // 解锁 exclusive
        { // 解锁 before notifying, for efficiency
            锁守卫实现<互斥量实现> _加锁(_我的互斥量);

            _Writing = false;
        }

        _Write_queue.通知全部();
    }

    void 共享加锁() { // 加锁 non-exclusive
        独占锁实现<互斥量实现> _加锁(_我的互斥量);
        while (_Writing || _Readers == _Max_readers) {
            _Write_queue.wait(_加锁);
        }

        ++_Readers;
    }

    _NODISCARD_TRY_CHANGE_STATE bool 尝试共享加锁() { // try to 加锁 non-exclusive
        锁守卫实现<互斥量实现> _加锁(_我的互斥量);
        if (_Writing || _Readers == _Max_readers) {
            return false;
        } else { // count another reader
            ++_Readers;
            return true;
        }
    }

    template <class _表示, class _Period>
    _NODISCARD_TRY_CHANGE_STATE bool 限时共享加锁(const chrono::duration<_表示, _Period>& _Rel_time) {
        // try to 加锁 non-exclusive for relative time
        return 共享加锁至时刻(_To_absolute_time(_Rel_time));
    }

    template <class _Clock, class _Duration>
    _NODISCARD_TRY_CHANGE_STATE bool 共享加锁至时刻(const chrono::time_point<_Clock, _Duration>& _Abs_time) {
        // try to 加锁 non-exclusive until absolute time
        static_assert(chrono::_Is_clock_v<_Clock>, "Clock type required");
        const auto _Can_acquire = [this] { return !_Writing && _Readers < _Max_readers; };

        独占锁实现<互斥量实现> _加锁(_我的互斥量);

        if (!_Write_queue.等待至时刻(_加锁, _Abs_time, _Can_acquire)) {
            return false;
        }

        ++_Readers;
        return true;
    }

    void 共享解锁() { // 解锁 non-exclusive
        _读计数类型 _Local_readers;
        bool _Local_writing;

        { // 解锁 before notifying, for efficiency
            锁守卫实现<互斥量实现> _加锁(_我的互斥量);
            --_Readers;
            _Local_readers = _Readers;
            _Local_writing = _Writing;
        }

        if (_Local_writing && _Local_readers == 0) {
            _Read_queue.通知一个();
        } else if (!_Local_writing && _Local_readers == _Max_readers - 1) {
            _Write_queue.通知全部();
        }
    }

private:
    互斥量实现 _我的互斥量{};
    条件变量实现 _Read_queue{};
    条件变量实现 _Write_queue{};
    _读计数类型 _Readers = 0;
    bool _Writing        = false;
};

_EXPORT_STD template <class _Mutex>
class 共享锁实现 { // shareable 加锁
public:
    using 互斥量类型 = _Mutex;

    共享锁实现() noexcept = default;

    _NODISCARD_CTOR_LOCK explicit 共享锁实现(互斥量类型& _Mtx)
        : _Pmtx(_STD addressof(_Mtx)), _Owns(true) { // construct with 互斥量实现 and 加锁 shared
        _Mtx.共享加锁();
    }

    共享锁实现(互斥量类型& _Mtx, 延迟锁类型) noexcept
        : _Pmtx(_STD addressof(_Mtx)), _Owns(false) {} // construct with unlocked 互斥量实现

    _NODISCARD_CTOR_LOCK 共享锁实现(互斥量类型& _Mtx, 尝试锁类型)
        : _Pmtx(_STD addressof(_Mtx)), _Owns(_Mtx.尝试共享加锁()) {} // construct with 互斥量实现 and try to 加锁 shared

    _NODISCARD_CTOR_LOCK 共享锁实现(互斥量类型& _Mtx, 接管锁类型) noexcept // strengthened
        : _Pmtx(_STD addressof(_Mtx)), _Owns(true) {} // construct with 互斥量实现 and adopt ownership

    template <class _表示, class _Period>
    _NODISCARD_CTOR_LOCK 共享锁实现(互斥量类型& _Mtx, const chrono::duration<_表示, _Period>& _Rel_time)
        : _Pmtx(_STD addressof(_Mtx)), _Owns(_Mtx.限时共享加锁(_Rel_time)) {
        // construct with 互斥量实现 and try to 加锁 for relative time
    }

    template <class _Clock, class _Duration>
    _NODISCARD_CTOR_LOCK 共享锁实现(互斥量类型& _Mtx, const chrono::time_point<_Clock, _Duration>& _Abs_time)
        : _Pmtx(_STD addressof(_Mtx)), _Owns(_Mtx.共享加锁至时刻(_Abs_time)) {
        // construct with 互斥量实现 and try to 加锁 until absolute time
        static_assert(chrono::_Is_clock_v<_Clock>, "Clock type required");
    }

    ~共享锁实现() noexcept {
        if (_Owns) {
            _Pmtx->共享解锁();
        }
    }

    _NODISCARD_CTOR_LOCK 共享锁实现(共享锁实现&& _Other) noexcept : _Pmtx(_Other._Pmtx), _Owns(_Other._Owns) {
        _Other._Pmtx = nullptr;
        _Other._Owns = false;
    }

    共享锁实现& operator=(共享锁实现&& _Right) noexcept {
        共享锁实现{_STD move(_Right)}.交换(*this);
        return *this;
    }

    共享锁实现(const 共享锁实现&)            = delete;
    共享锁实现& operator=(const 共享锁实现&) = delete;

    void 加锁() { // 加锁 the 互斥量实现
        _校验();
        _Pmtx->共享加锁();
        _Owns = true;
    }

    _NODISCARD_TRY_CHANGE_STATE bool 尝试加锁() { // try to 加锁 the 互斥量实现
        _校验();
        _Owns = _Pmtx->尝试共享加锁();
        return _Owns;
    }

    template <class _表示, class _Period>
    _NODISCARD_TRY_CHANGE_STATE bool 限时加锁(const chrono::duration<_表示, _Period>& _Rel_time) {
        // try to 加锁 the 互斥量实现 for _Rel_time
        _校验();
        _Owns = _Pmtx->限时共享加锁(_Rel_time);
        return _Owns;
    }

    template <class _Clock, class _Duration>
    _NODISCARD_TRY_CHANGE_STATE bool 加锁至时刻(const chrono::time_point<_Clock, _Duration>& _Abs_time) {
        // try to 加锁 the 互斥量实现 until _Abs_time
        static_assert(chrono::_Is_clock_v<_Clock>, "Clock type required");
        _校验();
        _Owns = _Pmtx->共享加锁至时刻(_Abs_time);
        return _Owns;
    }

    void 解锁() { // try to 解锁 the 互斥量实现
        if (!_Pmtx || !_Owns) {
            _Throw_system_error(errc::operation_not_permitted);
        }

        _Pmtx->共享解锁();
        _Owns = false;
    }

    void 交换(共享锁实现& _Right) noexcept {
        交换(_Pmtx, _Right._Pmtx);
        交换(_Owns, _Right._Owns);
    }

    互斥量类型* 释放() noexcept {
        _Mutex* _Res = _Pmtx;
        _Pmtx        = nullptr;
        _Owns        = false;
        return _Res;
    }

    _NODISCARD bool 持有锁() const noexcept {
        return _Owns;
    }

    explicit operator bool() const noexcept {
        return _Owns;
    }

    _NODISCARD 互斥量类型* 互斥量实现() const noexcept {
        return _Pmtx;
    }

private:
    _Mutex* _Pmtx = nullptr;
    bool _Owns    = false;

    void _校验() const { // check if the 互斥量实现 can be locked
        if (!_Pmtx) {
            _Throw_system_error(errc::operation_not_permitted);
        }

        if (_Owns) {
            _Throw_system_error(errc::resource_deadlock_would_occur);
        }
    }
};

_EXPORT_STD template <class _Mutex>
void 交换(共享锁实现<_Mutex>& _Left, 共享锁实现<_Mutex>& _Right) noexcept {
    _Left.交换(_Right);
}
} }
