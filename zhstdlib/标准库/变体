constexpr _变体_访问结果类型<_Callable, _作变体<_Variants>...> 访问(_Callable&& _Obj, _Variants&&... _Args) {
    // Invoke _Obj with the contained values of _Args...
    constexpr auto _Size = _Variant_total_states<_Remove_cvref_t<_作变体<_Variants>>...>;
    using _索引列表之列表 =
        _元_列表<_元_作列表<make_index_sequence<1 + variant_size_v<_Remove_cvref_t<_作变体<_Variants>>>>>...>;
    using _索引向量之列表 =
        _元_变换<_元_引用<_元_作整数序列>, _元_笛卡尔积<_索引列表之列表>>;
    using _返回 = _变体_访问结果类型<_Callable, _作变体<_Variants>...>;
    static_assert(_Variant_all_visit_results_same<_返回, _Callable, _元_列表<>, _作变体<_Variants>...>,
        "访问() requires the result of all potential invocations to have the same type and value category "
        "(N4950 [变体实现.访问]/5).");

