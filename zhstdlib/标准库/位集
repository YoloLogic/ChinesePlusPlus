_EXPORT_STD template <class _元素, class _Tr, size_t _Bits>
basic_ostream<_元素, _Tr>& operator<<(basic_ostream<_元素, _Tr>& _Ostr, const 位集实现<_Bits>& _Right) {
    using _字符类型             = typename basic_ostream<_元素, _Tr>::_字符类型;
    const _字符类型& _Ctype_fac = _STD use_facet<_字符类型>(_Ostr.getloc());
    const _元素 _Elem0       = _Ctype_fac.widen('0');
    const _元素 _Elem1       = _Ctype_fac.widen('1');

    _位缓冲<_元素, _Bits> _Buf;
    _Buf._分配();
    _Right._转字符串(_Buf._Buf, _Bits, _Elem0, _Elem1);
    _Ostr.write(_Buf._Buf, _Bits);
    return _Ostr;
}

_EXPORT_STD template <class _元素, class _Tr, size_t _Bits>
basic_istream<_元素, _Tr>& operator>>(basic_istream<_元素, _Tr>& _Istr, 位集实现<_Bits>& _Right) {
    using _输入流类型                    = basic_istream<_元素, _Tr>;
    using _字符类型                     = typename _输入流类型::_字符类型;
    const _字符类型& _Ctype_fac         = _STD use_facet<_字符类型>(_Istr.getloc());
    const _元素 _Elem0               = _Ctype_fac.widen('0');
    const _元素 _Elem1               = _Ctype_fac.widen('1');
    typename _输入流类型::iostate _State = _输入流类型::goodbit;
    size_t _Count                    = 0;
    _位缓冲<_元素, _Bits> _Buf;
    const typename _输入流类型::sentry _成功(_Istr);

    if (_成功) { // valid stream, extract elements
        _TRY_IO_BEGIN
        _Buf._分配();
        typename _Tr::int_type _Meta = _Istr.rdbuf()->sgetc();
        for (; _Count < _Bits; ++_Count, _Meta = _Istr.rdbuf()->snextc()) {
            // 测试 _Meta
            if (_Tr::eq_int_type(_Tr::eof(), _Meta)) { // end of file, quit
                _State |= _输入流类型::eofbit;
                break;
            }

            const _元素 _Char = _Tr::to_char_type(_Meta);

            if (!_Tr::eq(_Char, _Elem0) && !_Tr::eq(_Char, _Elem1)) {
                break; // invalid element
            }

            // valid, append '0' or '1'
            _Buf._Buf[_Count] = '0' + _Tr::eq(_Char, _Elem1);
        }

        _CATCH_IO_(_输入流类型, _Istr)
    }

    constexpr bool _Has_bits = _Bits > 0;

    if constexpr (_Has_bits) {
        if (_Count == 0) {
            _State |= _输入流类型::failbit;
        }
    }

    _Istr.setstate(_State);
    _Right = 位集实现<_Bits>{_Buf._Buf, _Count}; // convert string and store
    return _Istr;
}

template <size_t _Bits>
struct hash<位集实现<_Bits>> {
    using _ARGUMENT_TYPE_NAME _CXX17_DEPRECATE_ADAPTOR_TYPEDEFS = 位集实现<_Bits>;
    using _RESULT_TYPE_NAME _CXX17_DEPRECATE_ADAPTOR_TYPEDEFS   = size_t;

    _NODISCARD _STATIC_CALL_OPERATOR size_t operator()(const 位集实现<_Bits>& _Keyval) _CONST_CALL_OPERATOR noexcept {
        return _Hash_representation(_Keyval._Array);
    }
};
