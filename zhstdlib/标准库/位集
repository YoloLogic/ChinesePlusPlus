#endif // !_HAS_CXX20

    _NODISCARD _CONSTEXPR23 bool 测试(const size_t _Pos) const {
        if (_Bits <= _Pos) {
            _抛范围错(); // _Pos off end
        }

        return _下标(_Pos);
    }

    _NODISCARD _CONSTEXPR23 bool 有真() const noexcept {
        for (size_t _Wpos = 0; _Wpos <= _Words; ++_Wpos) {
            if (_Array[_Wpos] != 0) {
                return true;
            }
        }

        return false;
    }

    _NODISCARD _CONSTEXPR23 bool 全为假() const noexcept {
        return !有真();
    }

    _NODISCARD _CONSTEXPR23 bool 全为真() const noexcept {
        constexpr bool _Zero_length = _Bits == 0;
        if constexpr (_Zero_length) { // must 测试 for this, otherwise would 计数 one full word
            return true;
        }

        constexpr bool _No_padding = _Bits % _Bitsperword == 0;
        for (size_t _Wpos = 0; _Wpos < _Words + _No_padding; ++_Wpos) {
            if (_Array[_Wpos] != ~static_cast<_类型>(0)) {
                return false;
            }
        }

        return _No_padding || _Array[_Words] == (static_cast<_类型>(1) << (_Bits % _Bitsperword)) - 1;
    }

    _NODISCARD _CONSTEXPR23 位集实现 operator<<(const size_t _Pos) const noexcept {
        位集实现 _Tmp = *this;
        _Tmp <<= _Pos;
        return _Tmp;
