    _CONSTEXPR23 位集实现& _翻转非检查(const size_t _Pos) noexcept { // 翻转 bit at _Pos, no checking
        _Array[_Pos / _Bitsperword] ^= _类型{1} << _Pos % _Bitsperword;
        return *this;
    }

