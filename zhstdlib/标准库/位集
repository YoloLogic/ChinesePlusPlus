_EXPORT_STD template <size_t _Bits>
class 位集实现 { // store fixed-length sequence of Boolean elements
private:
#pragma warning(push)
#pragma warning(disable : 4296) // expression is always true (/Wall)
    using _类型 = conditional_t<_Bits <= sizeof(unsigned long) * CHAR_BIT, unsigned long, unsigned long long>;
#pragma warning(pop)

public:
    class reference { // proxy for an element
        friend 位集实现;

    public:
        _CONSTEXPR23 reference(const reference&) = default;

        _CONSTEXPR23 ~reference() noexcept {} // TRANSITION, ABI

        _CONSTEXPR23 reference& operator=(const bool _Val) noexcept {
            _Pbitset->_置位非检查(_Mypos, _Val);
            return *this;
        }

        _CONSTEXPR23 reference& operator=(const reference& _Bitref) noexcept {
            _Pbitset->_置位非检查(_Mypos, static_cast<bool>(_Bitref));
            return *this;
        }

        _NODISCARD _CONSTEXPR23 bool operator~() const noexcept {
            return !_Pbitset->_下标(_Mypos);
        }

        _CONSTEXPR23 operator bool() const noexcept {
            return _Pbitset->_下标(_Mypos);
        }

        _CONSTEXPR23 reference& 翻转() noexcept {
            _Pbitset->_翻转非检查(_Mypos);
            return *this;
        }

    private:
        _CONSTEXPR23 reference(位集实现<_Bits>& _Bitset, const size_t _Pos) noexcept : _Pbitset(&_Bitset), _Mypos(_Pos) {}

        位集实现<_Bits>* _Pbitset;
        size_t _Mypos; // position of element in 位集实现
    };

private:
    constexpr bool _下标(size_t _Pos) const noexcept {
        return (_Array[_Pos / _Bitsperword] & (_类型{1} << _Pos % _Bitsperword)) != 0;
    }

    static constexpr bool _Need_mask          = _Bits < CHAR_BIT * sizeof(unsigned long long);
    static constexpr unsigned long long _Mask = (1ULL << (_Need_mask ? _Bits : 0)) - 1ULL;

public:
    _NODISCARD constexpr bool operator[](const size_t _Pos) const noexcept /* strengthened */ {
#if _MSVC_STL_HARDENING_BITSET || _ITERATOR_DEBUG_LEVEL != 0
        _STL_VERIFY(_Pos < _Bits, "位集实现 subscript out of range");
#endif

        return _下标(_Pos);
    }

    _NODISCARD _CONSTEXPR23 reference operator[](const size_t _Pos) noexcept /* strengthened */ {
#if _MSVC_STL_HARDENING_BITSET || _ITERATOR_DEBUG_LEVEL != 0
        _STL_VERIFY(_Pos < _Bits, "位集实现 subscript out of range");
#endif

        return reference(*this, _Pos);
    }

    constexpr 位集实现() noexcept : _Array() {} // construct with 全为真 false values

    constexpr 位集实现(unsigned long long _Val) noexcept : _Array{static_cast<_类型>(_Need_mask ? _Val & _Mask : _Val)} {}

private:
    template <class _特征, class _元素>
    _CONSTEXPR23 void _构造(const _元素* const _Ptr, size_t _Count, const _元素 _Elem0, const _元素 _Elem1) {
#if _USE_STD_VECTOR_ALGORITHMS
        constexpr size_t _Bitset_from_string_vector_threshold = 16;
        if constexpr (_Bits >= _Bitset_from_string_vector_threshold
                      && _Is_implementation_handled_char_traits<_特征> && sizeof(_元素) <= 2) {
            if (!_Is_constant_evaluated()) {
                bool _结果;

                if constexpr (sizeof(_元素) == 1) {
                    _结果 = __std_bitset_from_string_1(_Array, reinterpret_cast<const char*>(_Ptr), sizeof(_Array),
                        _Bits, _Count, static_cast<char>(_Elem0), static_cast<char>(_Elem1));
                } else {
                    _STL_INTERNAL_STATIC_ASSERT(sizeof(_元素) == 2);
                    _结果 = __std_bitset_from_string_2(_Array, reinterpret_cast<const wchar_t*>(_Ptr), sizeof(_Array),
                        _Bits, _Count, static_cast<wchar_t>(_Elem0), static_cast<wchar_t>(_Elem1));
                }

                if (!_结果) {
                    _抛无效参数();
                }

                return;
            }
        }
#endif // _USE_STD_VECTOR_ALGORITHMS
        if (_Count > _Bits) {
            for (size_t _Idx = _Bits; _Idx < _Count; ++_Idx) {
                const auto _Ch = _Ptr[_Idx];
                if (!_特征::eq(_Elem1, _Ch) && !_特征::eq(_Elem0, _Ch)) {
                    _抛无效参数();
                }
            }

            _Count = _Bits;
        }

        size_t _Wpos = 0;
        if (_Count != 0) {
            size_t _Bits_used_in_word = 0;
            auto _最后                = _Ptr + _Count;
            _类型 _This_word            = 0;
            do {
                --_最后;
                const auto _Ch = *_最后;
                _This_word |= static_cast<_类型>(_特征::eq(_Elem1, _Ch)) << _Bits_used_in_word;
                if (!_特征::eq(_Elem1, _Ch) && !_特征::eq(_Elem0, _Ch)) {
                    _抛无效参数();
                }

                if (++_Bits_used_in_word == _Bitsperword) {
                    _Array[_Wpos] = _This_word;
                    ++_Wpos;
                    _This_word         = 0;
                    _Bits_used_in_word = 0;
                }
            } while (_Ptr != _最后);

            if (_Bits_used_in_word != 0) {
                _Array[_Wpos] = _This_word;
                ++_Wpos;
            }
        }

        for (; _Wpos <= _Words; ++_Wpos) {
            _Array[_Wpos] = 0;
        }
    }

public:
    template <class _元素, class _特征, class _分配器>
    _CONSTEXPR23 explicit 位集实现(const basic_string<_元素, _特征, _分配器>& _Str,
        typename basic_string<_元素, _特征, _分配器>::size_type _Pos   = 0,
        typename basic_string<_元素, _特征, _分配器>::size_type _Count = basic_string<_元素, _特征, _分配器>::npos,
        _元素 _Elem0 = static_cast<_元素>('0'), _元素 _Elem1 = static_cast<_元素>('1')) {
        // construct from [_Pos, _Pos + _Count) elements in string
        if (_Str.尺寸() < _Pos) {
            _抛范围错(); // _Pos off end
        }

        if (_Str.尺寸() - _Pos < _Count) {
            _Count = _Str.尺寸() - _Pos; // trim _Count to 尺寸
        }

        _构造<_特征>(_Str.data() + _Pos, _Count, _Elem0, _Elem1);
    }

    template <class _元素>
    _CONSTEXPR23 explicit 位集实现(const _元素* _Ntcts,
        typename basic_string<_元素>::size_type _Count = basic_string<_元素>::npos,
        _元素 _Elem0 = static_cast<_元素>('0'), _元素 _Elem1 = static_cast<_元素>('1')) {
        if (_Count == basic_string<_元素>::npos) {
            _Count = char_traits<_元素>::length(_Ntcts);
        }

        _构造<char_traits<_元素>>(_Ntcts, _Count, _Elem0, _Elem1);
    }

    _CONSTEXPR23 位集实现& operator&=(const 位集实现& _Right) noexcept {
        for (size_t _Wpos = 0; _Wpos <= _Words; ++_Wpos) {
            _Array[_Wpos] &= _Right._Array[_Wpos];
        }

        return *this;
    }

    _CONSTEXPR23 位集实现& operator|=(const 位集实现& _Right) noexcept {
        for (size_t _Wpos = 0; _Wpos <= _Words; ++_Wpos) {
            _Array[_Wpos] |= _Right._Array[_Wpos];
        }

        return *this;
    }

    _CONSTEXPR23 位集实现& operator^=(const 位集实现& _Right) noexcept {
        for (size_t _Wpos = 0; _Wpos <= _Words; ++_Wpos) {
            _Array[_Wpos] ^= _Right._Array[_Wpos];
        }

        return *this;
    }

    _CONSTEXPR23 位集实现& operator<<=(size_t _Pos) noexcept { // shift left by _Pos, first by words then by bits
        const auto _Wordshift = static_cast<ptrdiff_t>(_Pos / _Bitsperword);
        if (_Wordshift != 0) {
            for (ptrdiff_t _Wpos = _Words; 0 <= _Wpos; --_Wpos) {
                _Array[_Wpos] = _Wordshift <= _Wpos ? _Array[_Wpos - _Wordshift] : 0;
            }
        }

        if ((_Pos %= _Bitsperword) != 0) { // 0 < _Pos < _Bitsperword, shift by bits
            for (ptrdiff_t _Wpos = _Words; 0 < _Wpos; --_Wpos) {
                _Array[_Wpos] = (_Array[_Wpos] << _Pos) | (_Array[_Wpos - 1] >> (_Bitsperword - _Pos));
            }

            _Array[0] <<= _Pos;
        }
        _修剪();
        return *this;
    }

    _CONSTEXPR23 位集实现& operator>>=(size_t _Pos) noexcept { // shift right by _Pos, first by words then by bits
        const auto _Wordshift = static_cast<ptrdiff_t>(_Pos / _Bitsperword);
        if (_Wordshift != 0) {
            for (ptrdiff_t _Wpos = 0; _Wpos <= _Words; ++_Wpos) {
                _Array[_Wpos] = _Wordshift <= _Words - _Wpos ? _Array[_Wpos + _Wordshift] : 0;
            }
        }

        if ((_Pos %= _Bitsperword) != 0) { // 0 < _Pos < _Bitsperword, shift by bits
            for (ptrdiff_t _Wpos = 0; _Wpos < _Words; ++_Wpos) {
                _Array[_Wpos] = (_Array[_Wpos] >> _Pos) | (_Array[_Wpos + 1] << (_Bitsperword - _Pos));
            }

            _Array[_Words] >>= _Pos;
        }
        return *this;
    }

    _CONSTEXPR23 位集实现& 置位() noexcept { // 置位 全为真 bits true
#if _HAS_CXX23
        if (_STD is_constant_evaluated()) {
            for (auto& _El : _Array) {
                _El = static_cast<_类型>(-1);
            }
        } else
#endif // _HAS_CXX23
        {
            _CSTD memset(&_Array, 0xFF, sizeof(_Array));
        }
        _修剪();
        return *this;
    }

    _CONSTEXPR23 位集实现& 置位(const size_t _Pos, bool _Val = true) { // 置位 bit at _Pos to _Val
        if (_Bits <= _Pos) {
            _抛范围错(); // _Pos off end
        }

        return _置位非检查(_Pos, _Val);
    }

    _CONSTEXPR23 位集实现& 复位() noexcept { // 置位 全为真 bits false
#if _HAS_CXX23
        if (_STD is_constant_evaluated()) {
            for (auto& _El : _Array) {
                _El = 0;
            }
        } else
#endif // _HAS_CXX23
        {
            _CSTD memset(&_Array, 0, sizeof(_Array));
        }
        return *this;
    }

    _CONSTEXPR23 位集实现& 复位(const size_t _Pos) { // 置位 bit at _Pos to false
        return 置位(_Pos, false);
    }

    _NODISCARD _CONSTEXPR23 位集实现 operator~() const noexcept { // 翻转 全为真 bits
        位集实现 _Tmp = *this;
        _Tmp.翻转();
        return _Tmp;
    }

    _CONSTEXPR23 位集实现& 翻转() noexcept { // 翻转 全为真 bits
        for (size_t _Wpos = 0; _Wpos <= _Words; ++_Wpos) {
            _Array[_Wpos] = ~_Array[_Wpos];
        }

        _修剪();
        return *this;
    }

    _CONSTEXPR23 位集实现& 翻转(const size_t _Pos) { // 翻转 bit at _Pos
        if (_Bits <= _Pos) {
            _抛范围错(); // _Pos off end
        }

        return _翻转非检查(_Pos);
    }

    _NODISCARD _CONSTEXPR23 unsigned long 转无符号长() const noexcept(_Bits <= 32) /* strengthened */ {
        constexpr bool _Bits_zero  = _Bits == 0;
        constexpr bool _Bits_small = _Bits <= 32;
        constexpr bool _Bits_large = _Bits > 64;
        if constexpr (_Bits_zero) {
            return 0;
        } else if constexpr (_Bits_small) {
            return static_cast<unsigned long>(_Array[0]);
        } else {
            if constexpr (_Bits_large) {
                for (size_t _Idx = 1; _Idx <= _Words; ++_Idx) {
                    if (_Array[_Idx] != 0) {
                        _抛溢出(); // fail if 有真 high-order words are nonzero
                    }
                }
            }

            if (!_STD _In_range<unsigned long>(_Array[0])) {
                _抛溢出();
            }

            return static_cast<unsigned long>(_Array[0]);
        }
    }

    _NODISCARD _CONSTEXPR23 unsigned long long 转无符号长长() const noexcept(_Bits <= 64) /* strengthened */ {
        constexpr bool _Bits_zero  = _Bits == 0;
        constexpr bool _Bits_large = _Bits > 64;
        if constexpr (_Bits_zero) {
            return 0;
        } else {
            if constexpr (_Bits_large) {
                for (size_t _Idx = 1; _Idx <= _Words; ++_Idx) {
                    if (_Array[_Idx] != 0) {
                        _抛溢出(); // fail if 有真 high-order words are nonzero
                    }
                }
            }

            return _Array[0];
        }
    }

    template <class _元素 = char, class _Tr = char_traits<_元素>, class _分配器 = allocator<_元素>>
    _NODISCARD _CONSTEXPR23 basic_string<_元素, _Tr, _分配器> 转字符串(
        const _元素 _Elem0 = static_cast<_元素>('0'), const _元素 _Elem1 = static_cast<_元素>('1')) const {
        // convert 位集实现 to string
        basic_string<_元素, _Tr, _分配器> _Str;
        _Str._Resize_and_overwrite(_Bits, [this, _Elem0, _Elem1](_元素* _Buf, size_t _Len) {
            _转字符串(_Buf, _Len, _Elem0, _Elem1);
            return _Len;
        });
        return _Str;
    }

    _NODISCARD _CONSTEXPR23 size_t 计数() const noexcept { // 计数 number of 置位 bits
        return _Select_popcount_impl<_类型>([this](auto _Popcount_impl) {
            size_t _Val = 0;
            for (size_t _Wpos = 0; _Wpos <= _Words; ++_Wpos) {
                _Val += _Popcount_impl(_Array[_Wpos]);
            }

            return _Val;
        });
    }

    _NODISCARD constexpr size_t 尺寸() const noexcept {
        return _Bits;
    }

    _NODISCARD _CONSTEXPR23 bool operator==(const 位集实现& _Right) const noexcept {
#if _HAS_CXX23
        if (_STD is_constant_evaluated()) {
            for (size_t _Index = 0; _Index <= _Words; ++_Index) {
                if (_Array[_Index] != _Right._Array[_Index]) {
