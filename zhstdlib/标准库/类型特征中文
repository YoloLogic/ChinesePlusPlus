// <类型特征中文> —— 试点：类型特征的「中文成员」版本
//
// 试点结论（第一轮）：
//   · 关键字不能当标识符：`类型`（= class）不能做类名/成员名 → 用 结构
//   · `class` 默认私有成员 → 中文 结构 默认公开，正则成员能直接被读到
//   · 成员名也要避开关键字：value→值、type→类别（作者指定）；class→类型 是关键字，不能当名字
//   · 类名也要避开：switch→选择 是关键字，包装类改用 条件选择
#pragma once
#include <type_traits>

名域 标准 {

    模板 <类型名 某类型> 结构 是整数特征 {
        静态 常量表达式 布尔 值 = std::is_integral<某类型>::value;
        常量表达式 运算符 布尔() 常量 不抛出 { 返回 值; }
    };

    模板 <类型名 某类型> 结构 是浮点特征 {
        静态 常量表达式 布尔 值 = std::is_floating_point<某类型>::value;
        常量表达式 运算符 布尔() 常量 不抛出 { 返回 值; }
    };

    模板 <类型名 某类型> 结构 是空型特征 {
        静态 常量表达式 布尔 值 = std::is_void<某类型>::value;
        常量表达式 运算符 布尔() 常量 不抛出 { 返回 值; }
    };

    模板 <类型名 某类型> 结构 是常量特征 {
        静态 常量表达式 布尔 值 = std::is_const<某类型>::value;
        常量表达式 运算符 布尔() 常量 不抛出 { 返回 值; }
    };

    模板 <类型名 某类型> 结构 是类特征 {
        静态 常量表达式 布尔 值 = std::is_class<某类型>::value;
        常量表达式 运算符 布尔() 常量 不抛出 { 返回 值; }
    };

    模板 <类型名 某类型> 结构 是指针特征 {
        静态 常量表达式 布尔 值 = std::is_pointer<某类型>::value;
        常量表达式 运算符 布尔() 常量 不抛出 { 返回 值; }
    };

    模板 <类型名 某类型> 结构 是引用特征 {
        静态 常量表达式 布尔 值 = std::is_reference<某类型>::value;
        常量表达式 运算符 布尔() 常量 不抛出 { 返回 值; }
    };

    // 类型变换：中文名 + 中文成员 类别（对应 type，作者指定译名）
    模板 <类型名 某类型> 结构 去常量 {
        使用 类别 = std::remove_const_t<某类型>;
    };

    模板 <类型名 某类型> 结构 去引用 {
        使用 类别 = std::remove_reference_t<某类型>;
    };

    // 条件选择（对应 conditional_t）
    模板 <布尔 条件, 类型名 真类型, 类型名 假类型> 结构 条件选择 {
        使用 类别 = std::conditional_t<条件, 真类型, 假类型>;
    };
}