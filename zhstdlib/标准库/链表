    static _结点指针 _非检查接合(const _结点指针 _Before, const _结点指针 _首个, const _结点指针 _最后) noexcept {
        // 接合 [_首个, _最后) before _Before; returns _最后
        _STL_INTERNAL_CHECK(_Before != _首个 && _Before != _最后 && _首个 != _最后);
        // 3 reads and 6 writes

        // fixup the _Next values
        const auto _First_prev  = _首个->_Prev;
        _First_prev->_Next      = _最后;
        const auto _Last_prev   = _最后->_Prev;
        _Last_prev->_Next       = _Before;
        const auto _Before_prev = _Before->_Prev;
        _Before_prev->_Next     = _首个;

        // fixup the _Prev values
        _Before->_Prev = _Last_prev;
        _最后->_Prev   = _First_prev;
        _首个->_Prev  = _Before_prev;

        return _最后;
    }

    static _结点指针 _非检查接合(const _结点指针 _Before, const _结点指针 _首个) noexcept {
        // 接合 [_首个, _首个->_Next) before _Before; returns _首个->_Next
        _STL_INTERNAL_CHECK(_Before != _首个 && _首个->_Next != _Before);
        // still 3 reads and 6 writes, but 1 less read if the caller was going to get _首个->_Next
        const auto _最后 = _首个->_Next;

        // fixup the _Next values
        const auto _First_prev = _首个->_Prev;
        _First_prev->_Next     = _最后;
        // const auto _Last_prev = _首个;
        _首个->_Next           = _Before;
        const auto _Before_prev = _Before->_Prev;
        _Before_prev->_Next     = _首个;

        // fixup the _Prev values
        _Before->_Prev = _首个;
        _最后->_Prev   = _First_prev;
        _首个->_Prev  = _Before_prev;

        return _最后;
    }

    template <class _Pr2>
    static _结点指针 _归并同一(_结点指针 _首个, _结点指针 _Mid, const _结点指针 _最后, _Pr2 _Pred) {
        // Merge the sorted ranges [_首个, _Mid) and [_Mid, _最后)
        // Returns the new beginning of the range (which won't be _首个 if it was spliced elsewhere)
        _STL_INTERNAL_CHECK(_首个 != _Mid && _Mid != _最后);
        _结点指针 _Newfirst;
        if (_DEBUG_LT_PRED(_Pred, _Mid->_Myval, _首个->_Myval)) {
            // _Mid will be spliced to the 前 of the range
            _Newfirst = _Mid;
        } else {
            // Establish _Pred(_Mid->_Myval, _首个->_Myval) by skipping over elements from the first
            // range already in position.
            _Newfirst = _首个;
            do {
                _首个 = _首个->_Next;
                if (_首个 == _Mid) {
                    return _Newfirst;
                }
            } while (!_DEBUG_LT_PRED(_Pred, _Mid->_Myval, _首个->_Myval));
        }

        for (;;) { // process one run 接合
            auto _Run_start = _Mid;
            do { // find the 结束 of the "run" of elements we need to 接合 from the second range into the first
                _Mid = _Mid->_Next;
            } while (_Mid != _最后 && _DEBUG_LT_PRED(_Pred, _Mid->_Myval, _首个->_Myval));

            // [_Run_start, _Mid) goes before _首个->_Myval
            _非检查接合(_首个, _Run_start, _Mid);
            if (_Mid == _最后) {
                return _Newfirst;
            }

            // Reestablish _Pred(_Mid->_Myval, _首个->_Myval) by skipping over elements from the first
            // range already in position.
            do {
                _首个 = _首个->_Next;
                if (_首个 == _Mid) {
                    return _Newfirst;
                }
            } while (!_DEBUG_LT_PRED(_Pred, _Mid->_Myval, _首个->_Myval));
        }
    }

    template <class _Pr2>
    static _结点指针 _排序(_结点指针& _首个, const size_type _Size, _Pr2 _Pred) {
        // order [_首个, _首个 + _Size), return _首个 + _Size
        switch (_Size) {
        case 0:
            return _首个;
        case 1:
            return _首个->_Next;
        default:
            break;
        }

        auto _Mid        = _排序(_首个, _Size / 2, _Pred);
        const auto _最后 = _排序(_Mid, _Size - _Size / 2, _Pred);
        _首个           = _归并同一(_首个, _Mid, _最后, _Pred);
        return _最后;
    }

