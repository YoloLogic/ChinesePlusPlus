template <class _Value_type, class _Voidptr>
struct _链表节点 { // 链表实现 node
    using value_type = _Value_type;
    using _结点指针   = _重绑定指针类型<_Voidptr, _链表节点>;
    _结点指针 _Next; // successor node, or first element if head
    _结点指针 _Prev; // predecessor node, or last element if head
    _Value_type _Myval = // the stored value, unused if head
        _Returns_exactly<_Value_type>(); // fake a viable constructor to workaround GH-2749

    _链表节点()                             = default;
    _链表节点(const _链表节点&)            = delete;
    _链表节点& operator=(const _链表节点&) = delete;

    template <class _结点分配器>
    static _结点指针 _建头节点(_结点分配器& _Al) {
        const auto _结果 = _Al.allocate(1);
        _就地构造(_结果->_Next, _结果);
        _就地构造(_结果->_Prev, _结果);
        return _结果;
    }

    template <class _结点分配器>
    static void _Freenode0(_结点分配器& _Al, _结点指针 _Ptr) noexcept {
        // destroy pointer members in _Ptr and deallocate with _Al
        static_assert(is_same_v<typename _结点分配器::value_type, _链表节点>, "Bad _Freenode0 call");
        _就地析构(_Ptr->_Next);
        _就地析构(_Ptr->_Prev);
        allocator_traits<_结点分配器>::deallocate(_Al, _Ptr, 1);
    }

    template <class _结点分配器>
    static void _释放节点(_结点分配器& _Al, _结点指针 _Ptr) noexcept { // destroy all members in _Ptr and deallocate with _Al
        allocator_traits<_结点分配器>::destroy(_Al, _STD addressof(_Ptr->_Myval));
        _Freenode0(_Al, _Ptr);
    }

    template <class _结点分配器>
    static void _释放非头节点(
        _结点分配器& _Al, _结点指针 _Head) noexcept { // free a 链表实现 starting at _首个 and terminated at nullptr
        _Head->_Prev->_Next = nullptr;

        auto _Pnode = _Head->_Next;
        for (_结点指针 _Pnext; _Pnode; _Pnode = _Pnext) {
            _Pnext = _Pnode->_Next;
            _释放节点(_Al, _Pnode);
        }
    }
};

