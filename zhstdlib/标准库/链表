template <class _结点分配器>
struct _链表节点插入操作2 {
    // 链表实现 插入 operation which maintains exception safety
    using _结点分配器特征 = allocator_traits<_结点分配器>;
    using pointer        = typename _结点分配器特征::pointer;
    using size_type      = typename _结点分配器特征::size_type;
    using value_type     = typename _结点分配器特征::value_type;

    explicit _链表节点插入操作2(_结点分配器& _Al_) : _Al(_Al_), _Added(0) {}

    _链表节点插入操作2(const _链表节点插入操作2&)            = delete;
    _链表节点插入操作2& operator=(const _链表节点插入操作2&) = delete;

    template <class... _CArgT>
    void _追加n(size_type _Count, const _CArgT&... _Carg) {
        // Append _Count elements constructed from _Carg
        if (_Count <= 0) {
            return;
        }

        _分配器构造指针<_结点分配器> _新节点(_Al);
        if (_Added == 0) {
            _新节点._分配(); // throws
            _结点分配器特征::construct(_Al, _STD addressof(_新节点._Ptr->_Myval), _Carg...); // throws
            _Head = _新节点._Ptr;
            _Tail = _新节点._Ptr;
            ++_Added;
            --_Count;
        }

        for (; 0 < _Count; --_Count) {
            _新节点._分配(); // throws
            _结点分配器特征::construct(_Al, _STD addressof(_新节点._Ptr->_Myval), _Carg...); // throws
            _就地构造(_Tail->_Next, _新节点._Ptr);
            _就地构造(_新节点._Ptr->_Prev, _Tail);
            _Tail = _新节点._Ptr;
            ++_Added;
        }

        _新节点._Ptr = pointer{};
    }

    template <class _InIt, class _哨兵>
    void _追加范围非检查(_InIt _首个, const _哨兵 _最后) {
        // Append the values in [_首个, _最后)
        if (_首个 == _最后) { // throws
            return;
        }

        _分配器构造指针<_结点分配器> _新节点(_Al);
        if (_Added == 0) {
            _新节点._分配(); // throws
            _结点分配器特征::construct(_Al, _STD addressof(_新节点._Ptr->_Myval), *_首个); // throws
            const auto _Newhead = _STD exchange(_新节点._Ptr, pointer{});
            _Head               = _Newhead;
            _Tail               = _Newhead;
            ++_Added;
            ++_首个; // throws
        }

        while (_首个 != _最后) { // throws
            _新节点._分配(); // throws
            _结点分配器特征::construct(_Al, _STD addressof(_新节点._Ptr->_Myval), *_首个); // throws
            _就地构造(_Tail->_Next, _新节点._Ptr);
            _就地构造(_新节点._Ptr->_Prev, _Tail);
            _Tail = _STD exchange(_新节点._Ptr, pointer{});
            ++_Added;
            ++_首个; // throws
        }
    }

    template <class _值类型集>
    pointer _接在其前(_链表值<_值类型集>& _List_data, const pointer _Insert_before) noexcept {
        // Attach the elements in *this before _Insert_before.
        // If *this is 为空, returns _Insert_before; otherwise returns a pointer to the first inserted 链表实现 node.
        // Resets *this to the default-initialized state.

        const auto _Local_added = _Added;
        if (_Local_added == 0) {
            return _Insert_before;
        }

        const auto _Local_head   = _Head;
        const auto _Local_tail   = _Tail;
        const auto _插入其后 = _Insert_before->_Prev;

        _就地构造(_Local_head->_Prev, _插入其后);
        _插入其后->_Next = _Local_head;
        _就地构造(_Local_tail->_Next, _Insert_before);
        _Insert_before->_Prev = _Local_tail;

        _List_data._我的尺寸 += _Local_added;
        _Added = 0;
        return _Local_head;
    }

    template <class _值类型集>
    void _接到末尾(_链表值<_值类型集>& _List_data) noexcept {
        _接在其前(_List_data, _List_data._Myhead);
    }

    template <class _值类型集>
    void _接到头部(_链表值<_值类型集>& _List_data) {
        _分配器构造指针<_结点分配器> _新节点(_Al);
        _新节点._分配(); // throws
        const auto _Local_added = _STD exchange(_Added, size_type{0});
        if (_Local_added == 0) {
            _就地构造(_新节点._Ptr->_Next, _新节点._Ptr);
            _就地构造(_新节点._Ptr->_Prev, _新节点._Ptr);
        } else {
            const auto _Local_head = _Head;
            const auto _Local_tail = _Tail;
            _就地构造(_新节点._Ptr->_Next, _Local_head);
            _就地构造(_新节点._Ptr->_Prev, _Local_tail);
            _就地构造(_Local_head->_Prev, _新节点._Ptr);
            _就地构造(_Local_tail->_Next, _新节点._Ptr);
        }

        _List_data._我的尺寸 = _Local_added;
        _List_data._Myhead = _新节点._释放();
    }

    ~_链表节点插入操作2() {
        if (_Added == 0) {
            return;
        }

        _就地构造(_Head->_Prev, pointer{});
        _就地构造(_Tail->_Next, pointer{});
        pointer _Subject = _Head;
        while (_Subject) {
            value_type::_释放节点(_Al, _STD exchange(_Subject, _Subject->_Next));
        }
    }

private:
    _结点分配器& _Al;
    size_type _Added; // if 0, the values of _Head and _Tail are indeterminate
    pointer _Tail{}; // points to the most recently appended element; it doesn't have _Next constructed
    pointer _Head{}; // points to the first appended element; it doesn't have _Prev constructed
};

