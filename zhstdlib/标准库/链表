    _结点指针 _脱链节点(_结点指针 _Pnode) noexcept { // unlink node at _Where from the 链表实现
        _孤儿化指针2(_Pnode);
        _Pnode->_Prev->_Next = _Pnode->_Next;
        _Pnode->_Next->_Prev = _Pnode->_Prev;
        --_我的尺寸;
        return _Pnode;
    }

#if _ITERATOR_DEBUG_LEVEL == 2
    void _收养唯一(_链表值& _Other, _结点指针 _Pnode) noexcept {
        // adopt iterators pointing to the spliced node
        _Lockit _加锁(_LOCK_DEBUG);
        _迭代器基类12** _Pnext = &_Other._Myproxy->_Myfirstiter;
        const auto _Myproxy       = this->_Myproxy;
        while (*_Pnext) {
            auto& _Iter = static_cast<_链表常量迭代器<_链表值>&>(**_Pnext);
            if (_Iter._Ptr == _Pnode) { // adopt the iterator
