    void _收养范围(_链表值& _Other, const _结点指针 _首个, const _结点指针 _最后) noexcept {
        // adopt all iterators pointing to nodes in the "range" [_首个, _最后) by marking nodes
        _Lockit _加锁(_LOCK_DEBUG);
        _迭代器基类12** _Pnext = &_Other._Myproxy->_Myfirstiter;
        const auto _Myproxy       = this->_Myproxy;
        _结点指针 _Oldprev         = _首个->_Prev;
        for (_结点指针 _Ptr = _首个; _Ptr != _最后; _Ptr = _Ptr->_Next) { // mark _Prev pointers
            _Ptr->_Prev = nullptr;
        }

        while (*_Pnext) { // check the iterator
            auto& _Iter = static_cast<_链表常量迭代器<_链表值>&>(**_Pnext);
            if (_Iter._Ptr->_Prev) { // skip the iterator
                _Pnext = &_Iter._Mynextiter;
            } else { // adopt the iterator
                *_Pnext                = _Iter._Mynextiter;
                _Iter._Myproxy         = _Myproxy;
                _Iter._Mynextiter      = _Myproxy->_Myfirstiter;
                _Myproxy->_Myfirstiter = _STD addressof(_Iter);
            }
        }

        for (_结点指针 _Ptr = _首个; _Ptr != _最后; _Ptr = _Ptr->_Next) { // restore _Prev pointers
            _Ptr->_Prev = _Oldprev;
            _Oldprev    = _Ptr;
        }
    }
