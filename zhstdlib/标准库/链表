        _结点指针 _转移至末尾(const _结点指针 _Removed) noexcept {
            // extract _Removed from the 链表实现, and add it to the singly-linked 链表实现 of nodes to destroy
            // returns the node after _Removed
            _STL_INTERNAL_CHECK(_List._Mypair._Myval2._Myhead != _Removed);

            // snip the node out
            --_List._Mypair._Myval2._我的尺寸;
            const auto _Next = _STD exchange(_Removed->_Next, nullptr);
            const auto _Prev = _Removed->_Prev;
            _Prev->_Next     = _Next;
            _Next->_Prev     = _Prev;

#if _ITERATOR_DEBUG_LEVEL == 2
            // mark removed node for IDL to snip out later
            _Removed->_Prev = nullptr;
#endif // _ITERATOR_DEBUG_LEVEL == 2

            *_Tail = _Removed;
            _Tail  = _STD addressof(_Removed->_Next);

            return _Next;
        }

        ~_链表节点删除操作() {
            auto& _Al = _List._取分配器();

#if _ITERATOR_DEBUG_LEVEL == 2
            {
                _Lockit _加锁(_LOCK_DEBUG);
                _迭代器基类12** _Pnext = &_List._Mypair._Myval2._Myproxy->_Myfirstiter;
                while (*_Pnext) {
                    _迭代器基类12** _Pnextnext = &(*_Pnext)->_Mynextiter;
                    const auto _Pnextptr          = static_cast<const_iterator&>(**_Pnext)._Ptr;
                    if (_Pnextptr->_Prev) {
                        // iterator doesn't point to one of the elements we're removing
                        _Pnext = _Pnextnext;
                    } else { // orphan the iterator
                        (*_Pnext)->_Myproxy = nullptr;
                        *_Pnext             = *_Pnextnext;
                    }
                }
            }
#endif // _ITERATOR_DEBUG_LEVEL == 2

            auto _Target = _Head;
            while (_Target) {
                auto _Next = _Target->_Next;
                _List._Mypair._Myval2._孤儿化指针2(_Target);
                _结点分配器特征::destroy(_Al, _STD addressof(_Target->_Next));
                _结点分配器特征::destroy(_Al, _STD addressof(_Target->_Prev));
                _结点分配器特征::destroy(_Al, _STD addressof(_Target->_Myval));
                _Al.deallocate(_Target, 1);
                _Target = _Next;
            }
        }

        链表实现& _List;
        _结点指针 _Head; // singly linked 链表实现 of nodes to 移除; their _Prev pointers set to nullptr
        _结点指针* _Tail;
    };

    _LIST_REMOVE_RETURN 移除(const _类型& _Val) { // 擦除 each element matching _Val
        return 按条件移除([&](const _类型& _Other) -> bool { return _Other == _Val; });
    }

    template <class _Pr1>
    _LIST_REMOVE_RETURN 按条件移除(_Pr1 _Pred) { // 擦除 each element satisfying _Pred
        auto& _My_data = _Mypair._Myval2;
        _链表节点删除操作 _操作(*this);
        const auto _最后         = _My_data._Myhead;
        const size_type _Oldsize = _My_data._我的尺寸;
        for (auto _首个 = _最后->_Next; _首个 != _最后;) {
            auto _Next = _首个->_Next;
            if (_Pred(_首个->_Myval)) {
                _操作._转移至末尾(_首个);
            }

            _首个 = _Next;
        }

#if _HAS_CXX20
        return _Oldsize - _My_data._我的尺寸;
#else
        (void) _Oldsize;
#endif
    }

    _LIST_REMOVE_RETURN 去重() { // 擦除 each element matching previous
        return 去重(equal_to<>{});
    }

    template <class _Pr2>
    _LIST_REMOVE_RETURN 去重(_Pr2 _Pred) { // 擦除 each element satisfying _Pred with previous
        _链表节点删除操作 _操作(*this);
        const _结点指针 _Phead    = _Mypair._Myval2._Myhead;
        _结点指针 _Pprev          = _Phead->_Next;
        _结点指针 _Pnode          = _Pprev->_Next;
        const size_type _Oldsize = _Mypair._Myval2._我的尺寸;
        while (_Pnode != _Phead) {
            if (_Pred(_Pprev->_Myval, _Pnode->_Myval)) { // match, 移除 it
                _Pnode = _操作._转移至末尾(_Pnode);
            } else { // no match, advance
                _Pprev = _Pnode;
                _Pnode = _Pnode->_Next;
            }
        }

#if _HAS_CXX20
        return _Oldsize - _Mypair._Myval2._我的尺寸;
#else
        (void) _Oldsize;
#endif
    }

    void 归并(链表实现& _Right) { // 归并 in elements from _Right, both ordered by operator<
        _归并1(_Right, less<>{});
    }

    void 归并(链表实现&& _Right) { // 归并 in elements from _Right, both ordered by operator<
        _归并1(_Right, less<>{});
    }

    template <class _Pr2>
    void 归并(链表实现& _Right, _Pr2 _Pred) { // 归并 in elements from _Right, both ordered by _Pred
        _归并1(_Right, _传递函数(_Pred));
    }

    template <class _Pr2>
    void 归并(链表实现&& _Right, _Pr2 _Pred) { // 归并 in elements from _Right, both ordered by _Pred
        _归并1(_Right, _传递函数(_Pred));
    }

private:
    template <class _Pr2>
    void _归并1(链表实现& _Right, _Pr2 _Pred) { // 归并 in elements from _Right, both ordered by _Pred
#if _ITERATOR_DEBUG_LEVEL != 0
        _DEBUG_ORDER_UNWRAPPED(_非检查开始(), _非检查结束(), _Pred);
#endif // _ITERATOR_DEBUG_LEVEL != 0
        if (this == _STD addressof(_Right)) {
            return;
        }

#if _ITERATOR_DEBUG_LEVEL != 0
        _DEBUG_ORDER_UNWRAPPED(_Right._非检查开始(), _Right._非检查结束(), _Pred);
        if constexpr (!_结点分配器特征::is_always_equal::value) {
            _STL_VERIFY(_取分配器() == _Right._取分配器(), "链表实现 allocators incompatible for 归并");
        }
#endif // _ITERATOR_DEBUG_LEVEL != 0

        const auto _Right_size = _Right._Mypair._Myval2._我的尺寸;
        if (_Right_size == 0) {
            // nothing to do
            return;
        }

        // 接合 all _Right's nodes on the 结束 of *this
        const auto _Myhead     = _Mypair._Myval2._Myhead;
        const auto _Right_head = _Right._Mypair._Myval2._Myhead;
        const auto _Mid        = _Right_head->_Next;
        _接合(_Myhead, _Right, _Mid, _Right_head, _Right_size);

        // if *this had any elements, run the 归并 op between the range we just spliced and the old elements
        if (_Myhead->_Next != _Mid) {
            _迭代器检查值::_归并同一(_Myhead->_Next, _Mid, _Myhead, _Pred);
        }
    }

public:
    void 排序() { // order sequence
        排序(less<>{});
    }

    template <class _Pr2>
    void 排序(_Pr2 _Pred) { // order sequence
        auto& _My_data = _Mypair._Myval2;
        _迭代器检查值::_排序(_My_data._Myhead->_Next, _My_data._我的尺寸, _传递函数(_Pred));
    }

    void 反转() noexcept { // 反转 sequence
        const _结点指针 _Phead = _Mypair._Myval2._Myhead;
        _结点指针 _Pnode       = _Phead;

        for (;;) { // flip pointers in a node
            const _结点指针 _Pnext = _Pnode->_Next;
            _Pnode->_Next         = _Pnode->_Prev;
            _Pnode->_Prev         = _Pnext;

            if (_Pnext == _Phead) {
                break;
            }

            _Pnode = _Pnext;
        }
    }

private:
    _结点指针 _接合(
        const _结点指针 _Where, 链表实现& _Right, const _结点指针 _首个, const _结点指针 _最后, const size_type _Count) {
        // 接合 _Right [_首个, _最后) before _Where; returns _最后
        if (this != _STD addressof(_Right)) { // splicing from another 链表实现, adjust counts
#if _ITERATOR_DEBUG_LEVEL != 0
            if constexpr (!_结点分配器特征::is_always_equal::value) {
                _STL_VERIFY(_取分配器() == _Right._取分配器(), "链表实现 allocators incompatible for 接合");
            }
#endif // _ITERATOR_DEBUG_LEVEL != 0

            auto& _My_data = _Mypair._Myval2;
            if (max_size() - _My_data._我的尺寸 < _Count) {
                _Xlength_error("链表实现 too long");
            }

            auto& _Right_data = _Right._Mypair._Myval2;
#if _ITERATOR_DEBUG_LEVEL == 2
            // transfer ownership
            if (_Count == 1) {
                _My_data._收养唯一(_Right_data, _首个);
            } else if (_Count == _Right_data._我的尺寸) {
                _My_data._收养全部(_Right_data);
            } else {
                _My_data._收养范围(_Right_data, _首个, _最后);
            }
#endif // _ITERATOR_DEBUG_LEVEL == 2

            _My_data._我的尺寸 += _Count;
            _Right_data._我的尺寸 -= _Count;
        }

        return _迭代器检查值::_非检查接合(_Where, _首个, _最后);
    }

    void _分配哨兵与代理() {
        auto&& _Alproxy = _取代理分配器(_结点分配器, _取分配器());
        _容器代理指针<_分配器类型> _代理(_Alproxy, _Mypair._Myval2);
        auto& _Al     = _取分配器();
        auto _Newhead = _Al.allocate(1);
        _就地构造(_Newhead->_Next, _Newhead);
        _就地构造(_Newhead->_Prev, _Newhead);
        _Mypair._Myval2._Myhead = _Newhead;
        _代理._释放();
    }

    void _孤儿化全部() noexcept {
        _Mypair._Myval2._孤儿化全部();
    }

    _结点分配器& _取分配器() noexcept {
        return _Mypair._取第一();
    }

    const _结点分配器& _取分配器() const noexcept {
        return _Mypair._取第一();
    }

    _压缩对<_结点分配器, _迭代器检查值> _Mypair;
};

