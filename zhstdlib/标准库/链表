    void _孤儿化指针2(_结点指针 _Ptr) noexcept { // orphan iterators with specified node pointers
#if _ITERATOR_DEBUG_LEVEL == 2
        _Lockit _加锁(_LOCK_DEBUG);
        _迭代器基类12** _Pnext = &this->_Myproxy->_Myfirstiter;
        const auto _Head          = _Myhead;
        while (*_Pnext) {
            _迭代器基类12** _Pnextnext = &(*_Pnext)->_Mynextiter;
            const auto _Pnextptr          = static_cast<_链表常量迭代器<_链表值>&>(**_Pnext)._Ptr;
            if (_Pnextptr == _Head || _Pnextptr != _Ptr) {
                // iterator is 结束() or doesn't point at the one we are orphaning, move on
                _Pnext = _Pnextnext;
            } else { // orphan the iterator
                (*_Pnext)->_Myproxy = nullptr;
                *_Pnext             = *_Pnextnext;
            }
        }
#else // ^^^ _ITERATOR_DEBUG_LEVEL == 2 / _ITERATOR_DEBUG_LEVEL != 2 vvv
        (void) _Ptr;
#endif // ^^^ _ITERATOR_DEBUG_LEVEL != 2 ^^^
    }

    void _孤儿化非末尾() noexcept { // orphan iterators except 结束()
#if _ITERATOR_DEBUG_LEVEL == 2
        _Lockit _加锁(_LOCK_DEBUG);
        _迭代器基类12** _Pnext = &this->_Myproxy->_Myfirstiter;
        const auto _Head          = _Myhead;
        while (*_Pnext) {
            _迭代器基类12** _Pnextnext = &(*_Pnext)->_Mynextiter;
            if (static_cast<_链表常量迭代器<_链表值>&>(**_Pnext)._Ptr == _Head) { // iterator is 结束(), move on
                _Pnext = _Pnextnext;
            } else { // orphan the iterator
                (*_Pnext)->_Myproxy = nullptr;
