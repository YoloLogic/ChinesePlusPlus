// <内存> —— memory 的中文层（C++11/14/17/20 智能指针与内存工具）
//
// 设计：包含英文原头（std::unique_ptr / shared_ptr / weak_ptr 等保持原样），
//       再在这个命名空间里加中文名。
//
// 为什么是"别名"而不是把 <memory> 抄一份再把标识符改中文（铁律 4）：
//   unique_ptr / shared_ptr 的【类型身份】参与语义 —— 第三方库的接口签名里
//   写的是 std::unique_ptr<T>。如果中文名是另抄一份实现的类型，
//   标准::唯一指针<整数> 与 std::unique_ptr<整数> 就成了两套互不相认的东西，
//   传给 std::function、放进 std::vector<std::unique_ptr<...>> 都会报错。
//   别名则保证"同一个类型、两个名字"，与 <向量>/<映射> 的处理方式一致。
//
// 英文调用方式依旧可用：std::unique_ptr / std::make_shared / std::weak_ptr …
// 中文调用方式：标准::唯一指针<整数> 一 = 标准::构造唯一<整数>(7);
#pragma once
#include <memory>
#include <utility>

名域 标准 {

    // ---------------- 智能指针类型 ----------------
    模板 <类型名 元素, 类型名 删除器 = std::default_delete<元素>>
    使用 唯一指针 = std::unique_ptr<元素, 删除器>;

    模板 <类型名 元素>
    使用 共享指针 = std::shared_ptr<元素>;

    模板 <类型名 元素>
    使用 弱指针 = std::weak_ptr<元素>;

    // ---------------- 构造（对应 make_unique / make_shared）----------------
    模板 <类型名 元素, 类型名... 诸参数>
    内联 唯一指针<元素> 构造唯一(诸参数&&... 参数) {
        返回 std::make_unique<元素>(std::forward<诸参数>(参数)...);
    }

    模板 <类型名 元素, 类型名... 诸参数>
    内联 共享指针<元素> 构造共享(诸参数&&... 参数) {
        返回 std::make_shared<元素>(std::forward<诸参数>(参数)...);
    }

    // 用指定分配器构造共享指针（allocate_shared）
    模板 <类型名 元素, 类型名 分配器类型, 类型名... 诸参数>
    内联 共享指针<元素> 分配构造共享(常量 分配器类型& 分配器, 诸参数&&... 参数) {
        返回 std::allocate_shared<元素>(分配器, std::forward<诸参数>(参数)...);
    }

    // ---------------- 指针转换（static/dynamic/const/reinterpret_pointer_cast）----------------
    模板 <类型名 目标, 类型名 源>
    内联 共享指针<目标> 静态指针转换(常量 共享指针<源>& 源指针) 不抛出 {
        返回 std::static_pointer_cast<目标>(源指针);
    }

    模板 <类型名 目标, 类型名 源>
    内联 共享指针<目标> 动态指针转换(常量 共享指针<源>& 源指针) 不抛出 {
        返回 std::dynamic_pointer_cast<目标>(源指针);
    }

    模板 <类型名 目标, 类型名 源>
    内联 共享指针<目标> 常量指针转换(常量 共享指针<源>& 源指针) 不抛出 {
        返回 std::const_pointer_cast<目标>(源指针);
    }

    模板 <类型名 目标, 类型名 源>
    内联 共享指针<目标> 重释指针转换(常量 共享指针<源>& 源指针) 不抛出 {
        返回 std::reinterpret_pointer_cast<目标>(源指针);
    }


    // ---------------- 删除器 ----------------
    模板 <类型名 元素>
    使用 默认删除 = std::default_delete<元素>;

    // ---------------- 分配器 / 分配器特征 ----------------
    模板 <类型名 元素>
    使用 分配器 = std::allocator<元素>;

    模板 <类型名 分配器类型>
    使用 分配器特征 = std::allocator_traits<分配器类型>;

    // ---------------- 原始内存工具（地址 / 构造 / 销毁）----------------
    模板 <类型名 元素>
    内联 元素* 取地址(元素& 值) 不抛出 { 返回 std::addressof(值); }

    模板 <类型名 元素>
    内联 元素* 取地址(元素&&) = 删除;   // 禁止对临时量取地址

    模板 <类型名 元素, 类型名... 诸参数>
    内联 空型 构造于(元素* 位置, 诸参数&&... 参数) {
        std::construct_at(位置, std::forward<诸参数>(参数)...);
    }

    模板 <类型名 元素>
    内联 空型 销毁于(元素* 位置) 不抛出 {
        std::destroy_at(位置);
    }

    // ---------------- 共享所有权辅助 ----------------
    模板 <类型名 元素>
    使用 启用共享自 = std::enable_shared_from_this<元素>;

    模板 <类型名 元素>
    内联 弱指针<元素> 转弱(常量 共享指针<元素>& 源指针) 不抛出 { 返回 源指针; }

    模板 <类型名 元素>
    内联 共享指针<元素> 转共享(常量 弱指针<元素>& 源指针) { 返回 源指针.lock(); }

    模板 <类型名 元素>
    内联 布尔 已过期(常量 弱指针<元素>& 源指针) 不抛出 { 返回 源指针.expired(); }

    模板 <类型名 元素>
    内联 长型 引用计数(常量 共享指针<元素>& 源指针) 不抛出 {
        返回 源指针.use_count();
    }

}