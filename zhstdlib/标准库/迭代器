_EXPORT_STD template <class _Container>
class 插入迭代器实现 { // wrap inserts into container as output iterator
public:
    using iterator_category = output_iterator_tag;
    using value_type        = void;
    using pointer           = void;
    using reference         = void;

    using 容器类型 = _Container;
#if _HAS_CXX20
    using difference_type = ptrdiff_t;
    using _包装迭代器   = ranges::iterator_t<_Container>;
#else // ^^^ _HAS_CXX20 / !_HAS_CXX20 vvv
    using difference_type = void;
    using _包装迭代器   = typename _Container::iterator;
#endif // ^^^ !_HAS_CXX20 ^^^

