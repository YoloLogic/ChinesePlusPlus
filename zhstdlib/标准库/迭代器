_EXPORT_STD template <class _Elem, class _Traits>
class 输入流缓冲迭代器实现 {
public:
    using iterator_category = input_iterator_tag;
    using value_type        = _Elem;
    using difference_type   = typename _Traits::off_type;
    using pointer           = const _Elem*;
    using reference         = _Elem;
    using char_type         = _Elem;
    using traits_type       = _Traits;
    using int_type          = typename traits_type::int_type;
    using 流缓冲类型    = basic_streambuf<_Elem, _Traits>;
    using 输入流类型      = basic_istream<_Elem, _Traits>;

    constexpr 输入流缓冲迭代器实现() noexcept : _Strbuf(nullptr), _Got(true), _Val() {}
#if _HAS_CXX20
    constexpr 输入流缓冲迭代器实现(default_sentinel_t) noexcept : _Strbuf(nullptr), _Got(true), _Val() {}
#endif // _HAS_CXX20

    输入流缓冲迭代器实现(输入流类型& _Istr) noexcept : _Strbuf(_Istr.rdbuf()), _Got(!_Strbuf), _Val() {}

    输入流缓冲迭代器实现(流缓冲类型* _Sb) noexcept : _Strbuf(_Sb), _Got(!_Sb), _Val() {}

private:
    class _输入流缓冲代理 {
    public:
        _NODISCARD _Elem operator*() const noexcept(is_nothrow_copy_constructible_v<_Elem>) /* strengthened */ {
            return _Keep;
        }

    private:
        friend 输入流缓冲迭代器实现;
        _输入流缓冲代理(流缓冲类型* _Strbuf_, _Elem _Keep_)
            noexcept(is_nothrow_copy_constructible_v<_Elem>) // strengthened
            : _Strbuf(_Strbuf_), _Keep(_Keep_) {}

        流缓冲类型* _Strbuf;
        _Elem _Keep;
    };

public:
    输入流缓冲迭代器实现(const _输入流缓冲代理& _Px) noexcept : _Strbuf(_Px._Strbuf), _Got(!_Strbuf), _Val() {}

    _NODISCARD _Elem operator*() const {
        if (!_Got) {
            _窥视();
        }

#if _ITERATOR_DEBUG_LEVEL == 2
        _STL_VERIFY(_Strbuf, "输入流缓冲迭代器实现 is not dereferenceable");
#endif // _ITERATOR_DEBUG_LEVEL == 2

        return _Val;
    }

    输入流缓冲迭代器实现& operator++() {
#if _ITERATOR_DEBUG_LEVEL == 2
        _STL_VERIFY(_Strbuf, "输入流缓冲迭代器实现 is not incrementable");
#endif // _ITERATOR_DEBUG_LEVEL == 2

        _递增();
        return *this;
    }

    _输入流缓冲代理 operator++(int) {
        if (!_Got) {
            _窥视();
        }

        _输入流缓冲代理 _Tmp{_Strbuf, _Val};
        ++*this;
        return _Tmp;
    }

    _NODISCARD bool equal(const 输入流缓冲迭代器实现& _Right) const {
        if (!_Got) {
            _窥视();
        }

        if (!_Right._Got) {
            _Right._窥视();
        }

        return (!_Strbuf && !_Right._Strbuf) || (_Strbuf && _Right._Strbuf);
    }

#if _HAS_CXX20
    _NODISCARD friend bool operator==(const 输入流缓冲迭代器实现& _Left, default_sentinel_t) {
        if (!_Left._Got) {
            _Left._窥视();
        }

        return !_Left._Strbuf;
    }
#endif // _HAS_CXX20

private:
    void _递增() { // skip to next input element
        if (!_Strbuf || traits_type::eq_int_type(traits_type::eof(), _Strbuf->sbumpc())) {
            _Strbuf = nullptr;
            _Got    = true;
        } else {
            _Got = false;
        }
    }

    _Elem _窥视() const { // peek at next input element
        int_type _Meta;
        if (!_Strbuf || traits_type::eq_int_type(traits_type::eof(), _Meta = _Strbuf->sgetc())) {
            _Strbuf = nullptr;
        } else {
            _Val = traits_type::to_char_type(_Meta);
        }

        _Got = true;
        return _Val;
    }

    mutable 流缓冲类型* _Strbuf; // the wrapped stream buffer
    mutable bool _Got; // true if _Val is valid
    mutable _Elem _Val; // next element to deliver
};

