        : container(_STD addressof(_Cont)), iter(_STD move(_Where)) {}

    _CONSTEXPR20 插入迭代器实现& operator=(const typename _Container::value_type& _Val) {
        // insert into container and increment stored iterator
        iter = container->insert(iter, _Val);
        ++iter;
        return *this;
    }

    _CONSTEXPR20 插入迭代器实现& operator=(typename _Container::value_type&& _Val) { // push value into container
        iter = container->insert(iter, _STD move(_Val));
        ++iter;
        return *this;
    }

    _NODISCARD _CONSTEXPR20 插入迭代器实现& operator*() { // pretend to return designated value
        return *this;
    }

    _CONSTEXPR20 插入迭代器实现& operator++() { // pretend to preincrement
        return *this;
    }

    _CONSTEXPR20 插入迭代器实现& operator++(int) { // pretend to postincrement
        return *this;
    }

protected:
    _Container* container;
    _包装迭代器 iter;
};

