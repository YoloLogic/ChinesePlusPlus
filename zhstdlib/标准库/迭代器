_EXPORT_STD template <class _Ty, class _Elem = char, class _Traits = char_traits<_Elem>, class _Diff = ptrdiff_t>
class 输入流迭代器实现 {
public:
    using iterator_category = input_iterator_tag;
    using value_type        = _Ty;
    using difference_type   = _Diff;
    using pointer           = const _Ty*;
    using reference         = const _Ty&;
    using char_type         = _Elem;
    using traits_type       = _Traits;
    using 输入流类型      = basic_istream<_Elem, _Traits>;

    static_assert(conjunction_v<is_default_constructible<_Ty>, is_copy_constructible<_Ty>, is_copy_assignable<_Ty>>,
        "输入流迭代器实现<T> requires T to be default constructible, copy constructible, and copy assignable. "
        "(N4950 [istream.iterator]/2)");

    constexpr 输入流迭代器实现() noexcept(is_nothrow_default_constructible_v<_Ty>) /* strengthened */ {}

#if _HAS_CXX20
    constexpr 输入流迭代器实现(default_sentinel_t)
        noexcept(is_nothrow_default_constructible_v<_Ty>) /* strengthened */ {}
#endif // _HAS_CXX20

    输入流迭代器实现(输入流类型& _Istr) : _Myistr(_STD addressof(_Istr)) {
        _取原值();
    }

    _NODISCARD const _Ty& operator*() const noexcept /* strengthened */ {
        _STL_ASSERT(_Myistr, "The stored stream pointer in_stream must be non-null");
        return _Myval;
    }

    _NODISCARD const _Ty* operator->() const noexcept /* strengthened */ {
        _STL_ASSERT(_Myistr, "The stored stream pointer in_stream must be non-null");
        return _STD addressof(_Myval);
    }

    输入流迭代器实现& operator++() {
        _取原值();
        return *this;
    }

    输入流迭代器实现 operator++(int) {
        输入流迭代器实现 _Tmp = *this;
        _取原值();
        return _Tmp;
    }

    _NODISCARD bool _相等(const 输入流迭代器实现& _Right) const noexcept {
        return _Myistr == _Right._Myistr;
    }

#if _HAS_CXX20
    _NODISCARD friend bool operator==(const 输入流迭代器实现& _Left, default_sentinel_t) noexcept /* strengthened */ {
        return !_Left._Myistr;
    }
#endif // _HAS_CXX20

private:
    void _取原值() { // get a _Ty value if possible
        _STL_ASSERT(_Myistr, "The stored stream pointer in_stream must be non-null");
        if (!(*_Myistr >> _Myval)) {
            _Myistr = nullptr;
        }
    }

    输入流类型* _Myistr{nullptr}; // pointer to input stream
    _Ty _Myval{}; // lookahead value (valid if _Myistr is not null)
};

_EXPORT_STD template <class _Ty, class _Elem, class _Traits, class _Diff>
