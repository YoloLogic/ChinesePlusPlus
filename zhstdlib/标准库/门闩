// [ZH-DERIVE-LAYER] 汉语派生层（英文兼容层）从这一行开始 —— 本行【以上】属抄来那层，有英文名就是欠账
// ============================================================================
//  第二层：在【中文的基础上】派生，把英文原名补回来
//  · 第一层 标准::细节::门闩实现 是抄自微软的中文实现，成员名全中文
//  · 本层加回英文原名，所以两种名字在【同一个对象】上都能用
//  · 与微软的原类型并存：它是【另一个类型】，不碰 std 里的定义
// ============================================================================
名域 标准 {

类型 门闩 : 公开 细节::门闩实现 {
公开:
    使用 基类 = 细节::门闩实现;
    使用 基类::基类;

    // 嵌套类型名也要补回英文（数据成员不行 —— 那会改布局）


    // 英文原名，一模板转发回中文名（不需要写签名，重载也自动跟过去）
    模板 <类型名... 参数> 声明类型(自动) count_down(参数&&... 值) { 返回 基类::递减(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) count_down(参数&&... 值) 常量 { 返回 基类::递减(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) try_wait(参数&&... 值) { 返回 基类::尝试等待(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) try_wait(参数&&... 值) 常量 { 返回 基类::尝试等待(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) arrive_and_wait(参数&&... 值) { 返回 基类::到达并等待(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) arrive_and_wait(参数&&... 值) 常量 { 返回 基类::到达并等待(static_cast<参数&&>(值)...); }

    // 表里给的额外成员（deriveExtra）—— 【中文】转发，用来给"继承自借用基类"的
    // API 补中文名（那些名字不在本文件里，members 表改不到，见方案 §3.16）
    模板 <类型名... 参数> 声明类型(自动) 等待(参数&&... 值) 常量 { 返回 基类::wait(static_cast<参数&&>(值)...); }
};
