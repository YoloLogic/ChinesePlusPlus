// <字符串视图>（§17.19 丁类薄壳）—— 本头【没有微软原头可抄】：对应英文头的全部内容
//   已经在 <字符串视图内部件> 里（步骤 1 抄好并验证过）。本文件只做两件事：
//     ① 把内部件包含进来；② 在【中文的基础上】派生，把英文原名补回来（本文件后半段）。
//   ⚠ 派生层由生成器插在下面这个守卫 #endif 之前，所以本文件必须有且只有一个 #endif。
#ifndef _ZH_STRING_VIEW_
#define _ZH_STRING_VIEW_
#include <字符串视图内部件>

// [ZH-DERIVE-LAYER] 汉语派生层（英文兼容层）从这一行开始 —— 本行【以上】属抄来那层，有英文名就是欠账
// ============================================================================
//  第二层：在【中文的基础上】派生，把英文原名补回来
//  · 第一层 标准::细节::基础字符串视图 是抄自微软的中文实现，成员名全中文
//  · 本层加回英文原名，所以两种名字在【同一个对象】上都能用
//  · 与微软的原类型并存：它是【另一个类型】，不碰 std 里的定义
// ============================================================================
名域 标准 {
模板 <类型名 元素, 类型名 特征 = std::char_traits<元素>>
类型 基础字符串视图 : 公开 细节::基础字符串视图<元素, 特征> {
公开:
    使用 基类 = 细节::基础字符串视图<元素, 特征>;
    使用 基类::基类;

    // 嵌套类型名也要补回英文（数据成员不行 —— 那会改布局）


    // 英文原名，一模板转发回中文名（不需要写签名，重载也自动跟过去）
    模板 <类型名... 参数> 声明类型(自动) size(参数&&... 值) { 返回 基类::尺寸(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) size(参数&&... 值) 常量 { 返回 基类::尺寸(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) empty(参数&&... 值) { 返回 基类::为空(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) empty(参数&&... 值) 常量 { 返回 基类::为空(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) begin(参数&&... 值) { 返回 基类::开始(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) begin(参数&&... 值) 常量 { 返回 基类::开始(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) end(参数&&... 值) { 返回 基类::结束(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) end(参数&&... 值) 常量 { 返回 基类::结束(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) cbegin(参数&&... 值) { 返回 基类::常量开始(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) cbegin(参数&&... 值) 常量 { 返回 基类::常量开始(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) cend(参数&&... 值) { 返回 基类::常量结束(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) cend(参数&&... 值) 常量 { 返回 基类::常量结束(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) rbegin(参数&&... 值) { 返回 基类::反向开始(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) rbegin(参数&&... 值) 常量 { 返回 基类::反向开始(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) rend(参数&&... 值) { 返回 基类::反向结束(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) rend(参数&&... 值) 常量 { 返回 基类::反向结束(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) crbegin(参数&&... 值) { 返回 基类::常量反向开始(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) crbegin(参数&&... 值) 常量 { 返回 基类::常量反向开始(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) crend(参数&&... 值) { 返回 基类::常量反向结束(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) crend(参数&&... 值) 常量 { 返回 基类::常量反向结束(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) front(参数&&... 值) { 返回 基类::前(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) front(参数&&... 值) 常量 { 返回 基类::前(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) back(参数&&... 值) { 返回 基类::后(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) back(参数&&... 值) 常量 { 返回 基类::后(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) at(参数&&... 值) { 返回 基类::取值(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) at(参数&&... 值) 常量 { 返回 基类::取值(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) data(参数&&... 值) { 返回 基类::数据(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) data(参数&&... 值) 常量 { 返回 基类::数据(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) substr(参数&&... 值) { 返回 基类::子串(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) substr(参数&&... 值) 常量 { 返回 基类::子串(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) remove_prefix(参数&&... 值) { 返回 基类::去前缀(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) remove_prefix(参数&&... 值) 常量 { 返回 基类::去前缀(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) remove_suffix(参数&&... 值) { 返回 基类::去后缀(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) remove_suffix(参数&&... 值) 常量 { 返回 基类::去后缀(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) starts_with(参数&&... 值) { 返回 基类::开头为(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) starts_with(参数&&... 值) 常量 { 返回 基类::开头为(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) ends_with(参数&&... 值) { 返回 基类::结尾为(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) ends_with(参数&&... 值) 常量 { 返回 基类::结尾为(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) contains(参数&&... 值) { 返回 基类::包含(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) contains(参数&&... 值) 常量 { 返回 基类::包含(static_cast<参数&&>(值)...); }

    // 表里给的额外成员（deriveExtra）—— 【中文】转发，用来给"继承自借用基类"的
    // API 补中文名（那些名字不在本文件里，members 表改不到，见方案 §3.16）
    // §17.19.2：把「用户定义转换」挪进构造体内 —— 否则 `视 = 甲` 要两次转换，编不过。
    模板 <类型名 源> 基础字符串视图(常量 源& 值) : 基类(值) {}
};
}
名域 标准 {

使用 字符串视图   = 基础字符串视图<字符>;
使用 宽字符串视图 = 基础字符串视图<宽字符>;

}  // 名域 标准

// §17.41 **特征特化不会跟着派生走**：原生在【抄来那层】对 `基础字符串视图` 特化了
//   `enable_view` / `enable_borrowed_range`，而我们的公开类型是【派生层】的
//   `标准::基础字符串视图` ✗ —— 实测 `std::ranges::view<标准::字符串视图>` 与
//   `borrowed_range` 都是假，于是 `标准::切分视图<标准::字符串视图, 标准::字符串视图>`
//   报「约束未满足」（原生同样写法编得过）。所以在 `std::ranges` 里对**公开类型**再特化一次。
名域 std::ranges {
  模板 <类型名 元素, 类型名 特征>
  常量 布尔 enable_view<标准::基础字符串视图<元素, 特征>> = 真值;
  模板 <类型名 元素, 类型名 特征>
  常量 布尔 enable_borrowed_range<标准::基础字符串视图<元素, 特征>> = 真值;
}  // 名域 std::ranges

// §17.42 同 <字符串>：`std::hash<basic_string_view<...>>` 的特化也停在抄来那层 ✗，
//   公开派生类型要自己再特化一次，否则 `标准::无序集合<标准::字符串视图>` 装不下。
名域 std {
  模板 <类型名 元素, 类型名 特征>
  结构 hash<标准::基础字符串视图<元素, 特征>> {
    size_t 运算符()(标准::基础字符串视图<元素, 特征> 值) 常量 不抛出 {
      return std::hash<std::basic_string_view<元素, 特征>>{}(std::basic_string_view<元素, 特征>(值.数据(), 值.尺寸()));
    }
  };
}  // 名域 std

#endif // _ZH_STRING_VIEW_