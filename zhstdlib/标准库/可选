    模板 <类型名... 参数> 声明类型(自动) transform(参数&&... 值) 常量 { 返回 基类::变换(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) or_else(参数&&... 值) { 返回 基类::或则(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) or_else(参数&&... 值) 常量 { 返回 基类::或则(static_cast<参数&&>(值)...); }

    // 表里给的额外成员（deriveExtra）—— 【中文】转发，用来给"继承自借用基类"的
    // API 补中文名（那些名字不在本文件里，members 表改不到，见方案 §3.16）
    // ⚠ 不能写 使用 基类::operator=; —— 那会把基类的拷贝/移动赋值也拉进来，
    //   而 int 能经转换构造变成 可选，于是 `甲 = 5` 有两个候选 -> 歧义（实测）。
    //   手写一个模板赋值即可：对 `可选 = 可选` 隐式拷贝赋值（非模板）优先，不冲突。
    模板 <类型名 实参> 可选& operator=(实参&& 右) { 基类::operator=(static_cast<实参&&>(右)); 返回 *this; }
    使用 基类::operator*;
    使用 基类::operator->;
    // value 的中文名在这里手写（它不能登记进 members 表，见该条目注释与 §15.5）
    模板 <类型名... 参数> 声明类型(自动) 取值(参数&&... 值) { 返回 基类::value(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 取值(参数&&... 值) 常量 { 返回 基类::value(static_cast<参数&&>(值)...); }
};
}

名域 标准 {

// 坏可选访问异常（std::bad_optional_access）—— 只能是 std 的那个（铁律 4）
使用 坏可选访问 = std::bad_optional_access;

// 顶层 tag 类型也要能在 标准 里写
使用 空值类型 = 细节::空值类型;

// 无值（std::nullopt）—— 全局常量，成员转发管不到，手写
// ⚠ MSVC 的 nullopt_t 取的是嵌套的 _Tag，不是 int（我照 cppreference 写 {42} 是错的）：
//     struct nullopt_t { struct _Tag {}; constexpr explicit nullopt_t(_Tag) {} };
// ⚠⚠ §16.38：这行是【手写层引用拷贝层的名字】—— 拷贝层把 _Tag 翻成了 _标记，
//     手写层必须跟着改（否则 '空值类型' 里没有名为 '_Tag' 的成员）。
//     判据：**手写 extra/deriveExtra 里凡是 `细节::X::Y` 形态的引用，
//     都要在 X/Y 被登记改名时一并核对** —— 编译器会报，但没有守卫会替你记住。
内联 常量表达式 空值类型 无值{细节::空值类型::_标记{}};

}  // 名域 标准

#endif // _OPTIONAL_
