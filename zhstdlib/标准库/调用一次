_EXPORT_STD struct 一次标志实现 { // opaque data structure for 一次调用()
    constexpr 一次标志实现() noexcept : _Opaque(nullptr) {}

    一次标志实现(const 一次标志实现&)            = delete;
    一次标志实现& operator=(const 一次标志实现&) = delete;

    void* _Opaque;
};

template <class _类型>
union _永不析构实现 { // constructs _类型, never destroys
    constexpr _永不析构实现() noexcept : _Storage{} {}
    _永不析构实现(const _永不析构实现&)            = delete;
    _永不析构实现& operator=(const _永不析构实现&) = delete;
    ~_永不析构实现() {
        // do nothing
    }

    _类型 _Storage;
};

