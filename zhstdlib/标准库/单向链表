            const auto _Tombstone{reinterpret_cast<_结点指针>(_MSVC_STL_UINTPTR_TOMBSTONE_VALUE)};
            _Myhead = _Tombstone;
        }
    }
#endif // _MSVC_STL_DESTRUCTOR_TOMBSTONES

    _结点指针 _头之前() const noexcept { // return pointer to the "before 开始" pseudo node
        return pointer_traits<_结点指针>::pointer_to(reinterpret_cast<_节点&>(const_cast<_结点指针&>(_Myhead)));
    }

#if _ITERATOR_DEBUG_LEVEL == 2
    void _孤立指针(_结点指针 _Ptr) noexcept { // orphan iterators with specified node pointers
        const auto _BHead = _头之前();
        _Lockit _加锁(_LOCK_DEBUG);
        _迭代器基类12** _Pnext = &this->_Myproxy->_Myfirstiter;
        while (*_Pnext) {
            const auto _Pnextptr = static_cast<_单向链表常量迭代器<_单向链表值>&>(**_Pnext)._Ptr;
            if (_Pnextptr == _BHead || (_Ptr != nullptr && _Pnextptr != _Ptr)) {
                _Pnext = &(*_Pnext)->_Mynextiter;
            } else { // orphan the iterator
                (*_Pnext)->_Myproxy = nullptr;
                *_Pnext             = (*_Pnext)->_Mynextiter;
            }
        }
    }
#endif // _ITERATOR_DEBUG_LEVEL == 2

    template <class _Pr2>
    static _结点指针 _就地归并(_结点指针 _BFirst1, const _结点指针 _BMid, const _结点指针 _BLast, _Pr2 _Pred) {
        // Merge the sorted ranges (_BFirst1, _BMid] and (_BMid, _BLast)
        // Returns one before the new logical 结束 of the range.
        auto _First2 = _BMid->_Next;
        for (;;) { // process 1 splice
            _结点指针 _First1;
            for (;;) { // advance _BFirst1 over elements already in position
                if (_BFirst1 == _BMid) {
                    return _BLast;
                }

                _First1 = _BFirst1->_Next;
                if (_DEBUG_LT_PRED(_Pred, _First2->_Myval, _First1->_Myval)) {
                    // _First2->_Myval is out of order
                    break;
                }

                // _First1->_Myval is already in position; advance
                _BFirst1 = _First1;
            }

            // find the 结束 of the "run" of elements less than _First1->_Myval in the 2nd range
            auto _BRun_end = _First2;
            _结点指针 _Run_end;
            for (;;) {
                _Run_end = _BRun_end->_Next;
                if (_BRun_end == _BLast) {
                    break;
                }

                if (!_DEBUG_LT_PRED(_Pred, _Run_end->_Myval, _First1->_Myval)) {
                    // _Run_end is the first element in (_BMid->_Myval, _BLast->_Myval) that shouldn't precede
                    // _First1->_Myval.
                    // After the splice _First1->_Myval will be in position and must not be compared again.
                    break;
                }

                _BRun_end = _Run_end;
            }

            _BMid->_Next     = _Run_end; // snip out the run from its old position
            _BFirst1->_Next  = _First2; // insert into new position
            _BRun_end->_Next = _First1;
            if (_BRun_end == _BLast) {
                return _BMid;
            }

            _BFirst1 = _First1;
            _First2  = _Run_end;
        }
    }

    template <class _Pr2>
    static _结点指针 _排序2(const _结点指针 _BFirst, _Pr2 _Pred) {
        // Sort (_BFirst, _BFirst + 2], unless nullptr is encountered.
        // Returns a pointer one before the 结束 of the sorted region.
        const auto _First1 = _BFirst->_Next;
        if (!_First1) {
            return _BFirst;
        }

        auto _First2 = _First1->_Next;
        if (!_First2 || !_DEBUG_LT_PRED(_Pred, _First2->_Myval, _First1->_Myval)) {
            return _First1;
        }

        // swap _First2 and _First1
        _First1->_Next = _First2->_Next; // snip out *_First2
        _BFirst->_Next = _First2; // insert *_First2 before *_First1
        _First2->_Next = _First1;
        return _First2;
    }

    template <class _Pr2>
    static _结点指针 _排序(const _结点指针 _BFirst, size_type _Bound, _Pr2 _Pred) {
        // Sort (_BFirst, _BFirst + _Bound), unless nullptr is encountered.
        // Returns a pointer one before the 结束 of the sorted region.
        if (_Bound <= 2) {
            return _排序2(_BFirst, _Pred);
        }

        const auto _Half_bound = _Bound / 2;
        const auto _BMid       = _排序(_BFirst, _Half_bound, _Pred);
        if (!_BMid->_Next) {
            return _BMid;
        }

        const auto _BLast = _排序(_BMid, _Half_bound, _Pred);
        return _就地归并(_BFirst, _BMid, _BLast, _Pred);
    }

    template <class _Pr2>
    static void _排序(_结点指针 _BFirst, _Pr2 _Pred) {
        auto _BMid       = _排序2(_BFirst, _Pred);
        size_type _Bound = 2;
        do {
            if (!_BMid->_Next) {
                return;
            }

            const auto _BLast = _排序(_BMid, _Bound, _Pred);
            _BMid             = _就地归并(_BFirst, _BMid, _BLast, _Pred);
            _Bound <<= 1;
        } while (_Bound != 0);
    }

    _结点指针 _Myhead; // pointer to head node
};

template <class _结点分配器>
struct _单向链表后插操作2 {
    // 单向链表实现 insert-after operation which maintains exception safety
    using _结点分配器特征 = allocator_traits<_结点分配器>;
    using pointer        = typename _结点分配器特征::pointer;
    using value_type     = typename _结点分配器特征::value_type;

    explicit _单向链表后插操作2(_结点分配器& _Al_) : _Al(_Al_), _Tail() {}

    _单向链表后插操作2(const _单向链表后插操作2&)            = delete;
    _单向链表后插操作2& operator=(const _单向链表后插操作2&) = delete;

    template <class... _CArgT>
    void _追加n(typename _结点分配器特征::size_type _Count, const _CArgT&... _Carg) {
        // Append _Count elements, constructed from _Carg
        if (_Count <= 0) {
            return;
        }

        _分配器构造指针<_结点分配器> _新节点(_Al);
        if (_Tail == pointer{}) {
            _新节点._分配(); // throws
            _结点分配器特征::construct(_Al, _STD addressof(_新节点._Ptr->_Myval), _Carg...); // throws
            _Head = _新节点._Ptr;
            _Tail = _新节点._Ptr;
            --_Count;
        }

        for (; 0 < _Count; --_Count) {
            _新节点._分配(); // throws
            _结点分配器特征::construct(_Al, _STD addressof(_新节点._Ptr->_Myval), _Carg...); // throws
            _就地构造(_Tail->_Next, _新节点._Ptr);
            _Tail = _新节点._Ptr;
        }

        (void) _新节点._释放();
    }

    template <class _InIt, class _哨兵>
    void _追加范围非检查(_InIt _首个, const _哨兵 _最后) {
        // Append the values in [_首个, _最后)
        if (_首个 == _最后) { // throws
            return;
        }

        _分配器构造指针<_结点分配器> _新节点(_Al);
        if (_Tail == pointer{}) {
            _新节点._分配(); // throws
            _结点分配器特征::construct(_Al, _STD addressof(_新节点._Ptr->_Myval), *_首个); // throws
            const auto _Newhead = _新节点._释放();
            _Head               = _Newhead;
            _Tail               = _Newhead;
            ++_首个; // throws
        }

        while (_首个 != _最后) { // throws
            _新节点._分配(); // throws
            _结点分配器特征::construct(_Al, _STD addressof(_新节点._Ptr->_Myval), *_首个); // throws
            const auto _Newtail = _新节点._释放();
            _就地构造(_Tail->_Next, _Newtail);
            _Tail = _Newtail;
            ++_首个; // throws
        }
    }

    pointer _接在其后(pointer _After) noexcept {
        // Attaches the elements in *this after _After, and resets *this to the default-initialized state
        const auto _Local_tail = _Tail;
        if (_Local_tail == pointer{}) {
            return _After;
        }

        _就地构造(_Local_tail->_Next, _After->_Next);
        _After->_Next = _Head;
        _Tail         = pointer{};

        return _Local_tail;
    }

    ~_单向链表后插操作2() {
        if (_Tail == pointer{}) {
            return;
        }

        _就地构造(_Tail->_Next, pointer{});
        pointer _Subject = _Head;
        while (_Subject) {
            value_type::_释放节点(_Al, _STD exchange(_Subject, _Subject->_Next));
        }
    }

private:
    _结点分配器& _Al;
    pointer _Tail; // Points to the most recently constructed node. If pointer{}, the value of _Head is indeterminate.
                   // _Tail->_Next is not constructed.
    pointer _Head; // Points at the first constructed node.
};

