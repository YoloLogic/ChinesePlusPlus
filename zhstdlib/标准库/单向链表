class _单向链表值 : public _容器基类 {
public:
    using _结点指针 = typename _值类型集::_结点指针;
    using _节点    = typename pointer_traits<_结点指针>::element_type;

    using value_type      = typename _值类型集::value_type;
    using size_type       = typename _值类型集::size_type;
    using difference_type = typename _值类型集::difference_type;
    using pointer         = typename _值类型集::pointer;
    using const_pointer   = typename _值类型集::const_pointer;
    using reference       = value_type&;
    using const_reference = const value_type&;

