    struct _单向链表节点删除操作 {
        // tracks nodes pending removal in a 移除 operation, so that program-defined predicates may reference those
        // elements until the removal is complete.

        explicit _单向链表节点删除操作(单向链表实现& _List_) noexcept
            : _List(_List_), _Head(), _Tail(_STD addressof(_Head)) {}

        _单向链表节点删除操作(const _单向链表节点删除操作&)            = delete;
        _单向链表节点删除操作& operator=(const _单向链表节点删除操作&) = delete;

        _结点指针 _转移至末尾(const _结点指针 _Predecessor) noexcept {
            // extract _Predecessor->_Next from the container, and add it to the singly-linked list of nodes to destroy
            // returns the successor of the removed node

            // snip the node out
            const auto _Removed = _Predecessor->_Next;
            const auto _Next    = _Removed->_Next;
            _Removed->_Next     = nullptr;
            _Predecessor->_Next = _Next;

            *_Tail = _Removed;
            _Tail  = _STD addressof(_Removed->_Next);

            return _Next;
        }

        ~_单向链表节点删除操作() {
            auto& _Al    = _List._取分配器();
            auto _Target = _Head;
            while (_Target) {
                auto _Next = _Target->_Next;
#if _ITERATOR_DEBUG_LEVEL == 2
                _List._Mypair._Myval2._孤立指针(_Target);
#endif // _ITERATOR_DEBUG_LEVEL == 2
                _结点分配器特征::destroy(_Al, _STD addressof(_Target->_Next));
                _结点分配器特征::destroy(_Al, _STD addressof(_Target->_Myval));
                _Al.deallocate(_Target, 1);
                _Target = _Next;
            }
        }

        单向链表实现& _List;
        _结点指针 _Head;
        _结点指针* _Tail;
    };

    _LIST_REMOVE_RETURN 移除(const _类型& _Val) { // erase each element matching _Val
        return 按条件移除([&](const _类型& _Other) -> bool { return _Other == _Val; });
    }

    template <class _Pr1>
    _LIST_REMOVE_RETURN 按条件移除(_Pr1 _Pred) { // erase each element satisfying _Pr1
        _单向链表节点删除操作 _操作(*this);
        auto _Firstb       = _非检查首前();
        size_type _Removed = 0;

        for (auto _首个 = _非检查开始(); _首个._Ptr;) {
            if (_Pred(*_首个)) {
                _首个._Ptr = _操作._转移至末尾(_Firstb._Ptr);
                ++_Removed;
            } else { // advance iterators
                _Firstb = _首个;
                ++_首个;
            }
        }

#if _HAS_CXX20
        return _Removed;
#else
        (void) _Removed;
#endif
    }

    _LIST_REMOVE_RETURN 去重() { // erase each element matching previous
        return 去重(equal_to<>{});
    }

    template <class _Pr2>
    _LIST_REMOVE_RETURN 去重(_Pr2 _Pred) { // erase each element satisfying _Pred with previous
        _单向链表节点删除操作 _操作(*this);
        auto _首个        = _非检查开始();
        size_type _Removed = 0;
        if (_首个._Ptr) { // worth doing
            auto _After = _首个;
            ++_After;
            while (_After._Ptr) {
                if (_Pred(*_首个, *_After)) {
                    _After._Ptr = _操作._转移至末尾(_首个._Ptr);
                    ++_Removed;
                } else {
                    _首个 = _After;
                    ++_After;
                }
            }
        }

#if _HAS_CXX20
        return _Removed;
#else
        (void) _Removed;
#endif
    }

    void 归并(单向链表实现& _Right) { // 归并 in elements from _Right, both ordered by operator<
        _归并1(_Right, less<>{});
    }

    void 归并(单向链表实现&& _Right) { // 归并 in elements from _Right, both ordered by operator<
        _归并1(_Right, less<>{});
    }

    template <class _Pr2>
    void 归并(单向链表实现& _Right, _Pr2 _Pred) { // 归并 in elements from _Right, both ordered by _Pred
        _归并1(_Right, _传递函数(_Pred));
    }

    template <class _Pr2>
    void 归并(单向链表实现&& _Right, _Pr2 _Pred) { // 归并 in elements from _Right, both ordered by _Pred
        _归并1(_Right, _传递函数(_Pred));
    }

private:
    template <class _Pr2>
    void _归并1(单向链表实现& _Right, _Pr2 _Pred) { // 归并 in elements from _Right, both ordered by _Pred
#if _ITERATOR_DEBUG_LEVEL != 0
        _DEBUG_ORDER_UNWRAPPED(_非检查开始(), _Default_sentinel{}, _Pred);
#endif // _ITERATOR_DEBUG_LEVEL != 0
        if (this == _STD addressof(_Right)) {
            return;
        }

        auto& _My_data    = _Mypair._Myval2;
        auto& _Right_data = _Right._Mypair._Myval2;
#if _ITERATOR_DEBUG_LEVEL != 0
        _DEBUG_ORDER_UNWRAPPED(_Right._非检查开始(), _Default_sentinel{}, _Pred);
        if constexpr (!_结点分配器特征::is_always_equal::value) {
            _STL_VERIFY(_取分配器() == _Right._取分配器(), "单向链表实现 allocators incompatible for 归并");
        }
#endif // _ITERATOR_DEBUG_LEVEL != 0

        if (!_My_data._Myhead) {
            // *this is 为空; take all elements of _Right with no comparisons
#if _ITERATOR_DEBUG_LEVEL == 2
            {
                _Lockit _加锁(_LOCK_DEBUG);
                _转移非首前所有权(_Right);
            } // unlock
#endif // _ITERATOR_DEBUG_LEVEL == 2
            _My_data._Myhead    = _Right_data._Myhead;
            _Right_data._Myhead = nullptr;
            return;
        }

#if _ITERATOR_DEBUG_LEVEL == 2
        constexpr bool _Noexcept =
            noexcept(_DEBUG_LT_PRED(_Pred, _My_data._Myhead->_Myval, _Right_data._Myhead->_Myval));
        if constexpr (_Noexcept) {
            // if the comparison is noexcept, we can take all the iterators in one go and avoid quadratic updates of
            // the iterator chain
            _Lockit _加锁(_LOCK_DEBUG);
            _转移非首前所有权(_Right);
        } // unlock
#endif // _ITERATOR_DEBUG_LEVEL == 2

        if (!_Right_data._Myhead) {
            return;
        }

        auto _BFirst1 = _My_data._头之前();
        auto _First2  = _Right_data._Myhead;
        for (;;) { // process 1 splice
            _结点指针 _First1;
            for (;;) { // advance _BFirst1 over elements already in position
                _First1 = _BFirst1->_Next;
                if (!_First1) { // all elements in _Right are greater than elements in *this, splice them all
                    _BFirst1->_Next     = _First2;
                    _Right_data._Myhead = nullptr;
                    return;
                }

                if (_DEBUG_LT_PRED(_Pred, _First2->_Myval, _First1->_Myval)) {
                    // _First2->_Myval is out of order
                    break;
                }

                // _First1->_Myval is already in position; advance
                _BFirst1 = _First1;
            }

            // find the 结束 of the "run" of elements less than _First1->_Myval in _Right
            auto _BRun_end = _First2;
            _结点指针 _Run_end;
            for (;;) {
                _Run_end = _BRun_end->_Next;
                if (!_Run_end) {
                    break;
                }

                if (!_DEBUG_LT_PRED(_Pred, _Run_end->_Myval, _First1->_Myval)) {
                    // _Run_end is the first element in _Right that shouldn't precede _First1->_Myval.
                    // After the splice _First1->_Myval will be in position and must not be compared again.
                    break;
                }

                _BRun_end = _Run_end;
            }

#if _ITERATOR_DEBUG_LEVEL == 2
            if constexpr (!_Noexcept) {
                _Lockit _加锁(_LOCK_DEBUG);
                for (auto _Next = _First2; _Next != _Run_end; _Next = _Next->_Next) {
                    _转移所有权(_Right, _Next);
                }
            } // unlock
#endif // _ITERATOR_DEBUG_LEVEL == 2

            _Right_data._Myhead = _Run_end; // snip out the run from its old position
            _BFirst1->_Next     = _First2; // insert into new position
            _BRun_end->_Next    = _First1;
            if (!_Run_end) {
                return;
            }

            _BFirst1 = _First1;
            _First2  = _Run_end;
        }
    }

public:
    void 排序() { // order sequence
        _迭代器检查值::_排序(_Mypair._Myval2._头之前(), less<>{});
    }

    template <class _Pr2>
    void 排序(_Pr2 _Pred) { // order sequence
        _迭代器检查值::_排序(_Mypair._Myval2._头之前(), _传递函数(_Pred));
    }

    void 反转() noexcept { // 反转 sequence
        auto _Current = _Mypair._Myval2._Myhead;
        if (!_Current) {
            // 为空 单向链表实现
            return;
        }

        _结点指针 _Prev{};
        for (;;) {
            const auto _Next = _Current->_Next;
            _Current->_Next  = _Prev;
            if (!_Next) {
                _Mypair._Myval2._Myhead = _Current;
                return;
            }

            _Prev    = _Current;
            _Current = _Next;
        }
    }

private:
#if _ITERATOR_DEBUG_LEVEL == 2
    void _转移非首前所有权(单向链表实现& _Right) noexcept {
        // requires holding the debug lock
        const auto _我的容器            = _STD addressof(_Mypair._Myval2);
        const auto _Myproxy           = _我的容器->_Myproxy;
        const auto _Right_before_head = _Right._Mypair._Myval2._头之前();
        _迭代器基类12** _Pnext     = &_Right._Mypair._Myval2._Myproxy->_Myfirstiter;
        while (*_Pnext) {
            const auto _Pnextptr = static_cast<const_iterator&>(**_Pnext)._Ptr;
            if (_Pnextptr == _Right_before_head) {
                _Pnext = &(*_Pnext)->_Mynextiter;
            } else { // take the iterator
                const auto _Extracted   = *_Pnext;
                *_Pnext                 = (*_Pnext)->_Mynextiter;
                _Extracted->_Myproxy    = _Myproxy;
                _Extracted->_Mynextiter = _Myproxy->_Myfirstiter;
                _Myproxy->_Myfirstiter  = _Extracted;
            }
        }
    }

    void _转移所有权(单向链表实现& _Right, _结点指针 _Target) noexcept {
        // requires holding the debug lock
        const auto _我的容器        = _STD addressof(_Mypair._Myval2);
        const auto _Myproxy       = _我的容器->_Myproxy;
        _迭代器基类12** _Pnext = &_Right._Mypair._Myval2._Myproxy->_Myfirstiter;
        while (*_Pnext) {
            const auto _Pnextptr = static_cast<const_iterator&>(**_Pnext)._Ptr;
            if (_Pnextptr != _Target) {
                _Pnext = &(*_Pnext)->_Mynextiter;
            } else { // take the iterator
                const auto _Extracted   = *_Pnext;
                *_Pnext                 = (*_Pnext)->_Mynextiter;
                _Extracted->_Myproxy    = _Myproxy;
                _Extracted->_Mynextiter = _Myproxy->_Myfirstiter;
                _Myproxy->_Myfirstiter  = _Extracted;
            }
        }
    }
#endif // _ITERATOR_DEBUG_LEVEL == 2

    void _接合其后(_结点指针 _Where, 单向链表实现& _Right, _结点指针 _Prev) noexcept {
        // splice _Right (_Prev, _Prev + 2) after _Where
#if _ITERATOR_DEBUG_LEVEL == 0
        (void) _Right;
#else // ^^^ _ITERATOR_DEBUG_LEVEL == 0 / _ITERATOR_DEBUG_LEVEL != 0 vvv
        if constexpr (!_结点分配器特征::is_always_equal::value) {
            _STL_VERIFY(_取分配器() == _Right._取分配器(), "单向链表实现 containers incompatible for 后接合");
        }
#endif // ^^^ _ITERATOR_DEBUG_LEVEL != 0 ^^^

#if _ITERATOR_DEBUG_LEVEL == 2
        if (this != _STD addressof(_Right)) {
            _Lockit _加锁(_LOCK_DEBUG);
            _转移所有权(_Right, _Prev->_Next);
        }
#endif // _ITERATOR_DEBUG_LEVEL == 2

        if (_Where != _Prev) {
            const auto _首个 = _Prev->_Next;
            if (_Where != _首个) {
                _Prev->_Next  = _首个->_Next;
                _首个->_Next = _Where->_Next;
                _Where->_Next = _首个;
            }
        }
    }

    template <class _哨兵>
    void _接合其后(_非检查常量迭代器 _Where, 单向链表实现& _Right, _非检查常量迭代器 _首个,
        _哨兵 _最后) noexcept {
        // splice _Right (_首个, _最后) just after _Where
#if _ITERATOR_DEBUG_LEVEL == 0
        (void) _Right;
#else // ^^^ _ITERATOR_DEBUG_LEVEL == 0 / _ITERATOR_DEBUG_LEVEL != 0 vvv
        if constexpr (!_结点分配器特征::is_always_equal::value) {
            _STL_VERIFY(_取分配器() == _Right._取分配器(), "单向链表实现 containers incompatible for 后接合");
        }
#endif // ^^^ _ITERATOR_DEBUG_LEVEL != 0 ^^^

        if (_首个 == _最后) {
            return;
        }

#if _ITERATOR_DEBUG_LEVEL == 2
        if (this != _STD addressof(_Right)) { // transfer ownership of (_首个, _最后)
            _Lockit _加锁(_LOCK_DEBUG);
            _非检查常量迭代器 _Next = _首个;
            while (++_Next != _最后) { // transfer ownership
                _转移所有权(_Right, _Next._Ptr);
            }
        }
#endif // _ITERATOR_DEBUG_LEVEL == 2

        // find prev(_最后)
        _非检查常量迭代器 _After = _首个;
        ++_After;
        if (_After == _最后) {
            return;
        }

        _非检查常量迭代器 _Prev_last = _首个;
        do {
            _Prev_last = _After;
            ++_After;
        } while (_After != _最后);

        const auto _Extracted_head = _首个._Ptr->_Next;
        _首个._Ptr->_Next         = _After._Ptr;
        _Prev_last._Ptr->_Next     = _Where._Ptr->_Next;
        _Where._Ptr->_Next         = _Extracted_head;
    }

    void _分配代理() {
        _Mypair._Myval2._分配代理(_取代理分配器(_结点分配器, _取分配器()));
    }

    void _交换代理与迭代器(单向链表实现& _Right) noexcept {
        _Mypair._Myval2._交换代理与迭代器(_Right._Mypair._Myval2);
    }

    _结点分配器& _取分配器() noexcept {
        return _Mypair._取第一();
    }

    const _结点分配器& _取分配器() const noexcept {
        return _Mypair._取第一();
    }

    _压缩对<_结点分配器, _迭代器检查值> _Mypair;
};

