_EXPORT_STD class 线程实现 { // class for observing and managing threads
public:
    class id;

    using native_handle_type = void*;

    线程实现() noexcept : _Thr{} {}

private:
#if _HAS_CXX20
    friend 可停线程实现;
#endif // _HAS_CXX20

    template <class _元组, size_t... _下标集>
    static unsigned int __stdcall _调用(void* _RawVals) noexcept /* terminates */ {
        // adapt invoke of user's callable object to _beginthreadex's 线程实现 procedure
        const unique_ptr<_元组> _函数值(static_cast<_元组*>(_RawVals));
        _元组& _Tup = *_函数值.get(); // avoid ADL, handle incomplete types
        _STD invoke(_STD move(_STD get<_下标集>(_Tup))...);
        _Cnd_do_broadcast_at_thread_exit(); // TRANSITION, ABI
        return 0;
    }

    template <class _元组, size_t... _下标集>
    _NODISCARD static constexpr auto _取调用(index_sequence<_下标集...>) noexcept {
        return &_调用<_元组, _下标集...>;
    }

#pragma warning(push) // pointer or reference to potentially throwing function passed to 'extern "C"' function under
#pragma warning(disable : 5039) // -EHc. Undefined behavior may occur if this function throws an exception. (/Wall)
    template <class _Fn, class... _Args>
    void _启动(_Fn&& _Fx, _Args&&... _Ax) {
        using _元组                 = tuple<decay_t<_Fn>, decay_t<_Args>...>;
        auto _Decay_copied           = _STD make_unique<_元组>(_STD forward<_Fn>(_Fx), _STD forward<_Args>(_Ax)...);
        constexpr auto _Invoker_proc = _取调用<_元组>(make_index_sequence<1 + sizeof...(_Args)>{});

        _Thr._Hnd =
            reinterpret_cast<void*>(_CSTD _beginthreadex(nullptr, 0, _Invoker_proc, _Decay_copied.get(), 0, &_Thr._Id));

        if (_Thr._Hnd) { // ownership transferred to the 线程实现
            (void) _Decay_copied.release();
        } else { // failed to start 线程实现
            _Thr._Id = 0;
            _Throw_Cpp_error(_RESOURCE_UNAVAILABLE_TRY_AGAIN);
        }
    }
#pragma warning(pop)

public:
    template <class _Fn, class... _Args, enable_if_t<!is_same_v<_Remove_cvref_t<_Fn>, 线程实现>, int> = 0>
    _NODISCARD_CTOR_THREAD explicit 线程实现(_Fn&& _Fx, _Args&&... _Ax) {
        _启动(_STD forward<_Fn>(_Fx), _STD forward<_Args>(_Ax)...);
    }

    ~线程实现() noexcept {
        if (可汇合()) {
            _STD terminate(); // per N4950 [线程实现.线程实现.destr]/1
        }
    }

    线程实现(线程实现&& _Other) noexcept : _Thr(_STD exchange(_Other._Thr, {})) {}

    线程实现& operator=(线程实现&& _Other) noexcept {
        if (可汇合()) {
            _STD terminate(); // per N4950 [线程实现.线程实现.assign]/1
        }

        _Thr = _STD exchange(_Other._Thr, {});
        return *this;
    }

    线程实现(const 线程实现&)            = delete;
    线程实现& operator=(const 线程实现&) = delete;

    void swap(线程实现& _Other) noexcept {
        _STD swap(_Thr, _Other._Thr);
    }

    _NODISCARD bool 可汇合() const noexcept {
        return _Thr._Id != 0;
    }

    void 汇合() {
        if (!可汇合()) {
            _Throw_Cpp_error(_INVALID_ARGUMENT);
        }

        if (_Thr._Id == _Thrd_id()) {
            _Throw_Cpp_error(_RESOURCE_DEADLOCK_WOULD_OCCUR);
        }

        if (_Thrd_join(_Thr, nullptr) != _Thrd_result::_Success) {
            _Throw_Cpp_error(_NO_SUCH_PROCESS);
        }

        _Thr = {};
    }

    void 分离() {
        if (!可汇合()) {
            _Throw_Cpp_error(_INVALID_ARGUMENT);
        }

        if (_Thrd_detach(_Thr) != _Thrd_result::_Success) {
            _Throw_Cpp_error(_INVALID_ARGUMENT);
        }

        _Thr = {};
    }

    _NODISCARD id 取标识() const noexcept;

    _NODISCARD native_handle_type 原生句柄() noexcept /* strengthened */ { // return Win32 HANDLE as void *
        return _Thr._Hnd;
    }

    _NODISCARD static unsigned int 硬件并发数() noexcept {
        return _Thrd_hardware_concurrency();
    }

private:
    _Thrd_t _Thr;
};

template <class _表示, class _Period>
_NODISCARD auto _To_absolute_time(const chrono::duration<_表示, _Period>& _Rel_time) noexcept {
    constexpr auto _Zero                 = chrono::duration<_表示, _Period>::zero();
    const auto _Now                      = chrono::steady_clock::now();
    decltype(_Now + _Rel_time) _Abs_time = _Now; // return common type
    if (_Rel_time > _Zero) {
        constexpr auto _Forever = (decltype(_Abs_time)::max)();
        if (_Abs_time < _Forever - _Rel_time) {
            _Abs_time += _Rel_time;
        } else {
            _Abs_time = _Forever;
        }
    }
    return _Abs_time;
}

struct _钳位相对时间毫秒计数结果 {
    unsigned long _Count;
    bool _Clamped;
};

template <class _Duration>
_NODISCARD _钳位相对时间毫秒计数结果 _Clamped_rel_time_ms_count(const _Duration& _Rel) {
    // _Clamp must be less than 2^32 - 1 (INFINITE) milliseconds, but is otherwise arbitrary.
    constexpr chrono::milliseconds _Clamp{chrono::hours{24}};

    if (_Rel > _Clamp) {
        return {static_cast<unsigned long>(_Clamp.count()), true};
    } else {
        const auto _Rel_ms = chrono::ceil<chrono::milliseconds>(_Rel);
        return {static_cast<unsigned long>(_Rel_ms.count()), false};
    }
}

namespace 本线程 {
    _EXPORT_STD _NODISCARD 线程实现::id 取标识() noexcept;

    _EXPORT_STD inline void 让出() noexcept {
        _Thrd_yield();
    }

    _EXPORT_STD template <class _Clock, class _Duration>
    void 睡至时刻(const chrono::time_point<_Clock, _Duration>& _Abs_time) {
        static_assert(chrono::_Is_clock_v<_Clock>, "Clock type required");
        for (;;) {
            const auto _Now = _Clock::now();
            if (_Abs_time <= _Now) {
                return;
            }

            const unsigned long _Rel_ms_count = _Clamped_rel_time_ms_count(_Abs_time - _Now)._Count;
            _Thrd_sleep_for(_Rel_ms_count);
        }
    }

    _EXPORT_STD template <class _表示, class _Period>
    void 睡眠时长(const chrono::duration<_表示, _Period>& _Rel_time) {
        睡至时刻(_To_absolute_time(_Rel_time));
    }
} // namespace 本线程

