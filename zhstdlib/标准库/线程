#if _HAS_CXX20
_EXPORT_STD class 可停线程实现 {
public:
    using id                 = 线程实现::id;
    using native_handle_type = 线程实现::native_handle_type;

    可停线程实现() noexcept : _Impl{}, _Ssource{nostopstate} {}

    template <class _Fn, class... _Args>
        requires (!is_same_v<remove_cvref_t<_Fn>, 可停线程实现>)
    _NODISCARD_CTOR_JTHREAD explicit 可停线程实现(_Fn&& _Fx, _Args&&... _Ax) {
        if constexpr (is_invocable_v<decay_t<_Fn>, 停止令牌实现, decay_t<_Args>...>) {
            _Impl._启动(_STD forward<_Fn>(_Fx), _Ssource.取令牌(), _STD forward<_Args>(_Ax)...);
        } else {
            _Impl._启动(_STD forward<_Fn>(_Fx), _STD forward<_Args>(_Ax)...);
        }
    }

    ~可停线程实现() {
        _尝试取消并汇合();
    }

    可停线程实现(const 可停线程实现&)            = delete;
    可停线程实现(可停线程实现&&) noexcept        = default;
    可停线程实现& operator=(const 可停线程实现&) = delete;

    可停线程实现& operator=(可停线程实现&& _Other) noexcept {
        if (this == _STD addressof(_Other)) {
            return *this;
        }

        _尝试取消并汇合();
        _Impl    = _STD move(_Other._Impl);
        _Ssource = _STD move(_Other._Ssource);
        return *this;
    }

    void swap(可停线程实现& _Other) noexcept {
        _Impl.swap(_Other._Impl);
        _Ssource.swap(_Other._Ssource);
    }

    _NODISCARD bool 可汇合() const noexcept {
        return _Impl.可汇合();
    }

    void 汇合() {
        _Impl.汇合();
    }

    void 分离() {
        _Impl.分离();
    }

    _NODISCARD id 取标识() const noexcept {
        return _Impl.取标识();
    }

    _NODISCARD native_handle_type 原生句柄() noexcept /* strengthened */ {
        return _Impl.原生句柄();
    }

    _NODISCARD 停止源实现 取停止源() noexcept {
        return _Ssource;
    }

    _NODISCARD 停止令牌实现 取停止令牌() const noexcept {
        return _Ssource.取令牌();
    }

    bool 请求停止() noexcept {
        return _Ssource.请求停止();
    }

    friend void swap(可停线程实现& _Lhs, 可停线程实现& _Rhs) noexcept {
        _Lhs.swap(_Rhs);
    }

    _NODISCARD static unsigned int 硬件并发数() noexcept {
        return 线程实现::硬件并发数();
    }

private:
    void _尝试取消并汇合() noexcept {
        if (_Impl.可汇合()) {
            _Ssource.请求停止();
            _Impl.汇合();
        }
    }

    线程实现 _Impl;
    停止源实现 _Ssource;
};
#endif // _HAS_CXX20
