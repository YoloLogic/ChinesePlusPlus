#ifndef _USE_DETAILED_FUNCTION_NAME_IN_SOURCE_LOCATION
#define _USE_DETAILED_FUNCTION_NAME_IN_SOURCE_LOCATION 1
#endif // ^^^ !defined(_USE_DETAILED_FUNCTION_NAME_IN_SOURCE_LOCATION) ^^^

名域 标准 { 名域 细节 {
使用 名域 std;
_EXPORT_STD struct 源码位置 {
    _NODISCARD static consteval 源码位置 当前(const uint_least32_t _行号_ = __builtin_LINE(),
        const uint_least32_t _列号_ = __builtin_COLUMN(), const char* const _文件_ = __builtin_FILE(),
#if _USE_DETAILED_FUNCTION_NAME_IN_SOURCE_LOCATION
        const char* const _函数_ = __builtin_FUNCSIG()
#else // ^^^ detailed / basic vvv
        const char* const _函数_ = __builtin_FUNCTION()
#endif // ^^^ basic ^^^
            ) noexcept {
        源码位置 _结果{};
        _结果._行号     = _行号_;
        _结果._列号   = _列号_;
        _结果._文件     = _文件_;
        _结果._函数 = _函数_;
        return _结果;
    }

    _NODISCARD_CTOR constexpr 源码位置() noexcept = default;

    _NODISCARD constexpr uint_least32_t 行号() const noexcept {
        return _行号;
    }
    _NODISCARD constexpr uint_least32_t 列号() const noexcept {
        return _列号;
    }
    _NODISCARD constexpr const char* 文件名() const noexcept {
        return _文件;
    }
    _NODISCARD constexpr const char* 函数名() const noexcept {
        return _函数;
    }

private:
    uint_least32_t _行号{};
    uint_least32_t _列号{};
    const char* _文件     = "";
    const char* _函数 = "";
};
} }

#pragma pop_macro("new")
