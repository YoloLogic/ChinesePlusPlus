// <C时间> —— ctime 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   C 包装头自己没有实现，只是把 C 库名字搬进 std；而 std::time_t 这类
//   **必须与全局那个是同一个类型**（对齐 / ABI）。抄一份就变成"另一种类型"。
//   实测抄 cstddef 直接炸：「using _STD max_align_t;」那条"桥"搬名域后断链。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
#pragma once
#include <ctime>

名域 标准 {
    使用 时间类型               = std::time_t;
    使用 时钟类型               = std::clock_t;
    使用 时间结构               = std::tm;
    使用 取时间                = std::time;
    使用 取时钟                = std::clock;
    使用 本地时间               = std::localtime;
    使用 世界时                = std::gmtime;
    使用 格式化时间              = std::strftime;
    使用 时间差                = std::difftime;

}