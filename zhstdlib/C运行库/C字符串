// <C字符串> —— cstring 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   C 包装头自己没有实现，只是把 C 库名字搬进 std；这些类型
//   **必须与全局那个是同一个类型**（对齐 / ABI）。抄一份就变成"另一种类型"。
//   实测抄 cstddef 直接炸：「using _STD max_align_t;」那条"桥"搬名域后断链。
//
// 三种机制都用上了（见 docs\标准库汉化\标准库汉化方案.md §3.4）：
//   类型 -> 使用 中文名 = std::原名;
//   函数 -> 一模板转发（函数没有"别名"机制）
//   宏   -> 内联 常量 承载它的值
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变参函数（printf/scanf 一家）**也能转发** —— 用的就是上面那条变参模板，
// §18.19 实测改正了原先"变参无法转发"的错误结论。真正转发不了的只剩**宏**：setjmp / va_start / va_arg / va_end / va_copy。
#pragma once
#include <cstring>

名域 标准 {
    使用 大小类型 = std::size_t;
    模板 <类型名... 参数> 声明类型(自动) 字符串长度(参数&&... 值) { 返回 std::strlen(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 复制字符串(参数&&... 值) { 返回 std::strcpy(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 连接字符串(参数&&... 值) { 返回 std::strcat(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 比较字符串(参数&&... 值) { 返回 std::strcmp(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 复制内存(参数&&... 值) { 返回 std::memcpy(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 移动内存(参数&&... 值) { 返回 std::memmove(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 填充内存(参数&&... 值) { 返回 std::memset(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 比较内存(参数&&... 值) { 返回 std::memcmp(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 查找字符(参数&&... 值) { 返回 std::strchr(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 查找子串(参数&&... 值) { 返回 std::strstr(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 查找内存字符(参数&&... 值) { 返回 std::memchr(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 按区域比较字符串(参数&&... 值) { 返回 std::strcoll(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 串补集前缀长度(参数&&... 值) { 返回 std::strcspn(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 取错误信息(参数&&... 值) { 返回 std::strerror(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 限长连接字符串(参数&&... 值) { 返回 std::strncat(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 限长比较字符串(参数&&... 值) { 返回 std::strncmp(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 限长复制字符串(参数&&... 值) { 返回 std::strncpy(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 查找字符集(参数&&... 值) { 返回 std::strpbrk(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 反向查找字符(参数&&... 值) { 返回 std::strrchr(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 串集合前缀长度(参数&&... 值) { 返回 std::strspn(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 串分词(参数&&... 值) { 返回 std::strtok(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 串区域变换(参数&&... 值) { 返回 std::strxfrm(static_cast<参数&&>(值)...); }
}