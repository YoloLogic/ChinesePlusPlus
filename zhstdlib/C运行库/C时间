// <C时间> —— ctime 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   C 包装头自己没有实现，只是把 C 库名字搬进 std；这些类型
//   **必须与全局那个是同一个类型**（对齐 / ABI）。抄一份就变成"另一种类型"。
//   实测抄 cstddef 直接炸：「using _STD max_align_t;」那条"桥"搬名域后断链。
//
// 三种机制都用上了（见 docs\标准库汉化\标准库汉化方案.md §3.4）：
//   类型 -> 使用 中文名 = std::原名;
//   函数 -> 一模板转发（函数没有"别名"机制）
//   宏   -> 内联 常量 承载它的值
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变参函数（printf/scanf 一家）**也能转发** —— 用的就是上面那条变参模板，
// §18.19 实测改正了原先"变参无法转发"的错误结论。真正转发不了的只剩**宏**：setjmp / va_start / va_arg / va_end / va_copy。
#pragma once
#include <ctime>

名域 标准 {
    使用 时间类型 = std::time_t;
    使用 时钟类型 = std::clock_t;
    使用 时间结构 = std::tm;
    模板 <类型名... 参数> 声明类型(自动) 取时间(参数&&... 值) { 返回 std::time(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 取时钟(参数&&... 值) { 返回 std::clock(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 本地时间(参数&&... 值) { 返回 std::localtime(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 世界时(参数&&... 值) { 返回 std::gmtime(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 格式化时间(参数&&... 值) { 返回 std::strftime(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 时间差(参数&&... 值) { 返回 std::difftime(static_cast<参数&&>(值)...); }
    使用 时间规格 = std::timespec;
    使用 大小类型 = std::size_t;
    模板 <类型名... 参数> 声明类型(自动) 时间结构转串(参数&&... 值) { 返回 std::asctime(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 时间转串(参数&&... 值) { 返回 std::ctime(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 结构转时间(参数&&... 值) { 返回 std::mktime(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 取时间规格(参数&&... 值) { 返回 std::timespec_get(static_cast<参数&&>(值)...); }
}