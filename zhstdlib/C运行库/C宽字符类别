// <C宽字符类别> —— cwctype 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   C 包装头自己没有实现，只是把 C 库名字搬进 std；这些类型
//   **必须与全局那个是同一个类型**（对齐 / ABI）。抄一份就变成"另一种类型"。
//   实测抄 cstddef 直接炸：「using _STD max_align_t;」那条"桥"搬名域后断链。
//
// 三种机制都用上了（见 docs\标准库汉化\标准库汉化方案.md §3.4）：
//   类型 -> 使用 中文名 = std::原名;
//   函数 -> 一模板转发（函数没有"别名"机制）
//   宏   -> 内联 常量 承载它的值
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变参函数（printf/scanf 一家）**也能转发** —— 用的就是上面那条变参模板，
// §18.19 实测改正了原先"变参无法转发"的错误结论。真正转发不了的只剩**宏**：setjmp / va_start / va_arg / va_end / va_copy。
#pragma once
#include <cwctype>

名域 标准 {
    使用 宽变换类型 = std::wctrans_t;
    使用 宽类别类型 = std::wctype_t;
    使用 宽整数类型 = std::wint_t;
    模板 <类型名... 参数> 声明类型(自动) 是宽字母(参数&&... 值) { 返回 std::iswalpha(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 是宽数字(参数&&... 值) { 返回 std::iswdigit(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 是宽空白(参数&&... 值) { 返回 std::iswspace(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 转宽大写(参数&&... 值) { 返回 std::towupper(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 转宽小写(参数&&... 值) { 返回 std::towlower(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 是宽字母数字(参数&&... 值) { 返回 std::iswalnum(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 是宽空格(参数&&... 值) { 返回 std::iswblank(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 是宽控制(参数&&... 值) { 返回 std::iswcntrl(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 是宽类别(参数&&... 值) { 返回 std::iswctype(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 是宽可显示(参数&&... 值) { 返回 std::iswgraph(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 是宽小写(参数&&... 值) { 返回 std::iswlower(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 是宽可打印(参数&&... 值) { 返回 std::iswprint(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 是宽标点(参数&&... 值) { 返回 std::iswpunct(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 是宽大写(参数&&... 值) { 返回 std::iswupper(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 是宽十六进制数字(参数&&... 值) { 返回 std::iswxdigit(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 宽类别变换(参数&&... 值) { 返回 std::towctrans(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 取宽变换(参数&&... 值) { 返回 std::wctrans(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 取宽类别(参数&&... 值) { 返回 std::wctype(static_cast<参数&&>(值)...); }
}