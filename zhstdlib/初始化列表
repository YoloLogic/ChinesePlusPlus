// <初始化列表> —— initializer_list 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   本头里的东西，类型身份参与语义（换一份就成了两套互不相认的东西）。
//   这类头一旦抄一份，就会和 std 里那份成为两套互不相认的东西。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变体（英文里带 _v 的变量模板形式）暂未提供中文名，属"必须的妥协"，见方案 §六。
#pragma once
#include <initializer_list>

名域 标准 {
    模板 <类型名 元素>
    使用 初始化列表 = std::initializer_list<元素>;
    模板 <类型名 元素> 内联 自动 开始(初始化列表<元素> 表) noexcept { 返回 表.begin(); }
    模板 <类型名 元素> 内联 自动 结束(初始化列表<元素> 表) noexcept { 返回 表.end(); }
    模板 <类型名 元素> 内联 自动 尺寸(初始化列表<元素> 表) noexcept { 返回 表.size(); }
}