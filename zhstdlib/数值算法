void _Adjacent_difference_no_overlap(
    _TyDest* const _RESTRICT _目标, _TySrc* const _RESTRICT _Src, const ptrdiff_t _Count, _BinOp _Func) {
    _目标[0] = _Src[0];
    for (ptrdiff_t _Ix = 1; _Ix != _Count; ++_Ix) {
#if _HAS_CXX20
        _TySrc _Tmp = _Src[_Ix - 1];
        _目标[_Ix]  = _Func(_Src[_Ix], _STD move(_Tmp));
#else // ^^^ _HAS_CXX20 / !_HAS_CXX20 vvv
