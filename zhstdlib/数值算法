_EXPORT_STD template <class _Mt, class _Nt>
_NODISCARD constexpr common_type_t<_Mt, _Nt> 最大公约数(const _Mt _Mx, const _Nt _Nx) noexcept /* strengthened */ {
    // calculate greatest common divisor
    static_assert(_Is_nonbool_integral<_Mt> && _Is_nonbool_integral<_Nt>, "GCD requires nonbool integral types");

    using _公共          = common_type_t<_Mt, _Nt>;
    using _公共无符号类型 = make_unsigned_t<_公共>;

    if constexpr (is_signed_v<_公共>) {
#ifndef _DEBUG
        if (_Is_constant_evaluated())
#endif // ^^^ !defined(_DEBUG) ^^^
        {
            constexpr auto _Min_common = _STD _Min_limit<_公共>();
            _STL_VERIFY(_Mx != _Min_common && _Nx != _Min_common,
                "Preconditions: |m| and |n| are representable as a value of common_type_t<M, N>. "
                "(N4981 [numeric.ops.最大公约数]/2, N4981 [numeric.ops.最小公倍数]/2)");
        }
    }

    return _Select_countr_zero_impl<_公共无符号类型>([=](auto _Countr_zero_impl) {
        _公共无符号类型 _Mx_magnitude = _Abs_u(_Mx);
        _公共无符号类型 _Nx_magnitude = _Abs_u(_Nx);
        if (_Mx_magnitude == 0U) {
            return static_cast<_公共>(_Nx_magnitude);
        }

        if (_Nx_magnitude == 0U) {
            return static_cast<_公共>(_Mx_magnitude);
        }

        const auto _Mx_trailing_zeroes  = static_cast<unsigned long>(_Countr_zero_impl(_Mx_magnitude));
        auto _Nx_trailing_zeroes        = static_cast<unsigned long>(_Countr_zero_impl(_Nx_magnitude));
        const auto _Common_factors_of_2 = (_STD min)(_Mx_trailing_zeroes, _Nx_trailing_zeroes);
        _Mx_magnitude >>= _Mx_trailing_zeroes;
        for (;;) {
            _Nx_magnitude >>= _Nx_trailing_zeroes;
            if (_Mx_magnitude > _Nx_magnitude) {
                _公共无符号类型 _Temp = _Mx_magnitude;
                _Mx_magnitude          = _Nx_magnitude;
                _Nx_magnitude          = _Temp;
            }

            _Nx_magnitude -= _Mx_magnitude;
            if (_Nx_magnitude == 0U) {
                return static_cast<_公共>(_Mx_magnitude << _Common_factors_of_2);
            }

            _Nx_trailing_zeroes = static_cast<unsigned long>(_Countr_zero_impl(_Nx_magnitude));
        }
    });
}

_EXPORT_STD template <class _Mt, class _Nt>
_NODISCARD constexpr common_type_t<_Mt, _Nt> 最小公倍数(const _Mt _Mx, const _Nt _Nx) noexcept /* strengthened */ {
    // calculate least common multiple
    static_assert(_Is_nonbool_integral<_Mt> && _Is_nonbool_integral<_Nt>, "LCM requires nonbool integral types");
    using _公共                        = common_type_t<_Mt, _Nt>;
    using _公共无符号类型               = make_unsigned_t<_公共>;
    const _公共无符号类型 _Mx_magnitude = _Abs_u(_Mx);
    const _公共无符号类型 _Nx_magnitude = _Abs_u(_Nx);
    if (_Mx_magnitude == 0 || _Nx_magnitude == 0) {
        return 0;
    }

#ifndef _DEBUG
    if (!_Is_constant_evaluated()) {
        return static_cast<_公共>((_Mx_magnitude / 最大公约数(_Mx_magnitude, _Nx_magnitude)) * _Nx_magnitude);
    }
#endif // ^^^ !defined(_DEBUG) ^^^

    _公共无符号类型 _结果 = 0;
    _公共无符号类型 _Tmp    = static_cast<_公共无符号类型>(_Mx_magnitude / 最大公约数(_Mx_magnitude, _Nx_magnitude));
    const bool _Overflow     = _Mul_overflow(_Tmp, _Nx_magnitude, _结果) || !_In_range<_公共>(_结果);

    _STL_VERIFY(!_Overflow, "Preconditions: The least common multiple of |m| and |n| is representable as a value of "
                            "type common_type_t<M, N>. (N4981 [numeric.ops.最小公倍数]/2)");

    return static_cast<_公共>(_结果);
}
