template <class _值类型集>
class _树值 : public _容器基类 {
public:
    using _结点指针 = typename _值类型集::_结点指针;

    using value_type      = typename _值类型集::value_type;
    using size_type       = typename _值类型集::size_type;
    using difference_type = typename _值类型集::difference_type;
    using pointer         = typename _值类型集::pointer;
    using const_pointer   = typename _值类型集::const_pointer;
    using reference       = value_type&;
    using 常量引用 = const value_type&;

    using _非检查常量迭代器 = _树非检查常量迭代器<_树值>;
    using 常量迭代器            = _树常量迭代器<_树值>;

    template <class _结点分配器>
    struct _NODISCARD _擦树并孤立守卫 {
        _树值* _Val_ptr;
        _结点分配器& _Al;
        _结点指针 _New_root;

        _擦树并孤立守卫& operator=(const _擦树并孤立守卫&) = delete;
        ~_擦树并孤立守卫() noexcept {
            if (_Val_ptr != nullptr) {
                _Val_ptr->_擦除树并孤立(_Al, _New_root); // subtree copy failed, bail out
            }
        }
    };

    _树值() noexcept : _Myhead(), _我的尺寸(0) {}

#if _MSVC_STL_DESTRUCTOR_TOMBSTONES
    ~_树值() noexcept {
        if constexpr (is_pointer_v<_结点指针>) {
            const auto _Tombstone{reinterpret_cast<_结点指针>(_MSVC_STL_UINTPTR_TOMBSTONE_VALUE)};
            _Myhead = _Tombstone;
            _我的尺寸 = 0;
        }
    }
#endif // _MSVC_STL_DESTRUCTOR_TOMBSTONES

    enum _红黑 { // colors for link to parent
        _红,
        _黑
    };

    static _结点指针 _最大(_结点指针 _Pnode) noexcept { // return rightmost node in subtree at _Pnode
        while (!_Pnode->_Right->_Isnil) {
            _Pnode = _Pnode->_Right;
        }

        return _Pnode;
    }

    static _结点指针 _最小(_结点指针 _Pnode) noexcept { // return leftmost node in subtree at _Pnode
        while (!_Pnode->_Left->_Isnil) {
            _Pnode = _Pnode->_Left;
        }

        return _Pnode;
    }

    void _左旋(_结点指针 _Wherenode) noexcept { // promote right node to root of subtree
        _结点指针 _Pnode    = _Wherenode->_Right;
        _Wherenode->_Right = _Pnode->_Left;

        if (!_Pnode->_Left->_Isnil) {
            _Pnode->_Left->_Parent = _Wherenode;
        }

        _Pnode->_Parent = _Wherenode->_Parent;

        if (_Wherenode == _Myhead->_Parent) {
            _Myhead->_Parent = _Pnode;
        } else if (_Wherenode == _Wherenode->_Parent->_Left) {
            _Wherenode->_Parent->_Left = _Pnode;
        } else {
            _Wherenode->_Parent->_Right = _Pnode;
        }

        _Pnode->_Left       = _Wherenode;
        _Wherenode->_Parent = _Pnode;
    }

    void _右旋(_结点指针 _Wherenode) noexcept { // promote left node to root of subtree
        _结点指针 _Pnode   = _Wherenode->_Left;
        _Wherenode->_Left = _Pnode->_Right;

        if (!_Pnode->_Right->_Isnil) {
            _Pnode->_Right->_Parent = _Wherenode;
        }

        _Pnode->_Parent = _Wherenode->_Parent;

        if (_Wherenode == _Myhead->_Parent) {
            _Myhead->_Parent = _Pnode;
        } else if (_Wherenode == _Wherenode->_Parent->_Right) {
            _Wherenode->_Parent->_Right = _Pnode;
        } else {
            _Wherenode->_Parent->_Left = _Pnode;
        }

        _Pnode->_Right      = _Wherenode;
        _Wherenode->_Parent = _Pnode;
    }

    _结点指针 _摘取(_非检查常量迭代器 _Where) noexcept {
        _结点指针 _Erasednode = _Where._Ptr; // node to 擦除
        ++_Where; // save successor 迭代器 for return

        _结点指针 _Fixnode; // the node to recolor as needed
        _结点指针 _Fixnodeparent; // parent of _Fixnode (which may be nil)
        _结点指针 _Pnode = _Erasednode;

        if (_Pnode->_Left->_Isnil) {
            _Fixnode = _Pnode->_Right; // stitch up right subtree
        } else if (_Pnode->_Right->_Isnil) {
            _Fixnode = _Pnode->_Left; // stitch up left subtree
        } else { // two subtrees, must lift successor node to replace erased
            _Pnode   = _Where._Ptr; // _Pnode is successor node
            _Fixnode = _Pnode->_Right; // _Fixnode is only subtree
        }

        if (_Pnode == _Erasednode) { // at most one subtree, relink it
            _Fixnodeparent = _Erasednode->_Parent;
            if (!_Fixnode->_Isnil) {
                _Fixnode->_Parent = _Fixnodeparent; // link up
            }

            if (_Myhead->_Parent == _Erasednode) {
                _Myhead->_Parent = _Fixnode; // link down from root
            } else if (_Fixnodeparent->_Left == _Erasednode) {
                _Fixnodeparent->_Left = _Fixnode; // link down to left
            } else {
                _Fixnodeparent->_Right = _Fixnode; // link down to right
            }

            if (_Myhead->_Left == _Erasednode) {
                _Myhead->_Left = _Fixnode->_Isnil ? _Fixnodeparent // smallest is parent of erased node
                                                  : _最小(_Fixnode); // smallest in relinked subtree
            }

            if (_Myhead->_Right == _Erasednode) {
                _Myhead->_Right = _Fixnode->_Isnil ? _Fixnodeparent // largest is parent of erased node
                                                   : _最大(_Fixnode); // largest in relinked subtree
            }
        } else { // erased has two subtrees, _Pnode is successor to erased
            _Erasednode->_Left->_Parent = _Pnode; // link left up
            _Pnode->_Left               = _Erasednode->_Left; // link successor down

            if (_Pnode == _Erasednode->_Right) {
                _Fixnodeparent = _Pnode; // successor is next to erased
            } else { // successor further down, link in place of erased
                _Fixnodeparent = _Pnode->_Parent; // parent is successor's
                if (!_Fixnode->_Isnil) {
                    _Fixnode->_Parent = _Fixnodeparent; // link fix up
                }

                _Fixnodeparent->_Left        = _Fixnode; // link fix down
                _Pnode->_Right               = _Erasednode->_Right; // link next down
                _Erasednode->_Right->_Parent = _Pnode; // right up
            }

            if (_Myhead->_Parent == _Erasednode) {
                _Myhead->_Parent = _Pnode; // link down from root
            } else if (_Erasednode->_Parent->_Left == _Erasednode) {
                _Erasednode->_Parent->_Left = _Pnode; // link down to left
            } else {
                _Erasednode->_Parent->_Right = _Pnode; // link down to right
            }

            _Pnode->_Parent = _Erasednode->_Parent; // link successor up
            _STD swap(_Pnode->_Color, _Erasednode->_Color); // recolor it
        }

        if (_Erasednode->_Color == _黑) { // erasing black link, must recolor/rebalance tree
            for (; _Fixnode != _Myhead->_Parent && _Fixnode->_Color == _黑; _Fixnodeparent = _Fixnode->_Parent) {
                if (_Fixnode == _Fixnodeparent->_Left) { // fixup left subtree
                    _Pnode = _Fixnodeparent->_Right;
                    if (_Pnode->_Color == _红) { // rotate red up from right subtree
                        _Pnode->_Color         = _黑;
                        _Fixnodeparent->_Color = _红;
                        _左旋(_Fixnodeparent);
                        _Pnode = _Fixnodeparent->_Right;
                    }

                    if (_Pnode->_Isnil) {
                        _Fixnode = _Fixnodeparent; // shouldn't happen
                    } else if (_Pnode->_Left->_Color == _黑
                               && _Pnode->_Right->_Color == _黑) { // redden right subtree with black children
                        _Pnode->_Color = _红;
                        _Fixnode       = _Fixnodeparent;
                    } else { // must rearrange right subtree
                        if (_Pnode->_Right->_Color == _黑) { // rotate red up from left sub-subtree
                            _Pnode->_Left->_Color = _黑;
                            _Pnode->_Color        = _红;
                            _右旋(_Pnode);
                            _Pnode = _Fixnodeparent->_Right;
                        }

                        _Pnode->_Color         = _Fixnodeparent->_Color;
                        _Fixnodeparent->_Color = _黑;
                        _Pnode->_Right->_Color = _黑;
                        _左旋(_Fixnodeparent);
                        break; // tree now recolored/rebalanced
                    }
                } else { // fixup right subtree
                    _Pnode = _Fixnodeparent->_Left;
                    if (_Pnode->_Color == _红) { // rotate red up from left subtree
                        _Pnode->_Color         = _黑;
                        _Fixnodeparent->_Color = _红;
                        _右旋(_Fixnodeparent);
                        _Pnode = _Fixnodeparent->_Left;
                    }

                    if (_Pnode->_Isnil) {
                        _Fixnode = _Fixnodeparent; // shouldn't happen
                    } else if (_Pnode->_Right->_Color == _黑
                               && _Pnode->_Left->_Color == _黑) { // redden left subtree with black children
                        _Pnode->_Color = _红;
                        _Fixnode       = _Fixnodeparent;
                    } else { // must rearrange left subtree
                        if (_Pnode->_Left->_Color == _黑) { // rotate red up from right sub-subtree
                            _Pnode->_Right->_Color = _黑;
                            _Pnode->_Color         = _红;
                            _左旋(_Pnode);
                            _Pnode = _Fixnodeparent->_Left;
                        }

                        _Pnode->_Color         = _Fixnodeparent->_Color;
                        _Fixnodeparent->_Color = _黑;
                        _Pnode->_Left->_Color  = _黑;
                        _右旋(_Fixnodeparent);
                        break; // tree now recolored/rebalanced
                    }
                }
            }

            _Fixnode->_Color = _黑; // stopping node is black
        }

        if (0 < _我的尺寸) {
            --_我的尺寸;
        }

        return _Erasednode;
    }

    _结点指针 _插入节点(const _树标识<_结点指针> _Loc, const _结点指针 _新节点) noexcept {
        ++_我的尺寸;
        const auto _Head  = _Myhead;
        _新节点->_Parent = _Loc._Parent;
        if (_Loc._Parent == _Head) { // first node in tree, just set head values
            _Head->_Left     = _新节点;
            _Head->_Parent   = _新节点;
            _Head->_Right    = _新节点;
            _新节点->_Color = _黑; // the root is black
            return _新节点;
        }

        _STL_INTERNAL_CHECK(_Loc._Child != _树子向::_Unused);
        if (_Loc._Child == _树子向::_Right) { // add to right of _Loc._Parent
            _STL_INTERNAL_CHECK(_Loc._Parent->_Right->_Isnil);
            _Loc._Parent->_Right = _新节点;
            if (_Loc._Parent == _Head->_Right) { // remember rightmost node
                _Head->_Right = _新节点;
            }
        } else { // add to left of _Loc._Parent
            _STL_INTERNAL_CHECK(_Loc._Parent->_Left->_Isnil);
            _Loc._Parent->_Left = _新节点;
            if (_Loc._Parent == _Head->_Left) { // remember leftmost node
                _Head->_Left = _新节点;
            }
        }

        for (_结点指针 _Pnode = _新节点; _Pnode->_Parent->_Color == _红;) {
            if (_Pnode->_Parent == _Pnode->_Parent->_Parent->_Left) { // fixup red-red in left subtree
                const auto _Parent_sibling = _Pnode->_Parent->_Parent->_Right;
                if (_Parent_sibling->_Color == _红) { // parent's sibling has two red children, blacken both
                    _Pnode->_Parent->_Color          = _黑;
                    _Parent_sibling->_Color          = _黑;
                    _Pnode->_Parent->_Parent->_Color = _红;
                    _Pnode                           = _Pnode->_Parent->_Parent;
                } else { // parent's sibling has red and black children
                    if (_Pnode == _Pnode->_Parent->_Right) { // rotate right child to left
                        _Pnode = _Pnode->_Parent;
                        _左旋(_Pnode);
                    }

                    _Pnode->_Parent->_Color          = _黑; // propagate red up
                    _Pnode->_Parent->_Parent->_Color = _红;
                    _右旋(_Pnode->_Parent->_Parent);
                }
            } else { // fixup red-red in right subtree
                const auto _Parent_sibling = _Pnode->_Parent->_Parent->_Left;
                if (_Parent_sibling->_Color == _红) { // parent's sibling has two red children, blacken both
                    _Pnode->_Parent->_Color          = _黑;
                    _Parent_sibling->_Color          = _黑;
                    _Pnode->_Parent->_Parent->_Color = _红;
                    _Pnode                           = _Pnode->_Parent->_Parent;
                } else { // parent's sibling has red and black children
                    if (_Pnode == _Pnode->_Parent->_Left) { // rotate left child to right
                        _Pnode = _Pnode->_Parent;
                        _右旋(_Pnode);
                    }

                    _Pnode->_Parent->_Color          = _黑; // propagate red up
                    _Pnode->_Parent->_Parent->_Color = _红;
                    _左旋(_Pnode->_Parent->_Parent);
                }
            }
        }

        _Head->_Parent->_Color = _黑; // root is always black
        return _新节点;
    }

    void _孤立指针(const _结点指针 _Ptr) noexcept {
#if _ITERATOR_DEBUG_LEVEL == 2
        _Lockit _加锁(_LOCK_DEBUG);
        _迭代器基类12** _Pnext = &this->_Myproxy->_Myfirstiter;
        while (*_Pnext) {
            const auto _Pnextptr = static_cast<常量迭代器&>(**_Pnext)._Ptr;
            if (_Pnextptr == _Myhead || (_Ptr != nullptr && _Pnextptr != _Ptr)) {
                _Pnext = &(*_Pnext)->_Mynextiter;
            } else { // orphan the 迭代器
                (*_Pnext)->_Myproxy = nullptr;
                *_Pnext             = (*_Pnext)->_Mynextiter;
            }
        }
#else // ^^^ _ITERATOR_DEBUG_LEVEL == 2 / _ITERATOR_DEBUG_LEVEL != 2 vvv
        (void) _Ptr;
#endif // ^^^ _ITERATOR_DEBUG_LEVEL != 2 ^^^
    }

    template <class _结点分配器>
    void _擦除树并孤立(_结点分配器& _Al, _结点指针 _Rootnode) noexcept {
        while (!_Rootnode->_Isnil) { // free subtrees, then node
            _擦除树并孤立(_Al, _Rootnode->_Right);
            auto _To_delete = _STD exchange(_Rootnode, _Rootnode->_Left);
            _孤立指针(_To_delete);
            _结点分配器::value_type::_释放节点(_Al, _To_delete);
        }
    }

    template <class _结点分配器>
    void _擦除树(_结点分配器& _Al, _结点指针 _Rootnode) noexcept {
        while (!_Rootnode->_Isnil) { // free subtrees, then node
            _擦除树(_Al, _Rootnode->_Right);
            _结点分配器::value_type::_释放节点(_Al, _STD exchange(_Rootnode, _Rootnode->_Left));
        }
    }

    template <class _结点分配器>
    void _擦除头(_结点分配器& _Al) noexcept {
        this->_孤儿化全部();
        _擦除树(_Al, _Myhead->_Parent);
        _结点分配器::value_type::_Freenode0(_Al, _Myhead);
    }

    _结点指针 _Myhead; // pointer to head node
    size_type _我的尺寸; // number of elements
};

template <class _结点分配器, class _迭代器检查值>
struct _树头作用域指针 { // temporary storage for allocated node pointers to ensure exception safety
    _结点分配器& _Al;
    _迭代器检查值* _我的容器;

    _树头作用域指针(_结点分配器& _Al_, _迭代器检查值& _Mycont_) : _Al(_Al_), _我的容器(_STD addressof(_Mycont_)) {
        _我的容器->_Myhead = _结点分配器::value_type::_建头节点(_Al);
    }

    void _释放() noexcept {
        _我的容器 = nullptr;
    }

    ~_树头作用域指针() {
        if (_我的容器) {
            _我的容器->_擦除头(_Al);
        }
    }
};

template <class _结点分配器>
