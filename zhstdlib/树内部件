template <class _Value_type, class _Voidptr>
struct _树节点 {
    using _结点指针   = _重绑定指针类型<_Voidptr, _树节点>;
    using value_type = _Value_type;
    _结点指针 _Left; // left subtree, or smallest element if head
    _结点指针 _Parent; // parent, or root of tree if head
    _结点指针 _Right; // right subtree, or largest element if head
    char _Color; // _红 or _黑, _黑 if head
    char _Isnil; // true only if head (also nil) node; TRANSITION, should be bool
    value_type _Myval = // the stored value, unused if head
        _Returns_exactly<value_type>(); // fake a viable constructor to workaround GH-2749

    enum _红黑 { // colors for link to parent
        _红,
        _黑
    };

    _树节点()                             = default;
    _树节点(const _树节点&)            = delete;
    _树节点& operator=(const _树节点&) = delete;

    template <class _分配器>
    static _结点指针 _建头节点(_分配器& _Al) {
        static_assert(is_same_v<typename _分配器::value_type, _树节点>, "Bad _建头节点 call");
        const auto _Pnode = _Al.allocate(1);
        _就地构造(_Pnode->_Left, _Pnode);
        _就地构造(_Pnode->_Parent, _Pnode);
        _就地构造(_Pnode->_Right, _Pnode);
        _Pnode->_Color = _黑;
        _Pnode->_Isnil = true;
        return _Pnode;
    }

    template <class _分配器, class... _值参数类型>
    static _结点指针 _建节点(_分配器& _Al, _结点指针 _Myhead, _值参数类型&&... _Val) {
        // allocate a node with defaults and set links and value
        static_assert(is_same_v<typename _分配器::value_type, _树节点>, "Bad _建节点 call");
        _分配器构造指针<_分配器> _新节点(_Al);
        _新节点._分配();
        allocator_traits<_分配器>::construct(_Al, _STD addressof(_新节点._Ptr->_Myval), _STD forward<_值参数类型>(_Val)...);
        _就地构造(_新节点._Ptr->_Left, _Myhead);
        _就地构造(_新节点._Ptr->_Parent, _Myhead);
        _就地构造(_新节点._Ptr->_Right, _Myhead);
        _新节点._Ptr->_Color = _红;
        _新节点._Ptr->_Isnil = false;
        return _新节点._释放();
    }

    template <class _分配器>
    static void _Freenode0(_分配器& _Al, _结点指针 _Ptr) noexcept {
        static_assert(is_same_v<typename _分配器::value_type, _树节点>, "Bad _Freenode0 call");
        _就地析构(_Ptr->_Left);
        _就地析构(_Ptr->_Parent);
        _就地析构(_Ptr->_Right);
        allocator_traits<_分配器>::deallocate(_Al, _Ptr, 1);
    }

    template <class _分配器>
    static void _释放节点(_分配器& _Al, _结点指针 _Ptr) noexcept {
        static_assert(is_same_v<typename _分配器::value_type, _树节点>, "Bad _释放节点 call");
        allocator_traits<_分配器>::destroy(_Al, _STD addressof(_Ptr->_Myval));
        _Freenode0(_Al, _Ptr);
    }
};

