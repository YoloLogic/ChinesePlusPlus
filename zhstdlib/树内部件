#endif // _HAS_CXX23

    auto 插入(结点类型&& _Handle) {
        if (_Handle.empty()) {
            if constexpr (_Multi) {
                return end();
            } else {
                return _Insert_return_type<迭代器, 结点类型>{end(), false, {}};
            }
        }

        _检查节点分配器(_Handle);
        const auto _Scary        = _取检查值();
        const auto _Attempt_node = _Handle._取指针();
        const auto& _Keyval      = _特征::_取键(_Attempt_node->_Myval);
        _树查找结果<_结点指针> _Loc;
        if constexpr (_Multi) {
            _Loc = _查找上界(_Keyval);
        } else {
            _Loc = _查找下界(_Keyval);
            if (_下界重复项(_Loc._Bound, _Keyval)) {
                return _Insert_return_type<迭代器, 结点类型>{
                    迭代器(_Loc._Bound, _Scary), false, _STD move(_Handle)};
            }
        }

        _检查增一();

        // nothrow hereafter

        _Attempt_node->_Left = _Scary->_Myhead;
        // _Attempt_node->_Parent handled in _插入节点
        _Attempt_node->_Right = _Scary->_Myhead;
        _Attempt_node->_Color = _红;

        const auto _Inserted = _Scary->_插入节点(_Loc._Location, _Handle._释放());
        if constexpr (_Multi) {
            return 迭代器(_Inserted, _Scary);
        } else {
            return _Insert_return_type<迭代器, 结点类型>{迭代器(_Inserted, _Scary), true, _STD move(_Handle)};
        }
    }

    迭代器 插入(const 常量迭代器 _Hint, 结点类型&& _Handle) {
        const auto _Scary = _取检查值();
#if _ITERATOR_DEBUG_LEVEL == 2
        _STL_VERIFY(_Hint._取容器() == _Scary, "map/set 插入 迭代器 outside range");
#endif // _ITERATOR_DEBUG_LEVEL == 2
        if (_Handle.empty()) {
            return end();
        }

        _检查节点分配器(_Handle);
        const auto _Attempt_node = _Handle._取指针();
        const auto& _Keyval      = _特征::_取键(_Attempt_node->_Myval);
        const auto _Loc          = _按提示查找(_Hint._Ptr, _Keyval);
        if (_Loc._Duplicate) {
            return 迭代器(_Loc._Location._Parent, _Scary);
        }

        _检查增一();

        _Attempt_node->_Left = _Scary->_Myhead;
        // _Attempt_node->_Parent handled in _插入节点
        _Attempt_node->_Right = _Scary->_Myhead;
        _Attempt_node->_Color = _红;

        return 迭代器(_Scary->_插入节点(_Loc._Location, _Handle._释放()), _Scary);
    }

    template <class>
    friend class _树;

    template <class _Other_traits>
    void 归并(_树<_Other_traits>& _That) {
        static_assert(is_same_v<_结点指针, typename _树<_Other_traits>::_结点指针>,
            "归并() requires an argument with a compatible node type.");

        static_assert(is_same_v<分配器类型, typename _树<_Other_traits>::分配器类型>,
            "归并() requires an argument with the same allocator type.");

        if constexpr (is_same_v<_树, _树<_Other_traits>>) {
            if (this == _STD addressof(_That)) {
                return;
            }
        }

#if _ITERATOR_DEBUG_LEVEL == 2
        if constexpr (!_结点分配器特征::is_always_equal::value) {
            _STL_VERIFY(_取分配器() == _That._取分配器(), "allocator incompatible for 归并");
        }
#endif // _ITERATOR_DEBUG_LEVEL == 2

        const auto _Scary      = _取检查值();
        const auto _Head       = _Scary->_Myhead;
        const auto _That_scary = _That._取检查值();
        auto _首个            = _That._非检查开始();
        while (!_首个._Ptr->_Isnil) {
            const auto _Attempt_node = _首个._Ptr;
            ++_首个;
            _树查找结果<_结点指针> _Loc;
            const auto& _Keyval = _特征::_取键(_Attempt_node->_Myval);
            if constexpr (_Multi) {
                _Loc = _查找上界(_Keyval);
            } else {
                _Loc = _查找下界(_Keyval);
                if (_下界重复项(_Loc._Bound, _Keyval)) {
                    continue;
                }
            }

            _检查增一();

            // nothrow hereafter for this iteration
            const auto _Extracted = _That_scary->_摘取(_非检查常量迭代器(_Attempt_node, nullptr));
            _Extracted->_Left     = _Head;
            // _Extracted->_Parent handled in _插入节点
            _Extracted->_Right = _Head;
            _Extracted->_Color = _红;

            const auto _Inserted = _Scary->_插入节点(_Loc._Location, _Extracted);
            _重挂父指针(_Inserted, _That);
        }
    }

    template <class _Other_traits>
    void 归并(_树<_Other_traits>&& _That) {
        static_assert(is_same_v<_结点指针, typename _树<_Other_traits>::_结点指针>,
            "归并() requires an argument with a compatible node type.");

        static_assert(is_same_v<分配器类型, typename _树<_Other_traits>::分配器类型>,
            "归并() requires an argument with the same allocator type.");

        归并(_That);
    }

protected:
    template <class _Other_traits>
    void _重挂父指针(const _结点指针 _Ptr, _树<_Other_traits>& _Old_parent) {
        (void) _Ptr;
        (void) _Old_parent;
#if _ITERATOR_DEBUG_LEVEL == 2
        _Lockit _加锁(_LOCK_DEBUG);
        const auto _Old_parent_scary = _Old_parent._取检查值();
        _迭代器基类12** _Pnext    = &_Old_parent_scary->_Myproxy->_Myfirstiter;
        _STL_VERIFY(_Pnext, "source container corrupted");
        if (_Ptr == nullptr || _Ptr == _Old_parent_scary->_Myhead) {
            return;
        }

        const auto _My_saved_proxy               = _取检查值()->_Myproxy;
        _迭代器基类12** const _My_saved_first = &_My_saved_proxy->_Myfirstiter;

        while (*_Pnext) {
            _迭代器基类12** const _Next = &(*_Pnext)->_Mynextiter;
            const auto _Iter               = static_cast<常量迭代器*>(*_Pnext);
            if (_Iter->_Ptr == _Ptr) { // reparent the 迭代器
                *_Pnext            = *_Next;
                _Iter->_Myproxy    = _My_saved_proxy;
                _Iter->_Mynextiter = *_My_saved_first;
                *_My_saved_first   = _Iter;
            } else { // skip the 迭代器
                _Pnext = _Next;
            }
        }
#endif // _ITERATOR_DEBUG_LEVEL == 2
    }

    void _检查节点分配器(结点类型& _Handle) const {
        (void) _Handle;
#if _ITERATOR_DEBUG_LEVEL == 2
        _STL_VERIFY(取分配器() == _Handle._取分配器(), "node handle allocator incompatible for 插入");
#endif // _ITERATOR_DEBUG_LEVEL == 2
    }
#endif // _HAS_CXX17

    void _分配哨兵与代理() {
        const auto _Scary = _取检查值();
        auto&& _Alproxy   = _取代理分配器(_结点分配器, _取分配器());
        _容器代理指针<_结点分配器> _代理(_Alproxy, *_Scary);
        _Scary->_Myhead = _节点::_建头节点(_取分配器());
        _代理._释放();
    }

    template <class... _值参数类型>
    _结点指针 _建节点(_值参数类型&&... _Val) {
        return _节点::_建节点(_取分配器(), _取检查值()->_Myhead, _STD forward<_值参数类型>(_Val)...);
    }

    键比较器& _取比较器() noexcept {
        return _Mypair._取第一();
    }

    const 键比较器& _取比较器() const noexcept {
        return _Mypair._取第一();
    }

    _结点分配器& _取分配器() noexcept {
        return _Mypair._Myval2._取第一();
    }

    const _结点分配器& _取分配器() const noexcept {
        return _Mypair._Myval2._取第一();
    }

    _迭代器检查值* _取检查值() noexcept {
        return _STD addressof(_Mypair._Myval2._Myval2);
    }

    const _迭代器检查值* _取检查值() const noexcept {
        return _STD addressof(_Mypair._Myval2._Myval2);
    }

private:
    _压缩对<键比较器, _压缩对<_结点分配器, _迭代器检查值>> _Mypair;
