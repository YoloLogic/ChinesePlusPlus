template <class _Mytree, class _Base = _迭代器基类0>
class _树非检查常量迭代器 : public _Base {
public:
    using iterator_category = bidirectional_iterator_tag;

    using _结点指针        = typename _Mytree::_结点指针;
    using value_type      = typename _Mytree::value_type;
    using difference_type = typename _Mytree::difference_type;
    using pointer         = typename _Mytree::const_pointer;
    using reference       = const value_type&;

    _树非检查常量迭代器() noexcept : _Ptr() {}

    _树非检查常量迭代器(_结点指针 _Pnode, const _Mytree* _Plist) noexcept : _Ptr(_Pnode) {
        this->_收养(_Plist);
    }

    _NODISCARD reference operator*() const noexcept {
        return _Ptr->_Myval;
    }

    _NODISCARD pointer operator->() const noexcept {
        return pointer_traits<pointer>::pointer_to(**this);
    }

    _树非检查常量迭代器& operator++() noexcept {
        if (_Ptr->_Right->_Isnil) { // climb looking for right subtree
            _结点指针 _Pnode;
            while (!(_Pnode = _Ptr->_Parent)->_Isnil && _Ptr == _Pnode->_Right) {
                _Ptr = _Pnode; // ==> parent while right subtree
            }

            _Ptr = _Pnode; // ==> parent (head if end())
        } else {
            _Ptr = _Mytree::_最小(_Ptr->_Right); // ==> smallest of right subtree
        }

        return *this;
    }

    _树非检查常量迭代器 operator++(int) noexcept {
        _树非检查常量迭代器 _Tmp = *this;
        ++*this;
        return _Tmp;
    }

    _树非检查常量迭代器& operator--() noexcept {
        if (_Ptr->_Isnil) {
            _Ptr = _Ptr->_Right; // end() ==> rightmost
        } else if (_Ptr->_Left->_Isnil) { // climb looking for left subtree
            _结点指针 _Pnode;
            while (!(_Pnode = _Ptr->_Parent)->_Isnil && _Ptr == _Pnode->_Left) {
                _Ptr = _Pnode; // ==> parent while left subtree
            }

            if (!_Ptr->_Isnil) { // decrement non-begin()
                _Ptr = _Pnode; // ==> parent if not head
            }
        } else {
            _Ptr = _Mytree::_最大(_Ptr->_Left); // ==> largest of left subtree
        }

        return *this;
    }

    _树非检查常量迭代器 operator--(int) noexcept {
        _树非检查常量迭代器 _Tmp = *this;
        --*this;
        return _Tmp;
    }

    _NODISCARD bool operator==(const _树非检查常量迭代器& _Right) const noexcept {
        return _Ptr == _Right._Ptr;
    }

#if !_HAS_CXX20
    _NODISCARD bool operator!=(const _树非检查常量迭代器& _Right) const noexcept {
        return !(*this == _Right);
    }
#endif // !_HAS_CXX20

    _NODISCARD bool operator==(_Default_sentinel) const noexcept {
        return !!_Ptr->_Isnil; // TRANSITION, avoid warning C4800:
                               // "Implicit conversion from 'char' to bool. Possible information loss" (/Wall)
    }

#if !_HAS_CXX20
    _NODISCARD bool operator!=(_Default_sentinel) const noexcept {
        return !_Ptr->_Isnil;
    }
#endif // !_HAS_CXX20

    _结点指针 _Ptr; // pointer to node
};

