    _结点指针 _擦除非检查(_非检查常量迭代器 _Where) noexcept {
        const auto _Scary                    = _取检查值();
        _非检查常量迭代器 _Successor = _Where;
        ++_Successor; // save successor 迭代器 for return
        _结点指针 _Erasednode = _Scary->_摘取(_Where); // node to 擦除
        _Scary->_孤立指针(_Erasednode);
        _节点::_释放节点(_取分配器(), _Erasednode); // delete erased node
        return _Successor._Ptr; // return successor nodeptr
    }

    _结点指针 _擦除非检查(_非检查常量迭代器 _首个, _非检查常量迭代器 _最后) noexcept {
        const auto _Begin = _非检查开始();
        if (_首个 == _Begin && _最后._Ptr->_Isnil) {
            // 擦除 all
            清空();
            return _最后._Ptr;
        }

        // partial 擦除, one at a time
        while (_首个 != _最后) {
            _擦除非检查(_首个++);
        }

        return _最后._Ptr;
    }

    size_type _擦除(const pair<_结点指针, _结点指针> _Where) noexcept {
        const _非检查常量迭代器 _首个(_Where.first, nullptr);
