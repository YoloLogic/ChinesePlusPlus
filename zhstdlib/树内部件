template <class _结点分配器>
struct _树临时节点 : _树临时节点分配器<_结点分配器> {
    // temporarily stores a constructed tree node
    using _结点分配器特征 = allocator_traits<_结点分配器>;
    using _结点指针       = typename _结点分配器特征::pointer;

    enum _红黑 { // colors for link to parent
        _红,
        _黑
    };

    template <class... _Valtys>
    explicit _树临时节点(_结点分配器& _Al_, _结点指针 _Myhead, _Valtys&&... _Vals)
        : _树临时节点分配器<_结点分配器>(_Al_) {
        _结点分配器特征::construct(this->_Al, _STD addressof(this->_Ptr->_Myval), _STD forward<_Valtys>(_Vals)...);
        _就地构造(this->_Ptr->_Left, _Myhead);
        _就地构造(this->_Ptr->_Parent, _Myhead);
        _就地构造(this->_Ptr->_Right, _Myhead);
        this->_Ptr->_Color = _红;
        this->_Ptr->_Isnil = false;
    }

    _树临时节点(const _树临时节点&)            = delete;
    _树临时节点& operator=(const _树临时节点&) = delete;

    ~_树临时节点() {
        if (this->_Ptr) {
            _就地析构(this->_Ptr->_Left);
            _就地析构(this->_Ptr->_Parent);
            _就地析构(this->_Ptr->_Right);
            _结点分配器特征::destroy(this->_Al, _STD addressof(this->_Ptr->_Myval));
        }
    }
};

template <class _特征>
class _树 { // ordered red-black tree for map/multimap/set/multiset
public:
    using 键类型       = typename _特征::键类型;
    using value_type     = typename _特征::value_type;
    using 分配器类型 = typename _特征::分配器类型;

protected:
    using _分配器类型          = _重绑定分配器类型<分配器类型, value_type>;
    using _分配器特征   = allocator_traits<_分配器类型>;
    using _节点          = _树节点<value_type, typename _分配器特征::void_pointer>;
    using _结点分配器        = _重绑定分配器类型<分配器类型, _节点>;
    using _结点分配器特征 = allocator_traits<_结点分配器>;
    using _结点指针       = typename _结点分配器特征::pointer;

    using _迭代器检查值 = _树值<conditional_t<_Is_simple_alloc_v<_结点分配器>, _树简单类型集<value_type>,
        _树迭代类型集<value_type, typename _分配器特征::size_type, typename _分配器特征::difference_type,
            typename _分配器特征::pointer, typename _分配器特征::const_pointer, _结点指针>>>;

    static constexpr bool _Multi  = _特征::_Multi;
    static constexpr bool _Is_set = is_same_v<键类型, value_type>;

    enum _红黑 { // colors for link to parent
        _红,
        _黑
    };

public:
    using 值比较 = typename _特征::值比较;

    using 键比较器 = typename _特征::键比较器;

    using size_type       = typename _分配器特征::size_type;
    using difference_type = typename _分配器特征::difference_type;
    using pointer         = typename _分配器特征::pointer;
    using const_pointer   = typename _分配器特征::const_pointer;
    using reference       = value_type&;
    using 常量引用 = const value_type&;

    using 迭代器       = conditional_t<_Is_set, _树常量迭代器<_迭代器检查值>, _树迭代器<_迭代器检查值>>;
    using 常量迭代器 = _树常量迭代器<_迭代器检查值>;
    using _非检查迭代器 =
        conditional_t<_Is_set, _树非检查常量迭代器<_迭代器检查值>, _树非检查迭代器<_迭代器检查值>>;
    using _非检查常量迭代器 = _树非检查常量迭代器<_迭代器检查值>;

    using reverse_iterator       = _STD reverse_iterator<迭代器>;
    using const_reverse_iterator = _STD reverse_iterator<常量迭代器>;

    enum class _策略 : bool {
        _复制,
        _Move,
    };

    _树(const 键比较器& _Parg) : _Mypair(_先一后变参实参{}, _Parg, _先零后变参实参{}) {
        _分配哨兵与代理();
    }

    _树(const 键比较器& _Parg, const 分配器类型& _Al)
        : _Mypair(_先一后变参实参{}, _Parg, _先一后变参实参{}, _Al) {
        _分配哨兵与代理();
    }

    template <class _Any_alloc>
    _树(const _树& _Right, _Any_alloc&& _Al)
        : _Mypair(_先一后变参实参{}, _Right.键比较函数(), _先一后变参实参{},
              _STD forward<_Any_alloc>(_Al)) {
        auto&& _Alproxy   = _取代理分配器(_结点分配器, _取分配器());
        const auto _Scary = _取检查值();
        _容器代理指针<_分配器类型> _代理(_Alproxy, *_Scary);
        _树头作用域指针<_结点分配器, _迭代器检查值> _哨兵(_取分配器(), *_Scary);
        _复制<_策略::_复制>(_Right);
        _哨兵._释放();
        _代理._释放();
    }

    _树(_树&& _Right)
        : _Mypair(_先一后变参实参{}, _Right.键比较函数(), // intentionally copy comparator, see LWG-2227
              _先一后变参实参{}, _STD move(_Right._取分配器())) {
        _分配哨兵与代理();
        _交换值不含比较器(_Right);
    }

    _树(_树&& _Right, const 分配器类型& _Al)
        : _Mypair(_先一后变参实参{}, _Right.键比较函数(), // intentionally copy comparator, see LWG-2227
              _先一后变参实参{}, _Al) {
        if constexpr (!_结点分配器特征::is_always_equal::value) {
            if (_取分配器() != _Right._取分配器()) {
                auto&& _Alproxy   = _取代理分配器(_结点分配器, _取分配器());
                const auto _Scary = _取检查值();
                _容器代理指针<_分配器类型> _代理(_Alproxy, *_Scary);
                _树头作用域指针<_结点分配器, _迭代器检查值> _哨兵(_取分配器(), *_Scary);
                _复制<_策略::_Move>(_Right);
                _哨兵._释放();
                _代理._释放();
                return;
            }
        }

        _分配哨兵与代理();
        _交换值不含比较器(_Right);
    }

    _树& operator=(_树&& _Right)
        noexcept(_结点分配器特征::is_always_equal::value && is_nothrow_move_assignable_v<键比较器>) {
        if (this == _STD addressof(_Right)) {
            return *this;
        }

        auto& _Al                 = _取分配器();
        auto& _Right_al           = _Right._取分配器();
        constexpr auto _Pocma_val = _Choose_pocma_v<_结点分配器>;
        if constexpr (_Pocma_val == _传播复制移动赋值取值::_Propagate_allocators) {
            if (_Al != _Right_al) {
                清空();
                _取比较器()            = _Right._取比较器(); // intentionally copy comparator, see LWG-2227
                auto&& _Alproxy       = _取代理分配器(_结点分配器, _Al);
                auto&& _Right_alproxy = _取代理分配器(_结点分配器, _Right_al);
                _容器代理指针<_分配器类型> _代理(_Right_alproxy, _离开代理未绑定{});
                const auto _Scary       = _取检查值();
                const auto _Right_scary = _Right._取检查值();
                const auto _Newhead     = _STD exchange(_Right_scary->_Myhead, _节点::_建头节点(_Right_al));
                const auto _Newsize     = _STD exchange(_Right_scary->_我的尺寸, size_type{0});
                _Scary->_擦除头(_Al);
                _传播移动赋值(_Al, _Right_al);
                _Scary->_Myhead = _Newhead;
                _Scary->_我的尺寸 = _Newsize;
                _代理._绑定(_Alproxy, _Scary);
                _Scary->_交换代理与迭代器(*_Right_scary);
                return *this;
            }
        } else if constexpr (_Pocma_val == _传播复制移动赋值取值::_No_propagate_allocators) {
            if (_Al != _Right_al) {
                清空();
                _取比较器() = _Right._取比较器(); // intentionally copy comparator, see LWG-2227
                _复制<_策略::_Move>(_Right);
                return *this;
            }
        }

        清空();
        _取比较器() = _Right._取比较器(); // intentionally copy comparator, see LWG-2227
        _传播移动赋值(_Al, _Right_al);
        _交换值不含比较器(_Right);

        return *this;
    }

private:
    void _交换值不含比较器(_树& _Right) { // swap contents (except comparator) with _Right, equal allocators
        using _STD swap;
        const auto _Scary       = _取检查值();
        const auto _Right_scary = _Right._取检查值();
        _Scary->_交换代理与迭代器(*_Right_scary);
        swap(_Scary->_Myhead, _Right_scary->_Myhead); // intentional ADL
        _STD swap(_Scary->_我的尺寸, _Right_scary->_我的尺寸);
    }

protected:
    template <class... _Valtys>
    pair<_结点指针, bool> _就地安置(_Valtys&&... _Vals) {
        using _就地键提取器 = typename _特征::template _就地键提取器<_Valtys...>;
        const auto _Scary             = _取检查值();
        _树查找结果<_结点指针> _Loc;
        _结点指针 _Inserted;
        if constexpr (!_Multi && _就地键提取器::_Extractable) {
            const auto& _Keyval = _就地键提取器::_摘取(_Vals...);
            _Loc                = _查找下界(_Keyval);
            if (_下界重复项(_Loc._Bound, _Keyval)) {
                return {_Loc._Bound, false};
            }

            _检查增一();
            _Inserted = _树临时节点<_结点分配器>(_取分配器(), _Scary->_Myhead, _STD forward<_Valtys>(_Vals)...)._释放();
            // nothrow hereafter
        } else {
            _树临时节点<_结点分配器> _新节点(_取分配器(), _Scary->_Myhead, _STD forward<_Valtys>(_Vals)...);
            const auto& _Keyval = _特征::_取键(_新节点._Ptr->_Myval);
            if constexpr (_Multi) { // duplicate check if unique
                _Loc = _查找上界(_Keyval);
            } else {
                _Loc = _查找下界(_Keyval);
                if (_下界重复项(_Loc._Bound, _Keyval)) {
                    return {_Loc._Bound, false};
                }
            }

            _检查增一();
            // nothrow hereafter
            _Inserted = _新节点._释放();
        }

        return {_Scary->_插入节点(_Loc._Location, _Inserted), true};
    }

public:
    template <class... _Valtys>
    pair<迭代器, bool> 就地构造(_Valtys&&... _Vals) {
        const auto _结果 = _就地安置(_STD forward<_Valtys>(_Vals)...);
        return {迭代器(_结果.first, _取检查值()), _结果.second};
    }

protected:
    template <class... _Valtys>
    _结点指针 _按提示就地构造(const _结点指针 _Hint, _Valtys&&... _Vals) {
        using _就地键提取器 = typename _特征::template _就地键提取器<_Valtys...>;
        const auto _Scary             = _取检查值();
        _树查找提示结果<_结点指针> _Loc;
        _结点指针 _Inserted;
        if constexpr (!_Multi && _就地键提取器::_Extractable) {
            _Loc = _按提示查找(_Hint, _就地键提取器::_摘取(_Vals...));
            if (_Loc._Duplicate) {
                return _Loc._Location._Parent;
            }

            _检查增一();
            _Inserted = _树临时节点<_结点分配器>(_取分配器(), _Scary->_Myhead, _STD forward<_Valtys>(_Vals)...)._释放();
            // nothrow hereafter
        } else {
            _树临时节点<_结点分配器> _新节点(_取分配器(), _Scary->_Myhead, _STD forward<_Valtys>(_Vals)...);
            _Loc = _按提示查找(_Hint, _特征::_取键(_新节点._Ptr->_Myval));
            if constexpr (!_Multi) {
                if (_Loc._Duplicate) {
                    return _Loc._Location._Parent;
                }
            }

            _检查增一();
            // nothrow hereafter
            _Inserted = _新节点._释放();
        }

        return _Scary->_插入节点(_Loc._Location, _Inserted);
    }

public:
    template <class... _Valtys>
    迭代器 按提示就地构造(常量迭代器 _Where, _Valtys&&... _Vals) { // 插入 value_type(_Val...) at _Where
        const auto _Scary = _取检查值();
#if _ITERATOR_DEBUG_LEVEL == 2
        _STL_VERIFY(_Where._取容器() == _Scary, "map/set 插入 迭代器 outside range");
#endif // _ITERATOR_DEBUG_LEVEL == 2
        return 迭代器(_按提示就地构造(_Where._Ptr, _STD forward<_Valtys>(_Vals)...), _Scary);
    }

    ~_树() noexcept {
        const auto _Scary = _取检查值();
        _Scary->_擦除头(_取分配器());
#if _ITERATOR_DEBUG_LEVEL != 0 // TRANSITION, ABI
        auto&& _Alproxy = _取代理分配器(_结点分配器, _取分配器());
        _删除原生内部(_Alproxy, _Scary->_Myproxy);
#endif // _ITERATOR_DEBUG_LEVEL != 0
    }

public:
    _树& operator=(const _树& _Right) {
        if (this == _STD addressof(_Right)) {
            return *this;
        }

        auto& _Al       = _取分配器();
        auto& _Right_al = _Right._取分配器();
        if constexpr (_Choose_pocca_v<_结点分配器>) {
            if (_Al != _Right_al) {
                清空();
                const auto _Scary = _取检查值();
                _Scary->_孤儿化全部();
                auto&& _Alproxy       = _取代理分配器(_结点分配器, _Al);
                auto&& _Right_alproxy = _取代理分配器(_结点分配器, _Right_al);
                _容器代理指针<_分配器类型> _代理(_Right_alproxy, _离开代理未绑定{});
                auto _Right_al_non_const = _Right_al;
                auto _Newhead            = _节点::_建头节点(_Right_al_non_const);
                _节点::_Freenode0(_Al, _Scary->_Myhead);
                _传播复制赋值(_Al, _Right_al);
                _Scary->_Myhead = _Newhead;
                _代理._绑定(_Alproxy, _Scary);
                _取比较器() = _Right._取比较器();
                _复制<_策略::_复制>(_Right);
                return *this;
            }
        }

        清空();
        _取比较器() = _Right._取比较器();
        _传播复制赋值(_Al, _Right_al);
        _复制<_策略::_复制>(_Right);

        return *this;
    }

    _NODISCARD 迭代器 begin() noexcept {
        const auto _Scary = _取检查值();
        return 迭代器(_Scary->_Myhead->_Left, _Scary);
    }

    _NODISCARD 常量迭代器 begin() const noexcept {
        const auto _Scary = _取检查值();
        return 常量迭代器(_Scary->_Myhead->_Left, _Scary);
    }

    _NODISCARD 迭代器 end() noexcept {
        const auto _Scary = _取检查值();
        return 迭代器(_Scary->_Myhead, _Scary);
    }

