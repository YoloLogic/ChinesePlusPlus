protected:
    template <class _Keyty>
    _树查找提示结果<_结点指针> _按提示查找(const _结点指针 _Hint, const _Keyty& _Keyval) const {
        const auto& _比较器 = _取比较器();
        const auto _Head  = _取检查值()->_Myhead;
        if constexpr (_Multi) { // 插入 even if duplicate
            if (_Hint->_Isnil) {
                // 插入 at end if greater than or equal to last element
                if (_Head->_Parent->_Isnil || !_DEBUG_LT_PRED(_比较器, _Keyval, _特征::_取键(_Head->_Right->_Myval))) {
                    return {{_Head->_Right, _树子向::_Right}, false};
                }

                // _Hint is end(); it must be closer to the end of equivalents
                return {_查找上界(_Keyval)._Location, false};
            }

            if (_Hint == _Head->_Left) {
                // 插入 at beginning if less than or equal to first element
                if (!_DEBUG_LT_PRED(_比较器, _特征::_取键(_Hint->_Myval), _Keyval)) {
                    return {{_Hint, _树子向::_Left}, false};
                }

                // _Hint is begin(); it must be closer to the beginning of equivalents
                return {_查找下界(_Keyval)._Location, false};
            }

            if (!_DEBUG_LT_PRED(_比较器, _特征::_取键(_Hint->_Myval), _Keyval)) {
                // _Val <= *_Hint
                const auto _Prev = (--(_非检查常量迭代器(_Hint, nullptr)))._Ptr;
                if (!_DEBUG_LT_PRED(_比较器, _Keyval, _特征::_取键(_Prev->_Myval))) {
                    // _Val <= *_Hint and _Val >= *prev(_Hint); 插入 here
                    if (_Prev->_Right->_Isnil) {
                        return {{_Prev, _树子向::_Right}, false};
                    } else {
                        return {{_Hint, _树子向::_Left}, false};
                    }
                }

                // _Val goes before *_Hint; _Hint must be closer to the end of equivalents
                return {_查找上界(_Keyval)._Location, false};
            }

            // _Val goes after *_Hint; _Hint must be closer to the beginning of equivalents
            return {_查找下界(_Keyval)._Location, false};
        } else { // 插入 only if unique
            if (_Hint->_Isnil) { // 插入 at end if after last element
                // 插入 at end if greater than last element
                if (_Head->_Parent->_Isnil || _DEBUG_LT_PRED(_比较器, _特征::_取键(_Head->_Right->_Myval), _Keyval)) {
                    return {{_Head->_Right, _树子向::_Right}, false};
                }
            } else if (_Hint == _Head->_Left) {
                // 插入 at beginning if less than first element
                if (_DEBUG_LT_PRED(_比较器, _Keyval, _特征::_取键(_Hint->_Myval))) {
                    return {{_Hint, _树子向::_Left}, false};
                }
            } else if (_DEBUG_LT_PRED(_比较器, _Keyval, _特征::_取键(_Hint->_Myval))) {
                // _Val < *_Hint
                const auto _Prev = (--(_非检查常量迭代器(_Hint, nullptr)))._Ptr;
                if (_DEBUG_LT_PRED(_比较器, _特征::_取键(_Prev->_Myval), _Keyval)) {
                    // _Val < *_Hint and _Val > *prev(_Hint); 插入 here
                    if (_Prev->_Right->_Isnil) {
                        return {{_Prev, _树子向::_Right}, false};
                    } else {
                        return {{_Hint, _树子向::_Left}, false};
                    }
                }
            } else if (_DEBUG_LT_PRED(_比较器, _特征::_取键(_Hint->_Myval), _Keyval)) {
                // _Val > *_Hint
                const auto _Next = (++(_非检查常量迭代器(_Hint, nullptr)))._Ptr;
                if (_Next->_Isnil || _DEBUG_LT_PRED(_比较器, _Keyval, _特征::_取键(_Next->_Myval))) {
                    // _Val > *_Hint and _Val < *next(_Hint); 插入 here
                    if (_Hint->_Right->_Isnil) {
                        return {{_Hint, _树子向::_Right}, false};
                    }

                    return {{_Next, _树子向::_Left}, false};
                }
            } else {
                // _Val is equivalent to *_Hint; don't 插入
                return {{_Hint, _树子向::_Right}, true};
            }

            const auto _Loc = _查找下界(_Keyval);
            if (_下界重复项(_Loc._Bound, _Keyval)) {
                return {{_Loc._Bound, _树子向::_Unused}, true};
            }

            return {_Loc._Location, false};
        }
    }

    template <class _Keyty>
    _树查找结果<_结点指针> _查找上界(const _Keyty& _Keyval) const {
        const auto _Scary = _取检查值();
        _树查找结果<_结点指针> _结果{{_Scary->_Myhead->_Parent, _树子向::_Right}, _Scary->_Myhead};
        _结点指针 _Trynode = _结果._Location._Parent;
        while (!_Trynode->_Isnil) {
            _结果._Location._Parent = _Trynode;
            if (_DEBUG_LT_PRED(_取比较器(), _Keyval, _特征::_取键(_Trynode->_Myval))) {
                _结果._Location._Child = _树子向::_Left;
                _结果._Bound           = _Trynode;
                _Trynode                 = _Trynode->_Left;
            } else {
                _结果._Location._Child = _树子向::_Right;
                _Trynode                 = _Trynode->_Right;
            }
        }

        return _结果;
    }

    template <class _Keyty>
    bool _下界重复项(const _结点指针 _Bound, const _Keyty& _Keyval) const {
        return !_Bound->_Isnil && !_DEBUG_LT_PRED(_取比较器(), _Keyval, _特征::_取键(_Bound->_Myval));
    }

    template <class _Keyty>
    _树查找结果<_结点指针> _查找下界(const _Keyty& _Keyval) const {
        const auto _Scary = _取检查值();
        _树查找结果<_结点指针> _结果{{_Scary->_Myhead->_Parent, _树子向::_Right}, _Scary->_Myhead};
        _结点指针 _Trynode = _结果._Location._Parent;
        while (!_Trynode->_Isnil) {
            _结果._Location._Parent = _Trynode;
            if (_DEBUG_LT_PRED(_取比较器(), _特征::_取键(_Trynode->_Myval), _Keyval)) {
                _结果._Location._Child = _树子向::_Right;
                _Trynode                 = _Trynode->_Right;
            } else {
                _结果._Location._Child = _树子向::_Left;
                _结果._Bound           = _Trynode;
                _Trynode                 = _Trynode->_Left;
            }
        }

        return _结果;
    }

    void _检查增一() {
        if (max_size() == _取检查值()->_我的尺寸) {
            _抛树长度错误();
        }
    }

    template <_策略 _Strat>
    void _复制(const _树& _Right) { // copy or move entire tree from _Right
        const auto _Scary        = _取检查值();
        const auto _Right_scary  = _Right._取检查值();
        _Scary->_Myhead->_Parent = _复制节点<_Strat>(_Right_scary->_Myhead->_Parent, _Scary->_Myhead);
        _Scary->_我的尺寸          = _Right_scary->_我的尺寸;
        if (!_Scary->_Myhead->_Parent->_Isnil) { // nonempty tree, look for new smallest and largest
            _Scary->_Myhead->_Left  = _迭代器检查值::_最小(_Scary->_Myhead->_Parent);
            _Scary->_Myhead->_Right = _迭代器检查值::_最大(_Scary->_Myhead->_Parent);
        } else { // empty tree, just tidy head pointers
            _Scary->_Myhead->_Left  = _Scary->_Myhead;
            _Scary->_Myhead->_Right = _Scary->_Myhead;
        }
    }

    template <_策略 _Strat, class _类型>
    _结点指针 _复制或移动(_类型& _Val) {
        if constexpr (_Strat == _策略::_复制) {
            return _建节点(_Val);
        } else {
            if constexpr (_Is_set) {
                return _建节点(_STD move(_Val));
            } else {
                return _建节点(_STD move(const_cast<键类型&>(_Val.first)), _STD move(_Val.second));
            }
        }
    }

    template <_策略 _Strat>
    _结点指针 _复制节点(_结点指针 _Rootnode, _结点指针 _Wherenode) {
        // copy entire subtree, recursively
        const auto _Scary = _取检查值();
        _结点指针 _Newroot = _Scary->_Myhead; // point at nil node

        if (!_Rootnode->_Isnil) { // copy or move a node, then any subtrees
            _Newroot          = _复制或移动<_Strat>(_Rootnode->_Myval); // memorize new root
            _Newroot->_Parent = _Wherenode;
            _Newroot->_Color  = _Rootnode->_Color;

            typename _迭代器检查值::template _擦树并孤立守卫<_结点分配器> _Guard{_Scary, _取分配器(), _Newroot};

            _Newroot->_Left  = _复制节点<_Strat>(_Rootnode->_Left, _Newroot);
            _Newroot->_Right = _复制节点<_Strat>(_Rootnode->_Right, _Newroot);

            _Guard._Val_ptr = nullptr;
        }

        return _Newroot; // return newly constructed tree
    }

    template <class _Other>
    pair<_结点指针, _结点指针> _等值区间(const _Other& _Keyval) const
        noexcept(_Nothrow_compare<键比较器, 键类型, _Other> && _Nothrow_compare<键比较器, _Other, 键类型>) {
        // find range of nodes equivalent to _Keyval
        const auto _Scary = _取检查值();
        const auto& _比较器 = _取比较器();
        _结点指针 _Pnode   = _Scary->_Myhead->_Parent;
        _结点指针 _Lonode  = _Scary->_Myhead; // end() if search fails
        _结点指针 _Hinode  = _Scary->_Myhead; // end() if search fails

        while (!_Pnode->_Isnil) {
            const auto& _Nodekey = _特征::_取键(_Pnode->_Myval);
            if (_DEBUG_LT_PRED(_比较器, _Nodekey, _Keyval)) {
                _Pnode = _Pnode->_Right; // descend right subtree
            } else { // _Pnode not less than _Keyval, remember it
                if (_Hinode->_Isnil && _DEBUG_LT_PRED(_比较器, _Keyval, _Nodekey)) {
                    _Hinode = _Pnode; // _Pnode greater, remember it
                }

                _Lonode = _Pnode;
                _Pnode  = _Pnode->_Left; // descend left subtree
            }
        }

        _Pnode = _Hinode->_Isnil ? _Scary->_Myhead->_Parent : _Hinode->_Left; // continue scan for upper bound
        while (!_Pnode->_Isnil) {
            if (_DEBUG_LT_PRED(_取比较器(), _Keyval, _特征::_取键(_Pnode->_Myval))) {
                // _Pnode greater than _Keyval, remember it
                _Hinode = _Pnode;
                _Pnode  = _Pnode->_Left; // descend left subtree
            } else {
                _Pnode = _Pnode->_Right; // descend right subtree
            }
        }

        return {_Lonode, _Hinode};
    }

#if _HAS_CXX17
public:
    using 结点类型 = typename _特征::结点类型;

    结点类型 提取(const 常量迭代器 _Where) {
        const auto _Scary = _取检查值();
#if _ITERATOR_DEBUG_LEVEL == 2
        _STL_VERIFY(_Where._取容器() == _Scary && !_Where._Ptr->_Isnil, "map/set 擦除 迭代器 outside range");
#endif // _ITERATOR_DEBUG_LEVEL == 2

        const auto _Ptr = _Scary->_摘取(_Where._解包());
        _Scary->_孤立指针(_Ptr);
        return 结点类型::_Make(_Ptr, _取分配器());
    }

    结点类型 提取(const 键类型& _Keyval) {
        const 常量迭代器 _Where = find(_Keyval);
        if (_Where == end()) {
            return 结点类型{};
        }

        return 提取(_Where);
    }

#if _HAS_CXX23
    template <class _Kx>
        requires _Is_transparent_v<键比较器> && (!is_convertible_v<_Kx, 常量迭代器>)
              && (!is_convertible_v<_Kx, 迭代器>)
    结点类型 提取(_Kx&& _Keyval) {
        const 常量迭代器 _Where = find(_Keyval);
        if (_Where == end()) {
            return 结点类型{};
        }

        return 提取(_Where);
