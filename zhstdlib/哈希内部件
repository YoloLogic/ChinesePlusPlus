    struct _范围擦除器 {
        _范围擦除器(const _范围擦除器&)            = delete;
        _范围擦除器& operator=(const _范围擦除器&) = delete;

#if _ITERATOR_DEBUG_LEVEL == 2
        // Keep the 链表实现 nodes around until we have found all those we will erase, for an O(iterators + erasures) update
        // of the iterator chain.
        _范围擦除器(_我的链表& _List_, const _结点指针 _First_) noexcept
            : _List(_List_), _First(_First_), _Next(_First_) {}

        void _递增已擦除() noexcept {
            _Next = _Next->_Next;
        }

        ~_范围擦除器() noexcept {
            _List._非检查擦除(_First, _Next);
        }

        _我的链表& _List;
        const _结点指针 _First;
        _结点指针 _Next;
