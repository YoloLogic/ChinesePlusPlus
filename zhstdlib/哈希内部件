    template <class _Keyty>
    _NODISCARD _结点指针 _查找首个(const _Keyty& _Keyval, const size_t _Hashval) const {
        // find node pointer to first node matching _Keyval (with hash _Hashval) if it exists; otherwise, 结束
        const size_type _Bucket = _Hashval & _Mask;
        _结点指针 _Where         = _Vec._Mypair._Myval2._Myfirst[_Bucket << 1]._Ptr;
        const _结点指针 _End     = _List._Mypair._Myval2._Myhead;
        if (_Where == _End) {
            return _End;
