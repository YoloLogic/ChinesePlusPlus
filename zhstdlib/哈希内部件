      // Destroy the nodes as we encounter them to avoid a second traversal of the linked 链表实现.
        _范围擦除器(_我的链表& _List_, const _结点指针 _First_) noexcept
            : _List(_List_), _Predecessor(_First_->_Prev), _Next(_First_) {}

        void _递增已擦除() noexcept {
            const auto _Oldnext = _Next;
            _Next               = _Oldnext->_Next;
            _节点::_Freenode(_List._取分配器(), _Oldnext);
            --_List._Mypair._Myval2._Mysize;
        }

        ~_范围擦除器() noexcept {
            _Predecessor->_Next = _Next;
            _Next->_Prev        = _Predecessor;
        }

        _我的链表& _List;
        const _结点指针 _Predecessor;
        _结点指针 _Next;
#endif // ^^^ _ITERATOR_DEBUG_LEVEL != 2 ^^^
