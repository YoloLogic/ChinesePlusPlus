private:
    struct _等值区间结果 {
        _非检查常量迭代器 _First;
        _非检查常量迭代器 _Last;
        size_type _Distance;
    };

    template <class _Keyty>
    _NODISCARD _等值区间结果 _等值区间(const _Keyty& _Keyval, const size_t _Hashval) const
        noexcept(_Nothrow_compare<_Traits, 键类型, _Keyty> && _Nothrow_compare<_Traits, _Keyty, 键类型>) {
        const size_type _Bucket              = _Hashval & _Mask;
        _非检查常量迭代器 _Where     = _Vec._Mypair._Myval2._Myfirst[_Bucket << 1];
        const _非检查常量迭代器 _End = _非检查结束();
        if (_Where == _End) {
            return {_End, _End, 0};
        }

        const _非检查常量迭代器 _Bucket_hi = _Vec._Mypair._Myval2._Myfirst[(_Bucket << 1) + 1];
        for (; _Traitsobj(_Traits::_取键(*_Where), _Keyval); ++_Where) {
            if (_Where == _Bucket_hi) {
                return {_End, _End, 0};
            }
        }

        if constexpr (!_Traits::_Standard) {
            if (_Traitsobj(_Keyval, _Traits::_取键(*_Where))) {
                return {_End, _End, 0};
            }
        }

        const _非检查常量迭代器 _First = _Where;
        if constexpr (_Multi) {
            size_type _Distance = 0;
            for (;;) {
                ++_Distance;

                const bool _At_bucket_end = _Where == _Bucket_hi;
                ++_Where;
                if (_At_bucket_end) {
                    break;
                }

                if (_Traitsobj(_Keyval, _Traits::_取键(*_Where))) {
                    break;
                }
            }

            return {_First, _Where, _Distance};
        } else {
            ++_Where; // found the unique element
            return {_First, _Where, 1};
        }
    }

