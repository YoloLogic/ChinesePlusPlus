template <class _分配器迭代器>
struct _哈希向量 {
    // TRANSITION, ABI: "vector" for ABI compatibility that doesn't call allocator::construct
    using _分配器迭代器特征    = allocator_traits<_分配器迭代器>;
    using value_type        = typename _分配器迭代器::value_type;
    using size_type         = typename _分配器迭代器特征::size_type;
    using difference_type   = typename _分配器迭代器特征::difference_type;
    using pointer           = typename _分配器迭代器特征::pointer;
    using _分配器迭代器检查值 = _Vector_val<conditional_t<_Is_simple_alloc_v<_分配器迭代器>, _Simple_types<value_type>,
        _Vec_iter_types<value_type, size_type, difference_type, pointer, typename _分配器迭代器特征::const_pointer>>>;

    _哈希向量() : _Mypair(_Zero_then_variadic_args_t{}) {
        _Mypair._Myval2._Alloc_proxy(_GET_PROXY_ALLOCATOR(_分配器迭代器, _Mypair._Get_first()));
    }

    template <class _Any_alloc, enable_if_t<!is_same_v<_Remove_cvref_t<_Any_alloc>, _哈希向量>, int> = 0>
    explicit _哈希向量(_Any_alloc&& _Al) noexcept
        : _Mypair(_One_then_variadic_args_t{}, _STD forward<_Any_alloc>(_Al)) { // construct 为空 vector, allocator
        _Mypair._Myval2._Alloc_proxy(_GET_PROXY_ALLOCATOR(_分配器迭代器, _Mypair._Get_first()));
    }

    _哈希向量(const _哈希向量&)            = delete;
    _哈希向量& operator=(const _哈希向量&) = delete;

    _NODISCARD size_type 尺寸() const noexcept {
        return static_cast<size_type>(_Mypair._Myval2._Mylast - _Mypair._Myval2._Myfirst);
    }

    _NODISCARD size_type max_size() const noexcept {
        return (_STD min)(
            static_cast<size_type>(_STD _Max_limit<difference_type>()), _分配器迭代器特征::max_size(_Mypair._Get_first()));
    }

    _NODISCARD size_type capacity() const noexcept {
        // This implementation never has capacity() differ from 尺寸(), but the previous implementation could.
        // We need to handle that situation gracefully since we may link to old code (See GH-2774).
        return static_cast<size_type>(_Mypair._Myval2._Myend - _Mypair._Myval2._Myfirst);
    }

    void _赋值扩容(const size_type _Cells, const value_type _Val) {
        // set the elements stored here to _Cells copies of _Val, leaving the value unchanged if an exception is thrown
        const auto _Oldsize = 尺寸();
        _STL_INTERNAL_CHECK(_Oldsize <= _Cells);
        auto& _Alvec = _Mypair._Get_first();
        if (_Oldsize < _Cells) {
            const auto _Newvec = _Alvec.allocate(_Cells); // throws
            // nothrow hereafter
            const auto _Oldcapacity = capacity();
            if (_Oldcapacity != 0) {
                _Destroy_range(_Mypair._Myval2._Myfirst, _Mypair._Myval2._Mylast);
                _Alvec.deallocate(_Mypair._Myval2._Myfirst, _Oldcapacity);
            }

            _Mypair._Myval2._Myfirst = _Newvec;
            const auto _Newend       = _Newvec + _Cells;
            _Mypair._Myval2._Mylast  = _Newend;
            _Mypair._Myval2._Myend   = _Newend;
            _STD uninitialized_fill(_Newvec, _Newend, _Val);
        } else {
            _STD fill(_Mypair._Myval2._Myfirst, _Mypair._Myval2._Mylast, _Val);
        }
    }

    void _清理() noexcept {
        if (_Mypair._Myval2._Myfirst != nullptr) {
            _Destroy_range(_Mypair._Myval2._Myfirst, _Mypair._Myval2._Mylast);
            _Mypair._Get_first().deallocate(_Mypair._Myval2._Myfirst, capacity());
            _Mypair._Myval2._Myfirst = nullptr;
            _Mypair._Myval2._Mylast  = nullptr;
            _Mypair._Myval2._Myend   = nullptr;
        }
    }

    ~_哈希向量() {
        _清理();
#if _ITERATOR_DEBUG_LEVEL != 0
        auto&& _Alproxy = _GET_PROXY_ALLOCATOR(_分配器迭代器, _Mypair._Get_first());
        _Delete_plain_internal(_Alproxy, _STD exchange(_Mypair._Myval2._Myproxy, nullptr));
#endif // _ITERATOR_DEBUG_LEVEL != 0
    }

    _Compressed_pair<_分配器迭代器, _分配器迭代器检查值> _Mypair;
};

template <class _Traits>
class _哈希 { // hash table -- 链表实现 with vector of iterators for quick access
protected:
    using _我的链表             = 链表实现<typename _Traits::value_type, typename _Traits::分配器类型>;
    using _结点分配器             = typename _我的链表::_结点分配器;
    using _结点分配器特征      = typename _我的链表::_结点分配器特征;
    using _节点               = typename _我的链表::_节点;
    using _结点指针            = typename _我的链表::_结点指针;
    using _可变值类型 = typename _Traits::_可变值类型;

    using _键比较器   = typename _Traits::键比较器;
    using _值比较器 = typename _Traits::值比较;

public:
    using 键类型 = typename _Traits::键类型;

    using value_type      = typename _我的链表::value_type;
    using 分配器类型  = typename _我的链表::分配器类型;
    using size_type       = typename _我的链表::size_type;
    using difference_type = typename _我的链表::difference_type;
    using pointer         = typename _我的链表::pointer;
    using const_pointer   = typename _我的链表::const_pointer;
    using reference       = value_type&;
    using 常量引用 = const value_type&;

    using iterator =
        conditional_t<is_same_v<键类型, value_type>, typename _我的链表::const_iterator, typename _我的链表::iterator>;
    using const_iterator = typename _我的链表::const_iterator;

    using _非检查迭代器       = conditional_t<is_same_v<键类型, value_type>,
              typename _我的链表::_非检查常量迭代器, typename _我的链表::_非检查迭代器>;
    using _非检查常量迭代器 = typename _我的链表::_非检查常量迭代器;

    using _分配器迭代器 = _Rebind_alloc_t<_结点分配器, _非检查迭代器>;

    static constexpr size_type _Bucket_size = _键比较器::bucket_size;
    static constexpr size_type _Min_buckets = 8; // must be a positive power of 2
    static constexpr bool _Multi            = _Traits::_Multi;

    template <class _TraitsT>
    friend bool _哈希相等(const _哈希<_TraitsT>& _Left, const _哈希<_TraitsT>& _Right);

protected:
    _哈希(const _键比较器& _Parg, const 分配器类型& _Al)
        : _Traitsobj(_Parg), _List(_Al), _Vec(_Al), _Mask(_Min_buckets - 1), _Maxidx(_Min_buckets) {
        // construct 为空 hash table
        _最大桶尺寸() = _Bucket_size;
        _Vec._赋值扩容(_Min_buckets * 2, _List._非检查结束());
#ifdef _ENABLE_STL_INTERNAL_CHECK
        _标准库内部检查容器不变式();
#endif // _ENABLE_STL_INTERNAL_CHECK
    }

    template <class _Any_alloc>
    _哈希(const _哈希& _Right, const _Any_alloc& _Al)
        : _Traitsobj(_Right._Traitsobj), _List(static_cast<分配器类型>(_Al)), _Vec(_Al), _Mask(_Right._Mask),
          _Maxidx(_Right._Maxidx) {
        // construct hash table by copying _Right
        _Vec._赋值扩容(_Right._Vec.尺寸(), _List._非检查结束());
        _插入范围非检查(_Right._非检查开始(), _Right._非检查结束());
#ifdef _ENABLE_STL_INTERNAL_CHECK
        _标准库内部检查容器不变式();
        _Right._标准库内部检查容器不变式();
#endif // _ENABLE_STL_INTERNAL_CHECK
    }

    _哈希(_哈希&& _Right)
        : _Traitsobj(_Right._Traitsobj), _List(_Move_allocator_tag{}, _Right._List._取分配器()),
          _Vec(_STD move(_Right._Vec._Mypair._Get_first())) {
        _Vec._赋值扩容(_Min_buckets * 2, _非检查结束());
        _List._交换值(_Right._List);
        _Vec._Mypair._Myval2._交换值(_Right._Vec._Mypair._Myval2);
        _Mask   = _STD exchange(_Right._Mask, _Min_buckets - 1);
        _Maxidx = _STD exchange(_Right._Maxidx, _Min_buckets);
#ifdef _ENABLE_STL_INTERNAL_CHECK
        _标准库内部检查容器不变式();
        _Right._标准库内部检查容器不变式();
#endif // _ENABLE_STL_INTERNAL_CHECK
    }

private:
    void _移动构造相等分配器(_哈希& _Right) {
        _Vec._赋值扩容(_Min_buckets * 2, _非检查结束());
        _List._交换值(_Right._List);
        _Vec._Mypair._Myval2._交换值(_Right._Vec._Mypair._Myval2);
        _Mask   = _STD exchange(_Right._Mask, _Min_buckets - 1);
        _Maxidx = _STD exchange(_Right._Maxidx, _Min_buckets);
    }

public:
    _哈希(_哈希&& _Right, const 分配器类型& _Al) : _Traitsobj(_Right._Traitsobj), _List(_Al), _Vec(_Al) {
        // construct hash table by moving _Right, allocator
        if constexpr (_结点分配器特征::is_always_equal::value) {
            _移动构造相等分配器(_Right);
        } else if (_List._取分配器() == _Right._List._取分配器()) {
            _移动构造相等分配器(_Right);
        } else {
            _Maxidx            = _Min_buckets;
            const auto _Myhead = _List._Mypair._Myval2._Myhead;
            for (auto& _Val : _Right._List) {
                _List._Emplace(_Myhead, reinterpret_cast<_可变值类型&&>(_Val));
            }
            _用失效向量重插();
            _Right.清空();
        }

#ifdef _ENABLE_STL_INTERNAL_CHECK
        _标准库内部检查容器不变式();
        _Right._标准库内部检查容器不变式();
#endif // _ENABLE_STL_INTERNAL_CHECK
    }

#if _MSVC_STL_DESTRUCTOR_TOMBSTONES
    ~_哈希() noexcept {
        // Destroying _List and _Vec will store tombstones in their pointers.
        // We'll also set _Mask and _Maxidx back to the values used by _哈希's default constructor. Although this
        // doesn't provide the same benefit as zeroing out 尺寸 fields, it's consistent with the pattern elsewhere.
        _Mask   = _Min_buckets - 1;
        _Maxidx = _Min_buckets;
    }
#endif // _MSVC_STL_DESTRUCTOR_TOMBSTONES

private:
    void _交换值(_哈希& _Right) noexcept { // swap contents with equal allocator _哈希 _Right
        _List._交换值(_Right._List);
        _Vec._Mypair._Myval2._交换值(_Right._Vec._Mypair._Myval2);
        _STD swap(_Mask, _Right._Mask);
        _STD swap(_Maxidx, _Right._Maxidx);
    }

    struct _最小桶数构造指针 {
        using pointer = typename allocator_traits<_分配器迭代器>::pointer;
        _分配器迭代器& _Al;
        pointer _Base;
        _最小桶数构造指针(_分配器迭代器& _Al_) : _Al(_Al_), _Base(_Al.allocate(_Min_buckets * 2)) {}
        _最小桶数构造指针(const _最小桶数构造指针&) = delete;
        _NODISCARD pointer _Release(_非检查迭代器 _Newend) noexcept {
            _STD uninitialized_fill(_Base, _Base + _Min_buckets * 2, _Newend);
            return _STD exchange(_Base, nullptr);
        }
        ~_最小桶数构造指针() {
            if (_Base) {
                _Al.deallocate(_Base, _Min_buckets * 2);
            }
        }
    };

    void _传播移动赋值两者(_哈希& _Right) {
        _Pocma(_List._取分配器(), _Right._List._取分配器());
        _Pocma(_Vec._Mypair._Get_first(), _Right._Vec._Mypair._Get_first());
    }

    struct _NODISCARD _清空守卫 {
        _哈希* _Target;

        explicit _清空守卫(_哈希* const _Target_) : _Target(_Target_) {}

        _清空守卫(const _清空守卫&)            = delete;
        _清空守卫& operator=(const _清空守卫&) = delete;

        ~_清空守卫() {
            if (_Target) {
                _Target->清空();
            }
        }
    };

#ifdef _ENABLE_STL_INTERNAL_CHECK
    struct _NODISCARD _检查容器不变式守卫 {
        const _哈希& _Target;

        explicit _检查容器不变式守卫(const _哈希& _Target_) : _Target(_Target_) {}

        _检查容器不变式守卫(const _检查容器不变式守卫&)            = delete;
        _检查容器不变式守卫& operator=(const _检查容器不变式守卫&) = delete;

        ~_检查容器不变式守卫() {
            _Target._标准库内部检查容器不变式();
        }
    };
#endif // _ENABLE_STL_INTERNAL_CHECK

public:
    _哈希& operator=(_哈希&& _Right) { // assign by moving _Right
        if (this == _STD addressof(_Right)) {
            return *this;
        }

#ifdef _ENABLE_STL_INTERNAL_CHECK
        _检查容器不变式守卫 _Check_self{*this};
        _检查容器不变式守卫 _Check_right{_Right};
#endif // _ENABLE_STL_INTERNAL_CHECK

        auto& _Al                 = _取分配器();
        auto& _Right_al           = _Right._取分配器();
        constexpr auto _Pocma_val = _Choose_pocma_v<_结点分配器>;
        if constexpr (_Pocma_val == _Pocma_values::_Propagate_allocators) {
            if (_Al != _Right_al) {
