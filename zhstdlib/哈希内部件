    template <class _Other_traits>
    void merge(_哈希<_Other_traits>& _That) { // transfer all nodes from _That into *this
        static_assert(is_same_v<_结点指针, typename _哈希<_Other_traits>::_结点指针>,
            "merge() requires an argument with a compatible node type.");

        static_assert(is_same_v<分配器类型, typename _哈希<_Other_traits>::分配器类型>,
            "merge() requires an argument with the same allocator type.");

        if constexpr (is_same_v<_哈希, _哈希<_Other_traits>>) {
            if (this == _STD addressof(_That)) {
                return;
            }
        }

#if _ITERATOR_DEBUG_LEVEL == 2
        if constexpr (!_结点分配器特征::is_always_equal::value) {
            _STL_VERIFY(_List._取分配器() == _That._List._取分配器(), "allocator incompatible for merge");
        }
#endif // _ITERATOR_DEBUG_LEVEL == 2

        auto _First      = _That._非检查开始();
        const auto _Last = _That._非检查结束();
        while (_First != _Last) {
            const auto _Candidate = _First._Ptr;
            ++_First;
            const auto& _Keyval   = _Traits::_取键(_Candidate->_Myval);
            const size_t _Hashval = _Traitsobj(_Keyval);
            auto _Target          = _查找最后(_Keyval, _Hashval);
            if constexpr (!_Traits::_Multi) {
                if (_Target._Duplicate) {
                    continue;
                }
            }

            _检查最大尺寸();
            if (_检查需重哈希1()) {
                _为1重哈希();
                _Target = _查找最后(_Keyval, _Hashval);
            }

            // nothrow hereafter this iteration
            const auto _Source_bucket = _Hashval & _That._Mask;
            _That._擦除桶(_Candidate, _Source_bucket);
            _Candidate->_Prev->_Next = _Candidate->_Next;
            _Candidate->_Next->_Prev = _Candidate->_Prev;
            --_That._List._Mypair._Myval2._Mysize;
            _就地析构(_Candidate->_Next); // TRANSITION, ABI
            _就地析构(_Candidate->_Prev);
#if _ITERATOR_DEBUG_LEVEL == 2
            _List._Mypair._Myval2._Adopt_unique(_That._List._Mypair._Myval2, _Candidate);
#endif // _ITERATOR_DEBUG_LEVEL == 2
            (void) _在之前插入新节点(_Hashval, _Target._Insert_before, _Candidate);
        }
    }

