// <异常> —— exception 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   本头里是【常量】而不是类 —— 常量换不了类型，只能承载它的值。
//   这类头一旦抄一份，就会和 std 里那份成为两套互不相认的东西。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变体（英文里带 _v 的变量模板形式）暂未提供中文名，属"必须的妥协"，见方案 §六。
#pragma once
#include <exception>

名域 标准 {
    使用 异常 = std::exception;
    使用 坏异常 = std::bad_exception;
    使用 变体访问失败 = std::bad_variant_access;
    使用 异常指针 = std::exception_ptr;
    使用 嵌套异常 = std::nested_exception;
    使用 终止处理 = std::terminate_handler;
    模板 <类型名... 参数> 自动 当前异常(参数&&... 值) { 返回 current_exception(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 造异常指针(参数&&... 值) { 返回 make_exception_ptr(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 重抛异常(参数&&... 值) { 返回 rethrow_exception(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 抛出并嵌套(参数&&... 值) { 返回 throw_with_nested(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 若有嵌套则重抛(参数&&... 值) { 返回 rethrow_if_nested(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 终止(参数&&... 值) { 返回 terminate(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 取终止函数(参数&&... 值) { 返回 get_terminate(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 设置终止函数(参数&&... 值) { 返回 set_terminate(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 有未捕获异常(参数&&... 值) { 返回 uncaught_exception(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 自动 未捕获异常数(参数&&... 值) { 返回 uncaught_exceptions(static_cast<参数&&>(值)...); }
}