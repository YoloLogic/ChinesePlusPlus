// <算法> —— algorithm 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   算法头没有需要保身份的类型（都按迭代器模板推导），故走中文名转发；不含 ranges 版本（那要命名空间别名）。
//   这类头一旦抄一份，就会和 std 里那份成为两套互不相认的东西。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变体（英文里带 _v 的变量模板形式）暂未提供中文名，属"必须的妥协"，见方案 §六。
#pragma once
#include <algorithm>

名域 标准 {
    模板 <类型名 迭代> 空型 排序(迭代 首, 迭代 尾) { std::sort(首, 尾); }
    模板 <类型名 迭代, 类型名 比较> 空型 排序(迭代 首, 迭代 尾, 比较 丙) { std::sort(首, 尾, 丙); }
    模板 <类型名 迭代> 空型 稳定排序(迭代 首, 迭代 尾) { std::stable_sort(首, 尾); }
    模板 <类型名 迭代, 类型名 比较> 空型 稳定排序(迭代 首, 迭代 尾, 比较 丙) { std::stable_sort(首, 尾, 丙); }
    模板 <类型名 迭代> 空型 部分排序(迭代 首, 迭代 中, 迭代 尾) { std::partial_sort(首, 中, 尾); }
    模板 <类型名 迭代, 类型名 比较> 空型 部分排序(迭代 首, 迭代 中, 迭代 尾, 比较 丁) { std::partial_sort(首, 中, 尾, 丁); }
    模板 <类型名 迭代, 类型名 输出迭代> 输出迭代 部分排序复制(迭代 首, 迭代 尾, 输出迭代 出, 输出迭代 出尾) { 返回 std::partial_sort_copy(首, 尾, 出, 出尾); }
    模板 <类型名 迭代> 空型 定位第N小(迭代 首, 迭代 第n, 迭代 尾) { std::nth_element(首, 第n, 尾); }
    模板 <类型名 迭代> 布尔 已排序(迭代 首, 迭代 尾) { 返回 std::is_sorted(首, 尾); }
    模板 <类型名 迭代, 类型名 比较> 布尔 已排序(迭代 首, 迭代 尾, 比较 丙) { 返回 std::is_sorted(首, 尾, 丙); }
    模板 <类型名 迭代> 迭代 已排序终点(迭代 首, 迭代 尾) { 返回 std::is_sorted_until(首, 尾); }
    模板 <类型名 迭代, 类型名 值类型> 迭代 下界(迭代 首, 迭代 尾, const 值类型& 值) { 返回 std::lower_bound(首, 尾, 值); }
    模板 <类型名 迭代, 类型名 值类型> 迭代 上界(迭代 首, 迭代 尾, const 值类型& 值) { 返回 std::upper_bound(首, 尾, 值); }
    模板 <类型名 迭代, 类型名 值类型> 声明类型(自动) 相等区间(迭代 首, 迭代 尾, const 值类型& 值) { 返回 std::equal_range(首, 尾, 值); }
    模板 <类型名 迭代, 类型名 值类型> 布尔 折半查找(迭代 首, 迭代 尾, const 值类型& 值) { 返回 std::binary_search(首, 尾, 值); }
    模板 <类型名 迭代1, 类型名 迭代2, 类型名 输出迭代> 输出迭代 归并(迭代1 首1, 迭代1 尾1, 迭代2 首2, 迭代2 尾2, 输出迭代 出) { 返回 std::merge(首1, 尾1, 首2, 尾2, 出); }
    模板 <类型名 迭代> 空型 原地归并(迭代 首, 迭代 中, 迭代 尾) { std::inplace_merge(首, 中, 尾); }
    模板 <类型名 迭代1, 类型名 迭代2> 布尔 含子集(迭代1 首1, 迭代1 尾1, 迭代2 首2, 迭代2 尾2) { 返回 std::includes(首1, 尾1, 首2, 尾2); }
    模板 <类型名 迭代1, 类型名 迭代2, 类型名 输出迭代> 输出迭代 并集(迭代1 首1, 迭代1 尾1, 迭代2 首2, 迭代2 尾2, 输出迭代 出) { 返回 std::set_union(首1, 尾1, 首2, 尾2, 出); }
    模板 <类型名 迭代1, 类型名 迭代2, 类型名 输出迭代> 输出迭代 交集(迭代1 首1, 迭代1 尾1, 迭代2 首2, 迭代2 尾2, 输出迭代 出) { 返回 std::set_intersection(首1, 尾1, 首2, 尾2, 出); }
    模板 <类型名 迭代1, 类型名 迭代2, 类型名 输出迭代> 输出迭代 差集(迭代1 首1, 迭代1 尾1, 迭代2 首2, 迭代2 尾2, 输出迭代 出) { 返回 std::set_difference(首1, 尾1, 首2, 尾2, 出); }
    模板 <类型名 迭代1, 类型名 迭代2, 类型名 输出迭代> 输出迭代 对称差集(迭代1 首1, 迭代1 尾1, 迭代2 首2, 迭代2 尾2, 输出迭代 出) { 返回 std::set_symmetric_difference(首1, 尾1, 首2, 尾2, 出); }
    模板 <类型名 迭代> 空型 建堆(迭代 首, 迭代 尾) { std::make_heap(首, 尾); }
    模板 <类型名 迭代> 空型 压入堆(迭代 首, 迭代 尾) { std::push_heap(首, 尾); }
    模板 <类型名 迭代> 空型 弹出堆(迭代 首, 迭代 尾) { std::pop_heap(首, 尾); }
    模板 <类型名 迭代> 空型 堆排序(迭代 首, 迭代 尾) { std::sort_heap(首, 尾); }
    模板 <类型名 迭代> 布尔 是堆(迭代 首, 迭代 尾) { 返回 std::is_heap(首, 尾); }
    模板 <类型名 迭代> 迭代 是堆终点(迭代 首, 迭代 尾) { 返回 std::is_heap_until(首, 尾); }
    模板 <类型名 值类型> const 值类型& 最小值(const 值类型& 甲, const 值类型& 乙) { 返回 std::min(甲, 乙); }
    模板 <类型名 值类型> const 值类型& 最大值(const 值类型& 甲, const 值类型& 乙) { 返回 std::max(甲, 乙); }
    模板 <类型名 值类型> 声明类型(自动) 最小最大对(const 值类型& 甲, const 值类型& 乙) { 返回 std::minmax(甲, 乙); }
    模板 <类型名 迭代> 迭代 最小元素(迭代 首, 迭代 尾) { 返回 std::min_element(首, 尾); }
    模板 <类型名 迭代> 迭代 最大元素(迭代 首, 迭代 尾) { 返回 std::max_element(首, 尾); }
    模板 <类型名 迭代> 声明类型(自动) 最小最大元素(迭代 首, 迭代 尾) { 返回 std::minmax_element(首, 尾); }
    模板 <类型名 值类型> const 值类型& 夹取(const 值类型& 值, const 值类型& 低, const 值类型& 高) { 返回 std::clamp(值, 低, 高); }
    模板 <类型名 迭代1, 类型名 迭代2> 布尔 区间相等(迭代1 首1, 迭代1 尾1, 迭代2 首2) { 返回 std::equal(首1, 尾1, 首2); }
    模板 <类型名 迭代1, 类型名 迭代2> 声明类型(自动) 首个不匹配(迭代1 首1, 迭代1 尾1, 迭代2 首2) { 返回 std::mismatch(首1, 尾1, 首2); }
    模板 <类型名 迭代1, 类型名 迭代2> 布尔 字典序比较(迭代1 首1, 迭代1 尾1, 迭代2 首2, 迭代2 尾2) { 返回 std::lexicographical_compare(首1, 尾1, 首2, 尾2); }
    模板 <类型名 迭代1, 类型名 迭代2> 布尔 是排列(迭代1 首1, 迭代1 尾1, 迭代2 首2) { 返回 std::is_permutation(首1, 尾1, 首2); }
    模板 <类型名 迭代> 布尔 下一排列(迭代 首, 迭代 尾) { 返回 std::next_permutation(首, 尾); }
    模板 <类型名 迭代> 布尔 上一排列(迭代 首, 迭代 尾) { 返回 std::prev_permutation(首, 尾); }
    模板 <类型名 迭代, 类型名 值类型> 迭代 查找(迭代 首, 迭代 尾, const 值类型& 值) { 返回 std::find(首, 尾, 值); }
    模板 <类型名 迭代, 类型名 谓词> 迭代 查找若(迭代 首, 迭代 尾, 谓词 丙) { 返回 std::find_if(首, 尾, 丙); }
    模板 <类型名 迭代, 类型名 谓词> 迭代 查找若非(迭代 首, 迭代 尾, 谓词 丙) { 返回 std::find_if_not(首, 尾, 丙); }
    模板 <类型名 迭代> 迭代 查找相邻相等(迭代 首, 迭代 尾) { 返回 std::adjacent_find(首, 尾); }
    模板 <类型名 迭代1, 类型名 迭代2> 迭代1 查找子序列(迭代1 首1, 迭代1 尾1, 迭代2 首2, 迭代2 尾2) { 返回 std::search(首1, 尾1, 首2, 尾2); }
    模板 <类型名 迭代1, 类型名 迭代2> 迭代1 查找末尾(迭代1 首1, 迭代1 尾1, 迭代2 首2, 迭代2 尾2) { 返回 std::find_end(首1, 尾1, 首2, 尾2); }
    模板 <类型名 迭代1, 类型名 迭代2> 迭代1 查找首个属于(迭代1 首1, 迭代1 尾1, 迭代2 首2, 迭代2 尾2) { 返回 std::find_first_of(首1, 尾1, 首2, 尾2); }
    模板 <类型名 迭代, 类型名 值类型> 迭代 查找连续(迭代 首, 迭代 尾, std::size_t 个数, const 值类型& 值) { 返回 std::search_n(首, 尾, 个数, 值); }
    模板 <类型名 迭代, 类型名 值类型> 声明类型(自动) 计数(迭代 首, 迭代 尾, const 值类型& 值) { 返回 std::count(首, 尾, 值); }
    模板 <类型名 迭代, 类型名 谓词> 声明类型(自动) 计数若(迭代 首, 迭代 尾, 谓词 丙) { 返回 std::count_if(首, 尾, 丙); }
    模板 <类型名 迭代, 类型名 输出迭代> 输出迭代 复制区间(迭代 首, 迭代 尾, 输出迭代 出) { 返回 std::copy(首, 尾, 出); }
    模板 <类型名 迭代, 类型名 输出迭代, 类型名 谓词> 输出迭代 复制若(迭代 首, 迭代 尾, 输出迭代 出, 谓词 丁) { 返回 std::copy_if(首, 尾, 出, 丁); }
    模板 <类型名 迭代, 类型名 输出迭代> 输出迭代 移动区间(迭代 首, 迭代 尾, 输出迭代 出) { 返回 std::move(首, 尾, 出); }
    模板 <类型名 迭代, 类型名 值类型> 空型 填充(迭代 首, 迭代 尾, const 值类型& 值) { std::fill(首, 尾, 值); }
    模板 <类型名 迭代, 类型名 大小类型, 类型名 值类型> 迭代 填充个(迭代 首, 大小类型 个数, const 值类型& 值) { 返回 std::fill_n(首, 个数, 值); }
    模板 <类型名 迭代, 类型名 输出迭代, 类型名 一元操作> 输出迭代 变换(迭代 首, 迭代 尾, 输出迭代 出, 一元操作 丁) { 返回 std::transform(首, 尾, 出, 丁); }
    模板 <类型名 迭代, 类型名 生成器> 空型 生成(迭代 首, 迭代 尾, 生成器 丙) { 返回 std::generate(首, 尾, 丙); }
    模板 <类型名 迭代, 类型名 大小类型, 类型名 生成器> 迭代 生成个(迭代 首, 大小类型 个数, 生成器 丙) { 返回 std::generate_n(首, 个数, 丙); }
    模板 <类型名 迭代, 类型名 值类型> 迭代 移除元素(迭代 首, 迭代 尾, const 值类型& 值) { 返回 std::remove(首, 尾, 值); }
    模板 <类型名 迭代, 类型名 谓词> 迭代 移除若(迭代 首, 迭代 尾, 谓词 丙) { 返回 std::remove_if(首, 尾, 丙); }
    模板 <类型名 迭代, 类型名 值类型> 空型 替换(迭代 首, 迭代 尾, const 值类型& 旧值, const 值类型& 新值) { std::replace(首, 尾, 旧值, 新值); }
    模板 <类型名 迭代, 类型名 谓词, 类型名 值类型> 空型 替换若(迭代 首, 迭代 尾, 谓词 丙, const 值类型& 新值) { std::replace_if(首, 尾, 丙, 新值); }
    模板 <类型名 类型1, 类型名 类型2> 空型 交换值(类型1& 甲, 类型2& 乙) { std::swap(甲, 乙); }
    模板 <类型名 迭代1, 类型名 迭代2> 迭代2 交换区间(迭代1 首1, 迭代1 尾1, 迭代2 首2) { 返回 std::swap_ranges(首1, 尾1, 首2); }
    模板 <类型名 迭代> 空型 反转(迭代 首, 迭代 尾) { std::reverse(首, 尾); }
    模板 <类型名 迭代, 类型名 输出迭代> 输出迭代 反转复制(迭代 首, 迭代 尾, 输出迭代 出) { 返回 std::reverse_copy(首, 尾, 出); }
    模板 <类型名 迭代> 迭代 旋转(迭代 首, 迭代 中, 迭代 尾) { 返回 std::rotate(首, 中, 尾); }
    模板 <类型名 迭代, 类型名 输出迭代> 输出迭代 旋转复制(迭代 首, 迭代 中, 迭代 尾, 输出迭代 出) { 返回 std::rotate_copy(首, 中, 尾, 出); }
    模板 <类型名 迭代> 迭代 去重(迭代 首, 迭代 尾) { 返回 std::unique(首, 尾); }
    模板 <类型名 迭代, 类型名 输出迭代> 输出迭代 去重复制(迭代 首, 迭代 尾, 输出迭代 出) { 返回 std::unique_copy(首, 尾, 出); }
    模板 <类型名 随机迭代, 类型名 引擎> 空型 洗牌(随机迭代 首, 随机迭代 尾, 引擎& 丙) { std::shuffle(首, 尾, 丙); }
    模板 <类型名 迭代, 类型名 输出迭代, 类型名 引擎> 输出迭代 抽样(迭代 首, 迭代 尾, 输出迭代 出, std::ptrdiff_t 个数, 引擎& 戊) { 返回 std::sample(首, 尾, 出, 个数, 戊); }
    模板 <类型名 迭代, 类型名 函数> 函数 逐元素(迭代 首, 迭代 尾, 函数 丙) { 返回 std::for_each(首, 尾, 丙); }
    模板 <类型名 迭代, 类型名 谓词> 布尔 全部满足(迭代 首, 迭代 尾, 谓词 丙) { 返回 std::all_of(首, 尾, 丙); }
    模板 <类型名 迭代, 类型名 谓词> 布尔 任一满足(迭代 首, 迭代 尾, 谓词 丙) { 返回 std::any_of(首, 尾, 丙); }
    模板 <类型名 迭代, 类型名 谓词> 布尔 无一满足(迭代 首, 迭代 尾, 谓词 丙) { 返回 std::none_of(首, 尾, 丙); }
    模板 <类型名 迭代, 类型名 谓词> 迭代 分组(迭代 首, 迭代 尾, 谓词 丙) { 返回 std::partition(首, 尾, 丙); }
    模板 <类型名 迭代, 类型名 谓词> 迭代 稳定分组(迭代 首, 迭代 尾, 谓词 丙) { 返回 std::stable_partition(首, 尾, 丙); }
    模板 <类型名 迭代, 类型名 谓词> 迭代 分组点(迭代 首, 迭代 尾, 谓词 丙) { 返回 std::partition_point(首, 尾, 丙); }
    模板 <类型名 迭代, 类型名 谓词> 布尔 已分组(迭代 首, 迭代 尾, 谓词 丙) { 返回 std::is_partitioned(首, 尾, 丙); }
}