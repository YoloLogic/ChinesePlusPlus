// <协程> —— coroutine 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   本头里的东西，类型身份参与语义（换一份就成了两套互不相认的东西）。
//   这类头一旦抄一份，就会和 std 里那份成为两套互不相认的东西。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变体（英文里带 _v 的变量模板形式）暂未提供中文名，属"必须的妥协"，见方案 §六。
#pragma once
#include <coroutine>

名域 标准 {
    模板 <类型名 承诺 = 空型> 使用 协程句柄 = std::coroutine_handle<承诺>;
    模板 <类型名 结果, 类型名... 参数> 使用 协程特征 = std::coroutine_traits<结果, 参数...>;
    使用 始终挂起 = std::suspend_always;
    使用 从不挂起 = std::suspend_never;
    模板 <类型名 承诺> 内联 布尔 已完成(协程句柄<承诺> 柄) noexcept { 返回 柄.done(); }
    模板 <类型名 承诺> 内联 空型 恢复(协程句柄<承诺> 柄) { 柄.resume(); }
    模板 <类型名 承诺> 内联 空型 销毁(协程句柄<承诺> 柄) { 柄.destroy(); }
    模板 <类型名 承诺> 内联 承诺& 取承诺(协程句柄<承诺> 柄) { 返回 柄.promise(); }
    模板 <类型名 承诺> 内联 空型* 地址(协程句柄<承诺> 柄) noexcept { 返回 柄.address(); }
    内联 协程句柄<> 空协程() noexcept { 返回 std::noop_coroutine(); }
}