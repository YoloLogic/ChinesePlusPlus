// <打印> —— print 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   铁律③ 不适用（全是函数），但同样要中文门面；C++23 头，整块进条件壳（转发到 std::print）。
//   这类头一旦抄一份，就会和 std 里那份成为两套互不相认的东西。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变体（英文里带 _v 的变量模板形式）暂未提供中文名，属"必须的妥协"，见方案 §六。
#pragma once
#include <print>

名域 标准 {
    #如果 _HAS_CXX23
    模板 <类型名... 参数> 空型 打印(std::format_string<参数...> 格式, 参数&&... 甲) { std::print(格式, static_cast<参数&&>(甲)...); }
    模板 <类型名... 参数> 空型 打印行(std::format_string<参数...> 格式, 参数&&... 甲) { std::println(格式, static_cast<参数&&>(甲)...); }
    模板 <类型名... 参数> 空型 打印到文件(std::FILE* 甲, std::format_string<参数...> 格式, 参数&&... 乙) { std::print(甲, 格式, static_cast<参数&&>(乙)...); }
    #结束如果
}