// <调用栈> —— stacktrace 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   铁律③：stacktrace 类型被用户按类型接收/重载。C++23 头，整块进条件壳。
//   这类头一旦抄一份，就会和 std 里那份成为两套互不相认的东西。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变体（英文里带 _v 的变量模板形式）暂未提供中文名，属"必须的妥协"，见方案 §六。
#pragma once
#include <stacktrace>

名域 标准 {
    #如果 _HAS_CXX23
    使用 调用栈 = std::stacktrace;
    模板 <类型名 分配器> 使用 基本调用栈 = std::basic_stacktrace<分配器>;
    使用 栈帧 = std::stacktrace_entry;
    #结束如果
}