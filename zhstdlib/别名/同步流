// <同步流> —— syncstream 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   铁律③：basic_syncbuf/basic_osyncstream 身份参与语义。
//   这类头一旦抄一份，就会和 std 里那份成为两套互不相认的东西。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变体（英文里带 _v 的变量模板形式）暂未提供中文名，属"必须的妥协"，见方案 §六。
#pragma once
#include <syncstream>

名域 标准 {
    #ifndef _ZH_流类型名
    #define _ZH_流类型名
    模板 <类型名 元素, 类型名 特征 = std::char_traits<元素>> 使用 基础输入流 = std::basic_istream<元素, 特征>;
    模板 <类型名 元素, 类型名 特征 = std::char_traits<元素>> 使用 基础输出流 = std::basic_ostream<元素, 特征>;
    模板 <类型名 元素, 类型名 特征 = std::char_traits<元素>> 使用 基础流缓冲 = std::basic_streambuf<元素, 特征>;
    使用 输入流 = std::istream;
    使用 输出流 = std::ostream;
    使用 流缓冲 = std::streambuf;
    模板 <类型名 元素, 类型名 特征> 基础输出流<元素, 特征>& 行尾流冲刷(基础输出流<元素, 特征>& 甲) { 返回 std::endl(甲); }
    模板 <类型名 元素, 类型名 特征> 基础输出流<元素, 特征>& 加终止符(基础输出流<元素, 特征>& 甲) { 返回 std::ends(甲); }
    模板 <类型名 元素, 类型名 特征> 基础输出流<元素, 特征>& 流冲刷(基础输出流<元素, 特征>& 甲) { 返回 std::flush(甲); }
    #endif // _ZH_流类型名
    #ifndef _ZH_同步流名字
    #define _ZH_同步流名字
    模板 <类型名 元素, 类型名 特征 = std::char_traits<元素>, 类型名 分配器 = std::allocator<元素>> 使用 基础同步缓冲 = std::basic_syncbuf<元素, 特征, 分配器>;
    模板 <类型名 元素, 类型名 特征 = std::char_traits<元素>, 类型名 分配器 = std::allocator<元素>> 使用 基础输出同步流 = std::basic_osyncstream<元素, 特征, 分配器>;
    使用 同步缓冲 = std::syncbuf;
    使用 输出同步流 = std::osyncstream;
    使用 宽同步缓冲 = std::wsyncbuf;
    使用 宽输出同步流 = std::wosyncstream;
    #endif // _ZH_同步流名字
}