// <元组> —— tuple 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   本头里的东西，类型身份参与语义（换一份就成了两套互不相认的东西）。
//   这类头一旦抄一份，就会和 std 里那份成为两套互不相认的东西。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变体（英文里带 _v 的变量模板形式）暂未提供中文名，属"必须的妥协"，见方案 §六。
#pragma once
#include <tuple>

名域 标准 {
    模板 <类型名... 元素> 使用 元组 = std::tuple<元素...>;
    模板 <类型名... 元素> 内联 自动 造元组(元素&&... 值) { 返回 std::make_tuple(static_cast<元素&&>(值)...); }
    模板 <size_t 下标, 类型名... 元素> 内联 自动& 取(std::tuple<元素...>& 组) noexcept { 返回 std::get<下标>(组); }
    模板 <size_t 下标, 类型名... 元素> 内联 常量 自动& 取(常量 std::tuple<元素...>& 组) noexcept { 返回 std::get<下标>(组); }
    模板 <类型名 元组类型> 内联 常量表达式 size_t 元组大小 = std::tuple_size<元组类型>::value;
    模板 <size_t 下标, 类型名 元组类型> 使用 元组元素类型 = std::tuple_element_t<下标, 元组类型>;
    模板 <类型名... 元素> 内联 自动 前接(元素&&... 值) { 返回 std::tuple_cat(static_cast<元素&&>(值)...); }
}