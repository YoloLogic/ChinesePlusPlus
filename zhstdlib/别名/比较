// <比较> —— compare 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   铁律④：比较类别身份参与语义 —— 与 std::strong_ordering::equal 直接比较，抄/派生会让两侧类型不同。
//   这类头一旦抄一份，就会和 std 里那份成为两套互不相认的东西。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变体（英文里带 _v 的变量模板形式）暂未提供中文名，属"必须的妥协"，见方案 §六。
#pragma once
#include <compare>

名域 标准 {
    使用 强序 = std::strong_ordering;
    使用 弱序 = std::weak_ordering;
    使用 偏序 = std::partial_ordering;
    模板 <类型名... 参数> 声明类型(自动) 是否相等(参数&&... 值) { 返回 std::is_eq(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 是否不等(参数&&... 值) { 返回 std::is_neq(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 是否小于(参数&&... 值) { 返回 std::is_lt(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 是否小于等于(参数&&... 值) { 返回 std::is_lteq(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 是否大于(参数&&... 值) { 返回 std::is_gt(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) 是否大于等于(参数&&... 值) { 返回 std::is_gteq(static_cast<参数&&>(值)...); }
}