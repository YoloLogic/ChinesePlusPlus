// <数组> —— array 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   std::array 是【聚合】，且结构化绑定走 std::tuple_size / tuple_element 的【特化】；抄一份再派生会同时丢掉聚合性（花括号初始化）和结构化绑定。
//   这类头一旦抄一份，就会和 std 里那份成为两套互不相认的东西。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变体（英文里带 _v 的变量模板形式）暂未提供中文名，属"必须的妥协"，见方案 §六。
#pragma once
#include <array>

名域 标准 {
    模板 <类型名 元素, size_t 尺寸> 使用 数组 = std::array<元素, 尺寸>;
    模板 <size_t 下标, 类型名 元素, size_t 尺寸> 内联 自动& 取(std::array<元素, 尺寸>& 组) noexcept { 返回 std::get<下标>(组); }
    模板 <size_t 下标, 类型名 元素, size_t 尺寸> 内联 常量 自动& 取(常量 std::array<元素, 尺寸>& 组) noexcept { 返回 std::get<下标>(组); }
    模板 <类型名 元素, size_t 尺寸> 内联 常量表达式 自动 转数组(元素 (&甲)[尺寸]) { 返回 std::to_array(甲); }
    模板 <类型名 元素, size_t 尺寸> 内联 常量表达式 自动 转数组(元素 (&&甲)[尺寸]) { 返回 std::to_array(static_cast<元素 (&&)[尺寸]>(甲)); }
}