// <工具> —— utility 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   本头里的东西，类型身份参与语义（换一份就成了两套互不相认的东西）。
//   这类头一旦抄一份，就会和 std 里那份成为两套互不相认的东西。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变体（英文里带 _v 的变量模板形式）暂未提供中文名，属"必须的妥协"，见方案 §六。
#pragma once
#include <utility>

名域 标准 {
    模板 <类型名 甲, 类型名 乙> 使用 对 = std::pair<甲, 乙>;
    模板 <类型名 甲, 类型名 乙> 内联 自动& 第一(std::pair<甲, 乙>& 对) noexcept { 返回 对.first; }
    模板 <类型名 甲, 类型名 乙> 内联 常量 自动& 第一(常量 std::pair<甲, 乙>& 对) noexcept { 返回 对.first; }
    模板 <类型名 甲, 类型名 乙> 内联 自动& 第二(std::pair<甲, 乙>& 对) noexcept { 返回 对.second; }
    模板 <类型名 甲, 类型名 乙> 内联 常量 自动& 第二(常量 std::pair<甲, 乙>& 对) noexcept { 返回 对.second; }
    模板 <类型名 甲, 类型名 乙> 内联 自动 造对(甲&& 一, 乙&& 二) { 返回 std::make_pair(static_cast<甲&&>(一), static_cast<乙&&>(二)); }
    模板 <类型名 某类型> 内联 常量表达式 std::remove_reference_t<某类型>&& 移动(某类型&& 值) noexcept { 返回 static_cast<std::remove_reference_t<某类型>&&>(值); }
    模板 <类型名 某类型> 内联 常量表达式 某类型&& 转发(std::remove_reference_t<某类型>&& 值) noexcept { 返回 static_cast<某类型&&>(值); }
    模板 <类型名 某类型> 内联 空型 交换(某类型& 甲, 某类型& 乙) { std::swap(甲, 乙); }
    模板 <类型名 某类型, 类型名 别的> 内联 某类型 交换并返回(某类型& 对象, 别的&& 新值) { 返回 std::exchange(对象, static_cast<别的&&>(新值)); }
    模板 <类型名 某类型> 内联 常量表达式 常量 某类型& 视为常量(某类型& 值) noexcept { 返回 值; }
    模板 <类型名 某类型, 某类型... 值> 使用 整数序列 = std::integer_sequence<某类型, 值...>;
}