// <新建> —— new 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   本头里的东西，类型身份参与语义（换一份就成了两套互不相认的东西）。
//   这类头一旦抄一份，就会和 std 里那份成为两套互不相认的东西。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变体（英文里带 _v 的变量模板形式）暂未提供中文名，属"必须的妥协"，见方案 §六。
#pragma once
#include <new>

名域 标准 {
    使用 分配失败 = std::bad_alloc;
    使用 数组长度分配失败 = std::bad_array_new_length;
    使用 分配失败时类型 = std::nothrow_t;
    内联 常量 分配失败时类型 分配失败时不抛出 = std::nothrow;
    使用 分配失败处理函数 = std::new_handler;
    内联 分配失败处理函数 设分配失败处理函数(分配失败处理函数 处理) noexcept { 返回 std::set_new_handler(处理); }
    内联 分配失败处理函数 取分配失败处理函数() noexcept { 返回 std::get_new_handler(); }
    模板 <类型名 某类型> 内联 常量表达式 某类型* 洁净(某类型* 指针) noexcept { 返回 std::launder(指针); }
}