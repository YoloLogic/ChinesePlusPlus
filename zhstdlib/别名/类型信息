// <类型信息> —— typeinfo 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   本头里的东西，类型身份参与语义（换一份就成了两套互不相认的东西）。
//   这类头一旦抄一份，就会和 std 里那份成为两套互不相认的东西。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变体（英文里带 _v 的变量模板形式）暂未提供中文名，属"必须的妥协"，见方案 §六。
#pragma once
#include <typeinfo>

名域 标准 {
    使用 类型信息 = std::type_info;
    使用 类型转换失败 = std::bad_cast;
    使用 类型标识失败 = std::bad_typeid;
    内联 常量 字符* 名称(常量 类型信息& 信息) noexcept { 返回 信息.name(); }
    内联 size_t 哈希值(常量 类型信息& 信息) noexcept { 返回 信息.hash_code(); }
    内联 布尔 先于(常量 类型信息& 甲, 常量 类型信息& 乙) noexcept { 返回 甲.before(乙); }
    内联 布尔 相等(常量 类型信息& 甲, 常量 类型信息& 乙) noexcept { 返回 甲 == 乙; }
    内联 布尔 不等(常量 类型信息& 甲, 常量 类型信息& 乙) noexcept { 返回 甲 != 乙; }
}