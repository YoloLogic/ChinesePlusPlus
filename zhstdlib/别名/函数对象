// <函数对象> —— functional 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   铁律③：function/reference_wrapper/各算术函数对象的身份参与语义（用户继承 + 重载解析按类型）。
//   这类头一旦抄一份，就会和 std 里那份成为两套互不相认的东西。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变体（英文里带 _v 的变量模板形式）暂未提供中文名，属"必须的妥协"，见方案 §六。
#pragma once
#include <functional>

名域 标准 {
    模板 <类型名 值类型 = 空型> 使用 加 = std::plus<值类型>;
    模板 <类型名 值类型 = 空型> 使用 减 = std::minus<值类型>;
    模板 <类型名 值类型 = 空型> 使用 乘 = std::multiplies<值类型>;
    模板 <类型名 值类型 = 空型> 使用 除 = std::divides<值类型>;
    模板 <类型名 值类型 = 空型> 使用 取余 = std::modulus<值类型>;
    模板 <类型名 值类型 = 空型> 使用 取负 = std::negate<值类型>;
    模板 <类型名 值类型 = 空型> 使用 等于 = std::equal_to<值类型>;
    模板 <类型名 值类型 = 空型> 使用 不相等 = std::not_equal_to<值类型>;
    模板 <类型名 值类型 = 空型> 使用 大于 = std::greater<值类型>;
    模板 <类型名 值类型 = 空型> 使用 小于 = std::less<值类型>;
    模板 <类型名 值类型 = 空型> 使用 大于等于 = std::greater_equal<值类型>;
    模板 <类型名 值类型 = 空型> 使用 小于等于 = std::less_equal<值类型>;
    模板 <类型名 值类型 = 空型> 使用 逻辑与 = std::logical_and<值类型>;
    模板 <类型名 值类型 = 空型> 使用 逻辑或 = std::logical_or<值类型>;
    模板 <类型名 值类型 = 空型> 使用 逻辑非 = std::logical_not<值类型>;
    模板 <类型名 值类型 = 空型> 使用 按位与 = std::bit_and<值类型>;
    模板 <类型名 值类型 = 空型> 使用 按位或 = std::bit_or<值类型>;
    模板 <类型名 值类型 = 空型> 使用 按位异或 = std::bit_xor<值类型>;
    模板 <类型名 值类型 = 空型> 使用 按位非 = std::bit_not<值类型>;
    模板 <类型名 签名> 使用 函数包装 = std::function<签名>;
    使用 函数调用异常 = std::bad_function_call;
    模板 <类型名 值类型> 使用 引用包装 = std::reference_wrapper<值类型>;
    模板 <类型名 值类型> 声明类型(自动) 引用化(值类型& 甲) 不抛出 { 返回 std::ref(甲); }
    模板 <类型名 值类型> 声明类型(自动) 常量引用化(const 值类型& 甲) 不抛出 { 返回 std::cref(甲); }
    模板 <类型名 函数, 类型名... 参数> 声明类型(自动) 绑定(函数&& 甲, 参数&&... 乙) { 返回 std::bind(static_cast<函数&&>(甲), static_cast<参数&&>(乙)...); }
    模板 <类型名 值类型> 使用 是绑定表达式 = std::is_bind_expression<值类型>;
    模板 <类型名 值类型> 使用 是占位符 = std::is_placeholder<值类型>;
    模板 <类型名 成员函数> 声明类型(自动) 成员函数包装(成员函数 甲) 不抛出 { 返回 std::mem_fn(甲); }
    模板 <类型名 函数> 声明类型(自动) 否定包装(函数&& 甲) { 返回 std::not_fn(static_cast<函数&&>(甲)); }
    模板 <类型名 函数, 类型名... 参数> 声明类型(自动) 调用(函数&& 甲, 参数&&... 乙) { 返回 std::invoke(static_cast<函数&&>(甲), static_cast<参数&&>(乙)...); }
    使用 恒等 = std::identity;
    模板 <类型名 值类型> 使用 散列器 = std::hash<值类型>;
    模板 <类型名 元素, 类型名 谓词> 使用 默认查找器 = std::default_searcher<元素, 谓词>;
    模板 <类型名 元素, 类型名 散列, 类型名 相等> 使用 博耶摩尔查找器 = std::boyer_moore_searcher<元素, 散列, 相等>;
    模板 <类型名 元素, 类型名 散列, 类型名 相等> 使用 博耶摩尔霍斯普尔查找器 = std::boyer_moore_horspool_searcher<元素, 散列, 相等>;
}