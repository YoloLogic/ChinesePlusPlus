// <预期> —— expected 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   铁律③：expected/unexpected 身份参与语义（用户按类型重载 + 模板实参推导）。C++23 头，故整块进条件壳。
//   这类头一旦抄一份，就会和 std 里那份成为两套互不相认的东西。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变体（英文里带 _v 的变量模板形式）暂未提供中文名，属"必须的妥协"，见方案 §六。
#pragma once
#include <expected>

名域 标准 {
    #如果 _HAS_CXX23
    模板 <类型名 值类型, 类型名 错误类型> 使用 预期 = std::expected<值类型, 错误类型>;
    模板 <类型名 错误类型> 使用 非预期值 = std::unexpected<错误类型>;
    使用 非预期标记 = std::unexpect_t;
    内联 常量 std::unexpect_t 非预期 = std::unexpect;
    模板 <类型名 错误类型> 使用 预期访问异常 = std::bad_expected_access<错误类型>;
    #结束如果
}