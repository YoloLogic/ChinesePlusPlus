// <时间> —— chrono 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   铁律③：时长/时间点/日历类的身份参与语义（用户按类型重载、模板实参推导、时钟概念约束）。
//   这类头一旦抄一份，就会和 std 里那份成为两套互不相认的东西。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变体（英文里带 _v 的变量模板形式）暂未提供中文名，属"必须的妥协"，见方案 §六。
#pragma once
#include <chrono>

名域 标准 {
    模板 <类型名 表示, 类型名 周期 = std::ratio<1>> 使用 时长 = std::chrono::duration<表示, 周期>;
    模板 <类型名 时钟, 类型名 时长类型 = 类型名 时钟::duration> 使用 时间点 = std::chrono::time_point<时钟, 时长类型>;
    模板 <类型名 值类型> 使用 视为浮点 = std::chrono::treat_as_floating_point<值类型>;
    模板 <类型名 表示> 使用 时长取值 = std::chrono::duration_values<表示>;
    模板 <类型名 甲, 类型名 乙> 使用 时钟时间转换 = std::chrono::clock_time_conversion<甲, 乙>;
    模板 <类型名 值类型> 使用 是时钟 = std::chrono::is_clock<值类型>;
    使用 系统时钟 = std::chrono::system_clock;
    使用 稳定时钟 = std::chrono::steady_clock;
    使用 高精度时钟 = std::chrono::high_resolution_clock;
    使用 世界协调时钟 = std::chrono::utc_clock;
    使用 国际原子时钟 = std::chrono::tai_clock;
    使用 全球定位时钟 = std::chrono::gps_clock;
    使用 文件时钟 = std::chrono::file_clock;
    使用 本地时间类型 = std::chrono::local_t;
    模板 <类型名 目标时长, 类型名 表示, 类型名 周期> 声明类型(自动) 时长转换(const std::chrono::duration<表示, 周期>& 甲) { 返回 std::chrono::duration_cast<目标时长>(甲); }
    模板 <类型名 目标时长, 类型名 时钟, 类型名 时长类型> 声明类型(自动) 时间点转换(const std::chrono::time_point<时钟, 时长类型>& 甲) { 返回 std::chrono::time_point_cast<目标时长>(甲); }
    模板 <类型名 目标时钟, 类型名 源时钟, 类型名 时长类型> 声明类型(自动) 时钟转换(const std::chrono::time_point<源时钟, 时长类型>& 甲) { 返回 std::chrono::clock_cast<目标时钟>(甲); }
    模板 <类型名 目标时长, 类型名 表示, 类型名 周期> 声明类型(自动) 时长下取整(const std::chrono::duration<表示, 周期>& 甲) { 返回 std::chrono::floor<目标时长>(甲); }
    模板 <类型名 目标时长, 类型名 表示, 类型名 周期> 声明类型(自动) 时长上取整(const std::chrono::duration<表示, 周期>& 甲) { 返回 std::chrono::ceil<目标时长>(甲); }
    模板 <类型名 目标时长, 类型名 表示, 类型名 周期> 声明类型(自动) 时长四舍五入(const std::chrono::duration<表示, 周期>& 甲) { 返回 std::chrono::round<目标时长>(甲); }
    模板 <类型名 时长类型> 声明类型(自动) 时长绝对值(const 时长类型& 甲) { 返回 std::chrono::abs(甲); }
    使用 日 = std::chrono::day;
    使用 月 = std::chrono::month;
    使用 年 = std::chrono::year;
    使用 星期 = std::chrono::weekday;
    使用 最后标记 = std::chrono::last_spec;
    内联 常量 std::chrono::last_spec 最后 = std::chrono::last;
    使用 带序星期 = std::chrono::weekday_indexed;
    使用 末星期 = std::chrono::weekday_last;
    使用 月日 = std::chrono::month_day;
    使用 月末日 = std::chrono::month_day_last;
    使用 月星期 = std::chrono::month_weekday;
    使用 月末星期 = std::chrono::month_weekday_last;
    使用 年月 = std::chrono::year_month;
    使用 年月日 = std::chrono::year_month_day;
    使用 年月末日 = std::chrono::year_month_day_last;
    使用 年月星期 = std::chrono::year_month_weekday;
    使用 年月末星期 = std::chrono::year_month_weekday_last;
    使用 时分秒 = std::chrono::hh_mm_ss<std::chrono::seconds>;
    使用 时区 = std::chrono::time_zone;
    使用 时区链接 = std::chrono::time_zone_link;
    使用 带时区时间 = std::chrono::zoned_time<std::chrono::seconds>;
    使用 时区库 = std::chrono::tzdb;
    使用 时区库表 = std::chrono::tzdb_list;
    使用 闰秒 = std::chrono::leap_second;
    使用 闰秒信息 = std::chrono::leap_second_info;
    使用 系统时间信息 = std::chrono::sys_info;
    使用 本地时间信息 = std::chrono::local_info;
    使用 不存在本地时间 = std::chrono::nonexistent_local_time;
    使用 有歧义本地时间 = std::chrono::ambiguous_local_time;
    使用 择时 = std::chrono::choose;
    内联 常量 std::chrono::choose 最早 = std::chrono::choose::earliest;
    内联 常量 std::chrono::choose 最晚 = std::chrono::choose::latest;
    声明类型(自动) 当前时区() { 返回 std::chrono::current_zone(); }
    声明类型(自动) 查找时区(const char* 甲) { 返回 std::chrono::locate_zone(甲); }
    声明类型(自动) 取时区库() { 返回 std::chrono::get_tzdb(); }
    声明类型(自动) 取时区库表() { 返回 std::chrono::get_tzdb_list(); }
    模板 <类型名 时长类型> 声明类型(自动) 取闰秒信息(const std::chrono::utc_time<时长类型>& 甲) { 返回 std::chrono::get_leap_second_info(甲); }
    模板 <类型名 时长类型> 声明类型(自动) 造带时区时间(const std::chrono::time_zone* 甲, const std::chrono::sys_time<时长类型>& 乙) { 返回 std::chrono::zoned_time<时长类型>(甲, 乙); }
}