// <文件系统> —— filesystem 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   铁律③：路径/目录迭代器/文件时间点参与语义（按类型重载、与 chrono 互操作）。
//   这类头一旦抄一份，就会和 std 里那份成为两套互不相认的东西。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变体（英文里带 _v 的变量模板形式）暂未提供中文名，属"必须的妥协"，见方案 §六。
#pragma once
#include <filesystem>

名域 标准 {
    使用 路径 = std::filesystem::path;
    使用 文件系统异常 = std::filesystem::filesystem_error;
    使用 目录项 = std::filesystem::directory_entry;
    使用 目录迭代器 = std::filesystem::directory_iterator;
    使用 递归目录迭代器 = std::filesystem::recursive_directory_iterator;
    使用 文件状态 = std::filesystem::file_status;
    使用 空间信息 = std::filesystem::space_info;
    使用 文件类型 = std::filesystem::file_type;
    使用 权限集 = std::filesystem::perms;
    使用 复制选项 = std::filesystem::copy_options;
    使用 目录选项 = std::filesystem::directory_options;
    使用 权限选项 = std::filesystem::perm_options;
    使用 文件时间点 = std::filesystem::file_time_type;
    布尔 存在(const std::filesystem::path& 甲) { 返回 std::filesystem::exists(甲); }
    布尔 存在(const std::filesystem::file_status& 甲) 不抛出 { 返回 std::filesystem::exists(甲); }
    布尔 是目录(const std::filesystem::path& 甲) { 返回 std::filesystem::is_directory(甲); }
    布尔 是普通文件(const std::filesystem::path& 甲) { 返回 std::filesystem::is_regular_file(甲); }
    布尔 是符号链接(const std::filesystem::path& 甲) { 返回 std::filesystem::is_symlink(甲); }
    布尔 是空文件(const std::filesystem::path& 甲) { 返回 std::filesystem::is_empty(甲); }
    声明类型(自动) 文件大小(const std::filesystem::path& 甲) { 返回 std::filesystem::file_size(甲); }
    布尔 移除(const std::filesystem::path& 甲) { 返回 std::filesystem::remove(甲); }
    声明类型(自动) 移除全部(const std::filesystem::path& 甲) { 返回 std::filesystem::remove_all(甲); }
    布尔 创建目录(const std::filesystem::path& 甲) { 返回 std::filesystem::create_directory(甲); }
    布尔 创建目录树(const std::filesystem::path& 甲) { 返回 std::filesystem::create_directories(甲); }
    空型 复制(const std::filesystem::path& 甲, const std::filesystem::path& 乙, std::filesystem::copy_options 丙 = std::filesystem::copy_options::none) { std::filesystem::copy(甲, 乙, 丙); }
    布尔 复制文件(const std::filesystem::path& 甲, const std::filesystem::path& 乙, std::filesystem::copy_options 丙 = std::filesystem::copy_options::none) { 返回 std::filesystem::copy_file(甲, 乙, 丙); }
    空型 重命名(const std::filesystem::path& 甲, const std::filesystem::path& 乙) { std::filesystem::rename(甲, 乙); }
    声明类型(自动) 绝对路径(const std::filesystem::path& 甲) { 返回 std::filesystem::absolute(甲); }
    声明类型(自动) 规范路径(const std::filesystem::path& 甲) { 返回 std::filesystem::canonical(甲); }
    声明类型(自动) 弱规范路径(const std::filesystem::path& 甲) { 返回 std::filesystem::weakly_canonical(甲); }
    声明类型(自动) 相对路径(const std::filesystem::path& 甲) { 返回 std::filesystem::relative(甲); }
    声明类型(自动) 当前路径() { 返回 std::filesystem::current_path(); }
    空型 当前路径(const std::filesystem::path& 甲) { std::filesystem::current_path(甲); }
    声明类型(自动) 临时目录路径() { 返回 std::filesystem::temp_directory_path(); }
    布尔 等价路径(const std::filesystem::path& 甲, const std::filesystem::path& 乙) { 返回 std::filesystem::equivalent(甲, 乙); }
    声明类型(自动) 取文件状态(const std::filesystem::path& 甲) { 返回 std::filesystem::status(甲); }
    声明类型(自动) 取符号链接状态(const std::filesystem::path& 甲) { 返回 std::filesystem::symlink_status(甲); }
    空型 置权限(const std::filesystem::path& 甲, std::filesystem::perms 乙, std::filesystem::perm_options 丙 = std::filesystem::perm_options::replace) { std::filesystem::permissions(甲, 乙, 丙); }
    声明类型(自动) 最后写入时间(const std::filesystem::path& 甲) { 返回 std::filesystem::last_write_time(甲); }
    空型 最后写入时间(const std::filesystem::path& 甲, 标准::文件时间点 乙) { std::filesystem::last_write_time(甲, 乙); }
    声明类型(自动) 空间(const std::filesystem::path& 甲) { 返回 std::filesystem::space(甲); }
    内联 常量 std::filesystem::copy_options 覆盖已存在 = std::filesystem::copy_options::overwrite_existing;
    内联 常量 std::filesystem::copy_options 递归复制 = std::filesystem::copy_options::recursive;
    内联 常量 std::filesystem::directory_options 跳过权限拒绝 = std::filesystem::directory_options::skip_permission_denied;
}