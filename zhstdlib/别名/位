// <位> —— bit 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   本头里的东西，类型身份参与语义（换一份就成了两套互不相认的东西）。
//   这类头一旦抄一份，就会和 std 里那份成为两套互不相认的东西。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变体（英文里带 _v 的变量模板形式）暂未提供中文名，属"必须的妥协"，见方案 §六。
#pragma once
#include <bit>

名域 标准 {
    使用 字节序 = std::endian;
    内联 常量表达式 字节序 小端 = std::endian::little;
    内联 常量表达式 字节序 大端 = std::endian::big;
    内联 常量表达式 字节序 本机 = std::endian::native;
    模板 <类型名 到, 类型名 从> 内联 常量表达式 到 位转换(常量 从& 值) noexcept { 返回 std::bit_cast<到>(值); }
    模板 <类型名 某类型> 内联 常量表达式 布尔 只有一位(某类型 值) noexcept { 返回 std::has_single_bit(值); }
    模板 <类型名 某类型> 内联 常量表达式 某类型 下取整幂(某类型 值) noexcept { 返回 std::bit_floor(值); }
    模板 <类型名 某类型> 内联 常量表达式 某类型 上取整幂(某类型 值) noexcept { 返回 std::bit_ceil(值); }
    模板 <类型名 某类型> 内联 常量表达式 整数 位宽(某类型 值) noexcept { 返回 (整数)std::bit_width(值); }
    模板 <类型名 某类型> 内联 常量表达式 某类型 循环左移(某类型 值, 整数 位) noexcept { 返回 std::rotl(值, 位); }
    模板 <类型名 某类型> 内联 常量表达式 某类型 循环右移(某类型 值, 整数 位) noexcept { 返回 std::rotr(值, 位); }
    模板 <类型名 某类型> 内联 常量表达式 整数 左零位数(某类型 值) noexcept { 返回 (整数)std::countl_zero(值); }
    模板 <类型名 某类型> 内联 常量表达式 整数 左一位数(某类型 值) noexcept { 返回 (整数)std::countl_one(值); }
    模板 <类型名 某类型> 内联 常量表达式 整数 右零位数(某类型 值) noexcept { 返回 (整数)std::countr_zero(值); }
    模板 <类型名 某类型> 内联 常量表达式 整数 右一位数(某类型 值) noexcept { 返回 (整数)std::countr_one(值); }
    模板 <类型名 某类型> 内联 常量表达式 整数 一位个数(某类型 值) noexcept { 返回 (整数)std::popcount(值); }
}