// [ZH-DERIVE-LAYER] 汉语派生层（英文兼容层）从这一行开始 —— 本行【以上】属抄来那层，有英文名就是欠账
// ============================================================================
//  第二层：在【中文的基础上】派生，把英文原名补回来
//  · 第一层 标准::细节::任意实现 是抄自微软的中文实现，成员名全中文
//  · 本层加回英文原名，所以两种名字在【同一个对象】上都能用
//  · 与微软的原类型并存：它是【另一个类型】，不碰 std 里的定义
// ============================================================================
名域 标准 {

类型 任意 : 公开 细节::任意实现 {
公开:
    使用 基类 = 细节::任意实现;
    使用 基类::基类;

    // 嵌套类型名也要补回英文（数据成员不行 —— 那会改布局）


    // 英文原名，一模板转发回中文名（不需要写签名，重载也自动跟过去）
    模板 <类型名... 参数> 声明类型(自动) reset(参数&&... 值) { 返回 基类::重置(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) reset(参数&&... 值) 常量 { 返回 基类::重置(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) has_value(参数&&... 值) { 返回 基类::有值(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) has_value(参数&&... 值) 常量 { 返回 基类::有值(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) type(参数&&... 值) { 返回 基类::所属类型(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) type(参数&&... 值) 常量 { 返回 基类::所属类型(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) emplace(参数&&... 值) { 返回 基类::就地构造(static_cast<参数&&>(值)...); }
    模板 <类型名... 参数> 声明类型(自动) emplace(参数&&... 值) 常量 { 返回 基类::就地构造(static_cast<参数&&>(值)...); }

    // 表里给的额外成员（deriveExtra）—— 【中文】转发，用来给"继承自借用基类"的
    // API 补中文名（那些名字不在本文件里，members 表改不到，见方案 §3.16）
    // 让【抄来那层】的自由函数返回值能直接用：
    // make_any 返回 细节::任意实现，而对外类型是派生出来的 标准::任意。
    // 派生类没有"从基类回来"的路，所以手写一个接管构造。
    任意(细节::任意实现&& 内) noexcept : 基类(static_cast<细节::任意实现&&>(内)) {}
};
}

名域 标准 {

// 坏任意转换异常（std::bad_any_cast）—— 只能是 std 的那个（铁律 4）
使用 坏任意转换 = std::bad_any_cast;

// 自由函数：抄来后落在 细节::，这里用 using 声明引进 标准::
// （比重写转发保真：重载全带上、返回引用也不丢）
