_EXPORT_STD template <class _Kty, class _Ty, class _Pr = less<_Kty>, class _Alloc = allocator<pair<const _Kty, _Ty>>>
class 多重映射实现 : public _Tree<_映射特征<_Kty, _Ty, _Pr, _Alloc, true>> {
    // ordered red-black tree of {key, mapped} values, non-unique keys
public:
    static_assert(!_ENFORCE_MATCHING_ALLOCATORS || is_same_v<pair<const _Kty, _Ty>, typename _Alloc::value_type>,
        _MISMATCHED_ALLOCATOR_MESSAGE("多重映射实现<Key, Value, Compare, Allocator>", "pair<const Key, Value>"));
    static_assert(is_object_v<_Kty>, "The C++ Standard forbids containers of non-object types "
                                     "because of [container.requirements].");

    using _Mybase                = _Tree<_映射特征<_Kty, _Ty, _Pr, _Alloc, true>>;
    using key_type               = _Kty;
    using mapped_type            = _Ty;
    using key_compare            = _Pr;
    using 值比较器          = typename _Mybase::值比较器;
    using value_type             = pair<const _Kty, _Ty>;
    using allocator_type         = typename _Mybase::allocator_type;
    using size_type              = typename _Mybase::size_type;
    using difference_type        = typename _Mybase::difference_type;
    using pointer                = typename _Mybase::pointer;
    using const_pointer          = typename _Mybase::const_pointer;
    using reference              = value_type&;
    using const_reference        = const value_type&;
    using iterator               = typename _Mybase::iterator;
    using const_iterator         = typename _Mybase::const_iterator;
    using reverse_iterator       = typename _Mybase::reverse_iterator;
    using const_reverse_iterator = typename _Mybase::const_reverse_iterator;

    using _Alnode        = typename _Mybase::_Alnode;
    using _Alnode_traits = typename _Mybase::_Alnode_traits;

    多重映射实现() : _Mybase(key_compare()) {}

    explicit 多重映射实现(const allocator_type& _Al) : _Mybase(key_compare(), _Al) {}

    多重映射实现(const 多重映射实现& _Right)
        : _Mybase(_Right, _Alnode_traits::select_on_container_copy_construction(_Right._Getal())) {}

    多重映射实现(const 多重映射实现& _Right, const allocator_type& _Al) : _Mybase(_Right, _Al) {}

    explicit 多重映射实现(const key_compare& _Pred) : _Mybase(_Pred) {}

    多重映射实现(const key_compare& _Pred, const allocator_type& _Al) : _Mybase(_Pred, _Al) {}

    template <class _Iter>
    多重映射实现(_Iter _First, _Iter _Last) : _Mybase(key_compare()) {
        插入(_First, _Last);
    }

    template <class _Iter>
    多重映射实现(_Iter _First, _Iter _Last, const key_compare& _Pred) : _Mybase(_Pred) {
