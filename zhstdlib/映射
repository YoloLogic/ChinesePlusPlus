_EXPORT_STD template <class _Kty, class _类型, class _Pr = less<_Kty>, class _分配器 = allocator<pair<const _Kty, _类型>>>
class 多重映射实现 : public _树<_映射特征<_Kty, _类型, _Pr, _分配器, true>> {
    // ordered red-black tree of {key, mapped} values, non-unique keys
public:
    static_assert(!_ENFORCE_MATCHING_ALLOCATORS || is_same_v<pair<const _Kty, _类型>, typename _分配器::value_type>,
        _MISMATCHED_ALLOCATOR_MESSAGE("多重映射实现<Key, Value, Compare, Allocator>", "pair<const Key, Value>"));
    static_assert(is_object_v<_Kty>, "The C++ Standard forbids containers of non-object types "
                                     "because of [container.requirements].");

    using _我的基类                = _树<_映射特征<_Kty, _类型, _Pr, _分配器, true>>;
    using 键类型               = _Kty;
    using 映射类型            = _类型;
    using 键比较器            = _Pr;
    using 值比较          = typename _我的基类::值比较;
    using value_type             = pair<const _Kty, _类型>;
    using 分配器类型         = typename _我的基类::分配器类型;
    using size_type              = typename _我的基类::size_type;
    using difference_type        = typename _我的基类::difference_type;
    using pointer                = typename _我的基类::pointer;
    using const_pointer          = typename _我的基类::const_pointer;
    using reference              = value_type&;
    using 常量引用        = const value_type&;
    using 迭代器               = typename _我的基类::迭代器;
    using 常量迭代器         = typename _我的基类::常量迭代器;
    using reverse_iterator       = typename _我的基类::reverse_iterator;
    using const_reverse_iterator = typename _我的基类::const_reverse_iterator;

    using _结点分配器        = typename _我的基类::_结点分配器;
    using _结点分配器特征 = typename _我的基类::_结点分配器特征;

    多重映射实现() : _我的基类(键比较器()) {}

    explicit 多重映射实现(const 分配器类型& _Al) : _我的基类(键比较器(), _Al) {}

    多重映射实现(const 多重映射实现& _Right)
        : _我的基类(_Right, _结点分配器特征::select_on_container_copy_construction(_Right._取分配器())) {}

    多重映射实现(const 多重映射实现& _Right, const 分配器类型& _Al) : _我的基类(_Right, _Al) {}

    explicit 多重映射实现(const 键比较器& _Pred) : _我的基类(_Pred) {}

    多重映射实现(const 键比较器& _Pred, const 分配器类型& _Al) : _我的基类(_Pred, _Al) {}

    template <class _Iter>
    多重映射实现(_Iter _首个, _Iter _最后) : _我的基类(键比较器()) {
        插入(_首个, _最后);
    }

    template <class _Iter>
    多重映射实现(_Iter _首个, _Iter _最后, const 键比较器& _Pred) : _我的基类(_Pred) {
        插入(_首个, _最后);
    }

    template <class _Iter>
    多重映射实现(_Iter _首个, _Iter _最后, const 分配器类型& _Al) : _我的基类(键比较器(), _Al) {
        插入(_首个, _最后);
    }

    template <class _Iter>
    多重映射实现(_Iter _首个, _Iter _最后, const 键比较器& _Pred, const 分配器类型& _Al) : _我的基类(_Pred, _Al) {
        插入(_首个, _最后);
    }

#if _HAS_CXX23
    template <_Container_compatible_range<value_type> _Rng>
    多重映射实现(from_range_t, _Rng&& _Range) : _我的基类(键比较器()) {
        this->_插入范围非检查(_解包首(_Range), _解包尾(_Range));
    }

    template <_Container_compatible_range<value_type> _Rng>
    多重映射实现(from_range_t, _Rng&& _Range, const 键比较器& _Pred) : _我的基类(_Pred) {
        this->_插入范围非检查(_解包首(_Range), _解包尾(_Range));
    }

    template <_Container_compatible_range<value_type> _Rng>
    多重映射实现(from_range_t, _Rng&& _Range, const 键比较器& _Pred, const 分配器类型& _Al) : _我的基类(_Pred, _Al) {
        this->_插入范围非检查(_解包首(_Range), _解包尾(_Range));
    }

    template <_Container_compatible_range<value_type> _Rng>
    多重映射实现(from_range_t, _Rng&& _Range, const 分配器类型& _Al) : _我的基类(键比较器(), _Al) {
        this->_插入范围非检查(_解包首(_Range), _解包尾(_Range));
    }
#endif // _HAS_CXX23

    多重映射实现& operator=(const 多重映射实现& _Right) {
        _我的基类::operator=(_Right);
        return *this;
    }

    多重映射实现(多重映射实现&& _Right) : _我的基类(_STD move(_Right)) {}

    多重映射实现(多重映射实现&& _Right, const 分配器类型& _Al) : _我的基类(_STD move(_Right), _Al) {}

    多重映射实现& operator=(多重映射实现&& _Right)
        noexcept(_结点分配器特征::is_always_equal::value && is_nothrow_move_assignable_v<_Pr>) {
        _我的基类::operator=(_STD move(_Right));
        return *this;
    }

    template <class... _值参数类型>
    迭代器 就地构造(_值参数类型&&... _Val) {
        return _我的基类::就地构造(_STD forward<_值参数类型>(_Val)...).first;
    }

    void swap(多重映射实现& _Right) noexcept(noexcept(_我的基类::swap(_Right))) {
        _我的基类::swap(_Right);
    }

    using _我的基类::插入;

    template <class _值参数类型, enable_if_t<is_constructible_v<value_type, _值参数类型>, int> = 0>
    迭代器 插入(_值参数类型&& _Val) {
        return this->就地构造(_STD forward<_值参数类型>(_Val));
    }

    template <class _值参数类型, enable_if_t<is_constructible_v<value_type, _值参数类型>, int> = 0>
    迭代器 插入(常量迭代器 _Where, _值参数类型&& _Val) {
        return this->emplace_hint(_Where, _STD forward<_值参数类型>(_Val));
    }

    多重映射实现(initializer_list<value_type> _Ilist) : _我的基类(键比较器()) {
        插入(_Ilist);
    }

    多重映射实现(initializer_list<value_type> _Ilist, const 键比较器& _Pred) : _我的基类(_Pred) {
        插入(_Ilist);
    }

    多重映射实现(initializer_list<value_type> _Ilist, const 分配器类型& _Al) : _我的基类(键比较器(), _Al) {
        插入(_Ilist);
    }

    多重映射实现(initializer_list<value_type> _Ilist, const 键比较器& _Pred, const 分配器类型& _Al)
        : _我的基类(_Pred, _Al) {
        插入(_Ilist);
    }

    多重映射实现& operator=(initializer_list<value_type> _Ilist) {
        _我的基类::清空();
        插入(_Ilist);
        return *this;
    }

    using _我的基类::_非检查开始;
    using _我的基类::_非检查结束;
};

