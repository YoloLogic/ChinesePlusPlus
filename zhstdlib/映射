    static constexpr bool _Multi = _Mfl;

    template <class... _Args>
    using _就地键提取器 = _就地键提取映射<_Kty, _Args...>;

    class 值比较 {
    public:
        using _FIRST_ARGUMENT_TYPE_NAME _CXX17_DEPRECATE_ADAPTOR_TYPEDEFS  = value_type;
        using _SECOND_ARGUMENT_TYPE_NAME _CXX17_DEPRECATE_ADAPTOR_TYPEDEFS = value_type;
        using _RESULT_TYPE_NAME _CXX17_DEPRECATE_ADAPTOR_TYPEDEFS          = bool;

        _NODISCARD bool operator()(const value_type& _Left, const value_type& _Right) const {
            // test if _Left precedes _Right by comparing just keys
            return 比较器(_Left.first, _Right.first);
        }

    protected:
        friend _树<_映射特征>;

        值比较(键比较器 _Pred) : 比较器(_Pred) {}

        键比较器 比较器; // the comparator predicate for keys
    };

    template <class _Ty1, class _Ty2>
    static const _Kty& _取键(const pair<_Ty1, _Ty2>& _Val) { // extract key from element value
        return _Val.first;
    }
};

_EXPORT_STD template <class _Kty, class _类型, class _Pr = less<_Kty>, class _分配器 = allocator<pair<const _Kty, _类型>>>
class 映射实现 : public _树<_映射特征<_Kty, _类型, _Pr, _分配器, false>> {
    // ordered red-black tree of {key, mapped} values, unique keys
public:
    static_assert(!_ENFORCE_MATCHING_ALLOCATORS || is_same_v<pair<const _Kty, _类型>, typename _分配器::value_type>,
        _MISMATCHED_ALLOCATOR_MESSAGE("映射实现<Key, Value, Compare, Allocator>", "pair<const Key, Value>"));
    static_assert(is_object_v<_Kty>, "The C++ Standard forbids containers of non-object types "
                                     "because of [container.requirements].");

    using _我的基类                = _树<_映射特征<_Kty, _类型, _Pr, _分配器, false>>;
    using _结点指针               = typename _我的基类::_结点指针;
    using 键类型               = _Kty;
    using 映射类型            = _类型;
    using 键比较器            = _Pr;
    using 值比较          = typename _我的基类::值比较;
    using value_type             = pair<const _Kty, _类型>;
    using 分配器类型         = typename _我的基类::分配器类型;
    using size_type              = typename _我的基类::size_type;
    using difference_type        = typename _我的基类::difference_type;
    using pointer                = typename _我的基类::pointer;
    using const_pointer          = typename _我的基类::const_pointer;
    using reference              = value_type&;
    using 常量引用        = const value_type&;
    using 迭代器               = typename _我的基类::迭代器;
    using 常量迭代器         = typename _我的基类::常量迭代器;
    using reverse_iterator       = typename _我的基类::reverse_iterator;
    using const_reverse_iterator = typename _我的基类::const_reverse_iterator;

    using _结点分配器        = typename _我的基类::_结点分配器;
    using _结点分配器特征 = typename _我的基类::_结点分配器特征;

#if _HAS_CXX17
    using 插入返回类型 = _Insert_return_type<迭代器, typename _我的基类::结点类型>;
#endif // _HAS_CXX17

    映射实现() : _我的基类(键比较器()) {}

    explicit 映射实现(const 分配器类型& _Al) : _我的基类(键比较器(), _Al) {}

    映射实现(const 映射实现& _Right) : _我的基类(_Right, _结点分配器特征::select_on_container_copy_construction(_Right._取分配器())) {}

    映射实现(const 映射实现& _Right, const 分配器类型& _Al) : _我的基类(_Right, _Al) {}

    explicit 映射实现(const 键比较器& _Pred) : _我的基类(_Pred) {}

    映射实现(const 键比较器& _Pred, const 分配器类型& _Al) : _我的基类(_Pred, _Al) {}

    template <class _Iter>
    映射实现(_Iter _首个, _Iter _最后) : _我的基类(键比较器()) {
        插入(_首个, _最后);
    }

    template <class _Iter>
    映射实现(_Iter _首个, _Iter _最后, const 键比较器& _Pred) : _我的基类(_Pred) {
        插入(_首个, _最后);
    }

    template <class _Iter>
    映射实现(_Iter _首个, _Iter _最后, const 分配器类型& _Al) : _我的基类(键比较器(), _Al) {
        插入(_首个, _最后);
    }

    template <class _Iter>
    映射实现(_Iter _首个, _Iter _最后, const 键比较器& _Pred, const 分配器类型& _Al) : _我的基类(_Pred, _Al) {
        插入(_首个, _最后);
    }

#if _HAS_CXX23
    template <_Container_compatible_range<value_type> _Rng>
    映射实现(from_range_t, _Rng&& _Range) : _我的基类(键比较器()) {
        this->_插入范围非检查(_解包首(_Range), _解包尾(_Range));
    }

    template <_Container_compatible_range<value_type> _Rng>
    映射实现(from_range_t, _Rng&& _Range, const 键比较器& _Pred) : _我的基类(_Pred) {
        this->_插入范围非检查(_解包首(_Range), _解包尾(_Range));
    }

    template <_Container_compatible_range<value_type> _Rng>
    映射实现(from_range_t, _Rng&& _Range, const 键比较器& _Pred, const 分配器类型& _Al) : _我的基类(_Pred, _Al) {
        this->_插入范围非检查(_解包首(_Range), _解包尾(_Range));
    }

    template <_Container_compatible_range<value_type> _Rng>
    映射实现(from_range_t, _Rng&& _Range, const 分配器类型& _Al) : _我的基类(键比较器(), _Al) {
        this->_插入范围非检查(_解包首(_Range), _解包尾(_Range));
    }
#endif // _HAS_CXX23

    映射实现& operator=(const 映射实现& _Right) {
        _我的基类::operator=(_Right);
        return *this;
    }

    映射实现(映射实现&& _Right) : _我的基类(_STD move(_Right)) {}

    映射实现(映射实现&& _Right, const 分配器类型& _Al) : _我的基类(_STD move(_Right), _Al) {}

    映射实现& operator=(映射实现&& _Right) noexcept(_结点分配器特征::is_always_equal::value && is_nothrow_move_assignable_v<_Pr>) {
        _我的基类::operator=(_STD move(_Right));
        return *this;
    }

    映射类型& operator[](键类型&& _Keyval) { // find element matching _Keyval or 插入 value-initialized value
        return _尝试就地构造(_STD move(_Keyval)).first->_Myval.second;
    }

    void swap(映射实现& _Right) noexcept(noexcept(_我的基类::swap(_Right))) {
        _我的基类::swap(_Right);
    }

    using _我的基类::插入;

    template <class _值参数类型, enable_if_t<is_constructible_v<value_type, _值参数类型>, int> = 0>
    pair<迭代器, bool> 插入(_值参数类型&& _Val) {
        return this->就地构造(_STD forward<_值参数类型>(_Val));
    }

    template <class _值参数类型, enable_if_t<is_constructible_v<value_type, _值参数类型>, int> = 0>
    迭代器 插入(常量迭代器 _Where, _值参数类型&& _Val) {
        return this->emplace_hint(_Where, _STD forward<_值参数类型>(_Val));
    }

private:
    template <class _Keyty, class... _Mappedty>
    pair<_结点指针, bool> _尝试就地构造(_Keyty&& _Keyval, _Mappedty&&... _Mapval) {
        const auto _Loc = _我的基类::_查找下界(_Keyval);
        if (_我的基类::_下界重复项(_Loc._Bound, _Keyval)) {
            return {_Loc._Bound, false};
        }

        _我的基类::_检查增一();

        const auto _Scary    = _我的基类::_取检查值();
        const auto _Inserted = _树临时节点<_结点分配器>(_我的基类::_取分配器(), _Scary->_Myhead, piecewise_construct,
            _STD forward_as_tuple(_STD forward<_Keyty>(_Keyval)),
            _STD forward_as_tuple(_STD forward<_Mappedty>(_Mapval)...))
                                   ._释放();

        // nothrow hereafter
        return {_Scary->_插入节点(_Loc._Location, _Inserted), true};
    }

    template <class _Keyty, class... _Mappedty>
    _结点指针 _按提示尝试就地构造(const _结点指针 _Hint, _Keyty&& _Keyval, _Mappedty&&... _Mapval) {
        const auto _Loc = _我的基类::_按提示查找(_Hint, _Keyval);
        if (_Loc._Duplicate) {
            return _Loc._Location._Parent;
        }

        _我的基类::_检查增一();

        const auto _Scary    = _我的基类::_取检查值();
        const auto _Inserted = _树临时节点<_结点分配器>(_我的基类::_取分配器(), _Scary->_Myhead, piecewise_construct,
            _STD forward_as_tuple(_STD forward<_Keyty>(_Keyval)),
            _STD forward_as_tuple(_STD forward<_Mappedty>(_Mapval)...))
                                   ._释放();

        // nothrow hereafter
        return _Scary->_插入节点(_Loc._Location, _Inserted);
    }

public:
    template <class... _Mappedty>
    pair<迭代器, bool> 尝试就地构造(const 键类型& _Keyval, _Mappedty&&... _Mapval) {
        const auto _结果 = _尝试就地构造(_Keyval, _STD forward<_Mappedty>(_Mapval)...);
        return {迭代器(_结果.first, _我的基类::_取检查值()), _结果.second};
    }

    template <class... _Mappedty>
    迭代器 尝试就地构造(const 常量迭代器 _Hint, const 键类型& _Keyval, _Mappedty&&... _Mapval) {
        return 迭代器(
            _按提示尝试就地构造(_Hint._Ptr, _Keyval, _STD forward<_Mappedty>(_Mapval)...), _我的基类::_取检查值());
    }

    template <class... _Mappedty>
    pair<迭代器, bool> 尝试就地构造(键类型&& _Keyval, _Mappedty&&... _Mapval) {
        const auto _结果 = _尝试就地构造(_STD move(_Keyval), _STD forward<_Mappedty>(_Mapval)...);
        return {迭代器(_结果.first, _我的基类::_取检查值()), _结果.second};
    }

    template <class... _Mappedty>
    迭代器 尝试就地构造(const 常量迭代器 _Hint, 键类型&& _Keyval, _Mappedty&&... _Mapval) {
        return 迭代器(_按提示尝试就地构造(_Hint._Ptr, _STD move(_Keyval), _STD forward<_Mappedty>(_Mapval)...),
            _我的基类::_取检查值());
    }

private:
    template <class _Keyty, class _Mappedty>
    pair<_结点指针, bool> _插入或赋值(_Keyty&& _Keyval, _Mappedty&& _Mapval) {
        const auto _Loc = _我的基类::_查找下界(_Keyval);
        if (_我的基类::_下界重复项(_Loc._Bound, _Keyval)) {
            _Loc._Bound->_Myval.second = _STD forward<_Mappedty>(_Mapval);
            return {_Loc._Bound, false};
        }

        _我的基类::_检查增一();

        const auto _Scary    = _我的基类::_取检查值();
        const auto _Inserted = _树临时节点<_结点分配器>(
            _我的基类::_取分配器(), _Scary->_Myhead, _STD forward<_Keyty>(_Keyval), _STD forward<_Mappedty>(_Mapval))
                                   ._释放();

        // nothrow hereafter
        return {_Scary->_插入节点(_Loc._Location, _Inserted), true};
    }

    template <class _Keyty, class _Mappedty>
    _结点指针 _按提示插入或赋值(const _结点指针 _Hint, _Keyty&& _Keyval, _Mappedty&& _Mapval) {
        const auto _Loc = _我的基类::_按提示查找(_Hint, _Keyval);
        if (_Loc._Duplicate) {
            _Loc._Location._Parent->_Myval.second = _STD forward<_Mappedty>(_Mapval);
            return _Loc._Location._Parent;
        }

        _我的基类::_检查增一();

        const auto _Scary    = _我的基类::_取检查值();
        const auto _Inserted = _树临时节点<_结点分配器>(
            _我的基类::_取分配器(), _Scary->_Myhead, _STD forward<_Keyty>(_Keyval), _STD forward<_Mappedty>(_Mapval))
                                   ._释放();

        // nothrow hereafter
        return _Scary->_插入节点(_Loc._Location, _Inserted);
    }

public:
    template <class _Mappedty>
    pair<迭代器, bool> 插入或赋值(const 键类型& _Keyval, _Mappedty&& _Mapval) {
        const auto _结果 = _插入或赋值(_Keyval, _STD forward<_Mappedty>(_Mapval));
        return {迭代器(_结果.first, _我的基类::_取检查值()), _结果.second};
    }

    template <class _Mappedty>
    迭代器 插入或赋值(const 常量迭代器 _Hint, const 键类型& _Keyval, _Mappedty&& _Mapval) {
        return 迭代器(
            _按提示插入或赋值(_Hint._Ptr, _Keyval, _STD forward<_Mappedty>(_Mapval)), _我的基类::_取检查值());
    }

    template <class _Mappedty>
    pair<迭代器, bool> 插入或赋值(键类型&& _Keyval, _Mappedty&& _Mapval) {
        const auto _结果 = _插入或赋值(_STD move(_Keyval), _STD forward<_Mappedty>(_Mapval));
        return {迭代器(_结果.first, _我的基类::_取检查值()), _结果.second};
    }

    template <class _Mappedty>
    迭代器 插入或赋值(const 常量迭代器 _Hint, 键类型&& _Keyval, _Mappedty&& _Mapval) {
        return 迭代器(_按提示插入或赋值(_Hint._Ptr, _STD move(_Keyval), _STD forward<_Mappedty>(_Mapval)),
            _我的基类::_取检查值());
    }

    映射实现(initializer_list<value_type> _Ilist) : _我的基类(键比较器()) {
        插入(_Ilist);
    }

    映射实现(initializer_list<value_type> _Ilist, const 键比较器& _Pred) : _我的基类(_Pred) {
        插入(_Ilist);
    }

    映射实现(initializer_list<value_type> _Ilist, const 分配器类型& _Al) : _我的基类(键比较器(), _Al) {
        插入(_Ilist);
    }

    映射实现(initializer_list<value_type> _Ilist, const 键比较器& _Pred, const 分配器类型& _Al)
        : _我的基类(_Pred, _Al) {
        插入(_Ilist);
    }

    映射实现& operator=(initializer_list<value_type> _Ilist) {
        _我的基类::清空();
        插入(_Ilist);
        return *this;
    }

    映射类型& operator[](const 键类型& _Keyval) {
        return _尝试就地构造(_Keyval).first->_Myval.second;
    }

    _NODISCARD 映射类型& 取值(const 键类型& _Keyval) {
        const auto _Loc = _我的基类::_查找下界(_Keyval);
        if (!_我的基类::_下界重复项(_Loc._Bound, _Keyval)) {
            _Xout_of_range("invalid 映射实现<K, T> key");
        }

        return _Loc._Bound->_Myval.second;
    }

    _NODISCARD const 映射类型& 取值(const 键类型& _Keyval) const {
        const auto _Loc = _我的基类::_查找下界(_Keyval);
        if (!_我的基类::_下界重复项(_Loc._Bound, _Keyval)) {
            _Xout_of_range("invalid 映射实现<K, T> key");
        }

        return _Loc._Bound->_Myval.second;
    }

    using _我的基类::_非检查开始;
    using _我的基类::_非检查结束;
};

