    pair<_结点指针, bool> _Try_emplace(_Keyty&& _Keyval, _Mappedty&&... _Mapval) {
        const auto _Loc = _我的基类::_查找下界(_Keyval);
        if (_我的基类::_下界重复项(_Loc._Bound, _Keyval)) {
            return {_Loc._Bound, false};
        }

        _我的基类::_检查增一();

        const auto _Scary    = _我的基类::_取检查值();
        const auto _Inserted = _树临时节点<_结点分配器>(_我的基类::_取分配器(), _Scary->_Myhead, piecewise_construct,
            _STD forward_as_tuple(_STD forward<_Keyty>(_Keyval)),
            _STD forward_as_tuple(_STD forward<_Mappedty>(_Mapval)...))
                                   ._Release();

        // nothrow hereafter
        return {_Scary->_插入节点(_Loc._Location, _Inserted), true};
    }

    template <class _Keyty, class... _Mappedty>
    _结点指针 _Try_emplace_hint(const _结点指针 _Hint, _Keyty&& _Keyval, _Mappedty&&... _Mapval) {
        const auto _Loc = _我的基类::_按提示查找(_Hint, _Keyval);
        if (_Loc._Duplicate) {
            return _Loc._Location._Parent;
        }

        _我的基类::_检查增一();

        const auto _Scary    = _我的基类::_取检查值();
        const auto _Inserted = _树临时节点<_结点分配器>(_我的基类::_取分配器(), _Scary->_Myhead, piecewise_construct,
            _STD forward_as_tuple(_STD forward<_Keyty>(_Keyval)),
            _STD forward_as_tuple(_STD forward<_Mappedty>(_Mapval)...))
                                   ._Release();

        // nothrow hereafter
        return _Scary->_插入节点(_Loc._Location, _Inserted);
    }

public:
    template <class... _Mappedty>
    pair<迭代器, bool> 尝试就地构造(const 键类型& _Keyval, _Mappedty&&... _Mapval) {
        const auto _Result = _Try_emplace(_Keyval, _STD forward<_Mappedty>(_Mapval)...);
        return {迭代器(_Result.first, _我的基类::_取检查值()), _Result.second};
    }

    template <class... _Mappedty>
    迭代器 尝试就地构造(const 常量迭代器 _Hint, const 键类型& _Keyval, _Mappedty&&... _Mapval) {
        return 迭代器(
            _Try_emplace_hint(_Hint._Ptr, _Keyval, _STD forward<_Mappedty>(_Mapval)...), _我的基类::_取检查值());
    }

    template <class... _Mappedty>
    pair<迭代器, bool> 尝试就地构造(键类型&& _Keyval, _Mappedty&&... _Mapval) {
        const auto _Result = _Try_emplace(_STD move(_Keyval), _STD forward<_Mappedty>(_Mapval)...);
        return {迭代器(_Result.first, _我的基类::_取检查值()), _Result.second};
    }

    template <class... _Mappedty>
    迭代器 尝试就地构造(const 常量迭代器 _Hint, 键类型&& _Keyval, _Mappedty&&... _Mapval) {
        return 迭代器(_Try_emplace_hint(_Hint._Ptr, _STD move(_Keyval), _STD forward<_Mappedty>(_Mapval)...),
            _我的基类::_取检查值());
    }

private:
    template <class _Keyty, class _Mappedty>
    pair<_结点指针, bool> _Insert_or_assign(_Keyty&& _Keyval, _Mappedty&& _Mapval) {
        const auto _Loc = _我的基类::_查找下界(_Keyval);
        if (_我的基类::_下界重复项(_Loc._Bound, _Keyval)) {
            _Loc._Bound->_Myval.second = _STD forward<_Mappedty>(_Mapval);
            return {_Loc._Bound, false};
        }

        _我的基类::_检查增一();

        const auto _Scary    = _我的基类::_取检查值();
        const auto _Inserted = _树临时节点<_结点分配器>(
            _我的基类::_取分配器(), _Scary->_Myhead, _STD forward<_Keyty>(_Keyval), _STD forward<_Mappedty>(_Mapval))
                                   ._Release();

        // nothrow hereafter
        return {_Scary->_插入节点(_Loc._Location, _Inserted), true};
    }

    template <class _Keyty, class _Mappedty>
    _结点指针 _Insert_or_assign_hint(const _结点指针 _Hint, _Keyty&& _Keyval, _Mappedty&& _Mapval) {
        const auto _Loc = _我的基类::_按提示查找(_Hint, _Keyval);
        if (_Loc._Duplicate) {
            _Loc._Location._Parent->_Myval.second = _STD forward<_Mappedty>(_Mapval);
            return _Loc._Location._Parent;
        }

        _我的基类::_检查增一();

        const auto _Scary    = _我的基类::_取检查值();
        const auto _Inserted = _树临时节点<_结点分配器>(
            _我的基类::_取分配器(), _Scary->_Myhead, _STD forward<_Keyty>(_Keyval), _STD forward<_Mappedty>(_Mapval))
                                   ._Release();

        // nothrow hereafter
        return _Scary->_插入节点(_Loc._Location, _Inserted);
    }

public:
    template <class _Mappedty>
    pair<迭代器, bool> 插入或赋值(const 键类型& _Keyval, _Mappedty&& _Mapval) {
        const auto _Result = _Insert_or_assign(_Keyval, _STD forward<_Mappedty>(_Mapval));
        return {迭代器(_Result.first, _我的基类::_取检查值()), _Result.second};
    }

    template <class _Mappedty>
    迭代器 插入或赋值(const 常量迭代器 _Hint, const 键类型& _Keyval, _Mappedty&& _Mapval) {
        return 迭代器(
            _Insert_or_assign_hint(_Hint._Ptr, _Keyval, _STD forward<_Mappedty>(_Mapval)), _我的基类::_取检查值());
    }

    template <class _Mappedty>
    pair<迭代器, bool> 插入或赋值(键类型&& _Keyval, _Mappedty&& _Mapval) {
        const auto _Result = _Insert_or_assign(_STD move(_Keyval), _STD forward<_Mappedty>(_Mapval));
        return {迭代器(_Result.first, _我的基类::_取检查值()), _Result.second};
    }

    template <class _Mappedty>
    迭代器 插入或赋值(const 常量迭代器 _Hint, 键类型&& _Keyval, _Mappedty&& _Mapval) {
        return 迭代器(_Insert_or_assign_hint(_Hint._Ptr, _STD move(_Keyval), _STD forward<_Mappedty>(_Mapval)),
            _我的基类::_取检查值());
    }

