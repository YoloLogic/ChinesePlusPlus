    映射实现& operator=(initializer_list<value_type> _Ilist) {
        _我的基类::clear();
        insert(_Ilist);
        return *this;
    }

    映射类型& operator[](const 键类型& _Keyval) {
        return _Try_emplace(_Keyval).first->_Myval.second;
    }

    _NODISCARD 映射类型& 取值(const 键类型& _Keyval) {
        const auto _Loc = _我的基类::_查找下界(_Keyval);
        if (!_我的基类::_下界重复项(_Loc._Bound, _Keyval)) {
