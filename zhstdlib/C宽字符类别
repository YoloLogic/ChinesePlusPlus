// <C宽字符类别> —— cwctype 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   C 包装头自己没有实现，只是把 C 库名字搬进 std；而 std::iswalpha 这类
//   **必须与全局那个是同一个类型**（对齐 / ABI）。抄一份就变成"另一种类型"。
//   实测抄 cstddef 直接炸：「using _STD max_align_t;」那条"桥"搬名域后断链。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
#pragma once
#include <cwctype>

名域 标准 {
    使用 是宽字母               = std::iswalpha;
    使用 是宽数字               = std::iswdigit;
    使用 是宽空白               = std::iswspace;
    使用 转宽大写               = std::towupper;
    使用 转宽小写               = std::towlower;

}