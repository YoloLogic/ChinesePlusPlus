// <类型特征> —— type_traits 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   本头里的东西，类型身份参与语义（换一份就成了两套互不相认的东西）。
//   这类头一旦抄一份，就会和 std 里那份成为两套互不相认的东西。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变体（英文里带 _v 的变量模板形式）暂未提供中文名，属"必须的妥协"，见方案 §六。
#pragma once
#include <type_traits>

名域 标准 {
    使用 真类型 = std::true_type;
    使用 假类型 = std::false_type;
    模板 <类型名 甲, 类型名 乙> 使用 是相同类型 = std::is_same<甲, 乙>;
    模板 <类型名 某类型> 使用 是整数类型 = std::is_integral<某类型>;
    模板 <类型名 某类型> 使用 是浮点类型 = std::is_floating_point<某类型>;
    模板 <类型名 某类型> 使用 是算术类型 = std::is_arithmetic<某类型>;
    模板 <类型名 某类型> 使用 是指针类型 = std::is_pointer<某类型>;
    模板 <类型名 某类型> 使用 是引用类型 = std::is_reference<某类型>;
    模板 <类型名 某类型> 使用 是常量类型 = std::is_const<某类型>;
    模板 <类型名 某类型> 使用 是空型   = std::is_void<某类型>;
    模板 <类型名 某类型> 使用 是类类型 = std::is_class<某类型>;
    模板 <类型名 基, 类型名 派生> 使用 是基类 = std::is_base_of<基, 派生>;
    模板 <类型名 从, 类型名 到> 使用 是可转换 = std::is_convertible<从, 到>;
    模板 <类型名 某类型> 使用 是可平凡复制 = std::is_trivially_copyable<某类型>;
    模板 <布尔 条件, 类型名 某类型 = 空型> 使用 启用如果 = std::enable_if<条件, 某类型>;
    模板 <布尔 条件, 类型名 真型, 类型名 假型> 使用 条件类型 = std::conditional<条件, 真型, 假型>;
    模板 <类型名 某类型> 使用 移除引用 = std::remove_reference<某类型>;
    模板 <类型名 某类型> 使用 移除常量 = std::remove_const<某类型>;
    模板 <类型名 某类型> 使用 移除指针 = std::remove_pointer<某类型>;
    模板 <类型名 某类型> 使用 退化     = std::decay<某类型>;
    模板 <类型名 某类型> 使用 加常量   = std::add_const<某类型>;
    模板 <类型名 某类型> 使用 加左值引用 = std::add_lvalue_reference<某类型>;
    模板 <类型名 某类型> 使用 加右值引用 = std::add_rvalue_reference<某类型>;
    模板 <类型名 某类型> 使用 底层类型 = std::underlying_type<某类型>;
    模板 <类型名... 参数> 使用 公共类型 = std::common_type<参数...>;
    模板 <类型名... 参数> 使用 空型标记 = std::void_t<参数...>;
    模板 <类型名 某类型, 某类型 值> 使用 整数常量 = std::integral_constant<某类型, 值>;
}