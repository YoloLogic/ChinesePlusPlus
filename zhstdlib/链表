_NODISCARD bool operator!=(const 链表实现<_Ty, _Alloc>& _Left, const 链表实现<_Ty, _Alloc>& _Right) {
    return !(_Left == _Right);
}

template <class _Ty, class _Alloc>
_NODISCARD bool operator<(const 链表实现<_Ty, _Alloc>& _Left, const 链表实现<_Ty, _Alloc>& _Right) {
    return _STD lexicographical_compare(
        _Left._非检查开始(), _Left._非检查结束(), _Right._非检查开始(), _Right._非检查结束());
}

template <class _Ty, class _Alloc>
_NODISCARD bool operator>(const 链表实现<_Ty, _Alloc>& _Left, const 链表实现<_Ty, _Alloc>& _Right) {
    return _Right < _Left;
}

template <class _Ty, class _Alloc>
_NODISCARD bool operator<=(const 链表实现<_Ty, _Alloc>& _Left, const 链表实现<_Ty, _Alloc>& _Right) {
    return !(_Right < _Left);
}

template <class _Ty, class _Alloc>
_NODISCARD bool operator>=(const 链表实现<_Ty, _Alloc>& _Left, const 链表实现<_Ty, _Alloc>& _Right) {
    return !(_Left < _Right);
}
