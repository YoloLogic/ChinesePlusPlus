    void _孤儿化指针2(_结点指针 _Ptr) noexcept { // orphan iterators with specified node pointers
#if _ITERATOR_DEBUG_LEVEL == 2
        _Lockit _Lock(_LOCK_DEBUG);
        _Iterator_base12** _Pnext = &this->_Myproxy->_Myfirstiter;
        const auto _Head          = _Myhead;
        while (*_Pnext) {
            _Iterator_base12** _Pnextnext = &(*_Pnext)->_Mynextiter;
            const auto _Pnextptr          = static_cast<_链表常量迭代器<_链表值>&>(**_Pnext)._Ptr;
            if (_Pnextptr == _Head || _Pnextptr != _Ptr) {
                // iterator is 结束() or doesn't point at the one we are orphaning, move on
                _Pnext = _Pnextnext;
            } else { // orphan the iterator
                (*_Pnext)->_Myproxy = nullptr;
                *_Pnext             = *_Pnextnext;
            }
        }
#else // ^^^ _ITERATOR_DEBUG_LEVEL == 2 / _ITERATOR_DEBUG_LEVEL != 2 vvv
        (void) _Ptr;
#endif // ^^^ _ITERATOR_DEBUG_LEVEL != 2 ^^^
    }

    void _孤儿化非末尾() noexcept { // orphan iterators except 结束()
#if _ITERATOR_DEBUG_LEVEL == 2
        _Lockit _Lock(_LOCK_DEBUG);
        _Iterator_base12** _Pnext = &this->_Myproxy->_Myfirstiter;
        const auto _Head          = _Myhead;
        while (*_Pnext) {
            _Iterator_base12** _Pnextnext = &(*_Pnext)->_Mynextiter;
            if (static_cast<_链表常量迭代器<_链表值>&>(**_Pnext)._Ptr == _Head) { // iterator is 结束(), move on
                _Pnext = _Pnextnext;
            } else { // orphan the iterator
                (*_Pnext)->_Myproxy = nullptr;
                *_Pnext             = *_Pnextnext;
            }
        }
#endif // _ITERATOR_DEBUG_LEVEL == 2
    }

    _结点指针 _Unlinknode(_结点指针 _Pnode) noexcept { // unlink node at _Where from the 链表实现
        _孤儿化指针2(_Pnode);
        _Pnode->_Prev->_Next = _Pnode->_Next;
        _Pnode->_Next->_Prev = _Pnode->_Prev;
        --_Mysize;
        return _Pnode;
    }

#if _ITERATOR_DEBUG_LEVEL == 2
    void _Adopt_unique(_链表值& _Other, _结点指针 _Pnode) noexcept {
        // adopt iterators pointing to the spliced node
        _Lockit _Lock(_LOCK_DEBUG);
        _Iterator_base12** _Pnext = &_Other._Myproxy->_Myfirstiter;
        const auto _Myproxy       = this->_Myproxy;
        while (*_Pnext) {
            auto& _Iter = static_cast<_链表常量迭代器<_链表值>&>(**_Pnext);
            if (_Iter._Ptr == _Pnode) { // adopt the iterator
                *_Pnext                = _Iter._Mynextiter;
                _Iter._Myproxy         = _Myproxy;
                _Iter._Mynextiter      = _Myproxy->_Myfirstiter;
                _Myproxy->_Myfirstiter = _STD addressof(_Iter);
            } else { // skip the iterator
                _Pnext = &_Iter._Mynextiter;
            }
        }
    }

    void _收养全部(_链表值& _Other) noexcept {
        // adopt all iterators (except _Other.结束())
        _Lockit _Lock(_LOCK_DEBUG);
        _Iterator_base12** _Pnext = &_Other._Myproxy->_Myfirstiter;
        const auto _Myproxy       = this->_Myproxy;
        const auto _Otherhead     = _Other._Myhead;
        while (*_Pnext) {
            auto& _Iter = static_cast<_链表常量迭代器<_链表值>&>(**_Pnext);
            if (_Iter._Ptr != _Otherhead) { // adopt the iterator
                *_Pnext                = _Iter._Mynextiter;
                _Iter._Myproxy         = _Myproxy;
                _Iter._Mynextiter      = _Myproxy->_Myfirstiter;
                _Myproxy->_Myfirstiter = _STD addressof(_Iter);
            } else { // skip the iterator
                _Pnext = &_Iter._Mynextiter;
            }
        }
    }

    void _收养范围(_链表值& _Other, const _结点指针 _First, const _结点指针 _Last) noexcept {
        // adopt all iterators pointing to nodes in the "range" [_First, _Last) by marking nodes
        _Lockit _Lock(_LOCK_DEBUG);
        _Iterator_base12** _Pnext = &_Other._Myproxy->_Myfirstiter;
        const auto _Myproxy       = this->_Myproxy;
        _结点指针 _Oldprev         = _First->_Prev;
        for (_结点指针 _Ptr = _First; _Ptr != _Last; _Ptr = _Ptr->_Next) { // mark _Prev pointers
            _Ptr->_Prev = nullptr;
        }

        while (*_Pnext) { // check the iterator
            auto& _Iter = static_cast<_链表常量迭代器<_链表值>&>(**_Pnext);
            if (_Iter._Ptr->_Prev) { // skip the iterator
                _Pnext = &_Iter._Mynextiter;
            } else { // adopt the iterator
                *_Pnext                = _Iter._Mynextiter;
                _Iter._Myproxy         = _Myproxy;
                _Iter._Mynextiter      = _Myproxy->_Myfirstiter;
                _Myproxy->_Myfirstiter = _STD addressof(_Iter);
            }
        }

        for (_结点指针 _Ptr = _First; _Ptr != _Last; _Ptr = _Ptr->_Next) { // restore _Prev pointers
            _Ptr->_Prev = _Oldprev;
            _Oldprev    = _Ptr;
        }
    }
#endif // _ITERATOR_DEBUG_LEVEL == 2

    static _结点指针 _Unchecked_splice(const _结点指针 _Before, const _结点指针 _First, const _结点指针 _Last) noexcept {
        // 接合 [_First, _Last) before _Before; returns _Last
        _STL_INTERNAL_CHECK(_Before != _First && _Before != _Last && _First != _Last);
        // 3 reads and 6 writes

        // fixup the _Next values
        const auto _First_prev  = _First->_Prev;
        _First_prev->_Next      = _Last;
        const auto _Last_prev   = _Last->_Prev;
        _Last_prev->_Next       = _Before;
        const auto _Before_prev = _Before->_Prev;
        _Before_prev->_Next     = _First;

        // fixup the _Prev values
        _Before->_Prev = _Last_prev;
        _Last->_Prev   = _First_prev;
        _First->_Prev  = _Before_prev;

        return _Last;
    }

    static _结点指针 _Unchecked_splice(const _结点指针 _Before, const _结点指针 _First) noexcept {
        // 接合 [_First, _First->_Next) before _Before; returns _First->_Next
        _STL_INTERNAL_CHECK(_Before != _First && _First->_Next != _Before);
        // still 3 reads and 6 writes, but 1 less read if the caller was going to get _First->_Next
        const auto _Last = _First->_Next;

        // fixup the _Next values
        const auto _First_prev = _First->_Prev;
        _First_prev->_Next     = _Last;
        // const auto _Last_prev = _First;
        _First->_Next           = _Before;
        const auto _Before_prev = _Before->_Prev;
        _Before_prev->_Next     = _First;

        // fixup the _Prev values
        _Before->_Prev = _First;
        _Last->_Prev   = _First_prev;
        _First->_Prev  = _Before_prev;

        return _Last;
    }

    template <class _Pr2>
    static _结点指针 _归并同一(_结点指针 _First, _结点指针 _Mid, const _结点指针 _Last, _Pr2 _Pred) {
        // Merge the sorted ranges [_First, _Mid) and [_Mid, _Last)
        // Returns the new beginning of the range (which won't be _First if it was spliced elsewhere)
        _STL_INTERNAL_CHECK(_First != _Mid && _Mid != _Last);
        _结点指针 _Newfirst;
        if (_DEBUG_LT_PRED(_Pred, _Mid->_Myval, _First->_Myval)) {
            // _Mid will be spliced to the 前 of the range
            _Newfirst = _Mid;
        } else {
            // Establish _Pred(_Mid->_Myval, _First->_Myval) by skipping over elements from the first
            // range already in position.
            _Newfirst = _First;
            do {
                _First = _First->_Next;
                if (_First == _Mid) {
                    return _Newfirst;
                }
            } while (!_DEBUG_LT_PRED(_Pred, _Mid->_Myval, _First->_Myval));
        }

        for (;;) { // process one run 接合
            auto _Run_start = _Mid;
            do { // find the 结束 of the "run" of elements we need to 接合 from the second range into the first
                _Mid = _Mid->_Next;
            } while (_Mid != _Last && _DEBUG_LT_PRED(_Pred, _Mid->_Myval, _First->_Myval));

            // [_Run_start, _Mid) goes before _First->_Myval
            _Unchecked_splice(_First, _Run_start, _Mid);
            if (_Mid == _Last) {
                return _Newfirst;
            }

            // Reestablish _Pred(_Mid->_Myval, _First->_Myval) by skipping over elements from the first
            // range already in position.
            do {
                _First = _First->_Next;
                if (_First == _Mid) {
                    return _Newfirst;
                }
            } while (!_DEBUG_LT_PRED(_Pred, _Mid->_Myval, _First->_Myval));
        }
    }

    template <class _Pr2>
    static _结点指针 _排序(_结点指针& _First, const size_type _Size, _Pr2 _Pred) {
        // order [_First, _First + _Size), return _First + _Size
        switch (_Size) {
        case 0:
            return _First;
        case 1:
            return _First->_Next;
        default:
            break;
        }

        auto _Mid        = _排序(_First, _Size / 2, _Pred);
        const auto _Last = _排序(_Mid, _Size - _Size / 2, _Pred);
        _First           = _归并同一(_First, _Mid, _Last, _Pred);
        return _Last;
    }

    _结点指针 _Myhead; // pointer to head node
    size_type _Mysize; // number of elements
};

template <class _结点分配器>
struct _链表节点就地构造操作2 : _Alloc_construct_ptr<_结点分配器> {
    using _结点分配器特征 = allocator_traits<_结点分配器>;
