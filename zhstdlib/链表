    explicit _链表节点就地构造操作2(_结点分配器& _Al_, _Valtys&&... _Vals) : _Alloc_construct_ptr<_结点分配器>(_Al_) {
        this->_Allocate();
        _结点分配器特征::construct(this->_Al, _STD addressof(this->_Ptr->_Myval), _STD forward<_Valtys>(_Vals)...);
