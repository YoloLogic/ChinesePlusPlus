_EXPORT_STD template <class _Ty, class _Alloc>
void swap(链表实现<_Ty, _Alloc>& _Left, 链表实现<_Ty, _Alloc>& _Right) noexcept /* strengthened */ {
    _Left.swap(_Right);
}

_EXPORT_STD template <class _Ty, class _Alloc>
_NODISCARD bool operator==(const 链表实现<_Ty, _Alloc>& _Left, const 链表实现<_Ty, _Alloc>& _Right) {
    return _Left.尺寸() == _Right.尺寸()
        && _STD equal(_Left._非检查开始(), _Left._非检查结束(), _Right._非检查开始());
}

