// <绘图> —— 绘图 的中文别名层
//
// 这是什么：绘图（Windows 系统 API）的**中文名层**，机制与 C 包装头相同（方案 §3.4）：
//   类型 -> 使用 中文名 = 原名;      （**没有 std::**：Win32 名字住在全局名域）
//   函数 -> 一模板转发（函数没有"别名"机制）—— 一律指向**显式的 …W 真函数**：
//           Win32 里 CreateFile/WriteConsole/GetModuleHandle 这类"函数"其实是宏，
//           宏会被展开、不能转发，所以表里一律取 …W（决策 D-14 第 3 条）。
//   宏   -> 内联 常量 承载它的值（值仍取 SDK 自己的宏，**不重写定义**）
//
// ⚠ 下面两个宏是【必需】的，不是可选优化 —— 组合探针（全部汉语头放进同一个 TU）实测：
//   · 不给 WIN32_LEAN_AND_MEAN ⇒ rpcndr.h 的 typedef unsigned char byte; 让 byte 有歧义，
//     《通用内部件》里 20 条错（它与 std::byte 对不上号）；
//   · 不给 NOMINMAX ⇒ windef.h 的 min/max 宏把《数值极限》里的 (min)(...) 拆坏，也是 20 条错。
//   两个都给 = 0 条错（<Windows系统> 排在最前、后面跟全部 116 个汉语头也照样编过）。
//   用 #ifndef 包住：用户自己已经定过就按用户的 —— 这里只是"没定过时的兜底"。
//
// 英文原名照旧可用：这里只是【多一个名字】，SDK 头一个字节没动。
#pragma once
#ifndef NOMINMAX
#define NOMINMAX
#endif
#ifndef WIN32_LEAN_AND_MEAN
#define WIN32_LEAN_AND_MEAN
#endif
#include <Windows系统>
#include <C标准整数>

名域 标准 {
    使用 设备上下文 = HDC;
    使用 画笔 = HPEN;
    使用 画刷 = HBRUSH;
    使用 字体 = HFONT;
    使用 绘图对象 = HGDIOBJ;
    使用 颜色参考 = COLORREF;
    内联 常量 整数 实心笔 = PS_SOLID;
    内联 常量 整数 背景透明 = TRANSPARENT;
    内联 常量 整数 不透明 = OPAQUE;
    内联 标准::设备上下文 取窗口设备上下文(标准::窗口句柄 窗){ 返回 GetDC(窗); }
    内联 整数 释放设备上下文(标准::窗口句柄 窗, 标准::设备上下文 上下文){ 返回 ReleaseDC(窗, 上下文); }
    内联 标准::设备上下文 开始绘制(标准::窗口句柄 窗, PAINTSTRUCT* 绘制信息){ 返回 BeginPaint(窗, 绘制信息); }
    内联 整数 结束绘制(标准::窗口句柄 窗, PAINTSTRUCT* 绘制信息){ 返回 EndPaint(窗, 绘制信息); }
    内联 整数 填充矩形(标准::设备上下文 上下文, RECT* 框, 标准::画刷 刷){ 返回 FillRect(上下文, 框, 刷); }
    内联 整数 画矩形(标准::设备上下文 上下文, 整数 左, 整数 上, 整数 右, 整数 下){ 返回 Rectangle(上下文, 左, 上, 右, 下); }
    内联 整数 画椭圆(标准::设备上下文 上下文, 整数 左, 整数 上, 整数 右, 整数 下){ 返回 Ellipse(上下文, 左, 上, 右, 下); }
    内联 整数 画线(标准::设备上下文 上下文, 整数 起横, 整数 起纵, 整数 止横, 整数 止纵){ 返回 (整数)(MoveToEx(上下文, 起横, 起纵, 空指针) && LineTo(上下文, 止横, 止纵)); }
    内联 整数 输出文本(标准::设备上下文 上下文, 整数 横, 整数 纵, 常量 宽字符* 文本, 整数 字数){ 返回 TextOutW(上下文, 横, 纵, 文本, 字数); }
    内联 标准::颜色参考 设文本颜色(标准::设备上下文 上下文, 标准::颜色参考 色){ 返回 SetTextColor(上下文, 色); }
    内联 标准::颜色参考 设背景颜色(标准::设备上下文 上下文, 标准::颜色参考 色){ 返回 SetBkColor(上下文, 色); }
    内联 整数 设背景模式(标准::设备上下文 上下文, 整数 模式){ 返回 SetBkMode(上下文, 模式); }
    内联 标准::画刷 创建实心画刷(标准::颜色参考 色){ 返回 CreateSolidBrush(色); }
    内联 标准::绘图对象 选择对象(标准::设备上下文 上下文, 标准::绘图对象 对象){ 返回 SelectObject(上下文, 对象); }
    内联 整数 删除绘图对象(标准::绘图对象 对象){ 返回 DeleteObject(对象); }
    内联 整数 无效化矩形(标准::窗口句柄 窗, RECT* 框, 整数 擦除){ 返回 InvalidateRect(窗, 框, 擦除); }
    内联 整数 取设备能力(标准::设备上下文 上下文, 整数 索引){ 返回 GetDeviceCaps(上下文, 索引); }
    内联 整数 取系统度量(整数 索引){ 返回 GetSystemMetrics(索引); }
}