// <C数学> —— cmath 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   C 包装头自己没有实现，只是把 C 库名字搬进 std；而 std::sqrt 这类
//   **必须与全局那个是同一个类型**（对齐 / ABI）。抄一份就变成"另一种类型"。
//   实测抄 cstddef 直接炸：「using _STD max_align_t;」那条"桥"搬名域后断链。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
#pragma once
#include <cmath>

名域 标准 {
    使用 平方根                = std::sqrt;
    使用 幂                  = std::pow;
    使用 绝对值                = std::fabs;
    使用 向下取整               = std::floor;
    使用 向上取整               = std::ceil;
    使用 四舍五入               = std::round;
    使用 自然指数               = std::exp;
    使用 自然对数               = std::log;
    使用 常用对数               = std::log10;
    使用 正弦                 = std::sin;
    使用 余弦                 = std::cos;
    使用 正切                 = std::tan;
    使用 反正弦                = std::asin;
    使用 反余弦                = std::acos;
    使用 反正切                = std::atan;
    使用 双参反正切              = std::atan2;
    使用 余数                 = std::fmod;
    使用 双曲正弦               = std::sinh;

}