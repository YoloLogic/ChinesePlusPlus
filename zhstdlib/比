// <比> —— ratio 的中文别名层
//
// 为什么是别名而不是抄一份（方案铁律 4）：
//   本头里的东西，类型身份参与语义（换一份就成了两套互不相认的东西）。
//   这类头一旦抄一份，就会和 std 里那份成为两套互不相认的东西。
//
// 英文原名照旧可用：这里只是【多一个名字】，原头一个字节没动。
// 变体（英文里带 _v 的变量模板形式）暂未提供中文名，属"必须的妥协"，见方案 §六。
#pragma once
#include <ratio>

名域 标准 {
    模板 <整数 分子, 整数 分母 = 1>
    使用 比 = std::ratio<分子, 分母>;
    模板 <类型名 比甲, 类型名 比乙> 使用 比相加 = std::ratio_add<比甲, 比乙>;
    模板 <类型名 比甲, 类型名 比乙> 使用 比相减 = std::ratio_subtract<比甲, 比乙>;
    模板 <类型名 比甲, 类型名 比乙> 使用 比相乘 = std::ratio_multiply<比甲, 比乙>;
    模板 <类型名 比甲, 类型名 比乙> 使用 比相除 = std::ratio_divide<比甲, 比乙>;
    模板 <类型名 比甲, 类型名 比乙> 使用 比相等 = std::ratio_equal<比甲, 比乙>;
    模板 <类型名 比甲, 类型名 比乙> 使用 比不等 = std::ratio_not_equal<比甲, 比乙>;
    模板 <类型名 比甲, 类型名 比乙> 使用 比小于 = std::ratio_less<比甲, 比乙>;
    模板 <类型名 比甲, 类型名 比乙> 使用 比小于等于 = std::ratio_less_equal<比甲, 比乙>;
    模板 <类型名 比甲, 类型名 比乙> 使用 比大于 = std::ratio_greater<比甲, 比乙>;
    模板 <类型名 比甲, 类型名 比乙> 使用 比大于等于 = std::ratio_greater_equal<比甲, 比乙>;
    使用 阿托 = std::atto;   使用 飞托 = std::femto;  使用 皮可 = std::pico;
    使用 纳诺 = std::nano;   使用 微   = std::micro;  使用 毫   = std::milli;
    使用 厘   = std::centi;  使用 分   = std::deci;   使用 十   = std::deca;
    使用 百   = std::hecto;  使用 千   = std::kilo;   使用 兆   = std::mega;
    使用 吉   = std::giga;   使用 太   = std::tera;   使用 拍   = std::peta;
    使用 艾   = std::exa;
}