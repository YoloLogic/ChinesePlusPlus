{
  // Chinese++ 编辑器配置（便携版）
  //
  // 这个文件由包内 install.ps1 处理过：@@CLANGD@@ 与 @@CXX@@ 已被替换成
  // 本包内的真实路径，所以整个文件夹搬到任何盘符都能用。

  // ① 必须指向【我们的】clangd。
  //    clangd 扩展默认会自己下载一个官方 clangd，那个不认识中文关键字，
  //    会把 如果/类型/返回 全部标成红波浪。
  "clangd.path": "@@CLANGD@@",

  "clangd.arguments": [
    "--background-index",
    "--header-insertion=iwyu",
    "--completion-style=detailed",
    "--pch-storage=memory",
    "--fallback-style=LLVM",
    // ② 让 clangd 去问我们的编译器"系统头在哪"（MSVC STL / Windows SDK）。
    //    没有这一条，#include <cstdio> 会报找不到。
    "--query-driver=@@CXX@@"
  ],

  "clangd.onConfigChanged": "restart",

  // ③ 中文源码必须 UTF-8 读写
  "files.encoding": "utf8",
  "files.autoGuessEncoding": false,

  // ④ 关掉微软 C/C++ 扩展的 IntelliSense，免得和 clangd 抢标红
  "C_Cpp.intelliSenseEngine": "disabled",

  "[cpp]": { "editor.tabSize": 4, "editor.insertSpaces": true },

  "files.exclude": {
    "**/*.obj": true, "**/*.ilk": true, "**/*.pdb": true, "**/*.pcm": true
  },
  "search.exclude": { "**/out": true }
}
